[Module named: #multicoreSmoke requires: #[]];
[Globals at: #MulticoreCheck put: [Object clone]];
[Globals at: #MulticoreChecks put: [0 asCell]];
[Globals at: #MulticoreFailures put: [0 asCell]];
[Reflect defineMethod: #assert:label: on: MulticoreCheck as: [:self :condition :label |
  [MulticoreChecks inc];
  [[condition == true] ifFalse: [|
    [MulticoreFailures inc]; [System println: #[#FAILED label]]]]]];
[Reflect defineMethod: #run: on: MulticoreCheck as: [:self :image |
  let a := [Isolate start: #MulticoreWorker selector: #cpu: image: image];
  let b := [Isolate start: #MulticoreWorker selector: #cpu: image: image];
  let echo := [Isolate start: #MulticoreWorker selector: #echo: image: image];
  let id := [echo submit: nil timeout: 5000];
  [self assert: [[id isError] = false] label: #admitted];
  [self assert: [[[echo submit: 2 timeout: 5000] kind] = #notReady] label: #boundedAdmission];
  [self assert: [[[echo pollRequest: [id + 1]] kind] = #staleRequest] label: #wrongIdRejected];
  let reply := [nil asCell];
  [[| [[reply value] isNil]] whileTrue: [| [reply set: [echo pollRequest: id]]]];
  [self assert: [[reply value] = #[nil]] label: #nilSuccessEnvelope];
  [self assert: [[[echo pollRequest: id] kind] = #staleRequest] label: #duplicatePollRejected];
  [self assert: [[echo request: 42 timeout: 5000] = 42] label: #blockingApiStillWorks];
  [echo stop];

  let sequentialStart := [MulticoreClock now];
  [a request: 500000 timeout: 5000];
  [b request: 500000 timeout: 5000];
  let sequential := [[MulticoreClock now] - sequentialStart];
  let responsive := [false asCell];
  let parallelStart := [MulticoreClock now];
  let root := [TaskControl start: [:parent |
    let left := [TaskControl request: 500000 from: a timeout: 5000];
    let right := [TaskControl request: 500000 from: b timeout: 5000];
    [parent fork: [:ticker |
      [System gc];
      [responsive set: [[[left pollOutcome] isNil] and: [| [[right pollOutcome] isNil]]]]]];
    #[[left await] [right await]]]];
  let elapsed := [[MulticoreClock now] - parallelStart];
  let values := [[root pollOutcome] at: 1];
  let left := [values at: 0];
  let right := [values at: 1];
  [self assert: [[[root pollOutcome] at: 0] = #success] label: #parallelRequestsJoined];
  [self assert: [responsive value] label: #rootRunsWhileWorkersAreBusy];
  [self assert: [[left at: 0] < [right at: 1]] label: #leftOverlapsRight];
  [self assert: [[right at: 0] < [left at: 1]] label: #rightOverlapsLeft];
  [self assert: [[left at: 3] > 0] label: #leftDidCpuWork];
  [self assert: [[right at: 3] > 0] label: #rightDidCpuWork];
  [System println: #[#multicoreTiming sequential elapsed [[left at: 2] + [right at: 2]]]];
  [a stop]; [b stop];

  let sleeping := [Isolate start: #Isolate selector: #_isolateSleep: image: image];
  let cancelled := [TaskControl start: [:parent |
    let request := [TaskControl request: 100 from: sleeping timeout: 5000];
    [[| [[[request field: #requestId] value] isNil]] whileTrue: [| nil]];
    [request cancel: #observerStopped];
    [request outcome]]];
  [self assert: [[cancelled pollOutcome] = #[#success #[#cancelled #observerStopped]]] label: #cancelledRequestRetainsOwnershipUntilSettled];
  [self assert: [[sleeping state] = #ready] label: #cancelledRequestWasCollected];
  [self assert: [[sleeping request: 0 timeout: 5000] = 0] label: #workerReusableAfterCancelledWait];
  [sleeping stop];

  let bad := [Isolate start: #MulticoreWorker selector: #fail: image: image];
  let failure := [TaskControl request: nil from: bad timeout: 5000];
  [self assert: [[[[[failure pollOutcome] at: 1] at: 0] class] = #application] label: #applicationFailurePreserved];
  [self assert: [[bad state] = #ready] label: #applicationFailureKeepsWorkerUsable];
  [bad stop];
  let timeoutWorker := [Isolate start: #Isolate selector: #_isolateSleep: image: image];
  let timed := [TaskControl request: 50 from: timeoutWorker timeout: 0];
  [self assert: [[[[[timed pollOutcome] at: 1] at: 0] class] = #timeout] label: #deadlineSettlesRequest];
  [self assert: [[timeoutWorker state] = #exited] label: #deadlineTerminatesProcess];

  let doomed := [Isolate start: #Isolate selector: #_isolateSleep: image: image];
  let terminated := [TaskControl start: [:parent |
    let request := [TaskControl request: 5000 from: doomed timeout: 10000];
    [[| [[[request field: #requestId] value] isNil]] whileTrue: [| nil]];
    [doomed terminate];
    [request outcome]]];
  [self assert: [[[terminated pollOutcome] at: 0] = #failure] label: #terminationDoesNotFabricateSuccess];
  [self assert: [[[[[terminated pollOutcome] at: 1] at: 0] class] = #transport] label: #terminationReportsUncertainty];
  [self assert: [[doomed state] = #exited] label: #terminationBypassesBusyAdmission];
  [self assert: [[[TaskExecutor field: #ingress] value] = #[]] label: #ingressDrained];
  [self assert: [[[TaskExecutor field: #queue] value] = #[]] label: #readyQueueDrained];
  [System gc];
  [System println: #[#multicoreChecks [MulticoreChecks value] #failures [MulticoreFailures value]]]]];
