// Differential contract for the shipped Digla editor adapter. This runs only
// in the client project, where both the native adapter and Birnam reference are
// present. Cursors and ranges are valid UTF-8 byte boundaries.

[[|
let conformanceCases := #[
  { "name" -> "empty", "text" -> "", "cursors" -> #[0], "rangeStart" -> 0, "frameCursor" -> 0 }
  { "name" -> "ascii-wrap", "text" -> "abcdef\nxy",
    "cursors" -> #[0 1 4 5 6 7 9], "rangeStart" -> 0, "frameCursor" -> 5 }
  { "name" -> "unicode-wrap", "text" -> "a🙂b",
    "cursors" -> #[0 1 5 6], "rangeStart" -> 0, "frameCursor" -> 5 }
  { "name" -> "unicode-width", "text" -> "é界\tz",
    "cursors" -> #[0 1 3 6 7 8], "rangeStart" -> 3, "frameCursor" -> 6 }
  { "name" -> "nested-brackets", "text" -> "[{1}]",
    "cursors" -> #[0 1 2 3 4 5], "rangeStart" -> 0, "frameCursor" -> 5 }
  { "name" -> "string-bracket", "text" -> "\"[\"",
    "cursors" -> #[0 1 2 3], "rangeStart" -> 0, "frameCursor" -> 2 }
  { "name" -> "comment-bracket", "text" -> "// [\n1",
    "cursors" -> #[0 1 2 3 4 5 6], "rangeStart" -> 0, "frameCursor" -> 4 }
  { "name" -> "syntax", "text" -> "[Reflect defineMethod: #x on: Object as: [:self | 42]] // note",
    "cursors" -> #[0 1 8 22 25 29 36 40 48 51 52 60 61], "rangeStart" -> 0, "frameCursor" -> 22 }
];
let conformanceWidths := #[1 5 80];
let conformancePrompts := #[2];
let conformanceOk := [true asCell];
let requireConformance := [:condition |
  [condition ifFalse: [| [conformanceOk set: false]]]];

[conformanceCases do: [:case |
  let text := [case at: "text"];
  let cursors := [case at: "cursors"];
  let rangeStart := [case at: "rangeStart"];
  [cursors do: [:cursor |
    let nativeColumn := [Digla displayColumnIn: text at: cursor];
    let referenceColumn := [Digla referenceDisplayColumnIn: text at: cursor];
    [requireConformance value: [nativeColumn = referenceColumn]];
    [[cursor >= rangeStart] ifTrue: [|
      let nativeWidth := [Digla displayWidthIn: text from: rangeStart to: cursor];
      let referenceWidth := [Digla referenceDisplayWidthIn: text from: rangeStart to: cursor];
      [requireConformance value: [nativeWidth = referenceWidth]]]]]];
  let frameCursor := [case at: "frameCursor"];
  [conformancePrompts do: [:prompt |
    [conformanceWidths do: [:width |
      let nativeFrame := [Digla renderFrameFor: text version: 37 cursor: frameCursor
        promptWidth: prompt width: width];
      let referenceFrame := [Digla referenceRenderFrameFor: text version: 37
        cursor: frameCursor promptWidth: prompt width: width];
      [requireConformance value:
        [[Json stringify: nativeFrame] = [Json stringify: referenceFrame]]]]]]]]];
[System println: ["NATIVE-CONFORMANCE:" , [[conformanceOk value] printString]]]
] value]
