// Run after stdlib and task control load, as in Host source startup.
[[|
let checks := [Cell with: #[]];
let check := [:condition | [checks set: [[checks value] add: condition]]];
let basis := [Globals bindingBasis];
[check value: [[Namespace includesKey: #MethodInvocation] not]];
let target := [Object clone];
let first := [Reflect methodForArity: 1 implementation: [:self :argument | [argument + 1]]];
let second := [Reflect methodForArity: 1 implementation: [:self :argument | [argument + 2]]];
[check value: [[first == second] = false]];
[check value: [[first invokeOn: target arguments: #[40]] = 41]];
[check value: [[second invokeOn: target arguments: #[40]] = 42]];
let rebound := [Reflect methodForArity: 1 implementation: [:self :argument | [argument + 3]]];
[check value: [[rebound invokeOn: target arguments: #[40]] = 43]];
[check value: [[first invokeOn: target arguments: #[40]] = 41]];
[check value: [[Globals bindingBasis] = basis]];
[[Vtable behaviorOf: target] addMethod: first as: #answer:];
let captured := [target methodFor: #answer:];
[Reflect defineMethod: #answer: on: target as: [:self :argument | 99]];
[GC collectPrecisely];
[check value: [[target answer: 40] = 99]];
[check value: [[captured invokeOn: target arguments: #[40]] = 41]];
[Reflect defineMethod: #plain on: target as: [:self | 17]];
[check value: [[[target methodFor: #plain] invokeOn: target] = 17]];
let viaTemplate := [Reflect methodForArity: 1 implementation: [:self :argument | argument]];
[check value: [[viaTemplate invokeOn: target arguments: #[42]] = 42]];

// Explicit invocation must remain stackless and preserve its result destination.
let waiting := [Reflect methodForArity: 1 implementation: [:self :task | [task wait]; 42]];
let task := [TaskControl start: [:task | [waiting invokeOn: target arguments: #[task]]]];
[check value: [[task pollOutcome] isNil]];
let token := [task waitToken];
[check value: [token notNil]];
[GC collectPrecisely];
[check value: [task resolve: token with: nil]];
[check value: [[task pollOutcome] = #[#success 42]]];

// Replacing Reflect's constructor remains an ordinary live binding edit.
let refusal := [Error kind: #methodConstructionRefused];
let constructor := [Reflect methodFor: #methodForArity:implementation:];
[Reflect defineMethod: #methodForArity:implementation: on: Reflect as: [:self :arity :implementation | refusal]];
let rejected := [Reflect defineMethod: #neverInstalled on: target as: [:self | 0]];
[check value: [rejected == refusal]];
[[Vtable behaviorOf: Reflect] addMethod: constructor as: #methodForArity:implementation:];
[check value: [[first invokeOn: target arguments: #[40]] = 41]];
[check value: [[Reflect defineMethod: #restored on: target as: [:self | 42]] == target]];
[check value: [[target restored] = 42]];
[checks value]
] value]
