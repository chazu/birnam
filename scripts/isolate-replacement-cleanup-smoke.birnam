[System load: "modules/os.birnam"];
let require := [:condition :message |
  [condition ifFalse: [| [System println: message]; [OS exit: 1]]]];
let spec := {
  #receiver -> #ReplacementFixture,
  #selector -> #handle:,
  #image -> "/tmp/birnam-isolate-replacement-v2.image",
  #healthRequest -> #health,
  #readyTimeout -> 1000,
  #healthTimeout -> 1000,
  #stopTimeout -> 10};
let a := [Isolate start: #ReplacementFixture selector: #handle: image: "/tmp/birnam-isolate-replacement-v1.image"];
let result := [Isolate replace: a using: spec];
[require value: [[result status] = #cleanupPending] value: "post-selection cleanup was not reported as pending"];
[require value: [[[result currentWorker] == a] not] value: "traffic switched back to terminating worker A"];
[require value: [[result pendingCleanup] == a] value: "worker A is not the sole pending cleanup owner"];
[require value: [[result kind] = #reapPending] value: "pending cleanup did not preserve the reap outcome"];
let b := [result currentWorker];
[require value: [[b request: #version timeout: 1000] = #v2] value: "selected worker B was not usable"];
// Reaping is intentionally eventual after the bounded KILL path. Give the
// child a bounded scheduling window before the next host-boundary drain.
[0 to: 100 do: [:i | [Isolate _isolateSleep: 1]]];
[require value: [[a state] = #exited] value: "a later boundary did not reap worker A"];
[require value: [[a stopWithTimeout: 0] == a] value: "reaped worker A was not idempotent"];
[b stopWithTimeout: 10];
[b state];
[System println: "isolate-replacement-cleanup-smoke: TERM/KILL, sole pending owner, later reap, and selected B passed"]
