// ClosureControlProbe exists only in the ffi-test-hooks floor. The factory and
// its nested closure are compiled and admitted by the real installed Codegen.
[System load: "modules/os.birnam"];
[System preciseGc: [[System getEnv: "BIRNAM_CLOSURE_PRECISE"] = "1"]];
let source := [:input :observer |
    let closure := [| input];
    let alias := closure;
    let result := [closure value];
    let again := [alias value];
    let third := [closure value];
    let before := [observer inspect: closure alias: alias];
    let supplied := [observer checkpoint];
    let after := [observer inspect: closure alias: alias supplied: supplied];
    alias];
let factory := [Codegen materializeResumable: [[source codeObject] withoutSourceProvenance] captures: #[]];
let input := [73 asCell];
[ClosureControlProbe warm: factory input: input];
let capture := [[System getEnv: "BIRNAM_CLOSURE_CONTROL"] = "capture"];
[System println: "closure-control: begin measured control"];
let recovered := [ClosureControlProbe run: factory input: input capture: capture];
[System println: "closure-control: end measured control"];
[[[recovered value] == input] ifTrue: [| nil] ifFalse: [| [OS exit: 41]]];
[input set: 91];
[[[[recovered value] value] = 91] ifTrue: [| nil] ifFalse: [| [OS exit: 42]]];
[System println: "closure-control: recovered identity, shared Cell, pause collection, exact effects and native pins passed"];
