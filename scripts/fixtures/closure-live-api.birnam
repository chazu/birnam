[System load: "modules/os.birnam"];
[System preciseGc: [[System getEnv: "BIRNAM_CLOSURE_PRECISE"] = "1"]];
let source := [:input :observer |
    let closure := [| let saved := input; saved];
    let alias := closure;
    let result := [closure value];
    alias];
let factory := [Codegen materializeResumable: [[source codeObject] withoutSourceProvenance] captures: #[]];
let input := [73 asCell];
[ClosureControlProbe warm: factory input: input];
let operation := [[System getEnv: "BIRNAM_CLOSURE_API_OPERATION"] asInteger];
let answer := [ClosureControlProbe checkApi: factory input: input operation: operation];
[input set: 91];
[[[[answer value] value] = 91] ifTrue: [| nil] ifFalse: [| [OS exit: 51]]];
[System println: "closure-live-api: callbacks, restored admission, fresh identity and shared Cell passed"];
