// Source-created closures through the production portable compiler and driver.
[System load: "modules/os.birnam"];
let source := [:input | let closure := [| let alias := input; alias]; let result := [closure value]; result];
let block := [Codegen materializeResumable: [[source codeObject] withoutSourceProvenance] captures: #[]];
let input := [73 asCell];
[[block isError] ifTrue: [| [OS exit: 1]] ifFalse: [| nil]];
[256 timesRepeat: [|
    [[[block value: input] == input] ifTrue: [| nil] ifFalse: [| [OS exit: 2]]]]];
let escapeSource := [:input | let closure := [| input]; let alias := closure; let result := [closure value]; alias];
let escaping := [Codegen materializeResumable: [[escapeSource codeObject] withoutSourceProvenance] captures: #[]];
[128 timesRepeat: [|
    let a := [escaping value: input];
    let b := [escaping value: input];
    [[a == b] ifTrue: [| [OS exit: 3]] ifFalse: [| nil]];
    [[[a value] == input] ifTrue: [| nil] ifFalse: [| [OS exit: 4]]];
    [[[b value] == input] ifTrue: [| nil] ifFalse: [| [OS exit: 5]]]]];
[input set: 91];
[[[[block value: input] value] = 91] ifTrue: [| nil] ifFalse: [| [OS exit: 6]]];
let effects := [0 asCell];
let original := [escaping value: input];
[Reflect defineMethod: #value on: [Reflect vtableOf: original] as: [:self | [effects inc]; input]];
[128 timesRepeat: [| let replaced := [escaping value: input]; nil]];
[[[effects value] = 128] ifTrue: [| nil] ifFalse: [| [OS exit: 9]]];
[Codegen evictMaterializations];
[System gc];
[[[block value: input] == input] ifTrue: [| nil] ifFalse: [| [OS exit: 7]]];
let escaped := [escaping value: input];
[System gc];
[[[escaped value] == input] ifTrue: [| nil] ifFalse: [| [OS exit: 8]]];
[System println: "closure-elision: direct capture, fresh escaping identity, shared Cell, replacement and eviction passed"];
