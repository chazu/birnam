// Embedded into startup, source-free callers and saved image main.
[System load: "modules/os.birnam"];
// Build source-less portable meaning through ordinary Code APIs at each load.
let nestedDirect := [CodeProgram parameters: #[] captures: #["input"] statements: #[[CodeStatement letNamed: "alias" expression: [CodeNode lexicalReadAt: 0]] [CodeStatement expression: [CodeNode lexicalReadAt: 1]]]];
let directProgram := [CodeProgram parameters: #["input"] captures: #[] statements: #[[CodeStatement letNamed: "closure" expression: [CodeNode block: nestedDirect captureBindings: #[0]]] [CodeStatement letNamed: "result" expression: [CodeNode send: #value operands: #[[CodeNode lexicalReadAt: 1]]]] [CodeStatement expression: [CodeNode lexicalReadAt: 2]]]];
let direct := [Codegen materializeResumable: [CodeObject fromProgram: directProgram] captures: #[]];
let nestedEscape := [CodeProgram parameters: #[] captures: #["input"] statements: #[[CodeStatement expression: [CodeNode lexicalReadAt: 0]]]];
let escapeProgram := [CodeProgram parameters: #["input"] captures: #[] statements: #[[CodeStatement letNamed: "closure" expression: [CodeNode block: nestedEscape captureBindings: #[0]]] [CodeStatement letNamed: "alias" expression: [CodeNode lexicalReadAt: 1]] [CodeStatement letNamed: "result" expression: [CodeNode send: #value operands: #[[CodeNode lexicalReadAt: 1]]]] [CodeStatement expression: [CodeNode lexicalReadAt: 2]]]];
let escaping := [Codegen materializeResumable: [CodeObject fromProgram: escapeProgram] captures: #[]];
let shared := [73 asCell];
[System deferredIdentityCheckpoint: 0];
[256 timesRepeat: [|
    [[[direct value: shared] == shared] ifTrue: [| nil] ifFalse: [| [OS exit: 31]]]]];
[128 timesRepeat: [|
    let a := [escaping value: shared];
    let b := [escaping value: shared];
    [[a == b] ifTrue: [| [OS exit: 32]] ifFalse: [| nil]];
    [[[a value] == shared] ifTrue: [| nil] ifFalse: [| [OS exit: 33]]];
    [[[b value] == shared] ifTrue: [| nil] ifFalse: [| [OS exit: 34]]]]];
[System deferredIdentityCheckpoint: 1];
[shared set: 91];
[[[[direct value: shared] value] = 91] ifTrue: [| nil] ifFalse: [| [OS exit: 35]]];
let numericProgram := [CodeProgram parameters: #["a" "b"] captures: #[] statements: #[[CodeStatement letNamed: "first" expression: [CodeNode send: #+ operands: #[[CodeNode lexicalReadAt: 0] [CodeNode lexicalReadAt: 1]]]] [CodeStatement letNamed: "second" expression: [CodeNode send: #+ operands: #[[CodeNode lexicalReadAt: 2] [CodeNode lexicalReadAt: 1]]]] [CodeStatement expression: [CodeNode lexicalReadAt: 3]]]];
let numeric := [Codegen materializeResumable: [CodeObject fromProgram: numericProgram] captures: #[]];
[System deferredIdentityCheckpoint: 2];
[128 timesRepeat: [|
    [[[numeric value: 11 value: 3] = 17] ifTrue: [| nil] ifFalse: [| [OS exit: 36]]]]];
[System deferredIdentityCheckpoint: 3];
let effects := [0 asCell];
let original := [escaping value: shared];
let reflect := Reflect;
[reflect defineMethod: #value on: [Reflect vtableOf: original] as: [:self | [effects inc]; shared]];
[128 timesRepeat: [| let replaced := [escaping value: shared]; nil]];
[[[effects value] = 128] ifTrue: [| nil] ifFalse: [| [OS exit: 37]]];
[Codegen evictMaterializations];
[System gc];
[[[direct value: shared] == shared] ifTrue: [| nil] ifFalse: [| [OS exit: 38]]];
let escaped := [escaping value: shared];
[System gc];
[[[escaped value] == shared] ifTrue: [| nil] ifFalse: [| [OS exit: 39]]];
[System println: "deferred-identity-workload-ok"];
