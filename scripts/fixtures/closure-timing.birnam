[System load: "modules/os.birnam"];
[System preciseGc: true];
let shape := [[System getEnv: "BIRNAM_CLOSURE_SHAPE"] asInteger];
let batches := [[System getEnv: "BIRNAM_CLOSURE_BATCHES"] asInteger];
let sources := #[
    [:input | let closure := [| input]; let answer := [closure value]; answer]
    [:input | let closure := [| input]; let answer := [closure value]; closure]
    [:input | let closure := [| input]; let answer := [closure value]; closure]
    [:input | let closure := [| [input value]]; let answer := [closure value]; answer]
];
let source := [sources at: shape];
let block := [ClosureControlProbe prepare: [[source codeObject] withoutSourceProvenance] captures: #[]];
let input := [73 asCell];
[ClosureControlProbe measure: block input: input shape: shape batches: batches];
