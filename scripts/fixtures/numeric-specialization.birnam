"Actual Prelude arithmetic through a hot portable, stackless body.";
let source := [:a :b | let sum := [a + b]; let product := [sum * b]; [product - a]];
let numeric := [Codegen materializeResumable: [[source codeObject] withoutSourceProvenance] captures: #[]];
[[numeric isError] ifTrue: [| [OS exit: 1]] ifFalse: [| nil]];
[256 timesRepeat: [|
  [[[numeric value: 11 value: 3] = 31] ifTrue: [| nil] ifFalse: [| [OS exit: 2]]]]];
[[[numeric value: 1.5 value: 2] = 5.5] ifTrue: [| nil] ifFalse: [| [OS exit: 3]]];
[[[numeric value: 9223372036854775807 value: 1] isError] ifTrue: [| nil] ifFalse: [| [OS exit: 4]]];
[[[-9223372036854775808 mod: -1] = 0] ifTrue: [| nil] ifFalse: [| [OS exit: 5]]];
let boxed := 11;
[[[boxed + 0] == boxed] ifTrue: [| [OS exit: 6]] ifFalse: [| nil]];
[Codegen evictMaterializations];
[System gc];
[[[numeric value: 11 value: 3] = 31] ifTrue: [| nil] ifFalse: [| [OS exit: 7]]];
let divisionSource := [:a :b | let quotient := [a / b]; [quotient + 0]];
let division := [Codegen materializeResumable: [[divisionSource codeObject] withoutSourceProvenance] captures: #[]];
[256 timesRepeat: [|
  [[[division value: 12 value: 3] = 4] ifTrue: [| nil] ifFalse: [| [OS exit: 8]]]]];
[[[division value: 12 value: 0] isError] ifTrue: [| nil] ifFalse: [| [OS exit: 9]]];
[[[division value: -9223372036854775808 value: -1] isError] ifTrue: [| nil] ifFalse: [| [OS exit: 10]]];
let remainderSource := [:a :b | let remainder := [a mod: b]; [remainder + 0]];
let remainder := [Codegen materializeResumable: [[remainderSource codeObject] withoutSourceProvenance] captures: #[]];
[256 timesRepeat: [|
  [[[remainder value: 11 value: 3] = 2] ifTrue: [| nil] ifFalse: [| [OS exit: 11]]]]];
[[[remainder value: -9223372036854775808 value: -1] = 0] ifTrue: [| nil] ifFalse: [| [OS exit: 12]]];
[[[remainder value: 12 value: 0] isError] ifTrue: [| nil] ifFalse: [| [OS exit: 13]]];
[System println: "numeric-specialization: arithmetic, mixed values, errors, identity and retirement passed"];
