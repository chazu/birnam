[Module named: #replacementFixture requires: #[#stdlib #isolate]];

let ReplacementFixture := [Object clone];
[Reflect defineMethod: #handle: on: ReplacementFixture as: [:self :value |
  let handler := [{
    #health -> [| #healthy],
    #healthError -> [| [Error kind: #healthRejected message: "application health check failed"]],
    #healthSleep -> [| [Isolate _isolateSleep: 200]; #healthy],
    #healthCrash -> [| [Isolate _isolateCrash: nil]],
    #malformedHealth -> [| [Object clone]],
    #digest -> [| [LiveModules currentDigest]],
    #version -> [| #v2]} at: value];
  [[handler isNil] ifTrue: [| #v2] ifFalse: [| [handler value]]]]]
