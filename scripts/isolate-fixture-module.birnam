[Module named: #isolateFixture requires: #[#stdlib #isolate]];

let IsolateFixture := [Object clone];
[Reflect defineMethod: #handle: on: IsolateFixture as: [:self :value | value]];
[Reflect defineMethod: #fail: on: IsolateFixture as: [:self :value |
  [Error kind: #fixture message: "fixture application error"]]]
