// Log — leveled logging to stderr, authored in birnam.
//
//   [Log info: "starting"]            → stderr: <ms> [INFO] starting
//   [Log level: 2]                    → suppress debug+info; keep warn+error
//
// Levels: 0 debug, 1 info, 2 warn, 3 error. A message at level < the threshold
// is suppressed. Each call answers the message it logged, or nil if gated —
// handy for tests. Lines are stamped with `[Time millis]` as a monotonic-ish
// clock until a real time source/format lands.

let Log := [Object new];
let logLevel := [db atom: 1];

[[Log vtable] method: #level: do: [:n | [logLevel set: n]]];

let logAt := [:lvl :tag :msg |
  [[lvl >= [logLevel value]]
    ifTrue: [|
      let stamp := [[[Time millis] printString] , " ["] ;
      let line := [stamp , [tag , ["] " , msg]]] ;
      [System error: [line , "\n"]] ;
      msg]
    ifFalse: [| nil ]]];

[[Log vtable] method: #debug: do: [:m | [logAt value: 0 value: "DEBUG" value: m]]];
[[Log vtable] method: #info:  do: [:m | [logAt value: 1 value: "INFO"  value: m]]];
[[Log vtable] method: #warn:  do: [:m | [logAt value: 2 value: "WARN"  value: m]]];
[[Log vtable] method: #error: do: [:m | [logAt value: 3 value: "ERROR" value: m]]]
