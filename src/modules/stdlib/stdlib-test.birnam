// Tests for the birnam-authored stdlib units. Run with the default module set
// (which loads Test/Stats/Csv/Log):
//
//   birnam src/modules/stdlib/stdlib-test.birnam
//
// Exits after printing a pass/fail summary.

[Test reset];

[Test describe: "Stats" do: [|
  [Test it: "sum"         do: [| [[Stats sum: #[1 2 3 4]] = 10]]] ;
  [Test it: "mean"        do: [| [[Stats mean: #[1 2 3 4]] = 2.5]]] ;
  [Test it: "median odd"  do: [| [[Stats median: #[3 1 2]] = 2]]] ;
  [Test it: "median even" do: [| [[Stats median: #[1 2 3 4]] = 2.5]]] ;
  [Test it: "min"         do: [| [[Stats min: #[5 2 8 1]] = 1]]] ;
  [Test it: "max"         do: [| [[Stats max: #[5 2 8 1]] = 8]]] ;
  [Test it: "mode"        do: [| [[Stats mode: #[1 2 2 3 2]] = 2]]] ;
  [Test it: "stddev"      do: [| [[Stats stddev: #[2 4 4 4 5 5 7 9]] = 2.0]]]]];

[Test describe: "Csv" do: [|
  let rows := [Csv rows: "name,age\nAda,36\nBo,29"];
  [Test it: "row count"       do: [| [[rows size] = 2]]] ;
  [Test it: "field by header" do: [| [[[rows at: 0] at: #name] = "Ada"]]] ;
  [Test it: "second row"      do: [| [[[rows at: 1] at: #age] = "29"]]] ;
  [Test it: "parse cols"      do: [| [[[[Csv parse: "a,b,c\n1,2,3"] at: 0] size] = 3]]]]];

[Test describe: "Json" do: [|
  [Test it: "parse scalar"  do: [| [[[Json parse: "{\"n\": 5}"] at: #n] = 5]]] ;
  [Test it: "parse float"   do: [| [[[Json parse: "[1.5]"] at: 0] = 1.5]]] ;
  [Test it: "stringify rt"  do: [| [[Json stringify: #[1 2 3]] = "[1,2,3]"]]]]];

[Test describe: "Log" do: [|
  [Log level: 1] ;
  [Test it: "info logs"   do: [| [[Log info: "hi"] = "hi"]]] ;
  [Test it: "debug gated" do: [| [[Log debug: "x"] isNil]]] ;
  [Log level: 3] ;
  [Test it: "warn gated"  do: [| [[Log warn: "w"] isNil]]] ;
  [Log level: 1]]];

[Test summary]
