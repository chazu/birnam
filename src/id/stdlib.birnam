// stdlib.birnam — the SELF-HOSTED part of the standard library.
//
// The floor (Integer/Boolean/String/System protocol, collections) is provided by
// the Zig modules (prelude, collection) — those are the irreducible primitives.
// THIS file is birnam defining MORE of its own library, on top of those
// primitives, via `[Reflect defineMethod: #sel on: T as: aBlock]`. It is loaded by
// default; `BIRNAM_NO_STDLIB=1` runs on the bare Zig floor instead.
//
// ⚠️ AFTER EDITING THIS FILE: `loadStdlib` PREFERS the compiled dylib
// (zig-out/lib/libbirnam_stdlib.dylib) over this embedded source, so a stale dylib
// will SILENTLY SHADOW your change (the runtime keeps running the OLD code and your
// tests pass against it). Either `rm zig-out/lib/libbirnam_stdlib.dylib` to force the
// source path, or `zig build stage1` to regenerate the dylib. (Same for toml/config.)

// This module's dependency declaration (stage 3): the self-hosted stdlib sits
// directly on the Zig primitives, so it requires no other self-hosted module.
[Module named: #stdlib requires: #[]];

// -- documentation hooks (baseline no-ops; Doc overrides them) ----------------
// A method's docstring can ride its definition (`… as: block doc: "…"`) and a
// module can declare a one-line summary (`[Reflect docModule: #x is: "…"]`) with
// ZERO dependency on the Doc system: here both just install / do nothing. Loading
// modules/doc.birnam OVERRIDES both on Reflect to capture the docstrings as
// queryable facts — so docs materialize only when Doc is loaded before the modules,
// and cost nothing otherwise.
[Reflect defineMethod: #defineMethod:on:as:doc: on: Reflect as: [:self :sel :proto :blk :doc |
  [self defineMethod: sel on: proto as: blk];
  self]];
[Reflect defineMethod: #docModule:is: on: Reflect as: [:self :mod :summary | self]];

// -- Integer: derived arithmetic on top of the primitive + - * / mod: < <= = -----

[Reflect defineMethod: #negated on: Integer as: [:self | [0 - self]]];
[Reflect defineMethod: #squared on: Integer as: [:self | [self * self]]];
[Reflect defineMethod: #abs on: Integer
   as: [:self | [[self < 0] ifTrue: [| [0 - self]] ifFalse: [| self]]]];

[Reflect defineMethod: #even on: Integer as: [:self | [[self mod: 2] = 0]]];
[Reflect defineMethod: #odd  on: Integer as: [:self | [[self even] not]]];

[Reflect defineMethod: #max: on: Integer
   as: [:self :other | [[self > other] ifTrue: [| self] ifFalse: [| other]]]];
[Reflect defineMethod: #min: on: Integer
   as: [:self :other | [[self < other] ifTrue: [| self] ifFalse: [| other]]]];

[Reflect defineMethod: #between:and: on: Integer
   as: [:self :lo :hi | [[self >= lo] & [self <= hi]]]];

// Recursive — the method dispatches to itself (late-bound through the send).
[Reflect defineMethod: #factorial on: Integer
   as: [:self | [[self <= 1] ifTrue: [| 1] ifFalse: [| [self * [[self - 1] factorial]]]]]];

// -- Object: a display helper everything inherits -------------------------------

// Print the receiver's printString followed by a newline, and answer the receiver
// (so it chains). Handy in scripts and the REPL.
[Reflect defineMethod: #printNl on: Object
   as: [:self | [System println: [self printString]]; self]];

// -- Collection: the higher-order protocol, defined ONCE over inject:into: -------
//
// Vector, Range, Map and String all delegate to `Collection` and each provides
// exactly one native fold primitive, `inject:into:` (birnam has no mutable locals,
// so accumulation is functional — the fold threads the accumulator). Everything
// below derives from that single primitive, so all four families answer the whole
// protocol uniformly (docs/design/41 §B). `collect:`/`select:`/`asVector` build a
// Vector — the universal sequence — regardless of the source's family.

[Reflect defineMethod: #collect: on: Collection
   as: [:self :blk | [self inject: #[] into: [:acc :e | [acc add: [blk value: e]]]]]];

[Reflect defineMethod: #select: on: Collection
   as: [:self :blk | [self inject: #[] into: [:acc :e |
      [[blk value: e] ifTrue: [| [acc add: e]] ifFalse: [| acc]]]]]];

[Reflect defineMethod: #reject: on: Collection
   as: [:self :blk | [self inject: #[] into: [:acc :e |
      [[blk value: e] ifTrue: [| acc] ifFalse: [| [acc add: e]]]]]]];

[Reflect defineMethod: #asVector on: Collection
   as: [:self | [self inject: #[] into: [:acc :e | [acc add: e]]]]];

// count: aBlock — how many elements satisfy the predicate (cardinality is `size`).
[Reflect defineMethod: #count: on: Collection
   as: [:self :blk | [self inject: 0 into: [:acc :e |
      [[blk value: e] ifTrue: [| [acc + 1]] ifFalse: [| acc]]]]]];

// isEmpty over the fold — Range has no native isEmpty; this covers every family.
[Reflect defineMethod: #isEmpty on: Collection as: [:self | [[self size] = 0]]];
[Reflect defineMethod: #notEmpty on: Collection as: [:self | [[self isEmpty] not]]];

// includes: / anySatisfy: / allSatisfy: — phrased over count: and size so they
// never seed a fold with a boolean (avoids depending on literal true/false) and
// stay correct even when an element is nil (unlike a detect:-based membership test).
[Reflect defineMethod: #includes: on: Collection
   as: [:self :x | [[self count: [:e | [e = x]]] > 0]]];
[Reflect defineMethod: #anySatisfy: on: Collection
   as: [:self :blk | [[self count: blk] > 0]]];
[Reflect defineMethod: #allSatisfy: on: Collection
   as: [:self :blk | [[self count: blk] = [self size]]]];

// detect: — first matching element, or nil. detect:ifNone: evaluates a block when
// none match (matches Smalltalk; nil elements that match read as "not found").
[Reflect defineMethod: #detect: on: Collection
   as: [:self :blk | [self inject: nil into: [:acc :e |
      [[acc notNil] ifTrue: [| acc]
                    ifFalse: [| [[blk value: e] ifTrue: [| e] ifFalse: [| nil]]]]]]]];
[Reflect defineMethod: #detect:ifNone: on: Collection
   as: [:self :blk :none | [[[self detect: blk] notNil]
      ifTrue: [| [self detect: blk]] ifFalse: [| [none value]]]]];

// -- Integer: rounding / coercion are identity on a whole number; sqrt via Float ---
[Reflect defineMethod: #floor on: Integer as: [:self | self]];
[Reflect defineMethod: #ceiling on: Integer as: [:self | self]];
[Reflect defineMethod: #rounded on: Integer as: [:self | self]];
[Reflect defineMethod: #truncated on: Integer as: [:self | self]];
[Reflect defineMethod: #asInteger on: Integer as: [:self | self]];
[Reflect defineMethod: #sqrt on: Integer as: [:self | [[self asFloat] sqrt]]];

// -- Integer: timesRepeat:, in birnam over the native to:do: loop -----------------
// Rides the prim to:do: frame, so the stack stays flat. to:do: stops-and-
// propagates on a body error (the whileTrue: contract), so the error check here
// is only to answer the RECEIVER on success (to:do: answers ITS receiver, 1).
[Reflect defineMethod: #timesRepeat: on: Integer as: [:self :aBlock |
  let r := [1 to: self do: [:i | [aBlock value]]];
  [[r isError] ifTrue: [| r] ifFalse: [| self]]] doc:
  "Run aBlock self times (a no-op when self <= 0). Answers self, or the first error the body answers."];

// -- Cell: light mutable state — the store cell, one send away --------------------
// The grammar has NO local re-assignment (`:=` binds only inside `let`) and the
// collections are persistent, so mutable state lives in the historied fact store.
// `[db cellFor: e attr: a]` is the primitive handle; `[v asCell]` (the asString /
// asSymbol family) mints an independent one on a fresh anonymous entity, making
// loop state one send:  let n := [0 asCell]; … [n inc] / [n set: …] / [n value].
[Reflect defineMethod: #asCell on: Object as: [:self |
  let c := [db cellFor: [Object clone] attr: #value];
  [c set: self];
  c] doc:
  "A fresh, independent store cell holding self — [c value] reads, [c set: x] writes, [c history] remembers."];
[Reflect defineMethod: #inc on: CellVt as: [:self |
  [self set: [[self value] + 1]];
  [self value]] doc:
  "Bump a numeric cell by one; answers the new value."];
[Reflect defineMethod: #dec on: CellVt as: [:self |
  [self set: [[self value] - 1]];
  [self value]] doc:
  "Drop a numeric cell by one; answers the new value."];

// -- Equality: identity by default; value/structural where it has meaning (§B3) ----
//
// `=` on Object is identity over the floor's `==`. Integer/Float/String override it
// with value equality (native); Boolean/nil/Symbol are singletons, so identity IS
// value equality — they need nothing more. Collections override via DOUBLE DISPATCH:
// `a = b` asks `b` whether it is an equal collection of a's kind. The back-selectors
// default to false on Object, so `#[1] = aMap` or `#[1] = 5` answers false with no
// type tag and no special case in dispatch. Element comparison recurses through the
// ordinary `=`, so nested and mixed-type collections just work.
[Reflect defineMethod: #= on: Object as: [:self :other | [self == other]]];
[Reflect defineMethod: #equalsVector: on: Object as: [:self :other | false]];
[Reflect defineMethod: #equalsRange:  on: Object as: [:self :other | false]];
[Reflect defineMethod: #equalsMap:    on: Object as: [:self :other | false]];

// Element-wise compare for indexable sequences (both operands already same-kind).
[Reflect defineMethod: #hasSameElementsAs: on: Collection
   as: [:self :other | [[[self size] = [other size]]
      ifTrue: [| [[0 to: [[self size] - 1]] allSatisfy: [:i | [[self at: i] = [other at: i]]]] ]
      ifFalse: [| false ]]]];

[Reflect defineMethod: #= on: Vector as: [:self :other | [other equalsVector: self]]];
[Reflect defineMethod: #equalsVector: on: Vector
   as: [:self :other | [self hasSameElementsAs: other]]];

[Reflect defineMethod: #= on: Range as: [:self :other | [other equalsRange: self]]];
[Reflect defineMethod: #equalsRange: on: Range
   as: [:self :other | [self hasSameElementsAs: other]]];

// Maps compare by key→value content, independent of internal HAMT layout: same size,
// and every key of self present in other with an equal value (looked up, not walked).
[Reflect defineMethod: #= on: Map as: [:self :other | [other equalsMap: self]]];
[Reflect defineMethod: #equalsMap: on: Map
   as: [:self :other | [[[self size] = [other size]]
      ifTrue: [| [[self keys] allSatisfy: [:k |
         [[other includesKey: k]
            ifTrue:  [| [[self at: k] = [other at: k]] ]
            ifFalse: [| false ]]]] ]
      ifFalse: [| false ]]]];

// -- Object: the pipeline operator |> — thread a value into a block --------------
//
// `[x |> aBlock]` is `[aBlock value: x]`: it threads the left value in as the
// block's argument, so a nest of sends reads left-to-right instead of inside-out.
// Binary sends fold left, so it chains in one bracket:
// `[data |> parse |> validate |> render]` is `[render value: [validate value:
// [parse value: data]]]`. Defined on Object so any value pipes; the block chooses
// what to do with it (send, combine, guard), which recovers Smalltalk's
// thread-as-receiver fluency over birnam's native blocks.
[Reflect defineMethod: #|> on: Object as: [:self :block | [block value: self]]];

// ── error protocol (migrated from error.zig; docs/design/44a) ────────────────
// The representation (native Err payload), the doesNotUnderstand: SWAP, and the
// Error factory stay in the Zig core (error.zig) — they are floor. What lives here
// is pure block orchestration over the core primitives [e isError]/[e kind]/
// [e message] and the [Error …] factory. `ErrorVt` is the exported error-instance
// vtable; `on: ErrorVt` installs on every error instance.

// Type predicates live on the MIRROR (Reflect), not on base objects (Bracha
// stratification — a type query is asked THROUGH the mirror, not answered by the
// object itself). `[Reflect vtableOf: x]` is the one floor primitive; each
// predicate compares an object's vtable to an EXEMPLAR's — so it is independent of
// how a kind's prototype is exported (docs/design/44a).
// The exemplar vtables are taken ONCE at load (still export-shape-independent —
// derived from exemplar values, not from how a kind's prototype is exported);
// re-deriving per query would allocate a fresh "" on every string-protocol guard.
[Globals at: #SymbolExemplarVt put: [Reflect vtableOf: #s]];
[Globals at: #StringExemplarVt put: [Reflect vtableOf: ""]];
[Reflect defineMethod: #isSymbol: on: Reflect as: [:self :x | [[self vtableOf: x] == SymbolExemplarVt]]];
[Reflect defineMethod: #isString: on: Reflect as: [:self :x | [[self vtableOf: x] == StringExemplarVt]]];

// Does a caught error's kind satisfy an on:do: spec? the wildcard #error, an exact
// kind symbol, or any collection of kinds. A single symbol short-circuits to false
// (no match); only a non-symbol spec (a collection) is probed with `includes:`.
[Reflect defineMethod: #kindMatches: on: ErrorVt as: [:self :want |
   [[[want = #error] | [want = [self kind]]]
      ifTrue:  [| true]
      ifFalse: [| [[Reflect isSymbol: want] ifTrue:  [| false]
                                            ifFalse: [| [want includes: [self kind]]]]]]]];

// [[block] on: spec do: handler] — run the protected block; if it yields an error
// whose kind matches spec, run the handler with it; else pass the value through.
[Reflect defineMethod: #on:do: on: Object as: [:self :spec :handler |
   let val := [self value];
   [[val isError]
      ifTrue:  [| [[val kindMatches: spec] ifTrue:  [| [handler value: val]]
                                           ifFalse: [| val]]]
      ifFalse: [| val]]]];

// [protected ensure: cleanup] — always run cleanup, answer protected's result.
[Reflect defineMethod: #ensure: on: Object as: [:self :cleanup |
   let val := [self value]; [cleanup value]; val]];

// ifError:/ifNotError: — dispatch on whether the receiver is an error.
[Reflect defineMethod: #ifError:    on: Object  as: [:self :h | self]];
[Reflect defineMethod: #ifNotError: on: Object  as: [:self :h | [h value: self]]];
[Reflect defineMethod: #ifError:    on: ErrorVt as: [:self :h | [h value: self]]];
[Reflect defineMethod: #ifNotError: on: ErrorVt as: [:self :h | self]];

// printString — "error(#kind: message)"; kind is always a symbol, message may be nil.
[Reflect defineMethod: #printString on: ErrorVt as: [:self |
   let k := [[self kind] printString];
   let m := [[[self message] isNil] ifTrue: [| ""] ifFalse: [| [": " , [self message]]]];
   [[["error(" , k] , m] , ")"]]];

// Raise from a message string: ["boom" error] → #error; ["boom" error: #kind].
[Reflect defineMethod: #error  on: String as: [:self | [Error message: self]]];
[Reflect defineMethod: #error: on: String as: [:self :kind | [Error kind: kind message: self]]];

// ── String: the derived protocol over the byte floor (docs/design/44 Phase 2) ──
//
// The String FLOOR is: size, at: (1-byte String), byteAt: (Integer), copyFrom:to:
// (slice-or-nil), `,` (concat), `=`, printString, asSymbol, asInteger, asNumber —
// plus two native families that are DELIBERATE retentions: asLowercase/
// asUppercase/replace:with: (they BUILD byte content; wait on the Phase-5
// StringBuilder) and the per-byte SCANNERS split:/trimmed/indexOf: (a send costs
// ~1.5-2µs, so a derived scan over bulk text — zigdoc sweeping Zig sources for
// doc/docgen — is ~10× slower; "lift the surface, keep the native join").
// Everything else derives here. Iteration rides Range's native fold ([0 to: n]
// inject:/do: — an empty range, start > stop, iterates zero times), so String's
// whole Collection protocol (collect:/select:/detect:/…, and isEmpty/notEmpty
// from Collection itself) follows. Arg guards mirror the old native semantics:
// a non-String argument answers false (predicates) rather than erroring, via
// the [Reflect isString:] mirror.

// The fold primitive, derived: fold the 1-byte Strings through Range's fold.
[Reflect defineMethod: #inject:into: on: String
   as: [:self :acc :blk | [[0 to: [[self size] - 1]]
      inject: acc into: [:a :i | [blk value: a value: [self at: i]]]]]];

// do: — evaluate the block with each 1-byte String; answers self.
[Reflect defineMethod: #do: on: String
   as: [:self :blk |
      [[0 to: [[self size] - 1]] do: [:i | [blk value: [self at: i]]]];
      self]];

[Reflect defineMethod: #startsWith: on: String as: [:self :prefix |
   [[Reflect isString: prefix]
      ifTrue:  [| [[self copyFrom: 0 to: [prefix size]] = prefix]]
      ifFalse: [| false]]] doc:
   "True iff the receiver begins with `prefix` (every string starts with the empty string; a non-String answers false)."];

[Reflect defineMethod: #endsWith: on: String as: [:self :suffix |
   [[Reflect isString: suffix]
      ifTrue:  [| [[self copyFrom: [[self size] - [suffix size]] to: [self size]] = suffix]]
      ifFalse: [| false]]] doc:
   "True iff the receiver ends with `suffix` (a too-long slice is nil, which compares false; a non-String answers false)."];

// includesSubstring: — the surface over the native indexOf: scanner; indexOf:'s
// guards (non-String → nil, empty needle → 0) give exactly the right booleans.
[Reflect defineMethod: #includesSubstring: on: String as: [:self :sub |
   [[self indexOf: sub] notNil]] doc:
   "True iff `sub` occurs in the receiver (empty `sub` is everywhere; a non-String answers false)."];

// Internal: the six ASCII whitespace bytes (space \t \n \v \f \r), as trimmed/
// words define them — matching the native set exactly.
[Reflect defineMethod: #isWhitespaceByte: on: String as: [:self :b |
   [[[b = 32] | [b = 9]] | [[[b = 10] | [b = 11]] | [[b = 12] | [b = 13]]]]]];

// words — the whitespace-run tokenizer: thread #[parts runStart], runStart nil
// while inside whitespace; empty runs never open, so they are dropped.
[Reflect defineMethod: #words on: String as: [:self |
   let res := [[0 to: [[self size] - 1]] inject: #[ #[] nil ] into: [:acc :i |
      [[self isWhitespaceByte: [self byteAt: i]]
         ifTrue:  [| [[[acc at: 1] isNil]
                        ifTrue:  [| acc]
                        ifFalse: [| #[ [[acc at: 0] add: [self copyFrom: [acc at: 1] to: i]] nil ]]]]
         ifFalse: [| [[[acc at: 1] isNil]
                        ifTrue:  [| #[ [acc at: 0] i ]]
                        ifFalse: [| acc]]]]]];
   [[[res at: 1] isNil]
      ifTrue:  [| [res at: 0]]
      ifFalse: [| [[res at: 0] add: [self copyFrom: [res at: 1] to: [self size]]]]]] doc:
   "A Vector of the whitespace-separated runs (empty runs dropped; punctuation stays attached)."]
