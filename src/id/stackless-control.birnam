// stackless-control.birnam — source-authored callback-driving control.
//
// This unit contains only ordinary methods, blocks, and sends. Production
// compilation requires the whole unit to be resumable; no selector or source
// definition carries an execution-representation annotation.

[Module named: #stacklessControl requires: #[#modules #stdlib]];

// Boolean is the canonical true/base prototype. False is the canonical false
// singleton with a private vtable delegating to Boolean.
[Reflect defineMethod: #ifTrue:ifFalse: on: Boolean as: [:self :whenTrue :whenFalse |
  [whenTrue value]]];

[Reflect defineMethod: #ifTrue: on: Boolean as: [:self :whenTrue |
  [whenTrue value]]];

[Reflect defineMethod: #ifFalse: on: Boolean as: [:self :whenFalse |
  nil]];

[Reflect defineMethod: #ifTrue:ifFalse: on: False as: [:self :whenTrue :whenFalse |
  [whenFalse value]]];

[Reflect defineMethod: #ifTrue: on: False as: [:self :whenTrue |
  nil]];

[Reflect defineMethod: #ifFalse: on: False as: [:self :whenFalse |
  [whenFalse value]]];

// The recursive sends are tail sends once every implementation in this unit is
// selected. Atomic condition and body blocks may still be synchronous native
// leaves; they return across one bounded entry barrier per invocation.
[Reflect defineMethod: #whileTrue: on: Block as: [:conditionBlock :body |
  let condition := [conditionBlock value];
  [[condition isError]
    ifTrue: [| condition]
    ifFalse: [|
      [[condition == true]
        ifTrue: [|
          let result := [body value];
          [[result isError]
            ifTrue: [| result]
            ifFalse: [| [conditionBlock whileTrue: body]]]]
        ifFalse: [|
          [[condition == false]
            ifTrue: [| nil]
            ifFalse: [| [Error kind: #mustBeBoolean message: "while loop condition must answer true or false"]]]]]]]]];

[Reflect defineMethod: #whileFalse: on: Block as: [:conditionBlock :body |
  let condition := [conditionBlock value];
  [[condition isError]
    ifTrue: [| condition]
    ifFalse: [|
      [[condition == false]
        ifTrue: [|
          let result := [body value];
          [[result isError]
            ifTrue: [| result]
            ifFalse: [| [conditionBlock whileFalse: body]]]]
        ifFalse: [|
          [[condition == true]
            ifTrue: [| nil]
            ifFalse: [| [Error kind: #mustBeBoolean message: "while loop condition must answer true or false"]]]]]]]]];

// Integer iteration is tail-recursive inside the selected unit. The equality
// exit avoids overflowing when both bounds are maxInt, and the explicit answer
// argument preserves to:do:'s original receiver answer.
[Reflect defineMethod: #to:do: on: Integer as: [:self :last :body |
  [self stacklessTo: last do: body answer: self]]];

[Reflect defineMethod: #stacklessTo:do:answer: on: Integer as: [:self :last :body :answer |
  [[self > last]
    ifTrue: [| answer]
    ifFalse: [| [self stacklessToBody: last do: body answer: answer]]]]];

[Reflect defineMethod: #stacklessToBody:do:answer: on: Integer as: [:self :last :body :answer |
  let eachResult := [body value: self];
  [[eachResult isError]
    ifTrue: [| eachResult]
    ifFalse: [| [self stacklessToContinue: last do: body answer: answer]]]]];

[Reflect defineMethod: #stacklessToContinue:do:answer: on: Integer as: [:self :last :body :answer |
  [[self = last]
    ifTrue: [| answer]
    ifFalse: [| [[self + 1] stacklessTo: last do: body answer: answer]]]]];

[Reflect defineMethod: #timesRepeat: on: Integer as: [:self :body |
  let result := [1 to: self do: [:ignored | [body value]]];
  [[result isError] ifTrue: [| result] ifFalse: [| self]]]];

// Indexable collection drivers. Callback results from do: are deliberately
// ignored, matching the existing language contract; inject: threads every
// result, including ordinary Error values, into the next callback.
[Reflect defineMethod: #do: on: Vector as: [:self :body |
  [self stacklessDo: body from: 0]]];

[Reflect defineMethod: #stacklessDo:from: on: Vector as: [:self :body :index |
  [[index >= [self size]]
    ifTrue: [| self]
    ifFalse: [|
      [body value: [self at: index]];
      [self stacklessDo: body from: [index + 1]]]]]];

[Reflect defineMethod: #inject:into: on: Vector as: [:self :initial :body |
  [self stacklessInject: initial into: body from: 0]]];

[Reflect defineMethod: #stacklessInject:into:from: on: Vector as: [:self :accumulator :body :index |
  [[index >= [self size]]
    ifTrue: [| accumulator]
    ifFalse: [|
      let next := [body value: accumulator value: [self at: index]];
      [self stacklessInject: next into: body from: [index + 1]]]]]];

[Reflect defineMethod: #do: on: Range as: [:self :body |
  [self stacklessDo: body from: 0]]];

[Reflect defineMethod: #stacklessDo:from: on: Range as: [:self :body :index |
  [[index >= [self size]]
    ifTrue: [| self]
    ifFalse: [|
      [body value: [self at: index]];
      [self stacklessDo: body from: [index + 1]]]]]];

[Reflect defineMethod: #inject:into: on: Range as: [:self :initial :body |
  [self stacklessInject: initial into: body from: 0]]];

[Reflect defineMethod: #stacklessInject:into:from: on: Range as: [:self :accumulator :body :index |
  [[index >= [self size]]
    ifTrue: [| accumulator]
    ifFalse: [|
      let next := [body value: accumulator value: [self at: index]];
      [self stacklessInject: next into: body from: [index + 1]]]]]];

[Reflect defineMethod: #do: on: String as: [:self :body |
  [self stacklessDo: body from: 0]]];

[Reflect defineMethod: #stacklessDo:from: on: String as: [:self :body :index |
  [[index >= [self size]]
    ifTrue: [| self]
    ifFalse: [|
      [body value: [self at: index]];
      [self stacklessDo: body from: [index + 1]]]]]];

[Reflect defineMethod: #inject:into: on: String as: [:self :initial :body |
  [self stacklessInject: initial into: body from: 0]]];

[Reflect defineMethod: #stacklessInject:into:from: on: String as: [:self :accumulator :body :index |
  [[index >= [self size]]
    ifTrue: [| accumulator]
    ifFalse: [|
      let next := [body value: accumulator value: [self at: index]];
      [self stacklessInject: next into: body from: [index + 1]]]]]];

// Map iteration retains the native HAMT's deterministic values/keys projection
// as an atomic leaf, but no native frame remains live while user code runs.
[Reflect defineMethod: #do: on: MapVt as: [:self :body |
  [[self values] do: body];
  self]];

[Reflect defineMethod: #inject:into: on: MapVt as: [:self :initial :body |
  [[self values] inject: initial into: body]]];

[Reflect defineMethod: #keysAndValuesDo: on: MapVt as: [:self :body |
  [[self keys] do: [:key | [body value: key value: [self at: key]]]];
  self]];

// These derived Collection methods must share the selected unit with the fold
// primitives so their nested callback blocks do not reintroduce one native
// boundary per element.
[Reflect defineMethod: #collect: on: Collection as: [:self :body |
  [self inject: #[] into: [:result :each | [result add: [body value: each]]]]]];

[Reflect defineMethod: #select: on: Collection as: [:self :body |
  [self inject: #[] into: [:result :each |
    [[body value: each] ifTrue: [| [result add: each]] ifFalse: [| result]]]]]];

[Reflect defineMethod: #reject: on: Collection as: [:self :body |
  [self inject: #[] into: [:result :each |
    [[body value: each] ifTrue: [| result] ifFalse: [| [result add: each]]]]]]];

[Reflect defineMethod: #count: on: Collection as: [:self :body |
  [self inject: 0 into: [:count :each |
    [[body value: each] ifTrue: [| [count + 1]] ifFalse: [| count]]]]]];

[Reflect defineMethod: #detect: on: Collection as: [:self :body |
  [self inject: nil into: [:found :each |
    [[found notNil]
      ifTrue: [| found]
      ifFalse: [| [[body value: each] ifTrue: [| each] ifFalse: [| nil]]]]]]]];

[Reflect defineMethod: #detect:ifNone: on: Collection as: [:self :body :none |
  let found := [self detect: body];
  [[found notNil] ifTrue: [| found] ifFalse: [| [none value]]]]];

// Error-handling callbacks are control drivers too: protected, handler, and
// cleanup blocks now run without a synchronous Object>>on:do:/ensure: frame.
[Reflect defineMethod: #on:do: on: Object as: [:self :spec :handler |
  let value := [self value];
  [[value isError]
    ifTrue: [|
      [[value kindMatches: spec]
        ifTrue: [| [handler value: value]]
        ifFalse: [| value]]]
    ifFalse: [| value]]]];

[Reflect defineMethod: #ensure: on: Object as: [:self :cleanup |
  let value := [self value];
  [cleanup value];
  value]];

// Structured task policy. These ordinary methods share the selected control
// unit so waiting never leaves a synchronous library frame on the native stack.
[Machine prepareBlockControl];
[Globals at: #TaskControl put: [Object clone]];
[Globals at: #TaskExecutor put: [Object clone]];

[Reflect defineMethod: #attribute: on: TaskControl as: [:self :name |
  [["TaskControl." , [name asString]] asSymbol]]];
[Reflect defineMethod: #stateFields on: TaskControl as: [:self |
  #[#machine #outcome #waitToken #shieldDepth #failures #cancelled #cancelReason
    #parent #children #waiters #failureSources #childFailures #body #joining #protectedFromParent
    #controlError #queue #draining #current #quantum #transitionDepth #bodyActive
    #ingress #requestWorker #requestId #externalResult #serviceTask]]];
[Reflect defineMethod: #initializeStateSchema on: TaskControl as: [:self |
  [[self stateFields] do: [:name |
    let attribute := [self attribute: name];
    [db assert: attribute attr: #cardinality value: #one];
    [db assert: attribute attr: #history value: false];
    [db assert: attribute attr: #imageTransient value: true]]]]];
[TaskControl initializeStateSchema];
// Handles are process-local even after their Machine has finished. The marker
// itself is transient, so it does not make otherwise unreachable tasks durable.
[db assert: #imageTransientObject attr: #cardinality value: #one];
[db assert: #imageTransientObject attr: #history value: false];
[db assert: #imageTransientObject attr: #imageTransient value: true];
[Reflect defineMethod: #field: on: TaskControl as: [:self :name |
  [db cellFor: self attr: [self attribute: name]]]];
[Reflect defineMethod: #field: on: TaskExecutor as: [:self :name |
  [db cellFor: self attr: [TaskControl attribute: name]]]];
[[TaskExecutor field: #queue] set: #[]];
[[TaskExecutor field: #ingress] set: #[]];
[[TaskExecutor field: #draining] set: false];
[[TaskExecutor field: #current] set: nil];
[[TaskExecutor field: #quantum] set: 128];
[Reflect defineMethod: #current on: TaskExecutor as: [:self | [[self field: #current] value]]];
[Reflect defineMethod: #initialize on: TaskExecutor as: [:self |
  [[[[self field: #queue] value] isNil] ifTrue: [|
    [[self field: #queue] set: #[]];
    [[self field: #ingress] set: #[]];
    [[self field: #draining] set: false];
    [[self field: #quantum] set: 128];
    [[self field: #current] set: nil]]];
  self]];
[Reflect defineMethod: #quantum on: TaskExecutor as: [:self |
  [self initialize];
  [[self field: #quantum] value]]];
// Only the executing task needs a transition guard. Host executor work and
// synchronous native callbacks already run without another task being selected.
[Reflect defineMethod: #transition: on: TaskExecutor as: [:self :body |
  let task := [self current];
  [[task isNil]
    ifTrue: [| [body value]]
    ifFalse: [|
      let machine := [task machine];
      [[machine isNil]
        ifTrue: [| [body value]]
        ifFalse: [|
          [[[machine executionState] = #running]
            ifTrue: [|
              [[task canControl]
                ifTrue: [| [task transition: body]]
                ifFalse: [| [body value]]]]
            ifFalse: [| [body value]]]]]]]]];

[Reflect defineMethod: #enqueue: on: TaskExecutor as: [:self :job |
  [TaskExecutor transition: [|
    [self initialize];
    [[self field: #queue] set: [[[self field: #queue] value] add: job]];
    self]]]];
// Queue notifications; never recursively drive another task from a completing
// child's native entry. Each drive returns before the next task can run.
[Reflect defineMethod: #hasWork on: TaskExecutor as: [:self |
  [[[[[self field: #queue] value] size] > 0]
    ifTrue: [| true]
    ifFalse: [|
      [[[[[self field: #ingress] value] size] > 0]
        ifTrue: [| true]
        ifFalse: [|
          let task := [[self field: #serviceTask] value];
          [[task isNil] ifTrue: [| false] ifFalse: [| [[task pollOutcome] isNil]]]]]]]]];
[Reflect defineMethod: #watch: on: TaskExecutor as: [:self :task |
  [self transition: [|
    [[self field: #ingress] set: [[[self field: #ingress] value] add: task]]]]]];
[Reflect defineMethod: #pollIngress on: TaskExecutor as: [:self |
  let service := [[self field: #serviceTask] value];
  [[service notNil] ifTrue: [|
    let control := [Isolate pollServiceControl];
    [[control = true] ifTrue: [| [service cancel: #remoteCancellation]]];
    [[control = #ownerLost] ifTrue: [| [service cancel: #ownerLost]]]]];
  [[[self field: #ingress] value] do: [:task | [task pollExternal]]];
  [[self field: #ingress] set: [[[self field: #ingress] value] select: [:task |
    [[[task field: #externalResult] value] isNil]]]];
  self]];
[Reflect defineMethod: #idle on: TaskExecutor as: [:self |
  [Isolate idleFor: 1]]];
[Reflect defineMethod: #driveNext on: TaskExecutor as: [:self |
  let queue := [[self field: #queue] value];
  let job := [queue at: 0];
  [[self field: #queue] set: [queue copyFrom: 1 to: [queue size]]];
  let task := [job at: 0];
  [[self field: #current] set: task];
  let progress := [task drive: job];
  [[self field: #current] set: nil];
  progress]];
[Reflect defineMethod: #drain on: TaskExecutor as: [:self |
  [self initialize];
  [[[self field: #draining] value]
    ifTrue: [| nil]
    ifFalse: [|
      [[self field: #draining] set: true];
      let result := [[| [self hasWork]] whileTrue: [|
        [self pollIngress];
        [[[[[self field: #queue] value] size] > 0]
          ifTrue: [| [self driveNext]]
          ifFalse: [| [[self hasWork] ifTrue: [| [self idle]]]]]]];
      [[self field: #draining] set: false];
      result]]]];

[Reflect defineMethod: #machine on: TaskControl as: [:self | [[self field: #machine] value]]];
[Reflect defineMethod: #pollOutcome on: TaskControl as: [:self | [[self field: #outcome] value]]];
[Reflect defineMethod: #waitToken on: TaskControl as: [:self | [[self field: #waitToken] value]]];
[Reflect defineMethod: #shieldDepth on: TaskControl as: [:self | [[self field: #shieldDepth] value]]];
[Reflect defineMethod: #failures on: TaskControl as: [:self | [[self field: #failures] value]]];
[Reflect defineMethod: #children on: TaskControl as: [:self | [[self field: #children] value]]];

[Reflect defineMethod: #prepare:parent: on: TaskControl as: [:self :body :parent |
  let task := [self clone];
  [db assert: task attr: #imageTransientObject value: true];
  [[task field: #machine] set: [Machine new]];
  [[task field: #outcome] set: nil];
  [[task field: #waitToken] set: nil];
  [[task field: #shieldDepth] set: 0];
  [[task field: #failures] set: #[]];
  [[task field: #failureSources] set: #[]];
  [[task field: #childFailures] set: #[]];
  [[task field: #cancelled] set: false];
  [[task field: #cancelReason] set: nil];
  [[task field: #parent] set: parent];
  [[task field: #children] set: #[]];
  [[task field: #waiters] set: #[]];
  [[task field: #body] set: body];
  [[task field: #joining] set: false];
  [[task field: #protectedFromParent] set: false];
  [[task field: #controlError] set: nil];
  [[task field: #transitionDepth] set: 0];
  [[task field: #bodyActive] set: false];
  task]];

[Reflect defineMethod: #start: on: TaskControl as: [:self :body |
  // Calls inside a task remain owned; start: cannot accidentally detach work.
  [[[TaskExecutor current] isNil]
    ifTrue: [|
      let task := [self prepare: body parent: nil];
      [TaskExecutor enqueue: #[task #start nil]];
      let progress := [TaskExecutor drain];
      [[progress isError] ifTrue: [| progress] ifFalse: [| task]]]
    ifFalse: [| [[TaskExecutor current] fork: body]]]]];

// Lifecycle cleanup is owned before its first turn. Cancellation records an
// outcome but cannot skip resource release merely by arriving before startup.
[Reflect defineMethod: #startCleanup: on: TaskControl as: [:self :body |
  let parent := [TaskExecutor current];
  [[parent isNil]
    ifTrue: [|
      let task := [self prepare: body parent: nil];
      [[task field: #shieldDepth] set: 1];
      [TaskExecutor enqueue: #[task #start nil]];
      [TaskExecutor drain]; task]
    ifFalse: [|
      [TaskExecutor transition: [|
        let task := [parent fork: body];
        [[task isError] ifFalse: [| [[task field: #shieldDepth] set: 1]]];
        task]]]]]];

[Reflect defineMethod: #fork: on: TaskControl as: [:self :body |
  [TaskExecutor transition: [|
    [[[self pollOutcome] notNil]
      ifTrue: [| [Error kind: #taskClosed]]
      ifFalse: [|
        [[[self field: #joining] value]
          ifTrue: [| [Error kind: #taskClosed]]
          ifFalse: [|
            let child := [TaskControl prepare: body parent: self];
            [[child field: #protectedFromParent] set: [[self shieldDepth] > 0]];
            [[self field: #children] set: [[self children] add: child]];
            [[[self shieldDepth] = 0] ifTrue: [|
              [[[self field: #cancelled] value] ifTrue: [|
                [child cancel: [[self field: #cancelReason] value]]]]]];
            [TaskExecutor enqueue: #[child #start nil]];
            child]]]]]]]];

// The owner holds the Machine locally through terminal publication, which
// clears the task's reference before the final method returns.
[Reflect defineMethod: #drive: on: TaskControl as: [:self :job |
  let machine := [self machine];
  let quantum := [TaskExecutor quantum];
  let progress := [[[job at: 1] = #start]
    ifTrue: [|
      let body := [[self field: #body] value];
      [[self field: #body] set: nil];
      [machine runBlock: [| [self execute: body]] budget: quantum]]
    ifFalse: [|
      [[[job at: 1] = #resume]
        ifTrue: [| [machine resumeWith: [job at: 2] budget: quantum]]
        ifFalse: [|
          let delivery := [self deliverCancellationTo: machine];
          [[delivery isError]
            ifTrue: [| delivery]
            ifFalse: [| [machine continueWithBudget: quantum]]]]]]];
  [[progress isError] ifTrue: [| [[self field: #controlError] set: progress]]];
  // A budget expiry may split a library transition, but cannot hand the owner
  // to a peer until the transition finishes. Explicit parks still release it.
  [[| [self mustFinishTransitionOn: machine]] whileTrue: [|
    let next := [machine continueWithBudget: quantum];
    [[next isError] ifTrue: [| [[self field: #controlError] set: next]]]]];
  [[[[self field: #controlError] value] isNil] ifTrue: [|
    [[machine isRunnable] ifTrue: [| [TaskExecutor enqueue: #[self #continue nil]]]]]];
  [[self field: #controlError] value]]];
[Reflect defineMethod: #mustFinishTransitionOn: on: TaskControl as: [:self :machine |
  [[[[self field: #controlError] value] notNil]
    ifTrue: [| false]
    ifFalse: [|
      [[machine isRunnable]
        ifTrue: [|
          [[[[self field: #transitionDepth] value] > 0]
            ifTrue: [| true]
            ifFalse: [| [[self pollOutcome] notNil]]]]
        ifFalse: [| false]]]]]];
[Reflect defineMethod: #deliverCancellationTo: on: TaskControl as: [:self :machine |
  [[[self field: #cancelled] value] ifTrue: [|
    [[[self field: #bodyActive] value] ifTrue: [|
      [[[self shieldDepth] = 0] ifTrue: [|
        [[[[self field: #transitionDepth] value] = 0] ifTrue: [|
          [[machine boundaryDeliveryPending] ifFalse: [|
            [machine exitRunnableBoundary: #[#cancelled [[self field: #cancelReason] value]]]]]]]]]]]]]]];

// These are internal scheduler transitions, not application mutexes. Their
// boundary restores nesting on explicit fail:/exit; Error-valued returns remain
// ordinary values. Policy and state stay replaceable Birnam.
[Reflect defineMethod: #transition: on: TaskControl as: [:self :body |
  let machine := [self machine];
  let depth := [[self field: #transitionDepth] value];
  [[self field: #transitionDepth] set: [depth + 1]];
  let answer := [machine protectedBlock: [| #[#success [body value]]]];
  [machine acknowledgeBoundaryDelivery];
  [[self field: #transitionDepth] set: depth];
  [[[answer at: 0] = #success]
    ifTrue: [| [answer at: 1]]
    ifFalse: [| [machine leaveBoundary: answer]]]]];

[Reflect defineMethod: #recordFailures:from: on: TaskControl as: [:self :evidence :source |
  [TaskExecutor transition: [|
    let known := [[[self field: #failureSources] value] detect: [:each | [each == source]]];
    [[known isNil] ifTrue: [|
      [[self field: #failureSources] set: [[[self field: #failureSources] value] add: source]];
      [evidence do: [:each | [[self field: #failures] set: [[self failures] add: each]]]]]];
    self]]]];
[Reflect defineMethod: #recordOutcome:from: on: TaskControl as: [:self :result :source |
  [TaskExecutor transition: [|
    let known := [[[self field: #failureSources] value] detect: [:each | [each == source]]];
    [[known isNil] ifTrue: [|
      [self recordFailures: [result at: 1] from: source];
      [[self field: #childFailures] set: [[[self field: #childFailures] value] add: result]]]];
    self]]]];
[Reflect defineMethod: #fail: on: TaskControl as: [:self :evidence |
  [[self canControl]
    ifTrue: [|
      [self recordFailures: #[evidence] from: [Object clone]];
      [self cancelAllChildren: #parentFailed];
      [[self machine] leaveBoundary: #[#failure [self failures]]]
    ]
    ifFalse: [| [Error kind: #taskContextRequired]]]]];

[Reflect defineMethod: #shield on: TaskControl as: [:self |
  [[self field: #shieldDepth] set: [[self shieldDepth] + 1]];
  [[self machine] acknowledgeBoundaryDelivery];
  self]];
[Reflect defineMethod: #unshield on: TaskControl as: [:self |
  [[self field: #shieldDepth] set: [[self shieldDepth] - 1]];
  self]];
[Reflect defineMethod: #checkpoint on: TaskControl as: [:self |
  [[[self shieldDepth] = 0] ifTrue: [|
    [[[self field: #cancelled] value] ifTrue: [|
      [[[self machine] boundaryDeliveryPending] ifFalse: [|
        [[self machine] leaveBoundary: #[#cancelled [[self field: #cancelReason] value]]]]]]]]];
  self]];
[Reflect defineMethod: #canControl on: TaskControl as: [:self |
  [[[TaskExecutor current] == self]
    ifTrue: [| [[self machine] controlEligible]]
    ifFalse: [| false]]]];
[Reflect defineMethod: #canWait on: TaskControl as: [:self |
  [[self canControl]
    ifTrue: [| [[[self field: #transitionDepth] value] = 0]]
    ifFalse: [| false]]]];
[Reflect defineMethod: #waitError on: TaskControl as: [:self |
  [[[[self field: #transitionDepth] value] > 0]
    ifTrue: [| [Error kind: #taskTransitionWait]]
    ifFalse: [| [Error kind: #taskContextRequired]]]]];
[Reflect defineMethod: #wait on: TaskControl as: [:self |
  [[self canWait]
    ifTrue: [|
      let value := [TaskExecutor transition: [|
        [self checkpoint];
        [[self field: #waitToken] set: [Object clone]];
        [[self machine] park]]];
      [self checkpoint];
      value]
    ifFalse: [| [self waitError]]]]];
// Explicit cooperative yield is a real wait with an owner-queued wake. It is
// separate from a budget stop, which does not invent a Call result.
[Reflect defineMethod: #yield on: TaskControl as: [:self |
  [[self canWait]
    ifTrue: [|
      [TaskExecutor transition: [|
        [self checkpoint];
        [[self field: #waitToken] set: [Object clone]];
        [self enqueueResolution: [self waitToken] with: nil];
        [[self machine] park]]];
      [self checkpoint];
      self]
    ifFalse: [| [self waitError]]]]];

// Consume the identity before enqueueing: duplicates cannot queue a second
// resume, and a later cleanup wait cannot be claimed by this notification.
[Reflect defineMethod: #enqueueResolution:with: on: TaskControl as: [:self :token :value |
  [TaskExecutor transition: [|
    [[token isNil]
      ifTrue: [| false]
      ifFalse: [|
        [[[self pollOutcome] isNil]
          ifTrue: [|
            [[token == [self waitToken]]
              ifTrue: [|
                [[self field: #waitToken] set: nil];
                [TaskExecutor enqueue: #[self #resume value]];
                true]
              ifFalse: [| false]]]
          ifFalse: [| false]]]]]]]];
[Reflect defineMethod: #resolve:with: on: TaskControl as: [:self :token :value |
  let accepted := [self enqueueResolution: token with: value];
  let progress := [TaskExecutor drain];
  [[progress isError] ifTrue: [| progress] ifFalse: [| accepted]]]];
[Reflect defineMethod: #cancelAllChildren: on: TaskControl as: [:self :reason |
  [TaskExecutor transition: [|
    [[self children] do: [:child | [child requestCancellation: reason]]];
    self]]]];
[Reflect defineMethod: #cancelChildren: on: TaskControl as: [:self :reason |
  [TaskExecutor transition: [|
    [[self children] do: [:child |
      [[[child field: #protectedFromParent] value] ifFalse: [| [child requestCancellation: reason]]]]];
    self]]]];
[Reflect defineMethod: #requestCancellation: on: TaskControl as: [:self :reason |
  [TaskExecutor transition: [|
    [[[self pollOutcome] isNil] ifTrue: [|
      [[[self field: #cancelled] value] ifFalse: [|
        [[self field: #cancelled] set: true];
        [[self field: #cancelReason] set: reason];
        [self cancelChildren: reason]]];
      [[[self shieldDepth] = 0] ifTrue: [|
        [self enqueueResolution: [self waitToken] with: nil]]]]];
    self]]]];

[Reflect defineMethod: #cancel: on: TaskControl as: [:self :reason |
  [self requestCancellation: reason];
  [TaskExecutor drain];
  self]];

[Reflect defineMethod: #ensure:cleanup: on: TaskControl as: [:self :body :cleanup |
  [[self canControl]
    ifTrue: [|
      let answer := [[self machine] protectedBlock: [| #[#success [body value]]]];
      [self shield];
      let cleaned := [[self machine] protectedBlock: [| #[#success [cleanup value]]]];
      [[self machine] acknowledgeBoundaryDelivery];
      [self unshield];
      [[[cleaned at: 0] = #failure] ifTrue: [|
        [[self machine] leaveBoundary: cleaned]]];
      [[[answer at: 0] = #success]
        ifTrue: [| [self checkpoint]; [answer at: 1]]
        ifFalse: [| [[self machine] leaveBoundary: answer]]]
    ]
    ifFalse: [| [Error kind: #taskContextRequired]]]]];

[Reflect defineMethod: #removeWaiter: on: TaskControl as: [:self :token |
  [TaskExecutor transition: [|
    [[self field: #waiters] set: [[[self field: #waiters] value] reject: [:entry |
      [[entry at: 1] == token]]]];
    self]]]];
[Reflect defineMethod: #waitFor: on: TaskControl as: [:self :target |
  let token := [Object clone];
  [self ensure: [|
    [TaskExecutor transition: [|
      [self checkpoint];
      [[[target pollOutcome] isNil] ifTrue: [|
        [[self field: #waitToken] set: token];
        [[target field: #waiters] set: [[[target field: #waiters] value] add: #[self token]]];
        [[self machine] park]]]]];
    [self checkpoint]]
  cleanup: [| [target removeWaiter: token]]];
  [target pollOutcome]]];
[Reflect defineMethod: #outcome on: TaskControl as: [:self |
  let caller := [TaskExecutor current];
  [[caller isNil]
    ifTrue: [| [Error kind: #taskContextRequired]]
    ifFalse: [|
      [[caller canWait]
        ifTrue: [| [caller waitFor: self]]
        ifFalse: [| [caller waitError]]]]]]];
[Reflect defineMethod: #await on: TaskControl as: [:self |
  let result := [self outcome];
  [[result isError]
    ifTrue: [| result]
    ifFalse: [|
      [[[result at: 0] = #success]
        ifTrue: [| [result at: 1]]
        ifFalse: [|
          let caller := [TaskExecutor current];
          [[caller isNil]
            ifTrue: [| [Error kind: #taskContextRequired]]
            ifFalse: [|
              [[[result at: 0] = #failure]
                ifTrue: [|
                  [caller recordOutcome: result from: self];
                  [caller cancelAllChildren: #parentFailed]]
                ifFalse: [| [caller cancel: [result at: 1]]]];
              [[caller machine] leaveBoundary: result]]]]]]]]];

[Reflect defineMethod: #childSettled: on: TaskControl as: [:self :child |
  [TaskExecutor transition: [|
    let result := [child pollOutcome];
    [[[result at: 0] = #failure] ifTrue: [|
      [self recordOutcome: result from: child];
      [self requestCancellation: #childFailed];
      [self cancelAllChildren: #childFailed]]];
    self]]]];
[Reflect defineMethod: #publish: on: TaskControl as: [:self :answer |
  [TaskExecutor transition: [|
    let result := [[[[self failures] size] > 0]
      ifTrue: [| #[#failure [self failures] [[self field: #cancelReason] value] [[self field: #childFailures] value]]]
      ifFalse: [|
        [[[self field: #cancelled] value]
          ifTrue: [| #[#cancelled [[self field: #cancelReason] value]]]
          ifFalse: [| answer]]]];
    [[self field: #outcome] set: result];
    [[self field: #machine] set: nil];
    [[self field: #waitToken] set: nil];
    let parent := [[self field: #parent] value];
    [[parent notNil] ifTrue: [| [parent childSettled: self]]];
    let waiters := [[self field: #waiters] value];
    [[self field: #waiters] set: #[]];
    [[self field: #children] set: #[]];
    [[self field: #parent] set: nil];
    [[self field: #failureSources] set: #[]];
    [waiters do: [:entry | [[entry at: 0] resolve: [entry at: 1] with: nil]]];
    result]]]];
[Reflect defineMethod: #execute: on: TaskControl as: [:self :body |
  let answer := [[self machine] protectedBlock: [|
    [[self field: #bodyActive] set: true];
    [self checkpoint];
    #[#success [body value: self]]]];
  [TaskExecutor transition: [|
    [[self field: #bodyActive] set: false];
    [self shield];
    [[self field: #joining] set: true];
    [[[answer at: 0] = #failure] ifTrue: [| [self cancelAllChildren: #parentFailed]]]]];
  // The join is shielded, but cancellation still reaches ordinary children.
  // Resource cleanup can explicitly await children before releasing resources.
  [[self children] do: [:child | [self waitFor: child]]];
  [self unshield];
  [self publish: answer]]];

// Copied process requests are owned by ordinary structured tasks. Cancellation
// of the task retains the remote operation through shielded cleanup. Explicit
// process termination can force it to settle; it is not remote Birnam cleanup.
[Reflect defineMethod: #request:from:timeout: on: TaskControl as: [:self :value :worker :timeout |
  [self start: [:task |
    let answer := [task ensure: [|
      [TaskExecutor transition: [|
        let id := [worker submit: value timeout: timeout];
        [[id isError]
          ifTrue: [| [[task field: #externalResult] set: id]]
          ifFalse: [|
            [[task field: #requestWorker] set: worker];
            [[task field: #requestId] set: id];
            [TaskExecutor watch: task]]]]];
      [task waitExternal]]
    cleanup: [|
      // No request was admitted if cancellation arrived before submission.
      [[[[task field: #requestId] value] notNil] ifTrue: [|
        let settled := [task waitExternal];
        [[[[task field: #cancelled] value] & [settled isError]] ifTrue: [|
          [task recordFailures: #[settled] from: worker]]]]];
      [[task field: #requestWorker] set: nil];
      [[task field: #requestId] set: nil];
      [[task field: #externalResult] set: nil]]];
    [[answer isError]
      ifTrue: [| [task fail: answer]]
      ifFalse: [| [answer at: 0]]]]]]];
[Reflect defineMethod: #waitExternal on: TaskControl as: [:self |
  [TaskExecutor transition: [|
    [self checkpoint];
    [[[[self field: #externalResult] value] isNil] ifTrue: [|
      [[self field: #waitToken] set: [Object clone]];
      [[self machine] park]]]]];
  [self checkpoint];
  [[self field: #externalResult] value]]];
[Reflect defineMethod: #pollExternal on: TaskControl as: [:self |
  let worker := [[self field: #requestWorker] value];
  [[[self field: #cancelled] value] ifTrue: [|
    [worker cancelRequest: [[self field: #requestId] value]]]];
  let answer := [worker pollRequest: [[self field: #requestId] value]];
  [[answer notNil] ifTrue: [|
    [[self field: #externalResult] set: answer];
    [self enqueueResolution: [self waitToken] with: nil]]];
  self]];


// A task service has one independent request scope. Failure/cancellation of a
// request never turns the long-lived serial dispatcher into a failed parent.
[Globals at: #TaskService put: [Object clone]];
[Reflect defineMethod: #serve:request: on: TaskService as: [:self :receiver :argument |
  let task := [TaskControl prepare: [:request | [receiver handle: argument]] parent: nil];
  [[TaskExecutor field: #serviceTask] set: task];
  [TaskExecutor enqueue: #[task #start nil]];
  let progress := [TaskExecutor drain];
  [[TaskExecutor field: #serviceTask] set: nil];
  [[progress isError]
    ifTrue: [| #[#failure #[#[#controlFailure [progress printString]]] nil #[]]]
    ifFalse: [| [self wireOutcome: [task pollOutcome]]]]]];
[Reflect defineMethod: #wireOutcome: on: TaskService as: [:self :outcome |
  [[[outcome at: 0] = #failure]
    ifTrue: [|
      let failures := [[outcome at: 1] collect: [:failure |
        [[failure isError]
          ifTrue: [| #[#error [failure kind] [failure message]]]
          ifFalse: [| failure]]]];
      #[#failure failures [outcome at: 2]
        [[outcome at: 3] collect: [:child | [self wireOutcome: child]]]]]
    ifFalse: [| outcome]]]];

[Globals at: #Worker put: [Object clone]];
[Globals at: #RemoteFailure put: [Object clone]];
[#["Worker.activeRequest" "Worker.closing"] do: [:name |
  [db assert: [name asSymbol] attr: #imageTransient value: true]]];
[Reflect defineMethod: #field: on: Worker as: [:self :name |
  [db cellFor: self attr: [["Worker." , [name asString]] asSymbol]]]];
[Reflect defineMethod: #fromHandle: on: Worker as: [:self :handle |
  [[handle isError]
    ifTrue: [| handle]
    ifFalse: [|
      let worker := [self clone];
      [[worker field: #workerHandle] set: handle];
      [[worker field: #activeRequest] set: nil];
      [[worker field: #closing] set: false];
      worker]]]];
[Reflect defineMethod: #request: on: Worker as: [:self :value |
  [self request: value timeout: 60000]]];
[Reflect defineMethod: #request:timeout: on: Worker as: [:self :value :timeout |
  [TaskControl request: value from: self timeout: timeout]]];
[Reflect defineMethod: #submit:timeout: on: Worker as: [:self :value :timeout |
  [[[self field: #closing] value]
    ifTrue: [| [Error kind: #workerClosing]]
    ifFalse: [|
      let active := [[self field: #activeRequest] value];
      let busy := [[active isNil] ifTrue: [| false] ifFalse: [| [[active pollOutcome] isNil]]];
      [busy ifTrue: [| [Error kind: #workerBusy]] ifFalse: [|
        let id := [[[self field: #workerHandle] value] submit: value timeout: timeout];
        [[id isError] ifFalse: [| [[self field: #activeRequest] set: [TaskExecutor current]]]];
        id]]]]]];
[Reflect defineMethod: #cancelRequest: on: Worker as: [:self :id |
  [[[self field: #workerHandle] value] cancelRequest: id]]];
[Reflect defineMethod: #pollRequest: on: Worker as: [:self :id |
  let answer := [[[self field: #workerHandle] value] pollRequest: id];
  [[[answer isNil] | [answer isError]]
    ifTrue: [| answer]
    ifFalse: [|
      let outcome := [answer at: 0];
      [[[outcome at: 0] = #success]
        ifTrue: [| #[[outcome at: 1]]]
        ifFalse: [|
          [[[outcome at: 0] = #cancelled]
            ifTrue: [|
              [[[self field: #activeRequest] value] cancel: [outcome at: 1]];
              #[nil]]
            ifFalse: [| [RemoteFailure fromOutcome: outcome]]]]]]]]];
[Reflect defineMethod: #shutdown on: Worker as: [:self |
  [TaskExecutor transition: [| [[self field: #closing] set: true]]];
  [TaskControl startCleanup: [:task |
    // A cancelled shutdown observer still owns the drain-and-stop cleanup.
    [task ensure: [| nil] cleanup: [|
      let active := [[self field: #activeRequest] value];
      [[active notNil] ifTrue: [| [active outcome]]];
      let handle := [[self field: #workerHandle] value];
      [[handle notNil] ifTrue: [|
        let stopped := [handle stop];
        [[stopped isError] ifTrue: [| [task fail: stopped]]];
        [db retract: self attr: ["Worker.workerHandle" asSymbol] value: handle]]];
      [[self field: #activeRequest] set: nil]]]]]]];
[Reflect defineMethod: #cancel on: Worker as: [:self |
  [TaskExecutor transition: [|
    [[self field: #closing] set: true];
    let active := [[self field: #activeRequest] value];
    [[active notNil] ifTrue: [| [active cancel: #serviceCancelled]]]]];
  [self shutdown]]];
[Reflect defineMethod: #state on: Worker as: [:self |
  let handle := [[self field: #workerHandle] value];
  [[handle isNil] ifTrue: [| #exited] ifFalse: [| [handle state]]]]];
[Reflect defineMethod: #terminate on: Worker as: [:self |
  [[self field: #closing] set: true];
  [[[self field: #workerHandle] value] terminate]]];
[Reflect defineMethod: #fromOutcome: on: RemoteFailure as: [:self :outcome |
  let failure := [self clone];
  [db assert: failure attr: #remoteOutcome value: outcome];
  failure]];
[Reflect defineMethod: #isError on: RemoteFailure as: [:self | true]];
[Reflect defineMethod: #kind on: RemoteFailure as: [:self | #remoteFailure]];
[Reflect defineMethod: #outcome on: RemoteFailure as: [:self | [db currentValue: self attr: #remoteOutcome]]];
[Reflect defineMethod: #message on: RemoteFailure as: [:self | [[self outcome] printString]]];

[Reflect defineMethod: #close on: Concurrency as: [:self |
  [[self field: #closed] set: true];
  [TaskControl startCleanup: [:task |
    [task ensure: [| nil] cleanup: [|
      [[[self field: #workers] value] do: [:worker | [[worker shutdown] outcome]]];
      [[self field: #workers] set: #[]];
      [self removeFiles]]]]]]];
