// compiled-unit.birnam — the low-level reflected candidate lifecycle over Codegen's narrow
// candidate/ledger mechanism (docs/design/47). Candidate opening and validation
// are inert; dependency loading and native mapping are explicit operations.

[Module named: #compiledUnit requires: #[#modules #stdlib]];

// Idempotent because image boot preloads this module before restoring facts, then
// mapped/replayed image code runs it again to refresh method blocks on the same
// exported prototype family used by deserialized lifecycle instances.
[[[Globals at: #CompiledUnit] isNil]
  ifTrue: [| [Globals at: #CompiledUnit put: [Object clone]]]
  ifFalse: [| nil]];
[[[Globals at: #DispatchGeneration] isNil]
  ifTrue: [| [Globals at: #DispatchGeneration put: [Object clone]]]
  ifFalse: [| nil]];
[[[Globals at: #EvolutionIntent] isNil]
  ifTrue: [| [Globals at: #EvolutionIntent put: [Object clone]]]
  ifFalse: [| nil]];

// Lifecycle cells are single-valued. History is represented by immutable event
// entities, so stale #active assertions never remain query-visible.
[db assert: #state attr: #cardinality value: #one];
[db assert: #nextCompiledGeneration attr: #cardinality value: #one];
[db assert: #requires attr: #cardinality value: #one];
[db assert: #provides attr: #cardinality value: #one];
[db assert: #sourceRevision attr: #cardinality value: #one];
[db assert: #sourceMap attr: #cardinality value: #one];
[db assert: #baseDigest attr: #cardinality value: #one];
[db assert: #generationSelection attr: #cardinality value: #one];
[db assert: #kind attr: #cardinality value: #one];
[db assert: #rollbackAvailable attr: #cardinality value: #one];
[db assert: #composedInto attr: #cardinality value: #one];
[db assert: #compositionIdentity attr: #cardinality value: #one];
[db assert: #expectedBaseDigest attr: #cardinality value: #one];
[db assert: #predecessor attr: #cardinality value: #one];
[db assert: #deltaUnit attr: #cardinality value: #one];
[db assert: #activeGeneration attr: #cardinality value: #one];
[db assert: #intentUnit attr: #cardinality value: #one];
[db assert: #intentAction attr: #cardinality value: #one];

[Reflect defineMethod: #for:action: on: EvolutionIntent as: [:self :unit :action |
  let intent := [self clone];
  [db assert: intent attr: #intentUnit value: unit];
  [db assert: intent attr: #intentAction value: action];
  intent]];

[Reflect defineMethod: #isIntent: on: EvolutionIntent as: [:self :value |
  [[Reflect vtableOf: value] == [Reflect vtableOf: self]]]];

[Reflect defineMethod: #fulfill on: EvolutionIntent as: [:self |
  let unit := [db currentValue: self attr: #intentUnit];
  let action := [db currentValue: self attr: #intentAction];
  [[action = #activate]
    ifTrue: [| [unit commitActivation]]
    ifFalse: [|
      [[action = #rollback]
        ifTrue: [| [unit commitRollback]]
        ifFalse: [|
          [Error kind: #invalidEvolutionIntent]]]]]]];

[Reflect defineMethod: #current on: DispatchGeneration as: [:self |
  [db currentValue: #dispatch attr: #activeGeneration]]];

[Reflect defineMethod: #sourceMap on: DispatchGeneration as: [:self |
  [db currentValue: self attr: #sourceMap]]];

[Reflect defineMethod: #baseDigest on: DispatchGeneration as: [:self |
  [db currentValue: self attr: #baseDigest]]];

[Reflect defineMethod: #generationSelection on: DispatchGeneration as: [:self |
  [db currentValue: self attr: #generationSelection]]];

[Reflect defineMethod: #predecessor on: DispatchGeneration as: [:self |
  [db currentValue: self attr: #predecessor]]];

[Reflect defineMethod: #deltaUnit on: DispatchGeneration as: [:self |
  [db currentValue: self attr: #deltaUnit]]];

[Reflect defineMethod: #compositionIdentity on: DispatchGeneration as: [:self |
  [db currentValue: self attr: #compositionIdentity]]];

[Reflect defineMethod: #entryFor: on: DispatchGeneration as: [:self :name |
  [[self sourceMap] inject: nil into: [:found :entry |
    [[found notNil]
      ifTrue: [| found]
      ifFalse: [|
        [[[entry at: 0] = name]
          ifTrue: [| entry]
          ifFalse: [| nil]]]]]]]];

[Reflect defineMethod: #revisionFor: on: DispatchGeneration as: [:self :name |
  let entry := [self entryFor: name];
  [[entry isNil] ifTrue: [| nil] ifFalse: [| [entry at: 1]]]]];

[Reflect defineMethod: #unitFor: on: DispatchGeneration as: [:self :name |
  let entry := [self entryFor: name];
  [[entry isNil] ifTrue: [| nil] ifFalse: [| [entry at: 2]]]]];

[Reflect defineMethod: #fromProjection:predecessor:delta: on: DispatchGeneration as: [:self :projection :prior :unit |
  let generation := [self clone];
  [db assert: generation attr: #sourceMap value: [projection at: 1]];
  [db assert: generation attr: #baseDigest value: [projection at: 2]];
  [db assert: generation attr: #generationSelection value: [projection at: 3]];
  [[prior isNil] ifTrue: [| nil] ifFalse: [| [db assert: generation attr: #predecessor value: prior]]];
  [[unit isNil] ifTrue: [| nil] ifFalse: [| [db assert: generation attr: #deltaUnit value: unit]]];
  generation]];

[Reflect defineMethod: #initializeCurrent on: DispatchGeneration as: [:self |
  let current := [self current];
  [[current notNil]
    ifTrue: [| current]
    ifFalse: [|
      let projection := [Codegen initialGenerationProjection];
      [[projection isError]
        ifTrue: [| projection]
        ifFalse: [|
          let generation := [self fromProjection: projection predecessor: nil delta: nil];
          [[db cellFor: #dispatch attr: #activeGeneration] set: generation];
          [Codegen sealInitialGeneration];
          generation]]]]]];

// Retire one no-longer-current lifecycle carrier through ordinary Store
// retractions. A current-only compaction drops the graph; an explicit history
// window retains the exact retirement transitions by policy.
[Reflect defineMethod: #retireDurableEntity: on: CompiledUnit as: [:self :entity |
  [[| [[db attrCount: entity] > 0]] whileTrue: [|
    let attribute := [db attrAt: entity index: 0];
    let value := [db currentValue: entity attr: attribute];
    [db retract: entity attr: attribute value: value]]];
  entity]];

// Image recovery has already restored dispatch before this policy method runs.
// Mint one process-local composed component per source-map row, publish a fresh
// rollback-free DispatchGeneration with the exact same source/selection
// authority, then ask Codegen to snapshot the live direct bindings into its
// transient ledger. No candidate pointer snapshot crosses the image boundary.
[Reflect defineMethod: #reconcileImageComposition: on: CompiledUnit as: [:self :identity |
  let origin := [DispatchGeneration current];
  let existingIdentity := [db currentValue: origin attr: #compositionIdentity];
  [[existingIdentity = identity]
    ifTrue: [|
      let adopted := [Codegen adoptComposedGeneration: origin];
      [[adopted isNil]
        ifTrue: [| [Error kind: #imageCompositionRejected]]
        ifFalse: [| origin]]]
    ifFalse: [|
      let components := [[origin sourceMap] inject: #[] into: [:rows :entry |
        let name := [entry at: 0];
        let revision := [entry at: 1];
        let component := [self clone];
        [db assert: component attr: #unitName value: name];
        [db assert: component attr: #generation value: [self nextGenerationFor: name]];
        [db assert: component attr: #kind value: #composed];
        [db assert: component attr: #state value: #active];
        [db assert: component attr: #rollbackAvailable value: false];
        [db assert: component attr: #sourceRevision value: revision];
        [db assert: component attr: #authoredSource value: [revision at: 3]];
        [db assert: component attr: #revisionDigest value: [revision at: 6]];
        [db assert: component attr: #requires value: [revision at: 2]];
        [db assert: component attr: #provides value: #[]];
        [db assert: component attr: #compositionIdentity value: identity];
        [rows add: #[name revision component]]]];
      let projection := #[#generationProjection components [origin baseDigest] [origin generationSelection]];
      let composed := [DispatchGeneration fromProjection: projection predecessor: nil delta: nil];
      [db assert: composed attr: #kind value: #composed];
      [db assert: composed attr: #compositionIdentity value: identity];
      let active := [db cellFor: #dispatch attr: #activeGeneration];
      [active set: composed];
      let adopted := [Codegen adoptComposedGeneration: composed];
      [[adopted isNil]
        ifTrue: [| [active set: origin]; [Error kind: #imageCompositionRejected]]
        ifFalse: [|
          [[origin sourceMap] inject: nil into: [:ignored :entry |
            let prior := [entry at: 2];
            [[prior isNil]
              ifTrue: [| nil]
              ifFalse: [|
            [db assert: prior attr: #state value: #historical];
            [db assert: prior attr: #rollbackAvailable value: false];
            [db assert: prior attr: #composedInto value: composed];
            [self retireDurableEntity: prior]]]]];
      [db assert: origin attr: #composedInto value: composed];
      [self retireDurableEntity: origin];
      composed]]]]]];

[Reflect defineMethod: #state on: CompiledUnit as: [:self |
  let recorded := [db currentValue: self attr: #state];
  [[recorded = #active] ifTrue: [| [Codegen reconcileCandidate: self]] ifFalse: [| nil]];
  [db currentValue: self attr: #state]]];

[Reflect defineMethod: #kind on: CompiledUnit as: [:self |
  [db currentValue: self attr: #kind]]];

[Reflect defineMethod: #composedInto on: CompiledUnit as: [:self |
  [db currentValue: self attr: #composedInto]]];

[Reflect defineMethod: #unitName on: CompiledUnit as: [:self |
  [db currentValue: self attr: #unitName]]];

[Reflect defineMethod: #generation on: CompiledUnit as: [:self |
  [db currentValue: self attr: #generation]]];

[Reflect defineMethod: #requires on: CompiledUnit as: [:self |
  [db currentValue: self attr: #requires]]];

[Reflect defineMethod: #provides on: CompiledUnit as: [:self |
  [db currentValue: self attr: #provides]]];

[Reflect defineMethod: #sourceRevision on: CompiledUnit as: [:self |
  let revision := [db currentValue: self attr: #sourceRevision];
  [[revision isNil]
    ifTrue: [|
      let projected := [Codegen sourceRevisionOf: [db currentValue: self attr: #authoredSource]];
      [[projected isError] ifTrue: [| projected] ifFalse: [| [db assert: self attr: #sourceRevision value: projected]; projected]]]
    ifFalse: [| revision]]]];

[Reflect defineMethod: #authoredSource on: CompiledUnit as: [:self |
  [db currentValue: self attr: #authoredSource]]];

[Reflect defineMethod: #revisionDigest on: CompiledUnit as: [:self |
  [db currentValue: self attr: #revisionDigest]]];

[Reflect defineMethod: #artifactChecksum on: CompiledUnit as: [:self |
  [db currentValue: self attr: #artifactChecksum]]];

[Reflect defineMethod: #artifactLocation on: CompiledUnit as: [:self |
  [Codegen candidateContentPath: self]]];

[Reflect defineMethod: #operations on: CompiledUnit as: [:self |
  let ops := [db currentValue: self attr: #provides];
  [[ops isNil] ifTrue: [| #[]] ifFalse: [| ops]]]];

[Reflect defineMethod: #additions on: CompiledUnit as: [:self |
  [[self operations] inject: #[] into: [:rows :op |
    [[[db currentValue: op attr: #operation] = #install]
      ifTrue: [|
        [[db currentValue: op attr: #priorPresent]
          ifTrue: [| rows]
          ifFalse: [| [rows add: op]]]]
      ifFalse: [| rows]]]]]];

[Reflect defineMethod: #replacements on: CompiledUnit as: [:self |
  [[self operations] inject: #[] into: [:rows :op |
    [[[db currentValue: op attr: #operation] = #install]
      ifTrue: [|
        [[db currentValue: op attr: #priorPresent]
          ifTrue: [| [rows add: op]]
          ifFalse: [| rows]]]
      ifFalse: [| rows]]]]]];

[Reflect defineMethod: #removals on: CompiledUnit as: [:self |
  [[self operations] inject: #[] into: [:rows :op |
    [[[db currentValue: op attr: #operation] = #remove]
      ifTrue: [| [rows add: op]]
      ifFalse: [| rows]]]]]];

[Reflect defineMethod: #expectedBaseDigest on: CompiledUnit as: [:self |
  [db currentValue: self attr: #expectedBaseDigest]]];

[Reflect defineMethod: #importStatus on: CompiledUnit as: [:self |
  [db currentValue: self attr: #importStatus]]];

[Reflect defineMethod: #isMapped on: CompiledUnit as: [:self |
  [Codegen candidateMapped: self]]];

[Reflect defineMethod: #rollbackAvailable on: CompiledUnit as: [:self |
  let available := [db currentValue: self attr: #rollbackAvailable];
  [[available isNil] ifTrue: [| false] ifFalse: [| available]]]];

[Reflect defineMethod: #dependencyChanges on: CompiledUnit as: [:self |
  let current := [DispatchGeneration current];
  let priorRevision := [[current isNil] ifTrue: [| nil] ifFalse: [| [current revisionFor: [self unitName]]]];
  let old := [[priorRevision isNil] ifTrue: [| #[]] ifFalse: [| [priorRevision at: 2]]];
  let now := [self requires];
  let added := [now inject: #[] into: [:rows :dep |
    [[old includes: dep] ifTrue: [| rows] ifFalse: [| [rows add: dep]]]]];
  let removed := [old inject: #[] into: [:rows :dep |
    [[now includes: dep] ifTrue: [| rows] ifFalse: [| [rows add: dep]]]]];
  {#added -> added, #removed -> removed}]];

[Reflect defineMethod: #setState: on: CompiledUnit as: [:self :state |
  [[db cellFor: self attr: #state] set: state];
  self]];

[Reflect defineMethod: #nextGenerationFor: on: CompiledUnit as: [:self :name |
  let cell := [db cellFor: name attr: #nextCompiledGeneration];
  let old := [cell value];
  let next := [[old isNil] ifTrue: [| 1] ifFalse: [| [old + 1]]];
  [cell set: next];
  next]];

// Produces the dylib plus its pointer-free `.candidate` envelope. It does not
// open, map, or activate the result.
[Reflect defineMethod: #compile:named:output: on: CompiledUnit as: [:self :source :name :path |
  [Codegen compileCandidate: source named: name output: path]]];

// Selection is copied and validated by Codegen before lowering. This wrapper
// carries no policy of its own and cannot infer or repair malformed rows.
[Reflect defineMethod: #compile:named:output:selection: on: CompiledUnit as: [:self :source :name :path :selection |
  [Codegen compileCandidate: source named: name output: path selection: selection]]];

// Inspect-only open. Codegen verifies the sidecar and complete artifact hash
// before reflecting metadata into this freshly minted policy object.
[Reflect defineMethod: #open: on: CompiledUnit as: [:self :path |
  let unit := [self clone];
  let inspected := [Codegen inspectCandidate: path into: unit];
  [[inspected isError]
    ifTrue: [| inspected]
    ifFalse: [|
      [db assert: unit attr: #generation value: [self nextGenerationFor: [unit unitName]]];
      [unit setState: #candidate];
      unit]]]];

[Reflect defineMethod: #missingDependencies on: CompiledUnit as: [:self |
  [[self requires] inject: #[] into: [:missing :dep |
    [[Module isLoaded: dep]
      ifTrue: [| missing]
      ifFalse: [| [missing add: dep]]]]]]];

// Explicit ordinary effects. Candidate rejection/rollback never claims to undo
// what these module initializers did.
[Reflect defineMethod: #prepareDependencies on: CompiledUnit as: [:self |
  let me := self;
  [[self missingDependencies] inject: self into: [:answer :dep |
    [[answer isError]
      ifTrue: [| answer]
      ifFalse: [|
        let loaded := [Module load: dep];
        [[loaded isError] ifTrue: [| loaded] ifFalse: [| me]]]]]]]];

[Reflect defineMethod: #map on: CompiledUnit as: [:self |
  let missing := [self missingDependencies];
  [[[missing size] = 0]
    ifTrue: [| [Codegen mapCandidate: self]]
    ifFalse: [| [Error kind: #dependenciesMissing]]]]];

[Reflect defineMethod: #discard on: CompiledUnit as: [:self |
  [Codegen discardCandidate: self]]];

// Validation consumes no dispatch capability: preparation snapshots the complete
// plan and discard immediately invalidates the one-shot token.
[Reflect defineMethod: #validate on: CompiledUnit as: [:self |
  let current := [DispatchGeneration current];
  [[current isNil]
    ifTrue: [| [Error kind: #generationNotInitialized]]
    ifFalse: [|
      let projection := [Codegen successorGenerationProjection: [current sourceMap] replacing: [self unitName] with: [self sourceRevision] unit: self];
      [[projection isError]
        ifTrue: [| projection]
        ifFalse: [|
          let successor := [DispatchGeneration fromProjection: projection predecessor: current delta: self];
          let token := [Codegen prepareActivation: self plan: [self publicationPlan: #activate prior: [current unitFor: [self unitName]] expected: current successor: successor]];
          [[token isNil]
            ifTrue: [| [Error kind: #candidatePreparationFailed]]
            ifFalse: [|
              [[token isError]
                ifTrue: [| token]
                ifFalse: [|
                  let discarded := [Codegen discardPrepared: token];
                  [[discarded isNil]
                    ifTrue: [| [Error kind: #candidateDiscardFailed]]
                    ifFalse: [| [[discarded isError] ifTrue: [| discarded] ifFalse: [| self]]]]]]]]]]]]]];

[Reflect defineMethod: #recordEvent:prior: on: CompiledUnit as: [:self :action :prior |
  let event := [Object clone];
  [db assert: event attr: #unit value: self];
  [db assert: event attr: #action value: action];
  [db assert: event attr: #basis value: [db basis]];
  [[prior isNil] ifTrue: [| nil] ifFalse: [| [db assert: event attr: #priorUnit value: prior]]];
  [db assert: self attr: #activationEvent value: event];
  event]];

// The candidate facade chooses every object/value that the commit will publish. Codegen copies
// this positional plan during preparation and later applies it mechanically,
// after dispatch mutation, without invoking another CompiledUnit method.
[Reflect defineMethod: #publicationPlan:prior:expected:successor: on: CompiledUnit as: [:self :action :prior :expected :successor |
  #[action self [self unitName] prior [Object clone] [db basis] expected successor]]];

[Reflect defineMethod: #activate on: CompiledUnit as: [:self |
  [EvolutionIntent for: self action: #activate]]];

[Reflect defineMethod: #commitActivation on: CompiledUnit as: [:self |
  [[[self state] = #candidate]
    ifTrue: [|
      let name := [self unitName];
      let current := [DispatchGeneration current];
      [[current isNil]
        ifTrue: [| [Error kind: #generationNotInitialized]]
        ifFalse: [|
          let projection := [Codegen successorGenerationProjection: [current sourceMap] replacing: name with: [self sourceRevision] unit: self];
          [[projection isError]
            ifTrue: [| projection]
            ifFalse: [|
              let successor := [DispatchGeneration fromProjection: projection predecessor: current delta: self];
              let prior := [current unitFor: name];
              let token := [Codegen prepareActivation: self plan: [self publicationPlan: #activate prior: prior expected: current successor: successor]];
              [[token isNil]
                ifTrue: [| [Error kind: #candidatePreparationFailed]]
                ifFalse: [|
                  [[token isError]
                    ifTrue: [| token]
                    ifFalse: [|
                      let committed := [Codegen commitPrepared: token];
                      [[committed isNil]
                        ifTrue: [| [Error kind: #candidateCommitFailed]]
                        ifFalse: [| [[committed isError] ifTrue: [| committed] ifFalse: [| self]]]]]]]]]]]]]
    ifFalse: [| [Error kind: #invalidLifecycleTransition]]]]];

[Reflect defineMethod: #rollback on: CompiledUnit as: [:self |
  [EvolutionIntent for: self action: #rollback]]];

[Reflect defineMethod: #commitRollback on: CompiledUnit as: [:self |
  let state := [self state];
  [[state = #rolledBack]
    ifTrue: [| self]
    ifFalse: [|
      [[state = #active]
        ifTrue: [|
          let current := [DispatchGeneration current];
          [[[current isNil] or: [| [[[current deltaUnit] == self] not]]]
            ifTrue: [| [Error kind: #staleGeneration]]
            ifFalse: [|
              let predecessor := [current predecessor];
              [[predecessor isNil]
                ifTrue: [| [Error kind: #rollbackUnavailable]]
                ifFalse: [|
                  let prior := [predecessor unitFor: [self unitName]];
                  let token := [Codegen prepareRollback: self plan: [self publicationPlan: #rollback prior: prior expected: current successor: predecessor]];
                  [[token isNil]
                    ifTrue: [| [Error kind: #candidateRollbackPreparationFailed]]
                    ifFalse: [|
                      [[token isError]
                        ifTrue: [| token]
                        ifFalse: [|
                          let rolled := [Codegen commitPreparedRollback: token];
                          [[rolled isNil]
                            ifTrue: [| [Error kind: #candidateRollbackCommitFailed]]
                            ifFalse: [| [[rolled isError] ifTrue: [| rolled] ifFalse: [| self]]]]]]]]]]]]]
        ifFalse: [| [Error kind: #invalidLifecycleTransition]]]]]]];

[Reflect defineMethod: #activeFor: on: CompiledUnit as: [:self :name |
  let generation := [DispatchGeneration current];
  let unit := [[generation isNil] ifTrue: [| nil] ifFalse: [| [generation unitFor: name]]];
  [[unit isNil] ifTrue: [| nil] ifFalse: [| [unit state]; unit]]]];

// Lifecycle instances share this pure-Birnam prototype family. Its stable
// loader name lets image heap records relink those instances before module code
// reconstructs the candidate lifecycle facade.
[Reflect exportObject: CompiledUnit as: #CompiledUnitPrototype];
[Reflect exportVtableOf: CompiledUnit as: #CompiledUnitVt];
[Reflect exportObject: DispatchGeneration as: #DispatchGenerationPrototype];
[Reflect exportVtableOf: DispatchGeneration as: #DispatchGenerationVt];
[Reflect exportObject: EvolutionIntent as: #EvolutionIntentPrototype];
[Reflect exportVtableOf: EvolutionIntent as: #EvolutionIntentVt];

[Module markLoaded: #compiledUnit]
