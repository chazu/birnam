// config.birnam — birnam.toml runtime configuration, parsed with the built-in Toml.
//
// `Config` reads `./birnam.toml` (cwd) and exposes it as a Map, parsed by the
// self-hosted `Toml` module — so the language's own config format is its own TOML
// parser dogfooding itself. A named singleton bound in Globals, like `Toml`.
//
//   [Config at: "name"]        "=> the top-level `name` value, or nil"
//   [Config main]              "=> the `main` entry-point path, or nil"
//
// Discovery is cwd-only for now (cwd-upward walk wants directory ops we don't yet
// expose). A missing or malformed birnam.toml is not an error — `map` answers nil
// and every accessor degrades to nil, so a project without config just works.

// This module parses birnam.toml with Toml, so it requires the toml module.
[Module named: #config requires: #[#toml]];

[Globals at: #Config put: [Object clone]];
[Reflect docModule: #config is: "birnam.toml project configuration — parsed via Toml, exposed as at: lookups; a missing or invalid file degrades to nil."];

// The parsed birnam.toml as a Map, or nil when the file is absent or invalid.
// Read fresh each call (a project rarely rereads its config; keep it simple).
[Reflect defineMethod: #map on: Config as: [:self |
  let text := [System readFile: "birnam.toml"];
  [[text isError]
    ifTrue: [| nil]
    ifFalse: [|
      let m := [Toml parse: text];
      [[m isError] ifTrue: [| nil] ifFalse: [| m]]]]] doc:
  "The parsed birnam.toml as a Map, or nil when the file is absent or invalid (read fresh each call)."];

// The value bound to `aKey` in birnam.toml, or nil (no file / key absent).
[Reflect defineMethod: #at: on: Config as: [:self :aKey |
  let m := [self map];
  [[m notNil]
    ifTrue: [| [m at: aKey ifAbsent: [| nil]]]
    ifFalse: [| nil]]] doc:
  "The value bound to `aKey` in birnam.toml, or nil (no file / key absent)."];

// The project entry-point source file (`main = "..."`), or nil. The bare/REPL boot
// runs this before dropping to the prompt.
[Reflect defineMethod: #main on: Config as: [:self | [self at: "main"]] doc:
  "The project entry-point source path (the `main` key), or nil."]
