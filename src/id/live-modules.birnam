// live-modules.birnam — L1b file-backed revision and full-baseline policy.
// Import is inert: it parses, classifies, compiles, and inspects, but never
// publishes dispatch or source authority. Activation remains an EvolutionIntent
// fulfilled by the host only at a top-level quiescent boundary.

[Module named: #liveModules requires: #[#compiledUnit]];

[[[Globals at: #LiveModules] isNil]
  ifTrue: [| [Globals at: #LiveModules put: [Object clone]]]
  ifFalse: [| nil]];
[[[Globals at: #LiveImport] isNil]
  ifTrue: [| [Globals at: #LiveImport put: [Object clone]]]
  ifFalse: [| nil]];

[db assert: #expectedBaseDigest attr: #cardinality value: #one];
[db assert: #importStatus attr: #cardinality value: #one];
[db assert: #importPath attr: #cardinality value: #one];
[db assert: #importRevision attr: #cardinality value: #one];

[Reflect defineMethod: #currentGeneration on: LiveModules as: [:self |
  [DispatchGeneration current]]];

[Reflect defineMethod: #currentDigest on: LiveModules as: [:self |
  let current := [self currentGeneration];
  [[current isNil] ifTrue: [| nil] ifFalse: [| [current baseDigest]]]]];

[Reflect defineMethod: #revisionFor: on: LiveModules as: [:self :name |
  let current := [self currentGeneration];
  [[current isNil] ifTrue: [| nil] ifFalse: [| [current revisionFor: name]]]]];

[Reflect defineMethod: #sourceFor: on: LiveModules as: [:self :name |
  let revision := [self revisionFor: name];
  [[revision isNil] ifTrue: [| nil] ifFalse: [| [revision at: 3]]]]];

[Reflect defineMethod: #stagedCandidates on: LiveModules as: [:self |
  [Codegen stagedCandidates]]];

[Reflect defineMethod: #durabilityStatus on: LiveModules as: [:self |
  let staged := [self stagedCandidates];
  [[[staged size] > 0]
    ifTrue: [| [Error kind: #stagedCandidatesPresent message: "discard or activate every staged candidate before saving a baseline"]]
    ifFalse: [|
      let reconciled := [Codegen reconcileAllCandidates];
      [[reconciled isError]
        ifTrue: [| reconciled]
        ifFalse: [|
          let current := [self currentGeneration];
          [[current isNil]
            ifTrue: [| [Error kind: #generationNotInitialized]]
            ifFalse: [| {#status -> #fullImageReady, #baseDigest -> [current baseDigest]}]]]]]]]];

[Reflect defineMethod: #envelopeFor:base: on: LiveModules as: [:self :source :base |
  [["// birnam-live-base sha256:" , base] , ["\n" , source]]]];

[Reflect defineMethod: #fileOut:to: on: LiveModules as: [:self :name :path |
  let source := [self sourceFor: name];
  [[source isNil]
    ifTrue: [| [Error kind: #moduleNotInGeneration message: "module has no current source revision"]]
    ifFalse: [|
      let contents := [self envelopeFor: source base: [self currentDigest]];
      let checked := [Codegen liveRevisionOf: contents];
      [[checked isError]
        ifTrue: [| checked]
        ifFalse: [|
          let written := [System writeFile: path contents: contents];
          [[written isError] ifTrue: [| written] ifFalse: [| path]]]]]]]];

[Reflect defineMethod: #generation:hasDigest: on: LiveModules as: [:self :generation :digest |
  [[generation isNil]
    ifTrue: [| false]
    ifFalse: [|
      [[[generation baseDigest] = digest]
        ifTrue: [| true]
        ifFalse: [| [self generation: [generation predecessor] hasDigest: digest]]]]]]];

[Reflect defineMethod: #relationshipOfBase: on: LiveModules as: [:self :digest |
  let current := [self currentGeneration];
  [[current isNil]
    ifTrue: [| #missingGeneration]
    ifFalse: [|
      [[[current baseDigest] = digest]
        ifTrue: [| #current]
        ifFalse: [|
          [[self generation: [current predecessor] hasDigest: digest]
            ifTrue: [| #ancestor]
            ifFalse: [| #sibling]]]]]]]];

[Reflect defineMethod: #identical:base:path: on: LiveImport as: [:self :revision :base :path |
  let result := [self clone];
  [db assert: result attr: #importRevision value: revision];
  [db assert: result attr: #expectedBaseDigest value: base];
  [db assert: result attr: #importPath value: path];
  [db assert: result attr: #importStatus value: #identical];
  result]];

[Reflect defineMethod: #isImport: on: LiveImport as: [:self :value |
  [[Reflect vtableOf: value] == [Reflect vtableOf: self]]]];

[Reflect defineMethod: #status on: LiveImport as: [:self |
  [db currentValue: self attr: #importStatus]]];

[Reflect defineMethod: #sourceRevision on: LiveImport as: [:self |
  [db currentValue: self attr: #importRevision]]];

[Reflect defineMethod: #unitName on: LiveImport as: [:self |
  [[self sourceRevision] at: 1]]];

[Reflect defineMethod: #revisionDigest on: LiveImport as: [:self |
  [[self sourceRevision] at: 6]]];

[Reflect defineMethod: #expectedBaseDigest on: LiveImport as: [:self |
  [db currentValue: self attr: #expectedBaseDigest]]];

[Reflect defineMethod: #printString on: LiveImport as: [:self |
  [[[["live import(" , [[self unitName] printString]] , " "] , [[self status] printString]] , ")"]]];

[Reflect defineMethod: #import: on: LiveModules as: [:self :path |
  [self import: path for: nil]]];

[Reflect defineMethod: #compileRevision:base:path: on: LiveModules as: [:self :revision :base :path |
  let name := [revision at: 1];
  let output := [Codegen candidateTempPathFor: [revision at: 6]];
  let compiled := [CompiledUnit compile: [revision at: 3] named: name output: output];
  [[compiled isError]
    ifTrue: [| compiled]
    ifFalse: [|
      let unit := [CompiledUnit open: output];
      [[unit isError]
        ifTrue: [| unit]
        ifFalse: [|
          [db assert: unit attr: #expectedBaseDigest value: base];
          [db assert: unit attr: #importPath value: path];
          [db assert: unit attr: #importStatus value: #staged];
          unit]]]]]];

[Reflect defineMethod: #stagedFor:base:path: on: LiveModules as: [:self :revision :base :path |
  [[self stagedCandidates] inject: nil into: [:found :unit |
    [[found notNil]
      ifTrue: [| found]
      ifFalse: [|
        let sameRevision := [[unit revisionDigest] = [revision at: 6]];
        let sameBase := [[unit expectedBaseDigest] = base];
        let samePath := [[db currentValue: unit attr: #importPath] = path];
        [[[sameRevision & sameBase] & samePath]
          ifTrue: [| unit]
          ifFalse: [| nil]]]]]]]];

[Reflect defineMethod: #divergenceFor: on: LiveModules as: [:self :relationship |
  [[relationship = #ancestor]
    ifTrue: [| [Error kind: #staleAncestor message: "file is based on an ancestor generation"]]
    ifFalse: [|
      [[relationship = #sibling]
        ifTrue: [| [Error kind: #siblingDivergence message: "file base is not in the current generation lineage"]]
        ifFalse: [| [Error kind: #generationNotInitialized]]]]]]];

[Reflect defineMethod: #stageRevision:base:path: on: LiveModules as: [:self :revision :base :path |
  let name := [revision at: 1];
  let currentRevision := [self revisionFor: name];
  [[currentRevision isNil]
    ifTrue: [| [Error kind: #moduleIntroductionNotAvailable]]
    ifFalse: [|
      [[[currentRevision at: 6] = [revision at: 6]]
        ifTrue: [| [LiveImport identical: revision base: base path: path]]
        ifFalse: [|
          let relationship := [self relationshipOfBase: base];
          [[relationship = #current]
            ifTrue: [|
              let staged := [self stagedFor: revision base: base path: path];
              [[staged isNil]
                ifTrue: [| [self compileRevision: revision base: base path: path]]
                ifFalse: [| staged]]]
            ifFalse: [| [self divergenceFor: relationship]]]]]]]]];

[Reflect defineMethod: #import:for: on: LiveModules as: [:self :path :expectedName |
  let contents := [System readFile: path];
  [[contents isError]
    ifTrue: [| contents]
    ifFalse: [|
      let parsed := [Codegen liveRevisionOf: contents];
      [[parsed isError]
        ifTrue: [| parsed]
        ifFalse: [|
          let base := [parsed at: 1];
          let revision := [parsed at: 2];
          let name := [revision at: 1];
          [[[expectedName notNil] & [[name = expectedName] not]]
            ifTrue: [| [Error kind: #wrongModuleName message: "declared module does not match the requested module"]]
            ifFalse: [| [self stageRevision: revision base: base path: path]]]]]]]]];

[Reflect defineMethod: #activationFor: on: LiveModules as: [:self :unit |
  let deps := [unit prepareDependencies];
  [[deps isError]
    ifTrue: [| deps]
    ifFalse: [|
      let mapped := [unit map];
      [[mapped isError]
        ifTrue: [| mapped]
        ifFalse: [|
          [Codegen retireCandidateArtifacts: unit];
          let valid := [unit validate];
          [[valid isError] ifTrue: [| valid] ifFalse: [| [unit activate]]]]]]]]];

[Reflect defineMethod: #activate: on: LiveModules as: [:self :path |
  let imported := [self import: path];
  [[imported isError]
    ifTrue: [| imported]
    ifFalse: [|
      [[LiveImport isImport: imported]
        ifTrue: [| imported]
        ifFalse: [| [self activationFor: imported]]]]]]];

[Reflect defineMethod: #rollback on: LiveModules as: [:self |
  let current := [self currentGeneration];
  let unit := [[current isNil] ifTrue: [| nil] ifFalse: [| [current deltaUnit]]];
  [[[unit isNil] or: [| [[unit isMapped] not]]]
    ifTrue: [| [Error kind: #rollbackUnavailable message: "the current generation has no process-local rollback capability"]]
    ifFalse: [| [unit rollback]]]]];

[Reflect defineMethod: #saveBaseline: on: LiveModules as: [:self :path |
  [EvolutionIntent for: path action: #saveBaseline]]];

[Reflect defineMethod: #commitSaveBaseline: on: LiveModules as: [:self :path |
  let durable := [self durabilityStatus];
  [[durable isError]
    ifTrue: [| durable]
    ifFalse: [|
      let repl := [Globals at: #Repl];
      let consoleState := [[repl isNil] ifTrue: [| nil] ifFalse: [| [repl detachConsoleForBaseline]]];
      let saved := [System saveImage: path];
      [[repl isNil] ifTrue: [| nil] ifFalse: [| [repl restoreConsoleAfterBaseline: consoleState]]];
      [[saved isNil]
        ifTrue: [| [Error kind: #baselineSaveFailed message: [[System imageSaveReport] detail]]]
        ifFalse: [|
          let current := [self currentGeneration];
          {#status -> #saved,
           #path -> path,
           #baseDigest -> [current baseDigest],
           #sourceCount -> [[current sourceMap] size]}]]]]]];

// L2 wire requests are positional copied values. The native isolate codec turns
// these vectors into fixed versioned records; no CompiledUnit, generation, Oop,
// prepared token, or rollback capability crosses the process boundary.
[Reflect defineMethod: #evolutionRequestFor: on: LiveModules as: [:self :unit |
  let location := [unit artifactLocation];
  [[location isError]
    ifTrue: [| location]
    ifFalse: [|
      #[#activate
        [unit unitName]
        [unit revisionDigest]
        [unit authoredSource]
        [unit artifactChecksum]
        location
        [unit expectedBaseDigest]]]]]];

[Reflect defineMethod: #rollbackRequest on: LiveModules as: [:self |
  #[#rollback [self currentDigest]]]];

[Reflect defineMethod: #rollbackRequestForDigest: on: LiveModules as: [:self :digest |
  #[#rollback digest]]];

[Reflect defineMethod: #releaseEvolution:kind:message: on: LiveModules as: [:self :unit :kind :message |
  [Codegen releaseCandidate: unit];
  [Error kind: kind message: message]]];

[Reflect defineMethod: #mapEvolutionUnit: on: LiveModules as: [:self :unit |
  let deps := [unit prepareDependencies];
  [[deps isError]
    ifTrue: [| [self releaseEvolution: unit kind: [deps kind] message: [deps message]]]
    ifFalse: [|
      let mapped := [unit map];
      [[mapped isError]
        ifTrue: [| [self releaseEvolution: unit kind: [mapped kind] message: [mapped message]]]
        ifFalse: [|
          let valid := [unit validate];
          [[valid isError]
            ifTrue: [| [self releaseEvolution: unit kind: [valid kind] message: [valid message]]]
            ifFalse: [| [unit activate]]]]]]]]];

[Reflect defineMethod: #validateEvolutionUnit:request: on: LiveModules as: [:self :unit :request |
  let source := [request at: 3];
  let identityMatches := [[[unit unitName] = [request at: 1]] & [[unit revisionDigest] = [request at: 2]]];
  let artifactMatches := [[unit artifactChecksum] = [request at: 4]];
  let sourceMatches := [[source isNil] or: [| [[unit authoredSource] = source]]];
  [[[identityMatches & artifactMatches] & sourceMatches]
    ifTrue: [|
      [db assert: unit attr: #expectedBaseDigest value: [request at: 6]];
      [self mapEvolutionUnit: unit]]
    ifFalse: [|
      [self releaseEvolution: unit kind: #evolutionIdentityMismatch message: "candidate metadata does not match the evolution request"]]]]];

[Reflect defineMethod: #prepareEvolutionActivation: on: LiveModules as: [:self :request |
  [[[self currentDigest] = [request at: 6]]
    ifTrue: [|
      let unit := [CompiledUnit open: [request at: 5]];
      [[unit isError]
        ifTrue: [| unit]
        ifFalse: [| [self validateEvolutionUnit: unit request: request]]]]
    ifFalse: [| [Error kind: #staleGeneration message: "worker generation does not match the requested base"]]]]];

[Reflect defineMethod: #prepareEvolution: on: LiveModules as: [:self :request |
  let operation := [request at: 0];
  [[operation = #activate]
    ifTrue: [| [self prepareEvolutionActivation: request]]
    ifFalse: [|
      [[operation = #rollback]
        ifTrue: [|
          [[[self currentDigest] = [request at: 1]]
            ifTrue: [| [self rollback]]
            ifFalse: [| [Error kind: #staleGeneration message: "worker generation does not match the rollback digest"]]]]
        ifFalse: [| [Error kind: #invalidEvolutionOperation]]]]]]];

[Reflect defineMethod: #apiVersion on: LiveModules as: [:self | #L2]];

[Reflect defineMethod: #printString on: CompiledUnit as: [:self |
  [[[["candidate(" , [[self unitName] printString]] , " "] , [[self state] printString]] , ")"]]];

[Reflect exportObject: LiveImport as: #LiveImportPrototype];
[Reflect exportVtableOf: LiveImport as: #LiveImportVt];

[Module markLoaded: #liveModules]
