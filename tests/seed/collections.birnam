let Assert := [Object clone];
[Reflect defineMethod: #that: on: Assert as: [:self :condition |
  [condition ifTrue: [| self] ifFalse: [| [Error kind: #assertionFailed message: "collection/control assertion"]]]]];
let marker := [Object clone];
let cell := [Cell with: marker];
let other := [cell clone];
[Assert that: [[other value] == marker]];
[cell value: 7];
[Assert that: [[other value] == marker]];
let n := [Cell with: 0];
[[| [[n value] < 100]] whileTrue: [| [n value: [[n value] + 1]]]];
[Assert that: [[n value] = 100]];
[Assert that: [[false and: [| missing]] == false]];
[Assert that: [[true or: [| missing]] == true]];
let loopBody := [| [n value: 999]];
[Reflect defineMethod: #value on: loopBody as: [:self | [n value: 101]]];
[[| [[n value] < 101]] whileTrue: loopBody];
[Assert that: [[n value] = 101]];
[Assert that: [[[[| 1] whileTrue: [| missing]] kind] == #nonBooleanCondition]];
let error := [Error kind: #bodyFailed message: "expected"];
[Assert that: [[[| true] whileTrue: [| error]] == error]];
let source := #[marker];
let extended := [source append: 1];
let joined := [extended concat: #[2 3]];
[Assert that: [[source size] = 1]];
[Assert that: [[joined size] = 4]];
[Assert that: [[joined at: 0] == marker]];
[Assert that: [[joined at: 3] = 3]];
let dictionary := [Namespace new];
[dictionary at: #storedNil put: nil];
[Assert that: [[dictionary at: #storedNil ifAbsent: [| missing]] == nil]];
[Assert that: [[dictionary at: #missing ifAbsent: [| marker]] == marker]];
[Assert that: [["abc" commonPrefixLengthWith: "abd" at: 0] = 2]];
[Assert that: [["abc" commonPrefixLengthWith: "bc" at: 1] = 2]];
[Assert that: [["abc" commonPrefixLengthWith: "x" at: 3] = 0]];
[Assert that: [["é" commonPrefixLengthWith: ["é" bytesFrom: 0 to: 1] at: 0] = 1]];
[Assert that: [[["abc" commonPrefixLengthWith: "a" at: -1] kind] == #indexOutOfBounds]];
[GC collect];
[System println: "PASS general collection and control helpers"];
