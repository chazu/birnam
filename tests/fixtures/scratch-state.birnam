// Run by scripts/scratch-state-test.py, after optional development source loads.
[Module load: #json]; [Module load: #time]; [Module load: #os];
[Module load: #markdown]; [Module load: #nativedoc]; [Module load: #alienCompiler];
let check := [:condition :label |
  [condition ifFalse: [| [System printErrorText: [label , "\n"]]; [OS exit: 1]]]
];
// Same-named fields on an unrelated entity remain real, queryable Store data.
let sentinel := [Object clone];
[#[#mode #buf #items #shift #pending #summary #input #offset #aggregates #kind #count #valid #arguments #value]
  do: [:key | [db assert: sentinel attr: key value: #untouched]]];
let measure := [:name :operation :expected |
  [check value: [[operation value] = expected] value: [name , " warm result"]];
  let batches := [[1 to: 3] collect: [:batch |
    [System gc];
    let facts := [db retainedFactCount]; let objects := [System liveObjects];
    [1 to: 20 do: [:i |
      [check value: [[operation value] = expected] value: [name , " result"]]
    ]];
    [System gc]; let after := [db retainedFactCount]; let live := [System liveObjects];
    [check value: [after = facts] value: [name , " published scratch facts"]];
    [db compact]; [System gc];
    [check value: [[db retainedFactCount] = facts] value: [name , " compacted facts changed"]];
    [check value: [[live - objects] < 16] value: [name , " retained scratch objects"]];
    {"fact_delta" -> [after - facts] "object_delta" -> [live - objects]}
  ]];
  [System println: [Json stringify: {"case" -> name "calls_per_batch" -> 20 "batches" -> batches}]]
];
[measure value: "markdown" value: [| [Markdown toHtml: "para\n- one\n- two\n\n```\n<raw>\n```"]]
  value: "<p>para</p><ul><li>one</li><li>two</li></ul><pre><code>&lt;raw&gt;</code></pre>"];
[measure value: "alien-parse" value: [| [AlienCompiler parse: "i i"]] value: #[#[#scalar "i"] #[#[#scalar "i"]] #[]]];
[measure value: "alien-error" value: [| [[AlienCompiler parse: "{0i}"] message]] value: "array at offset 1 has zero length"];
[measure value: "alien-classify" value: [| [AlienCompiler classify: [AlienCompiler parse: "{d{dd}} {4f}"]]]
  value: #[#[#aggregate 1 #["d" 3]] #[#[#aggregate 2 #["f" 4]]]]];
// Exercise the complete generator, not only its parser. Exact bytes have a
// separate frozen-Rust oracle; here check a stable generated-code property.
[measure value: "alien-compile" value: [|
  let source := [AlienCompiler compile: "scratch_example" signature: "l l"];
  [check value: [[source isError] not] value: "compile error"];
  [[source size] > 100]
] value: true];
// Summary-only scans update the same published catalog records. They must not
// add scanner entities. Declaration publication is checked separately below.
[measure value: "nativedoc" value: [|
  [NativeDoc scanRust: "summary.rs" as: #scratchSummary];
  [db currentValue: #scratchSummary attr: #docSummary]
] value: "Retained public summary."];
[NativeDoc scanRust: "declaration.rs" as: #scratchDeclaration];
[check value: [Doc isRustFloor: #scratchDeclaration] value: "lost document kind"];
[check value: [[Doc modules] includes: #scratchDeclaration] value: "lost catalog query"];
[check value: [[Doc cli: #scratchDeclaration] includesSubstring: "PublicThing"] value: "lost declaration"];
[check value: [[db currentValue: #scratchDeclaration attr: #docSummary] = "Public declaration summary."] value: "lost summary fact"];
[#[#mode #buf #items #shift #pending #summary #input #offset #aggregates #kind #count #valid #arguments #value]
  do: [:key | [check value: [[db currentValue: sentinel attr: key] == #untouched] value: "unrelated Store user changed"]]];
// Keep public asCell fact-backed. This patch changes private callers only.
[[|
let facts := [db retainedFactCount];
let publicCell := [7 asCell];
[check value: [[db retainedFactCount] = [facts + 1]] value: "public asCell changed"];
[check value: [[publicCell value] = 7] value: "public Cell lost value"]
] value];
// Collect and reenter during ordinary replaceable helper sends. Inner scanners
// must not overwrite the outer invocation's state. These overrides are last so
// they cannot weaken the output/retention checks above.
let nestedHtml := [db localCell: nil];
[Reflect defineMethod: #inlineHtml: on: Markdown as: [:self :text |
  [System gc];
  [[text = "outer"] ifTrue: [| [nestedHtml set: [self toHtml: "inner"]]]];
  text
]];
[check value: [[Markdown toHtml: "outer\n\nlast"] = "<p>outer</p><p>last</p>"] value: "reentrant Markdown corrupted outer scanner"];
[check value: [[nestedHtml value] = "<p>inner</p>"] value: "reentrant Markdown failed"];
let nestedSignature := [db localCell: nil]; let inside := [db localCell: false];
[Reflect defineMethod: #advance: on: AlienCompiler as: [:self :parser |
  [System gc];
  [[inside value] ifFalse: [|
    [inside set: true]; [nestedSignature set: [self parse: "f f"]]; [inside set: false]
  ]];
  [self state: parser at: #offset put: [[self position: parser] + 1]]
]];
[check value: [[AlienCompiler parse: "i i"] = #[#[#scalar "i"] #[#[#scalar "i"]] #[]]] value: "reentrant parse corrupted outer parser"];
[check value: [[nestedSignature value] = #[#[#scalar "f"] #[#[#scalar "f"]] #[]]] value: "reentrant parse failed"];
let nestedScan := [db localCell: false];
[Reflect defineMethod: #after:mark: on: NativeDoc as: [:self :line :mark |
  [System gc];
  [[nestedScan value] ifFalse: [|
    [nestedScan set: true];
    [self scanRust: "summary.rs" as: #scratchNestedSummary];
    [nestedScan set: false]
  ]];
  [[[line split: mark] last] trimmed]
]];
[NativeDoc scanRust: "declaration.rs" as: #scratchReentrantDeclaration];
[check value: [[db currentValue: #scratchReentrantDeclaration attr: #docSummary] = "Public declaration summary."] value: "reentrant scan corrupted summary"];
[check value: [[Doc cli: #scratchReentrantDeclaration] includesSubstring: "PublicThing"] value: "reentrant scan lost declaration"];
[check value: [[db currentValue: #scratchNestedSummary attr: #docSummary] = "Retained public summary."] value: "nested scan failed"];
[System println: "scratch-state: passed"]
