[[|
// Bind ordinary compiled code through object messages. These are
// source-backed bodies, but retained Method objects themselves stay process-local.
let first := [Object clone];
let second := [Object clone];
let a := [Reflect methodForArity: 1 implementation: [:self :argument | #[self argument #first]]];
let b := [Reflect methodForArity: 1 implementation: [:self :argument | #[self argument #second]]];
[Reflect defineMethod: #answer: on: first as: [:self :argument | argument]];
[[Reflect vtableOf: first] addMethod: a as: #answer:];
[Reflect defineMethod: #answer: on: second as: [:self :argument | argument]];
[[Reflect vtableOf: second] addMethod: b as: #answer:];
[Globals at: #MethodBindingTargets put: #[first second]];
true
] value]
