// Experimental ordinary-result publication policy; not installed as production.
let policy := [Object clone];
[Reflect defineMethod: #publish:on:with:authorize:describe:notify: on: policy as: [:self :selector :target :method :authorizer :description :observer |
  let allowed := [authorizer value];
  [[allowed == true] ifTrue: [|
    let changed := [target addMethod: method as: selector];
    [[changed isError] ifTrue: [| changed] ifFalse: [|
      let described := [[description isNil] ifTrue: [| nil] ifFalse: [|
        [description value: selector value: target]
      ]];
      [[described isError] ifTrue: [| described] ifFalse: [|
        let observed := [observer managedMethodChanged: selector on: target];
        [[observed isError] ifTrue: [| observed] ifFalse: [| self]]
      ]]
    ]]
  ] ifFalse: [| allowed]]
]];
[Globals at: #PublicationResultProposal put: policy];
true
