.cargo-target/
.zig-cache/
zig-out/
chat.md

# Override global ignore so we can commit vendored libs (dyncall, etc.)
!vendor/
!vendor/**
.aot_app.bim

# mise.toml is the project's pinned toolchain + task runner — track it despite
# the global ignore (mise is usually a personal/local convention).
!mise.toml
!Cargo.lock

# Built first-party wrapped C libraries (produced by `birnam wrap`)
wrapped/**/lib*.dylib
wrapped/**/lib*.so

# Between-version benchmark runs are disposable; only per-tag snapshots
# (bench/results/v*.json) are tracked. (docs/design/46)
bench/results/dev/
