// image.birnam — the image-save benchmark (docs/design/46 Phase 4).
//
// One-shot protocol: boot, install a marker binding (so the saved image is
// non-trivially different from a bare boot), then time ONE [System saveImage:]
// on the warm heap. The artifact this writes is what bench.sh's boot.image
// macro case boots and checks through its saved main. BENCH_IMG overrides
// where the image lands.
//
//   "$HOME/.local/bin/birnam" bench/image.birnam

let benchSource := [System getEnv: "BIRNAM_BENCH_SOURCE"];
[System load: [[benchSource isNil] ifTrue: [| "modules/bench.birnam"] ifFalse: [| benchSource]]];
[Module load: #os];

let env := ["BENCH_IMG" getenvValue];
let IMG := [[env isNil] ifTrue: [| "bench/results/dev/bench.image"] ifFalse: [| env]];
[Bench ensureDir: "bench"];
[Bench ensureDir: "bench/results"];
[Bench ensureDir: "bench/results/dev"];

[Globals at: #BenchImageMark put: 42];
[Globals at: #main put: [|
  [[BenchImageMark = 42] ifTrue: [| nil] ifFalse: [| [OS exit: 1]]]]];

[System autoGc: false];
[System gc];
let t0 := [Time monotonicMicros];
let saved := [System saveImage: IMG];
let t1 := [Time monotonicMicros];

let s := [BenchSuite named: "image"];
[Bench runSuite: s];
[Bench record: "image.save" us: [t1 - t0] ops: 1];
let written := [Bench writeResults: "bench/results/dev/image.json"];

// A successful save answers true and publishes a saved report. An Error or nil
// must not be accepted as benchmark evidence for an image that was not written.
let saveOk := [[saved == true] & [[[System imageSaveReport] status] = #saved]];
[saveOk ifTrue: [| nil] ifFalse: [|
  [System println: ["image save REJECTED: " , [[[System imageSaveReport] detail] printString]]]]];

let ok := [[[[[[Bench results] size] = 1]
           & [[Bench failures] = 0]]
           & saveOk]
           & [[written isError] ifTrue: [| false] ifFalse: [| true]]];
[ok
  ifTrue:  [| [OS exit: 0]]
  ifFalse: [| [OS exit: 1]]]
