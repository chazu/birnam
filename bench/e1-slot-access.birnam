// e1-slot-access.birnam — Design 74 E1 resumable loop fixture.
//
// Diagnostic, not part of the frozen benchmark suites and not release
// acceptance evidence. The loop control and both bodies live in a unit that
// this script compiles in-process with whole-unit resumable selection, so the
// same Birnam source runs as the baseline StepMethods (ordinary emission) or
// as the candidate (BIRNAM_DEV_GUARDED_SLOTS=1 in a dev-feature prefix).
// Iteration count and unit path come from the environment at run time; the
// step body accumulates an observable checksum in a captured Cell.
//
//   E1_ITERATIONS=1024 E1_UNIT_PATH=/tmp/e1.dylib birnam bench/e1-slot-access.birnam
//
// Output lines: e1-ready, empty-us, step-us, empty-answer, checksum. Driven by
// the retired Design 74 drivers (74B–74D); kept as a retained probe of the
// guarded slot-access loop cost. Design 66's control probe stays unchanged.

[System load: "modules/time.birnam"];
[System load: "modules/os.birnam"];
[Alien wrap: "getenv" signature: "s s" as: #e1Getenv on: String];

let countText := ["E1_ITERATIONS" e1Getenv];
let unitPath := ["E1_UNIT_PATH" e1Getenv];
[[[countText isNil] | [unitPath isNil]]
  ifTrue: [| [System println: "e1-missing-environment"]; [OS exit: 2]]
  ifFalse: [| nil]];
let parsed := [0 asCell];
[0 to: [[countText size] - 1] do: [:i |
  [parsed set: [[[parsed value] * 10] + [[countText byteAt: i] - 48]]]]];
let count := [parsed value];

let source := "[Module named: #e1SlotAccess requires: #[]]; [Reflect defineMethod: #e1Step: on: Integer as: [:self :index | [self + index]]]; [Reflect defineMethod: #e1To:do:answer: on: Integer as: [:self :last :body :answer | [[self > last] ifTrue: [| answer] ifFalse: [| [self e1ToBody: last do: body answer: answer]]]]]; [Reflect defineMethod: #e1ToBody:do:answer: on: Integer as: [:self :last :body :answer | let eachResult := [body value: self]; [[eachResult isError] ifTrue: [| eachResult] ifFalse: [| [self e1ToContinue: last do: body answer: answer]]]]]; [Reflect defineMethod: #e1ToContinue:do:answer: on: Integer as: [:self :last :body :answer | [[self + 1] e1To: last do: body answer: answer]]]; [Reflect defineMethod: #e1RunEmpty: on: Integer as: [:self :count | [1 e1To: count do: [:index | nil] answer: self]]]; [Reflect defineMethod: #e1RunStep: on: Integer as: [:self :count | let acc := [0 asCell]; [1 e1To: count do: [:index | [acc set: [[acc value] + [self e1Step: index]]]] answer: self]; [acc value]]]";

// The script harness has no host prompt boundary: record the module's
// baseline source and seal the current generation, then compile the unit as
// its successor candidate (the same setup modules/compiled-unit-test uses).
[Codegen recordModuleSource: "[Module named: #e1SlotAccess requires: #[]]" named: #e1SlotAccess];
[DispatchGeneration initializeCurrent];
let c0 := [Time monotonicMicros];
let compiled := [CompiledUnit compile: source named: #e1SlotAccess output: unitPath selection: #resumableRequired];
[[[compiled isError] | [compiled isNil]]
  ifTrue: [| [System println: "e1-compile-failed"]; [System println: [[Codegen lastError] printString]]; [OS exit: 1]]
  ifFalse: [| nil]];
let unit := [CompiledUnit open: unitPath];
[[unit isError] ifTrue: [| [System println: ["e1-open-failed " , [[unit kind] printString] , " " , [[unit message] printString]]]; [OS exit: 1]] ifFalse: [| nil]];
let mapped := [unit map];
[[mapped isError] ifTrue: [| [System println: ["e1-map-failed " , [[mapped kind] printString] , " " , [[mapped message] printString] , " " , [[Codegen lastError] printString]]]; [OS exit: 1]] ifFalse: [| nil]];
let activated := [[unit activate] fulfill];
[[activated isError] ifTrue: [| [System println: ["e1-activate-failed " , [[activated kind] printString] , " " , [[activated message] printString] , " " , [[Codegen lastError] printString]]]; [OS exit: 1]] ifFalse: [| nil]];
[System println: ["compile-us " , [[[Time monotonicMicros] - c0] printString]]];
[System println: "e1-ready"];

// Phases (Design 74 §7.5): compile-and-activate above, then a cold first run
// of each body, then the median of five warm repetitions of each body.
let t0 := [Time monotonicMicros];
let emptyAnswer := [7 e1RunEmpty: count];
let t1 := [Time monotonicMicros];
let checksum := [7 e1RunStep: count];
let t2 := [Time monotonicMicros];
[System println: ["empty-us " , [[t1 - t0] printString]]];
[System println: ["step-us " , [[t2 - t1] printString]]];
[System println: ["empty-answer " , [emptyAnswer printString]]];
[System println: ["checksum " , [checksum printString]]];
let warmEmpty := [#[] asCell];
let warmStep := [#[] asCell];
[1 to: 5 do: [:rep |
  let w0 := [Time monotonicMicros];
  let a := [7 e1RunEmpty: count];
  let w1 := [Time monotonicMicros];
  let c := [7 e1RunStep: count];
  let w2 := [Time monotonicMicros];
  [[[a = emptyAnswer] & [c = checksum]] ifTrue: [| nil] ifFalse: [| [System println: "e1-warm-mismatch"]; [OS exit: 1]]];
  [warmEmpty set: [[warmEmpty value] add: [w1 - w0]]];
  [warmStep set: [[warmStep value] add: [w2 - w1]]]]];
[System println: ["warm-empty-us " , [[[[warmEmpty value] sortBy: [:x | x]] at: 2] printString]]];
[System println: ["warm-step-us " , [[[[warmStep value] sortBy: [:x | x]] at: 2] printString]]];
