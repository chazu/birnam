// Establish the stable receiver before G0; L1b changes declarative methods on
// stable targets and deliberately does not introduce new globals or top-level effects.
let LiveExampleWorker := [Object clone];
[System load: "examples/live-modules/worker-v1.birnam"];
[DispatchGeneration initializeCurrent];

let exported := "/tmp/birnam-live-example-export.birnam";
[LiveModules fileOut: #liveExample to: exported];
[System println: ["exported v1: " , exported]];

let successor := [System readFile: "examples/live-modules/worker-v2.birnam"];
let candidate := "/tmp/birnam-live-example-v2.birnam";
[System writeFile: candidate contents:
  [LiveModules envelopeFor: successor base: [LiveModules currentDigest]]];

let staged := [LiveModules import: candidate];
[System println: ["staged: " , [staged printString]]];
[System println: ["replacements: " , [[[staged replacements] size] printString]]];

let intent := [LiveModules activationFor: staged];
let activated := [intent fulfill];
[System println: ["activated: " , [activated printString]]];
[System println: ["live reply: " , [[LiveExampleWorker handle: "hello"] printString]]];

// A normal image boot executes main; worker boot deliberately suppresses it.
let main := [|
  [System println: ["baseline reply: " , [[LiveExampleWorker handle: "boot"] printString]]]];
let report := [[LiveModules saveBaseline: "/tmp/birnam-live-example.image"] fulfill];
[System println: ["baseline: " , [report printString]]]
