let worker := [Isolate
  start: #LiveExampleWorker selector: #handle:
  image: "/tmp/birnam-live-rollout-example.image"]
["rollout before: " , [[worker request: "before"] printString]]

[System writeFile: "/tmp/birnam-live-rollout-example-v2.birnam" contents:
  [LiveModules envelopeFor: [System readFile: "examples/live-modules/worker-v2.birnam"]
    base: [LiveModules currentDigest]]]
let candidate := [LiveModules import: "/tmp/birnam-live-rollout-example-v2.birnam"]
let request := [LiveModules evolutionRequestFor: candidate]
let receipt := [worker evolve: request timeout: 10000]
["rollout outcome: " , [[receipt outcome] printString]]
["rollout digest changed: " , [[[[receipt priorDigest] = [receipt currentDigest]] not] printString]]
["rollout after:  " , [[worker request: "after"] printString]]

let rollback := [worker evolve:
  [LiveModules rollbackRequestForDigest: [receipt currentDigest]] timeout: 10000]
["rollback outcome: " , [[rollback outcome] printString]]
["rollback after: " , [[worker request: "restored"] printString]]
[worker stop]
:q
