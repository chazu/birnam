// TCP echo server — one connection, then exit.
//
//   birnam examples/net-echo.birnam        # in one terminal
//   nc 127.0.0.1 9090                       # in another; type a line, see it echoed
//
// `Net listen:` binds 127.0.0.1:port; `accept` blocks for a client; `recv:`/
// `send:` move bytes; `close` ends. All over zig's std.net, no FFI.

let port := 9090;
let srv := [Net listen: port];
[System println: ["echo server on 127.0.0.1:" , [port printString]]];

let conn := [srv accept];
[System println: "client connected"];

let msg := [conn recv: 4096];
[System println: ["got " , [[[msg size] printString] , " bytes"]]];
[conn send: ["echo: " , msg]];

[conn close];
[srv close];
[System println: "done"]
