// The journal — incremental append vs. compaction (docs/40 §7.4).
//
//   birnam examples/journal.birnam    // writes /tmp/birnam-journal.image
//   birnam /tmp/birnam-journal.image  // boots it — base + every delta restored
//
// An image is a compacted journal; the journal is an image in progress — one
// format, two write modes:
//   - `[System saveImage: path]`  writes a fresh, fully-compacted image (a base).
//   - `[System appendImage: path]` writes ONLY what changed since the last save/
//     append (or, in a booted app, since boot) — no rewrite, the file just grows.
// A fresh boot reads the base and every appended delta in order, cumulatively:
// later facts win, and heap objects born in a delta relink against the base.
//
// This is the cheap-checkpoint path: a long-running app can `appendImage:` its
// evolving DATA repeatedly, and `saveImage:` occasionally to compact.

// A base generation: some starting state, then the base save.
[Globals at: #turn put: 1];
[Globals at: #log put: #[ "started" ]];
[System saveImage: "/tmp/birnam-journal.image"];
[System println: "wrote base (turn 1)"];

// Two deltas — each appends only its own change.
[Globals at: #turn put: 2];
[Globals at: #note put: "advanced to turn 2"];
[System appendImage: "/tmp/birnam-journal.image"];
[System println: "appended delta 1 (turn 2 + a note)"];

[Globals at: #turn put: 3];
[Globals at: #log put: #[ "started" "turn 2" "turn 3" ]];
[System appendImage: "/tmp/birnam-journal.image"];
[System println: "appended delta 2 (turn 3, log grown)"];

[System println: "now boot it — turn is 3, note is set, log has 3 entries:"];
[System println: "  [Globals at: #turn]        => 3   (newest delta wins)"];
[System println: "  [Globals at: #note]        => advanced to turn 2"];
[System println: "  [[Globals at: #log] size]  => 3"]
