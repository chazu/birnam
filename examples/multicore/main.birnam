// Run from the repository root: birnam examples/multicore/main.birnam
[Module load: #os];
let program := [Concurrency load: #[
  "examples/multicore/platform.birnam"
  "examples/multicore/worker.birnam"
  "examples/multicore/coordinator.birnam"]];
[[program isError] ifTrue: [| [System println: program]; [OS exit: 1]]];

// Change the limit for a longer or shorter run. The library owns compilation,
// the worker image, and temporary directory; requests return ordinary tasks.
let success := [MulticoreDemo run: program limit: 10000];
[program close];
[[success = true] ifFalse: [| [OS exit: 1]]];
