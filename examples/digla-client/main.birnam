// Digla's Termbox client entrypoint. The edited image may be local or remote,
// but terminal and editor state belong only to this client process.

let args := [Globals at: #ProjectArgs];
let config := [Digla configForArgs: args];
[[config isError]
  ifTrue: [| [System println: [config printString]]]
  ifFalse: [|
    let headless := [args includes: "--headless-client"];
    [headless
      ifTrue: [| nil]
      ifFalse: [|
        let init := [Termbox init];
        [[init = 0]
          ifTrue: [|
            [Termbox hideCursor];
            [Digla runTerminalLoop: [Digla editorStateFor: config]];
            [Termbox shutdown]]
          ifFalse: [| [System println: "Digla: unable to initialize Termbox"]]]]]]]
