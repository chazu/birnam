// The image — save the running system, boot it back (docs/40, slice 3).
//
//   birnam examples/image.birnam      // writes /tmp/birnam-demo.image
//   birnam /tmp/birnam-demo.image     // boots it into the REPL, state restored
//
// An image is the live system made durable: its store-reachable state — the
// globals (a global binding IS a store cell) and everything reachable from
// their values — serialized so a fresh process maps it back and starts sending
// messages. No recompilation, no fact-by-fact replay.
//
// Slice 3 carries DATA. Everything below round-trips into a fresh process:
//   - leaf values (integers, strings, floats, symbols)
//   - vector tries, including nested ones (a trie of tries)
//   - HAMTs (maps), keyed by content-stable hashes
//   - a user method's SOURCE (recorded as a store fact, queryable, durable)
// What does NOT survive slice 3: compiled code — a user method's machine code
// and any block-valued global (a closure). Those are image-born; the save
// COUNTS and reports them (the "deferred N facts" line), and slice 4 recovers
// them (mapped code sections + replay from the source facts saved here).

// A spread of values as globals — the durability line is what the store names.
[Globals at: #answer put: 42];
[Globals at: #greeting put: "hello from a previous life"];
[Globals at: #ratio put: 1.5];
[Globals at: #nums put: #[ #[1 2 3] #[4 5 6] ]];
[Globals at: #config put: {#host -> "localhost", #port -> 8080}];

// A user method. Its SOURCE lands in the store (below) and survives the image,
// even though its compiled code is deferred to slice 4.
[Reflect defineMethod: #double on: Integer as: [:x | [x + x]]];

let path := [Globals at: #imagePath put: "/tmp/birnam-demo.image"];
[System saveImage: path];
[System println: ["saved image to " , path]];
[System println: "boot it, then in the REPL try:"];
[System println: "  [Globals at: #answer]         => 42"];
[System println: "  [Globals at: #config]         => a restored HAMT"];
[System println: "  [[Globals at: #nums] at: 1]   => #[4 5 6]"];
[System println: "  [db findAll: ?s where: #[ #[#__methods__ ?k ?s] ]]   => the method sources"]
