// FizzBuzz.
//
// Print 1..20, but multiples of 3 become "Fizz", of 5 "Buzz", and of both
// "FizzBuzz". Run as a script:
//
//   birnam examples/fizzbuzz.birnam
//
// The classic version is a pile of nested ifs. Here the two divisibility tests
// are named blocks (`fizzy`/`buzzy`), and `classify` reads as the rule it is:
// both → "FizzBuzz", else 3 → "Fizz", else 5 → "Buzz", else the number. Each
// block takes the number as a parameter, so they compose without capturing any
// loop state.

let fizzy := [:n | [[n mod: 3] = 0]];
let buzzy := [:n | [[n mod: 5] = 0]];

// `&` is eager boolean AND. `ifTrue:ifFalse:` answers the value of whichever
// branch block runs, so `classify` evaluates to the line to print.
let classify := [:n |
  [[[fizzy value: n] & [buzzy value: n]]
    ifTrue:  [| "FizzBuzz"]
    ifFalse: [|
      [[fizzy value: n]
        ifTrue:  [| "Fizz"]
        ifFalse: [|
          [[buzzy value: n]
            ifTrue:  [| "Buzz"]
            ifFalse: [| [n printString]]]]]]]];

[1 to: 20 do: [:n | [System println: [classify value: n]]]]
