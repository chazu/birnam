// logue — the interactive render + input layer over Termbox. This is the ONLY
// file that touches `Termbox`; all game logic lives in logue-core.birnam (and is
// fully exercised headlessly by logue-test.birnam).
//
// Run it from THIS directory, on a real terminal (termbox opens /dev/tty):
//
//   cd examples/logue && birnam logue.birnam        (or ./play.sh)
//
// birnam runs a single script; a script pulls in its dependencies with
// `[System load: …]`, evaluated into the shared global scope. Build the termbox2
// dylib once first (`../../wrapped/termbox2/build.sh`); configure Alien to find
// it, then load the reusable Termbox module.
[Alien libraryDir: "../../wrapped/termbox2"];
[System load: "../../wrapped/termbox2/termbox2.birnam"];
[System load: "logue-core.birnam"];
let tb := Termbox;

// ---- key codes ----------------------------------------------------------
let K_UP    := 65517;
let K_DOWN  := 65516;
let K_LEFT  := 65515;
let K_RIGHT := 65514;
let K_ESC   := 27;

// ---- dirty-render state -------------------------------------------------
// The map is static between turns, so we draw it in full only on a level
// change and per-turn repaint just the cells entities cover. A full per-frame
// redraw of all 1080 cells costs ~1.3s at interpreter speed; this is ~40 calls.
let lastDepth := [newCell value: 0];     // != depth -> full map redraw
let dirty     := [newCell value: #[]];   // cells covered by entities last frame

// ---- small draw helpers -------------------------------------------------
let putStr  := [:x :y :fg :s | [tb printX: x y: y fg: fg bg: 0 str: s]];
let putCell := [:x :y :ch :fg | [tb setX: x y: y ch: ch fg: fg bg: 0]];

// ---- glyph / colour tables ----------------------------------------------
let tileGlyph := [:t |
  [[symEq value: t value: #wall] ifTrue: [| 35] ifFalse: [|
    [[symEq value: t value: #up] ifTrue: [| 60] ifFalse: [|
      [[symEq value: t value: #down] ifTrue: [| 62] ifFalse: [| 46]]]]]]];

let tileColor := [:t |
  [[[symEq value: t value: #up] | [symEq value: t value: #down]] ifTrue: [| C_CYAN] ifFalse: [|
    [[symEq value: t value: #wall] ifTrue: [| C_BLUE] ifFalse: [| C_WHITE]]]]];

let itemGlyph := [:k |
  [[symEq value: k value: #gold] ifTrue: [| 36] ifFalse: [|
    [[symEq value: k value: #food] ifTrue: [| 37] ifFalse: [|
      [[symEq value: k value: #potion] ifTrue: [| 33] ifFalse: [|
        [[symEq value: k value: #weapon] ifTrue: [| 41] ifFalse: [|
          [[symEq value: k value: #armor] ifTrue: [| 91] ifFalse: [| 42]]]]]]]]]]];

let itemColor := [:k |
  [[symEq value: k value: #macguffin] ifTrue: [| C_MAGENTA] ifFalse: [|
    [[symEq value: k value: #gold] ifTrue: [| C_YELLOW] ifFalse: [| C_GREEN]]]]];

let classWord := [:c |
  [[symEq value: c value: #fighter] ifTrue: [| "Fighter"] ifFalse: [|
    [[symEq value: c value: #rogue] ifTrue: [| "Rogue"] ifFalse: [| "Wizard"]]]]];

let hungerWord := [:h |
  [[h > 600] ifTrue: [| "Sated"] ifFalse: [|
    [[h > 300] ifTrue: [| "Peckish"] ifFalse: [|
      [[h > 100] ifTrue: [| "Hungry"] ifFalse: [| "STARVING"]]]]]]];

// ---- HUD ----------------------------------------------------------------
let drawMessages := [:y0 |
  let m := [messages value];
  let n := [m size];
  let startI := [[n - 4] max: 0];
  [[startI to: [n - 1]] do: [:i |
    [putStr value: 0 value: [y0 + [i - startI]] value: C_WHITE value: [m at: i]]]]];

// Render a "x/y" pair as a string (kept tiny to keep brackets simple).
let slash := [:a :b | [[a printString] , ["/" , [b printString]]]];

let drawHud := [|
  let p := [player value];
  let y := [MAP_H + 1];
  // clear the HUD region first (no full-screen clear each frame any more)
  [[y to: [y + 9]] do: [:ry |
    [putStr value: 0 value: ry value: 0 value: "                                                                              "]]];
  // stats row — one short putStr per field at a fixed column
  [putStr value: 0  value: y value: C_YELLOW value: ["Depth " , [[depth value] printString]]];
  [putStr value: 10 value: y value: C_YELLOW value: ["HP " , [slash value: [p at: #hp] value: [p at: #maxHp]]]];
  [putStr value: 24 value: y value: C_YELLOW value: ["Hunger " , [hungerWord value: [p at: #hunger]]]];
  [putStr value: 42 value: y value: C_YELLOW value: ["Gold " , [[p at: #gold] printString]]];
  [putStr value: 54 value: y value: C_YELLOW value: [[classWord value: [p at: #class]] , [" L" , [[p at: #plvl] printString]]]];
  // equipment row
  [putStr value: 0  value: [y + 1] value: C_GREEN value: ["Weapon " , [[p at: #weapon] , [" (" , [[[p at: #weaponDmg] printString] , ")"]]]]];
  [putStr value: 26 value: [y + 1] value: C_GREEN value: ["Armor " , [[p at: #armor] , [" (" , [[[p at: #armorDef] printString] , ")"]]]]];
  [putStr value: 50 value: [y + 1] value: C_GREEN value: ["Rat " , [[p at: #rations] printString]]];
  [putStr value: 58 value: [y + 1] value: C_GREEN value: ["Pot " , [[p at: #potions] printString]]];
  [[[p at: #maxMana] > 0]
    ifTrue:  [| [putStr value: 0 value: [y + 2] value: C_CYAN value:
                  ["Mana " , [[slash value: [p at: #mana] value: [p at: #maxMana]] , "   (z: zap adjacent foe)"]]]]
    ifFalse: [| nil]];
  [drawMessages value: [y + 4]];
  [putStr value: 0 value: [y + 9] value: C_BLUE value:
    "move hjkl/yubn/arrows  >descend <ascend  e eat  q quaff  z zap  Q quit"]];

// ---- dirty render -------------------------------------------------------
// Full static-map repaint — `[tiles value]` hoisted out of the cell loop, and
// `tmap at:` used directly (not tileAt, which re-reads the cell each call).
let drawFullMap := [|
  [tb clear];
  let tmap := [tiles value];
  [[0 to: [MAP_H - 1]] do: [:y |
    [[0 to: [MAP_W - 1]] do: [:x |
      let t := [tmap at: [idx value: x value: y] ifAbsent: [| #wall]];
      [putCell value: x value: y value: [tileGlyph value: t] value: [tileColor value: t]]]]]]];

// Repaint the base tile under each cell an entity covered last frame.
let restoreDirty := [|
  let tmap := [tiles value];
  [[dirty value] do: [:pos |
    let t := [tmap at: [idx value: [pos at: 0] value: [pos at: 1]] ifAbsent: [| #wall]];
    [putCell value: [pos at: 0] value: [pos at: 1] value: [tileGlyph value: t] value: [tileColor value: t]]]]];

// Draw items, monsters, player; record their cells as next frame's dirty set.
let drawEntities := [|
  let d1 := [[items value] inject: #[] into: [:acc :it |
    [putCell value: [it at: #x] value: [it at: #y] value: [itemGlyph value: [it at: #kind]] value: [itemColor value: [it at: #kind]]];
    [acc add: [pair value: [it at: #x] value: [it at: #y]]]]];
  let d2 := [[monsters value] inject: d1 into: [:acc :m |
    [putCell value: [m at: #x] value: [m at: #y] value: [m at: #glyph] value: C_RED];
    [acc add: [pair value: [m at: #x] value: [m at: #y]]]]];
  let px := [[player value] at: #x];
  let py := [[player value] at: #y];
  [putCell value: px value: py value: 64 value: C_YELLOW];
  [dirty set: [d2 add: [pair value: px value: py]]]];

let draw := [|
  [[[depth value] = [lastDepth value]]
    ifTrue:  [| [restoreDirty value]]
    ifFalse: [| [drawFullMap value]; [lastDepth set: [depth value]]]];
  [drawEntities value];
  [drawHud value];
  [tb present]];

// ---- input → action -----------------------------------------------------
// Each key maps to one action; only the matching branch fires (keys are
// distinct), so a flat list of guarded sends is fine.
let act := [:ch :key |
  // cardinal movement (vi + arrows)
  [[[ch = 104] | [key = K_LEFT]]  ifTrue: [| [playerStep value: -1 value: 0]] ifFalse: [| nil]];
  [[[ch = 108] | [key = K_RIGHT]] ifTrue: [| [playerStep value: 1 value: 0]] ifFalse: [| nil]];
  [[[ch = 107] | [key = K_UP]]    ifTrue: [| [playerStep value: 0 value: -1]] ifFalse: [| nil]];
  [[[ch = 106] | [key = K_DOWN]]  ifTrue: [| [playerStep value: 0 value: 1]] ifFalse: [| nil]];
  // diagonals (vi: y u b n)
  [[ch = 121] ifTrue: [| [playerStep value: -1 value: -1]] ifFalse: [| nil]];
  [[ch = 117] ifTrue: [| [playerStep value: 1 value: -1]] ifFalse: [| nil]];
  [[ch = 98]  ifTrue: [| [playerStep value: -1 value: 1]] ifFalse: [| nil]];
  [[ch = 110] ifTrue: [| [playerStep value: 1 value: 1]] ifFalse: [| nil]];
  // commands
  [[ch = 62] ifTrue: [| [descend value]] ifFalse: [| nil]];   // >
  [[ch = 60] ifTrue: [| [ascend value]]  ifFalse: [| nil]];   // <
  [[ch = 101] ifTrue: [| [eat value]]   ifFalse: [| nil]];    // e
  [[ch = 113] ifTrue: [| [quaff value]] ifFalse: [| nil]];    // q
  [[ch = 122] ifTrue: [| [zap value]]   ifFalse: [| nil]];    // z
  [[ch = 46] ifTrue: [| [endTurn value]] ifFalse: [| nil]];   // . wait
  // quit
  [[[ch = 81] | [key = K_ESC]] ifTrue: [| [mode set: #quit]] ifFalse: [| nil]]];

// ---- screens ------------------------------------------------------------
let titleScreen := [|
  [tb clear];
  [putStr value: 4 value: 1 value: C_YELLOW value: "L O G U E"];
  [putStr value: 4 value: 2 value: C_WHITE  value: "the Dungeon of Birnam — retrieve the Star from level 5 and escape"];
  [putStr value: 4 value: 4 value: C_WHITE  value: "Choose your class:"];
  [putStr value: 6 value: 6 value: C_GREEN  value: "1)  Fighter  — hp 30, sword + chainmail. Tough; hits hard."];
  [putStr value: 6 value: 7 value: C_GREEN  value: "2)  Rogue    — hp 22, dagger + leather. Crits; starts richer."];
  [putStr value: 6 value: 8 value: C_GREEN  value: "3)  Wizard   — hp 18, staff + robe. Frail; 'z' zaps for big damage."];
  [putStr value: 4 value: 10 value: C_WHITE value: "Press 1, 2 or 3   (Esc to quit)"];
  [tb present]];

let endScreen := [|
  let m := [mode value];
  let txt := [[symEq value: m value: #won]
    ifTrue:  [| "YOU ESCAPED WITH THE STAR OF BIRNAM. Victory!"]
    ifFalse: [| [[symEq value: m value: #dead] ifTrue: [| "You have died in the dungeon."] ifFalse: [| "You abandon the dungeon."]]]];
  [putStr value: 0 value: [MAP_H + 7] value: C_MAGENTA value: txt];
  [putStr value: 0 value: [MAP_H + 8] value: C_WHITE value: "Press any key to leave."];
  [tb present]];

// ---- main ---------------------------------------------------------------
[tb init];
[tb hideCursor];

// class select
let chosen := [newCell value: #none];
[titleScreen value];
[whileDo value: [| [symEq value: [chosen value] value: #none]] value: [|
  [tb poll];
  let c := [tb evCh];
  let k := [tb evKey];
  [[c = 49] ifTrue: [| [chosen set: #fighter]] ifFalse: [| nil]];
  [[c = 50] ifTrue: [| [chosen set: #rogue]]   ifFalse: [| nil]];
  [[c = 51] ifTrue: [| [chosen set: #wizard]]  ifFalse: [| nil]];
  [[k = K_ESC] ifTrue: [| [chosen set: #quit]] ifFalse: [| nil]]]];

[[symEq value: [chosen value] value: #quit]
  ifTrue:  [| [tb shutdown]]
  ifFalse: [|
    [newGame value: [chosen value]];
    // play loop
    [whileDo value: [| [symEq value: [mode value] value: #play]] value: [|
      [draw value];
      [tb poll];
      let ch := [tb evCh];
      let key := [tb evKey];
      [act value: ch value: key];
      // Periodically drop the temporal history of all the per-turn cell writes
      // (player/monsters/items/turn/dirty/...). `retainCurrent` sets the
      // retention floor to "now"; it bounds reclaimable history rather than
      // compacting in place (no birnam-exposed compaction yet). NB: measured,
      // runtime growth is small (~130 KB/turn) — the dominant memory cost is
      // loading the program itself (code reified as facts), not play.
      [[[[turn value] mod: 50] = 0] ifTrue: [| [db retainCurrent]] ifFalse: [| nil]]]];
    // final frame + end screen
    [draw value];
    [endScreen value];
    [tb poll];
    [tb shutdown]]]
