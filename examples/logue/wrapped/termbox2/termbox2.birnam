// termbox2 — terminal cell grid + keyboard events, wrapped for birnam via Alien.
//
// First-party wrapped C library. All calls go through a thin int-clean C adapter
// (`lg_*`, see termbox2.c), so every signature here is int->int, (ints…)->int, or
// (ints…, cstring)->int — no struct peeks, no uint64 attr-width marshalling.
//
// BUILD the dylib first (single-header lib; TB_IMPL is instantiated in termbox2.c):
//
//   cd examples/logue/wrapped/termbox2 && ./build.sh   # -> libtermbox2.dylib
//
// LOAD it before the renderer. logue.birnam pulls it in with `[System load: …]`
// (run from examples/logue, so the relative dylib path below resolves):
//
//   [System load: "wrapped/termbox2/termbox2.birnam"];
//
// The wraps declared here resolve at commit, so `tb` is only callable in a LATER
// unit — which is exactly how the renderer uses it (System load is one commit,
// the renderer body another).

// Make the library's symbols resolvable by `wrap:` below. Path is relative to the
// cwd the renderer runs from (examples/logue).
[Alien dlopen: "wrapped/termbox2/libtermbox2.dylib"];

// The module: a private singleton to hang the wrapped methods on. `on: tb` gives
// `tb` its own copy-on-write vtable, so these methods are private to it (they do
// not leak onto Object). System load persists this top-level `let` into the
// shared scope, so the renderer can send `tb` messages.
let tb := [Object clone];

// -- lifecycle / screen ---------------------------------------------------
// No C arguments, so the receiver is unused: signature is just the return type.
[Alien wrap: "lg_init"        signature: "i" as: #init       on: tb];   // 0 on success
[Alien wrap: "lg_shutdown"    signature: "i" as: #shutdown   on: tb];
[Alien wrap: "lg_width"       signature: "i" as: #width      on: tb];   // columns
[Alien wrap: "lg_height"      signature: "i" as: #height     on: tb];   // rows
[Alien wrap: "lg_clear"       signature: "i" as: #clear      on: tb];   // clear back buffer
[Alien wrap: "lg_present"     signature: "i" as: #present    on: tb];   // flush to screen
[Alien wrap: "lg_hide_cursor" signature: "i" as: #hideCursor on: tb];

// -- drawing --------------------------------------------------------------
// These take arguments, so Alien marshals the receiver as the first C arg. The
// adapter's leading `void* self` is a dummy that absorbs `tb`; the real values
// follow (see the receiver-idiom note in termbox2.c). Hence the `p` after the
// return type in each signature.
// [tb setX: c y: r ch: codepoint fg: fgColor bg: bgColor]
[Alien wrap: "lg_set_cell" signature: "i p i i i i i" as: #setX:y:ch:fg:bg: on: tb];
// [tb printX: c y: r fg: fgColor bg: bgColor str: "text"]
[Alien wrap: "lg_print"    signature: "i p i i i i s" as: #printX:y:fg:bg:str: on: tb];

// -- input ----------------------------------------------------------------
[Alien wrap: "lg_poll"    signature: "i" as: #poll   on: tb];   // BLOCKS; returns event type
[Alien wrap: "lg_ev_type" signature: "i" as: #evType on: tb];   // TB_EVENT_*
[Alien wrap: "lg_ev_key"  signature: "i" as: #evKey  on: tb];   // TB_KEY_* (0 if a char)
[Alien wrap: "lg_ev_ch"   signature: "i" as: #evCh   on: tb]    // codepoint (0 if special)
