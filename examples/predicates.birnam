// Predicate clauses — datalog queries with inline comparison filters.
//
//   birnam examples/predicates.birnam
//
// A `where:` clause is normally a triple pattern `#[e a v]` that binds logic
// variables (a leading `?`). A clause whose MIDDLE position is a comparison-op
// symbol is instead a PREDICATE: it filters the rows bound so far and binds
// nothing. Both spellings work — named (`#lt #le #gt #ge #eq #ne`) and the glyphs
// (`#< #<= #> #>= #= #~=`). A predicate must come AFTER the clauses that bind its
// variables (there is no clause-reorder planner yet), so `#[?a #gt 18]` reads the
// `?a` bound by the preceding `#[?p #age ?a]`.

// Each person is an entity carrying one `:age` fact.
let person := [:age |
  let p := [db entity];
  [db assert: p attr: #age value: age];
  p];

let p1 := [person value: 18];
let p2 := [person value: 30];
let p3 := [person value: 40];

// Everyone older than 18 — a named predicate op.
let adults := [db findAll: ?p where: #[ #[?p #age ?a] #[?a #gt 18] ]];
[System println: ["adults (age > 18): " , [[adults size] printString]]];

// The ages that are 30 or more — a glyph predicate op, projecting the value var.
let grownAges := [db findAll: ?a where: #[ #[?p #age ?a] #[?a #>= 30] ]];
[System println: ["ages >= 30: " , [grownAges printString]]];

// Equality and its (predicate) negation.
let notThirty := [db findAll: ?a where: #[ #[?p #age ?a] #[?a #ne 30] ]];
[System println: ["ages /= 30: " , [notThirty printString]]];

// Clause NEGATION (negation as failure): a `#not`-led clause keeps a solution
// only when its inner pattern has NO match under the bound variables. Here:
// everyone who does NOT have an age of exactly 40 — i.e. all but the eldest.
let notForty := [db findAll: ?a where: #[ #[?p #age ?a] #[#not #[?a #eq 40]] ]];
[System println: ["ages (not 40): " , [notForty printString]]];

// Clause DISJUNCTION: a `#or`-led clause unions its branches. Here: ages that are
// either below 20 or above 35 — the two extremes.
let extremes := [db findAll: ?a where: #[ #[?p #age ?a] #[#or #[?a #lt 20] #[?a #gt 35]] ]];
[System println: ["ages (<20 or >35): " , [extremes printString]]];

// AGGREGATES fold the distinct bindings: count / sum / min / max / avg.
let n     := [db count: ?p where: #[ #[?p #age ?a] ]];
let total := [db sum:   ?a where: #[ #[?p #age ?a] ]];
let oldest := [db max:  ?a where: #[ #[?p #age ?a] ]];
let mean  := [db avg:   ?a where: #[ #[?p #age ?a] ]];
[System println: ["people: " , [n printString]]];
[System println: ["age sum: " , [total printString]]];
[System println: ["oldest: " , [oldest printString]]];
[System println: ["mean age: " , [mean printString]]];

// GROUP-BY: bucket by a variable, aggregate within each group. Tag people with a
// team, then count members per team → a Map {team -> count}.
[db assert: p1 attr: #team value: #red];
[db assert: p2 attr: #team value: #red];
[db assert: p3 attr: #team value: #blue];
let perTeam := [db groupBy: ?t aggregate: #count of: ?p where: #[ #[?p #team ?t] ]];
[System println: ["per team: " , [perTeam printString]]]
