// Bank ledger — a balance cell with time-travel over the fact store.
//
//   birnam examples/bank-ledger.birnam
//
// The balance lives at (#account, #balance) in `db`. We opt that ATTRIBUTE into
// history so every prior value is retained (the store default is history-off —
// the 4 GB lesson), then a cell is just a handle onto that (entity, attribute).
// `[db basis]` captures a point in time; `[db valueOf:attr:asOf:]` rewinds the
// balance to it, and `[cell history]` reports how many values it has held.
//
// `deposit`/`withdraw` are named blocks taking the amount as a parameter —
// applied transactions, not buried expressions. Time-travel for free: the
// ledger is just the balance attribute's past.

// Opt the balance attribute into history before its first value is written.
[Module load: #store];

[db assert: #balance attr: #history value: true];

let acct := [db cellFor: #account attr: #balance];
[acct set: 0];
let t0 := [db basis];              // snapshot: the moment before any transaction

let deposit  := [:amt | [acct set: [[acct value] + amt]]];
let withdraw := [:amt | [acct set: [[acct value] - amt]]];

[deposit  value: 100];
[deposit  value: 50];
[withdraw value: 30];

[System println: ["balance now:  " , [[acct value] printString]]];
[System println: ["at start:     " , [[db valueOf: #account attr: #balance asOf: t0] printString]]];
[System println: ["values held:  " , [[acct history] printString]]]
