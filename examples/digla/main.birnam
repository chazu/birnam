// Digla's runnable entrypoint. The default remains a headless configuration
// report so project checks and scripts are safe. This is the headless image
// root: use `--session-stdio` for a child-process protocol or
// `--session-listen` for a loopback TCP session server. The Termbox client is a
// separate `examples/digla-client` project and never enters this image.

let args := [Globals at: #ProjectArgs];
let config := [Digla configForArgs: args];
[[config isError]
  ifTrue: [| [System println: [config printString]]]
  ifFalse: [|
    let sessionStdio := [args includes: "--session-stdio"];
    let sessionListen := [args includes: "--session-listen"];
    let sessionListenOnce := [args includes: "--session-listen-once"];
    let allowRemote := [args includes: "--allow-remote"];
    let sessionTcp := [sessionListen | sessionListenOnce];
    [sessionStdio
      ifTrue: [| [Digla serveSessionStdio: [Digla localSessionFor: config]]]
      ifFalse: [|
        [sessionTcp
          ifTrue: [|
            let endpoint := [[config at: "bind"] , ":" , [[config at: "port"] printString]];
            [System println: ["Digla framed session listening on " , endpoint]];
            let result := [sessionListenOnce
              ifTrue: [| [Digla serveOneSessionTcpWith: config allowRemote: allowRemote]]
              ifFalse: [| [Digla serveSessionTcpWith: config allowRemote: allowRemote]]];
            [[result isError]
              ifTrue: [| [System println: [result printString]]]
              ifFalse: [| result]]]
          ifFalse: [|
            [System println: [Digla summary: config]]]]]]]];
