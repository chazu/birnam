digraph startup {
  graph [rankdir=TB, bgcolor="#FFFFFF", pad="0.45", nodesep="0.45", ranksep="0.42", splines=polyline,
    fontname="Helvetica", fontsize=28, fontcolor="#152C43", labelloc=t, labeljust=l,
    label="How Birnam loads itself\lCurrent production startup · through 81CA\l"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", color="#A8BDD5", fillcolor="#EDF3FC", fontcolor="#19334C", penwidth=1.2, margin="0.20,0.14"];
  edge [color="#4C6883", penwidth=1.6, arrowsize=0.7, fontname="Helvetica", fontsize=11, fontcolor="#4C6883"];
  siphon [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" WIDTH="385"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="18"><B>01  Siphon / startup host</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">bin/birnam · Rust host</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Find the selected Id library and runtime library directory.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Default: &lt;prefix&gt;/lib (executable-relative).</FONT></TD></TR></TABLE>>, fillcolor="#EDF3FC", color="#A8BDD5"];
  prepare [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" WIDTH="385"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="18"><B>02  Open Id and prepare dependencies</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Platform dlopen / dlsym → libbirnam_id.dylib</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Attach explicit native factories before calling id_init.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Validate contracts and retain the loaded libraries.</FONT></TD></TR></TABLE>>, fillcolor="#EDF3FC", color="#A8BDD5"];
  deps [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" WIDTH="440"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15"><B>Prepared native services</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Namespace; Object Model enumeration, epoch and key index</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Method Observation; Root Registry; GC Settings</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Payload Layout; Trace Hooks; Finalizers</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Native Stack; Native Mark; Allocation Budget</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Collect phase state; Storage observation and identities</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Storage deferred index; Dispatch Cache and Guard Verdicts</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Preparation ≠ ordinary module initialization.</FONT></TD></TR></TABLE>>, fillcolor="#EDF3FC", color="#A8BDD5"];
  id [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" WIDTH="385"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="18"><B>03  Initialize the Id foundation</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">id_init() → IdApi v20</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Construct the object/vtable universe, symbols and heap;</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">establish execution objects and native runtime state.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">The primordial foundation is still implemented in Rust.</FONT></TD></TR></TABLE>>, fillcolor="#EDF3FC", color="#A8BDD5"];
  native [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" WIDTH="385"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="18"><B>04  Initialize 52 native module rungs</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Open through the selected IdApi and call module_init.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">IdApi + prior state + 10 capabilities (12 arguments).</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Install native objects, methods and runtime services.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Keep successful library handles pinned for process lifetime.</FONT></TD></TR></TABLE>>, fillcolor="#EDF3FC", color="#A8BDD5"];
  rungs [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" WIDTH="440"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15"><B>Native stack · Rust, with C/libtcc support</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Exact SCRIPT_MODULES initialization order, left to right:</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">namespace → storage → trace → collect</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">error_value → integer → float → word</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">object_model → method_observation → root_registry → gc_settings</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">payload_layout → trace_hooks → finalizers → native_stack</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">native_mark → allocation_budget → dispatch_cache → id_artifact</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">store → id_peg → id_lang → id_tcc</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">id_codegen → boolean → printing → system_gc</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">text_view → system_output → system_input → environment</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">file_io → block_loop → native_loader → source_loader</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">id_prelude → nil → string → string_builder</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">collection_value → vector → range → map</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">string_collection → id_collection → id_error → portable_code</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">id_isolate → id_relational → id_alien → id_image</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Names are file stems: libbirnam_&lt;name&gt;.dylib.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Some construction providers are prepared early;</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">their ordinary module_init still follows this order.</FONT></TD></TR></TABLE>>, fillcolor="#EDF3FC", color="#A8BDD5"];
  connect [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" WIDTH="385"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="18"><B>05  Connect the loaded runtime</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Wire runtime services and resolve isolate hooks.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Store backfillMirror records the existing object graph.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Obtain the canonical Codegen object for module loading.</FONT></TD></TR></TABLE>>, fillcolor="#EDF3FC", color="#A8BDD5"];
  manager [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" WIDTH="385"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="18"><B>06  Load the Birnam module manager</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">modules → Module</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Register native kernel names and library directory;</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">ask Module for the authored modules’ dependency order.</FONT></TD></TR></TABLE>>, fillcolor="#E8F5EE", color="#9AC9AE"];
  selection [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" WIDTH="440"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15"><B>How authored bootstrap modules load</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">PREFER COMPILED</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">libbirnam_&lt;name&gt;.dylib → Codegen load:</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">If absent/rejected, or BIRNAM_FORCE_SOURCE is set:</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">embedded Birnam source → record source → Codegen eval:</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">stacklessControl uses loadInitialModule: instead.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Its fallback compiles a temporary resumable dylib,</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">then loads it; it is not evaluated synchronously.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Both routes use the loaded Rust compiler/runtime.</FONT></TD></TR></TABLE>>, fillcolor="#F5FAF7", color="#9AC9AE"];
  bootstrap [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" WIDTH="385"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="18"><B>07  Load the Birnam bootstrap layer</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">stdlib → compiledUnit → toml → config → appConfig</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">→ isolate → stacklessControl</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Install derived libraries, configuration and concurrency policy.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">stacklessControl installs resumable control methods last.</FONT></TD></TR></TABLE>>, fillcolor="#E8F5EE", color="#9AC9AE"];
  ready [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" WIDTH="385"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="18"><B>08  Establish the execution boundary</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">start() returns the assembled runtime.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">prepare_execution sets the host’s live native GC stack anchor.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Dispatch the requested command.</FONT></TD></TR></TABLE>>, fillcolor="#F0F3F6", color="#B6C2CC"];
  program [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" WIDTH="385"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15"><B>Source / compiled program / tools</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Run the selected program, CLI or REPL.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Module loads additional Birnam modules and dependencies</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">on demand through Codegen; projectPolicy is lazy.</FONT></TD></TR></TABLE>>, fillcolor="#E8F5EE", color="#9AC9AE"];
  image [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" WIDTH="440"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15"><B>Saved image / baked program / worker</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Restore image state after the native stack and bootstrap.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Map stored compiled code or rebuild it;</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">reconnect recovered code and process-local services,</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">then run image main or enter the worker driver.</FONT></TD></TR></TABLE>>, fillcolor="#FFF3DB", color="#DCC080"];
  legend [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" WIDTH="440"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15"><B>Reading this diagram</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Blue: Rust-authored native implementation</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Green: Birnam-authored modules (often compiled to dylibs)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Amber: image recovery on the already loaded runtime</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Installed inventory: 53 native + 28 compiled Birnam libraries.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">8 authored modules form the ordinary bootstrap.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Compile-only / BIRNAM_NO_STDLIB skips that bootstrap.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">The current Siphon remains a Rust host; native loading</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">has been modularized, but the runtime is not yet Birnam.</FONT></TD></TR></TABLE>>, fillcolor="#FAFBFD", color="#D2DAE2"];

  siphon -> prepare -> id -> native -> connect -> manager -> bootstrap -> ready;
  prepare -> deps [style=dashed, arrowhead=none, constraint=false];
  native -> rungs [style=dashed, arrowhead=none, constraint=false];
  manager -> selection [style=dashed, arrowhead=none, constraint=false];
  ready -> program;
  ready -> image;
  {rank=same; prepare; deps;}
  {rank=same; native; rungs;}
  {rank=same; manager; selection;}
  {rank=same; bootstrap; legend;}
  {rank=same; program; image;}
  deps -> rungs -> selection -> legend [style=invis, weight=4];
}
