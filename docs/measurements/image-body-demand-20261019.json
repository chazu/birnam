  "driver": "import subprocess,time,resource,statistics,json,sys,re,hashlib\nfrom pathlib import Path\nsys.path.insert(0,str(Path.cwd()/'scripts'))\nfrom validation_support import clean_environment\nw=Path('/tmp/birnam-demand-bodies-20261019');old=Path('/tmp/birnam-runtime-audit-20261019')\nprefixes={'eager':old/'final-prefix','demand':w/'prefix'}\nenv=clean_environment();env['BIRNAM_GC_PRECISE']='1';rows=[]\ndef run(n,script):\n before=resource.getrusage(resource.RUSAGE_CHILDREN);start=time.perf_counter()\n p=subprocess.run(['/usr/bin/time','-l',prefixes[n]/'bin/birnam',script],env=env,capture_output=True,text=True,timeout=60)\n wall=time.perf_counter()-start;after=resource.getrusage(resource.RUSAGE_CHILDREN)\n assert p.returncode==0 and p.stdout=='ready\\n',(n,p)\n rss=re.search(r'(\\d+)\\s+maximum resident set size',p.stderr);assert rss,p.stderr\n footprint=re.search(r'(\\d+)\\s+peak memory footprint',p.stderr)\n assert not ('birnam:' in p.stderr or 'Error' in p.stderr),p.stderr\n return dict(wall_seconds=wall,cpu_seconds=after.ru_utime+after.ru_stime-before.ru_utime-before.ru_stime,max_rss_bytes=int(rss[1]),peak_footprint_bytes=int(footprint[1]) if footprint else None)\nfor mode,script in [('startup_script',old/'ready.birnam'),('saved_image',old/'no-temp.image')]:\n for n in prefixes:run(n,script)\n for i in range(5):\n  for n in (list(prefixes) if i%2==0 else list(reversed(prefixes))):\n   rows.append(dict(mode=mode,variant=n,repeat=i,**run(n,script)))\n  (w/'comparison.json').write_text(json.dumps({'rows':rows},indent=2)+'\\n');print(mode,i+1,flush=True)\nkeys=['wall_seconds','cpu_seconds','max_rss_bytes','peak_footprint_bytes']\nmedians={m:{n:{k:statistics.median(r[k] for r in rows if r['variant']==n and r['mode']==m and r[k] is not None) for k in keys} for n in prefixes} for m in ['startup_script','saved_image']}\n(w/'comparison.json').write_text(json.dumps({'rows':rows,'medians':medians,'scope':'Five interleaved fresh processes after warmups; precise GC, warm filesystem, identical preexisting images/artifacts, only Codegen runtime binary replaced; macOS time -l memory measurements are bytes. No diagnostic omissions.'},indent=2)+'\\n')\nprint(json.dumps(medians,indent=2),flush=True)\n",
