  "probe_source": "[Module load: #json]; [Module load: #markdown]; [Module load: #alienCompiler]; [Module load: #time]; [Module load: #os];\nlet measure := [:label :operation :expected |\n  // Warm and validate before either count. Nothing returned by operation is kept.\n  let warm := [operation value];\n  [[warm = expected] ifFalse: [| [System printErrorText: \"bad warm result\\n\"]; [OS exit: 2]]];\n  [System gc];\n  let before := [db retainedFactCount];\n  let objects := [System liveObjects];\n  let cpu := [16 clockNanos];\n  [1 to: 50 do: [:i |\n    [[[operation value] = expected] ifFalse: [| [System printErrorText: \"bad result\\n\"]; [OS exit: 2]]]\n  ]];\n  let used := [[16 clockNanos] - cpu];\n  [System gc];\n  let after := [db retainedFactCount];\n  let retained := [System liveObjects];\n  [db compact]; [System gc];\n  [System println: [Json stringify: {\"case\" -> label \"calls\" -> 50 \"facts_before\" -> before \"facts_after_gc\" -> after\n    \"facts_after_compact_gc\" -> [db retainedFactCount] \"object_delta\" -> [retained - objects] \"cpu_ns\" -> used}]]\n];\n[measure value: \"control\" value: [| 7] value: 7];\n[measure value: \"local-cell\" value: [| [[db localCell: 7] value]] value: 7];\n[measure value: \"asCell\" value: [| [[7 asCell] value]] value: 7];\n[measure value: \"markdown\" value: [| [Markdown toHtml: \"hello\"]] value: \"<p>hello</p>\"];\n[measure value: \"alien-signature-parser\" value: [| [AlienCompiler parse: \"i i\"]] value: #[#[#scalar \"i\"] #[#[#scalar \"i\"]] #[]]];\n[System println: \"done\"]\n",
  "qualification": "Two fresh processes. Warm each operation once, verify all 50 returned results, discard per-call results, run GC before/after and then compact global db and collect again. Facts belong to global db. Object delta is process-wide after GC, includes three objects of common measurement overhead, and is not a byte metric. CPU is incidental; this is a retention witness, not an optimization A/B benchmark. Other consumers are source-audited only. No runtime/module edits.",
