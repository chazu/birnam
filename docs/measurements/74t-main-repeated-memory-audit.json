  "scope": "Current verified main baseline, normal published release floor. All coordinate/order/source/artifact bindings, generated phase inputs, result/identity-check completion markers and EOF exits revalidated. Rounded vmmap whole-process footprints, not exact optimizer storage, activation evidence or leak freedom. Released drops sampler-owned references; source factories and independent compiler/runtime roots may remain. Concurrent host work and paging can affect observations.",
  "audit_source": "\"\"\"Audit all repeated normal-floor memory coordinates and retain paired ranges.\"\"\"\nimport hashlib\nimport importlib.util\nimport itertools\nimport json\nfrom pathlib import Path\nimport re\nimport statistics\nimport sys\n\nROOT = Path('/tmp/birnam-74t-verification-support')\nINPUT = ROOT / 'docs/measurements/74t-main-repeated-memory.json'\nOUTPUT = ROOT / 'docs/measurements/74t-main-repeated-memory-audit.json'\nPROOF = ROOT / 'docs/measurements/74t-verification-support-production.json'\nsha = lambda path: hashlib.sha256(Path(path).read_bytes()).hexdigest()\nsys.path.insert(0, str(ROOT / 'scripts'))\nspec = importlib.util.spec_from_file_location('memory_sampler', ROOT / 'scripts/recovery-memory.py')\nsampler = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(sampler)\n\n\ndef mib(text):\n    match = re.fullmatch(r'(\\d+(?:\\.\\d+)?)([BKMG])', text)\n    assert match, text\n    return float(match[1]) * {'B': 1 / 1048576, 'K': 1 / 1024, 'M': 1, 'G': 1024}[match[2]]\n\n\ndef spread(values):\n    return dict(minimum=round(min(values), 4), median=round(statistics.median(values), 4), maximum=round(max(values), 4), samples=values)\n\n\nd = json.loads(INPUT.read_text())\nproof = json.loads(PROOF.read_text())\nassert d['status'] == 'passed' and d['qualified'] is False and d['pairs'] == 3\nassert proof['status'] == proof['production_verification'] == 'passed'\nassert len(proof['commands']) == 75 and all(c['exit_code'] == 0 for c in proof['commands'])\nassert len(proof['sources']) == 288\nassert sha(PROOF) == d['correctness_sha256']\nassert all(sha(ROOT / n) == h for n, h in proof['sources'].items())\nassert all(sha(ROOT / n) == h for n, h in d['sources'].items())\nprefix = Path(d['prefix'])\nassert all(sha(prefix / n) == h for n, h in d['installed_sha256'].items())\nmanifest = json.loads((prefix / 'share/birnam/rust-install.json').read_text())\nassert manifest['profile'] == 'release' and manifest['publication']['state'] == 'published'\nassert d['installed_sha256'] == dict(manifest['staged_manifest'], **{'share/birnam/rust-install.json': sha(prefix / 'share/birnam/rust-install.json')})\nexpected_sources = dict(proof['sources'])\nexpected_sources['scripts/recovery-memory.py'] = sha(ROOT / 'scripts/recovery-memory.py')\nexpected_sources.update({n.removeprefix('share/birnam/src/'): h for n, h in manifest['staged_manifest'].items() if n.startswith('share/birnam/src/')})\nassert d['sources'] == expected_sources\nexpected = list(itertools.product(range(3), sampler.SWITCHES, (False, True), (False, True)))\nby_coordinate = {}\nfor row in d['rows']:\n    key = row['pair'], row['family'], row['refused'], row['enabled']\n    assert key not in by_coordinate and row['exit_code'] == 0\n    _, steps = sampler.phases(row['family'], row['refused'])\n    assert row['fixture_sha256'] == hashlib.sha256(''.join(code for _, code in steps).encode()).hexdigest()\n    enabled = row['enabled']\n    switches = {sampler.SWITCHES[row['family']]: '1'} if enabled else ({sampler.SWITCHES[row['family']]: '0'} if row['family'] in sampler.DEFAULT_ON else {})\n    assert row['switch_values'] == switches\n    assert len(row['phases']) == 7\n    for phase, (name, code) in zip(row['phases'], steps):\n        assert phase['name'] == name and phase['input'] == code\n        assert phase['summary'] == sampler.memory_summary(phase['vmmap'])\n        assert phase['output'].endswith('birnam> ')\n        assert any(line.removeprefix('birnam> ') == 'memory-checkpoint ' + name for line in phase['output'].splitlines())\n        assert 'EvaluationRejected' not in phase['output'] and 'error(' not in phase['output']\n    by_coordinate[key] = {p['name']: mib(p['summary']['Physical footprint']) for p in row['phases']}\nassert len(d['rows']) == 60 and set(by_coordinate) == set(expected)\nassert [(r['pair'], r['family'], r['refused'], r['enabled']) for r in d['rows']] == [\n    (pair, family, refused, enabled) for pair in range(3) for family in sampler.SWITCHES\n    for refused in (False, True) for enabled in ((False, True) if pair % 2 == 0 else (True, False))]\nsummaries = []\nfor family in sampler.SWITCHES:\n    for refused in (False, True):\n        comparisons = {phase: spread([round(by_coordinate[pair, family, refused, True][phase] - by_coordinate[pair, family, refused, False][phase], 4) for pair in range(3)]) for phase in ('cold', 'steady-2', 'evicted-live', 'released')}\n        adjusted = {phase: spread([round((by_coordinate[pair, family, refused, True][phase] - by_coordinate[pair, family, refused, True]['setup']) - (by_coordinate[pair, family, refused, False][phase] - by_coordinate[pair, family, refused, False]['setup']), 4) for pair in range(3)]) for phase in ('cold', 'steady-2', 'evicted-live', 'released')}\n        within = {str(enabled): {label: spread([round(by_coordinate[pair, family, refused, enabled][end] - by_coordinate[pair, family, refused, enabled][start], 4) for pair in range(3)]) for label, start, end in [('steady_growth', 'steady-1', 'steady-2'), ('release_from_setup', 'setup', 'released')]} for enabled in (False, True)}\n        summaries.append(dict(family=family, refused=refused, enabled_minus_disabled_mib=comparisons, setup_adjusted_enabled_minus_disabled_mib=adjusted, within_process_mib=within))\nassert not OUTPUT.exists(), 'preserve prior audit'\nout = dict(status='passed', qualified=False, receipt_sha256=sha(INPUT), production_proof_sha256=sha(PROOF), processes=60, checkpoints=420, checked_calls=30720, pairs=3, summaries=summaries,\n           scope='Current verified main baseline, normal published release floor. All coordinate/order/source/artifact bindings, generated phase inputs, result/identity-check completion markers and EOF exits revalidated. Rounded vmmap whole-process footprints, not exact optimizer storage, activation evidence or leak freedom. Released drops sampler-owned references; source factories and independent compiler/runtime roots may remain. Concurrent host work and paging can affect observations.', audit_source=Path(__file__).read_text())\nOUTPUT.write_text(json.dumps(out, indent=2) + '\\n')\nprint('Audited 60 processes, 420 checkpoints, 30720 checked calls; all observations unqualified')\nfor item in summaries:\n    print(item['family'], 'refused=' + str(item['refused']), 'steady enabled-minus-disabled MiB', item['enabled_minus_disabled_mib']['steady-2'])\n"
}
