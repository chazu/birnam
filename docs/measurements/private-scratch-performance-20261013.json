  "date": "2026-10-13",
  "driver_source": "import sys,json,subprocess,statistics,hashlib,platform\nfrom pathlib import Path\nsys.path.insert(0,'/Users/chazu/dev/zig/birnam/scripts')\nfrom validation_support import command,clean_environment,save_json,sha\nroot=Path('/Users/chazu/dev/zig/birnam');work=Path('/tmp/birnam-scratch-performance')\nprefixes={'before':Path('/Users/chazu/.local/opt/birnam'),'after':Path('/tmp/birnam-scratch-state/prefix')}\nreference=root/'.cargo-target/alien-reference/debug/birnam-alien-compiler-reference'\nline=subprocess.run([reference],input='73616d706c65\\t6c206c\\n',text=True,capture_output=True,check=True).stdout.strip()\nkind,encoded=line.split('\\t');assert kind=='ok';(work/'expected.c').write_bytes(bytes.fromhex(encoded))\n(work/'summary.rs').write_text('//! Retained public summary.\\n')\nmd='para\\n- one\\n- two\\n\\n```\\n<raw>\\n```'\ncases={\n 'markdown':(100,'[Markdown toHtml: '+json.dumps(md)+']',json.dumps('<p>para</p><ul><li>one</li><li>two</li></ul><pre><code>&lt;raw&gt;</code></pre>')),\n 'alien-parse':(100,'[AlienCompiler parse: \"i i\"]','#[#[#scalar \"i\"] #[#[#scalar \"i\"]] #[]]'),\n 'alien-compile':(20,'[AlienCompiler compile: \"sample\" signature: \"l l\"]','[System readFile: \"expected.c\"]'),\n 'nativedoc':(50,'[NativeDoc scanRust: \"summary.rs\" as: #scratchPerfSummary]; [db currentValue: #scratchPerfSummary attr: #docSummary]',json.dumps('Retained public summary.'))}\nbody='''[Module load: #json]; [Module load: #markdown]; [Module load: #nativedoc]; [Module load: #alienCompiler]; [Module load: #time]; [Module load: #os];\nlet measure := [:operation :expected :count |\n  [[[operation value] = expected] ifFalse: [| [System printErrorText: \"warm result mismatch\\\\n\"]; [OS exit: 1]]];\n  [System gc];\n  let before := [db retainedFactCount]; let objects := [System liveObjects];\n  let cpu := [16 clockNanos]; let wall := [6 clockNanos];\n  [1 to: count do: [:i |\n    [[[operation value] = expected] ifFalse: [| [System printErrorText: \"result mismatch\\\\n\"]; [OS exit: 1]]]\n  ]];\n  let elapsed := [[6 clockNanos] - wall]; let used := [[16 clockNanos] - cpu];\n  let gcStart := [16 clockNanos]; [System gc]; let gcUsed := [[16 clockNanos] - gcStart];\n  let retained := [System liveObjects]; let after := [db retainedFactCount];\n  [System println: [Json stringify: {\"calls\" -> count \"cpu_ns\" -> used \"wall_ns\" -> elapsed \"post_batch_gc_cpu_ns\" -> gcUsed\n    \"facts_before\" -> before \"facts_after\" -> after \"object_delta\" -> [retained - objects]}]]\n];\n'''\nresult={'schema':1,'platform':platform.platform(),'qualification':'Five fresh processes per variant/case; alternating variant order per repetition, sequential timing. Same warmed operation and checked result on every call. Normal automatic GC; startup/module loading and JSON output excluded. Post-batch explicit GC timed separately. Full rebuilt-prefix comparison, including its reduced startup fact inventory; not an isolated accessor benchmark. Counts are live-object/fact diagnostics, not bytes.','prefixes':{k:str(p) for k,p in prefixes.items()},'runtime_sha256':{k:{str(p.relative_to(prefix)):sha(p) for p in [prefix/'bin/birnam',*sorted((prefix/'lib').glob('*.dylib')),*sorted((prefix/'lib').glob('*.image'))]} for k,prefix in prefixes.items()},'driver_source':Path(__file__).read_text(),'script_body':body,'cases':{},'runs':[]}\nfor name,(count,operation,expected) in cases.items():\n script=work/(name+'.birnam');script.write_text(body+'[measure value: [| '+operation+'] value: '+expected+' value: '+str(count)+']\\n')\n result['cases'][name]={'calls':count,'script':script.read_text(),'script_sha256':sha(script)}\nfor sample in range(5):\n for name in cases:\n  for variant in (['before','after'] if sample%2==0 else ['after','before']):\n   run=command([prefixes[variant]/'bin/birnam',work/(name+'.birnam')],cwd=work,env=clean_environment(),timeout=120)\n   assert run['exit_code']==0 and not run['stderr'],run\n   row=json.loads(run['stdout']);row.update(case=name,variant=variant,sample=sample,process_wall_ns=run['wall_ns'])\n   result['runs'].append(row);save_json(work/'results.json',result)\n   print(name,variant,sample,round(row['cpu_ns']/1e6,2),'ms',row['facts_after']-row['facts_before'],'facts',flush=True)\nresult['summary']=[]\nfor name in cases:\n summary={'case':name}\n for variant in prefixes:\n  rows=[r for r in result['runs'] if r['case']==name and r['variant']==variant]\n  summary[variant]={key:[r[key] for r in rows] for key in ('cpu_ns','wall_ns','post_batch_gc_cpu_ns','object_delta')}\n  summary[variant]['fact_deltas']=[r['facts_after']-r['facts_before'] for r in rows]\n  summary[variant]['median_cpu_ns']=statistics.median(r['cpu_ns'] for r in rows)\n summary['cpu_reduction_percent']=100*(1-summary['after']['median_cpu_ns']/summary['before']['median_cpu_ns'])\n result['summary'].append(summary)\nsave_json(work/'results.json',result)\nprint(json.dumps(result['summary'],indent=2))\n",
