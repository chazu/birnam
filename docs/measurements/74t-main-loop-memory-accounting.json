  "findings": [
    "All three admitted loop pairs have identical rounded malloc allocated totals at setup, both steady checkpoints and release. Higher enabled footprint therefore does not correspond to a similarly sized malloc allocated-total difference in these samples.",
    "Allocator fragmentation, dirty and swapped totals differ between processes. These retained reports support allocator/page accounting as an explanation for the footprint difference, without isolating its cause.",
    "The shorter verified diagnostic control uses equal private unit counts, relocated bytes and logical allocation charge, with a 400-byte enabled loop cache. It is a different run and duration; its counters do not prove ownership stability throughout the long normal-floor sampler."
  ],
  "scope": "Read-only analysis of retained whole-process reports and existing exact-source diagnostic controls. Rounded allocator totals are not Birnam object sizes; no exact total optimizer accounting, activation assertion for the normal sampler, leak-freedom proof or timing claim.",
  "audit_source": "\"\"\"Separate malloc accounting from loop process footprint using retained reports.\"\"\"\nimport hashlib\nimport json\nfrom pathlib import Path\nimport re\nimport sys\n\nROOT = Path('/tmp/birnam-74t-verification-support')\nsys.path.insert(0, str(ROOT / 'scripts'))\nfrom loop_timing_common import check_pair\n\nsha = lambda path: hashlib.sha256(Path(path).read_bytes()).hexdigest()\nreceipt = ROOT / 'docs/measurements/74t-main-repeated-memory.json'\naudit = receipt.with_name('74t-main-repeated-memory-audit.json')\nproof = ROOT / 'docs/measurements/74t-verification-support-production.json'\noutput = receipt.with_name('74t-main-loop-memory-accounting.json')\nd, a, p = [json.loads(path.read_text()) for path in (receipt, audit, proof)]\nassert d['status'] == a['status'] == p['status'] == p['production_verification'] == 'passed'\nassert sha(receipt) == a['receipt_sha256'] and sha(proof) == a['production_proof_sha256']\nassert all(sha(ROOT / name) == digest for name, digest in d['sources'].items())\nassert all(sha(Path(d['prefix']) / name) == digest for name, digest in d['installed_sha256'].items())\nrows = []\nfor row in d['rows']:\n    if row['family'] != 'loop' or row['refused']:\n        continue\n    phases = []\n    for phase in row['phases']:\n        # Anchor the actual allocator table, not earlier 'see MALLOC ZONE' notes.\n        header = re.search(r'^MALLOC ZONE\\s+SIZE.*$', phase['vmmap'], re.M)\n        assert header and 'ALLOCATED' in header[0] and 'FRAG SIZE' in header[0]\n        totals = [line.split() for line in phase['vmmap'][header.end():].splitlines() if line.startswith('TOTAL ')]\n        assert len(totals) == 1 and len(totals[0]) == 10\n        fields = totals[0]\n        phases.append(dict(name=phase['name'], footprint=phase['summary']['Physical footprint'],\n                           allocator_virtual=fields[1], allocator_resident=fields[2],\n                           allocator_dirty=fields[3], allocator_swapped=fields[4],\n                           allocations=int(fields[5]), allocated=fields[6],\n                           fragmentation=fields[7], fragmentation_percent=fields[8], regions=int(fields[9])))\n    rows.append(dict(pair=row['pair'], enabled=row['enabled'], phases=phases))\nassert len(rows) == 6 and {(r['pair'], r['enabled']) for r in rows} == {(pair, enabled) for pair in range(3) for enabled in (False, True)}\nfor pair in range(3):\n    matched = [next(r for r in rows if r['pair'] == pair and r['enabled'] == enabled) for enabled in (False, True)]\n    for phase in ('setup', 'steady-1', 'steady-2', 'released'):\n        amounts = [next(p['allocated'] for p in r['phases'] if p['name'] == phase) for r in matched]\n        assert amounts[0] == amounts[1], (pair, phase, amounts)\nmatrix = p['unboxed_source_matrices']['loop-measure-release.json']\ncontrols = [r for r in matrix['rows'] if r['operations'] == 16 and r['precise'] == 1 and r['shape'] in (0, 3) and r['unboxed'] == 0]\nassert len(controls) == 4\nfor shape in (0, 3):\n    off, on = [next(r for r in controls if r['shape'] == shape and r['enabled'] == enabled) for enabled in (0, 1)]\n    check_pair(off, on, matrix['batches'], False)\n    for key in ('private_native_units', 'private_relocated_bytes', 'allocation_bytes'):\n        assert off['measure'][key] == on['measure'][key]\n    assert off['measure']['cache_bytes'] == 0 and on['measure']['cache_bytes'] == 400\nassert not output.exists()\nresult = dict(status='passed', qualified=False, receipt_sha256=sha(receipt), audit_sha256=sha(audit), production_proof_sha256=sha(proof), rows=rows, shorter_diagnostic_controls=controls,\n              findings=['All three admitted loop pairs have identical rounded malloc allocated totals at setup, both steady checkpoints and release. Higher enabled footprint therefore does not correspond to a similarly sized malloc allocated-total difference in these samples.',\n                        'Allocator fragmentation, dirty and swapped totals differ between processes. These retained reports support allocator/page accounting as an explanation for the footprint difference, without isolating its cause.',\n                        'The shorter verified diagnostic control uses equal private unit counts, relocated bytes and logical allocation charge, with a 400-byte enabled loop cache. It is a different run and duration; its counters do not prove ownership stability throughout the long normal-floor sampler.'],\n              scope='Read-only analysis of retained whole-process reports and existing exact-source diagnostic controls. Rounded allocator totals are not Birnam object sizes; no exact total optimizer accounting, activation assertion for the normal sampler, leak-freedom proof or timing claim.', audit_source=Path(__file__).read_text())\noutput.write_text(json.dumps(result, indent=2) + '\\n')\nprint('Audited six loop processes, 42 allocator summaries and four shorter exact-storage controls')\n"
}
