  "drivers": {
    "profile_memory.py": "import os,subprocess,time,json,hashlib\nfrom pathlib import Path\nwork=Path('/tmp/birnam-runtime-audit-20261019'); script=work/'ready.birnam';script.write_text('[System println: \"ready\"]\\n')\nenv={k:v for k,v in os.environ.items() if not k.startswith('BIRNAM_')};env['BIRNAM_GC_PRECISE']='1'\nprefixes={'memory':'/tmp/birnam-runtime-audit-20261019/final-prefix'}\nrows=[]\nfor name,prefix in prefixes.items():\n for phase,delay,duration in [('early',0.05,3),('late',2.4,2)]:\n  p=subprocess.Popen([prefix+'/bin/birnam',str(script)],env=env,stdout=subprocess.PIPE,stderr=subprocess.PIPE)\n  time.sleep(delay);path=work/(name+'-'+phase+'.sample.txt')\n  sampled=subprocess.run(['/usr/bin/sample',str(p.pid),str(duration),'1','-file',str(path)],capture_output=True,text=True,timeout=20)\n  out,err=p.communicate(timeout=30)\n  assert p.returncode==0 and out==b'ready\\n' and not err,(name,out,err)\n  assert path.exists() and path.stat().st_size,(sampled.returncode,sampled.stderr)\n  rows.append({'variant':name,'phase':phase,'delay_seconds':delay,'duration_seconds':duration,'sample_status':sampled.returncode,'path':str(path),'sha256':hashlib.sha256(path.read_bytes()).hexdigest()})\n  print(name,phase,'sampled',flush=True)\n(work/'memory-startup-samples.json').write_text(json.dumps(rows,indent=2)+'\\n')\n",
    "compare_setup.py": "import subprocess,time,resource,statistics,json,sys\nfrom pathlib import Path\nsys.path.insert(0,str(Path.cwd()/'scripts'))\nfrom validation_support import clean_environment\nw=Path('/tmp/birnam-runtime-audit-20261019');prefixes={n:w/'setup-prefix' for n in ['control','no_runtime','neither']}\nenv=clean_environment();env['BIRNAM_GC_PRECISE']='1';rows=[]\ndef run(n,script):\n env.pop('BIRNAM_AUDIT_SKIP_SDK',None);env.pop('BIRNAM_AUDIT_SKIP_RUNTIME',None)\n if n in ['no_sdk','neither']:env['BIRNAM_AUDIT_SKIP_SDK']='1'\n if n in ['no_runtime','neither']:env['BIRNAM_AUDIT_SKIP_RUNTIME']='1'\n before=resource.getrusage(resource.RUSAGE_CHILDREN);start=time.perf_counter();p=subprocess.run([prefixes[n]/'bin/birnam',script],env=env,capture_output=True,text=True,timeout=60);wall=time.perf_counter()-start;after=resource.getrusage(resource.RUSAGE_CHILDREN)\n assert p.returncode==0 and p.stdout=='ready\\n' and not p.stderr,(n,p)\n return dict(wall_seconds=wall,cpu_seconds=after.ru_utime+after.ru_stime-before.ru_utime-before.ru_stime)\nfor mode,script in [('startup_script',w/'ready.birnam'),('saved_image',w/'no-temp.image')]:\n for n in prefixes:run(n,script)\n for i in range(3):\n  for n in (list(prefixes) if i%2==0 else list(reversed(prefixes))):\n   rows.append(dict(mode=mode,variant=n,repeat=i,**run(n,script)))\n  (w/'setup-comparison.json').write_text(json.dumps({'rows':rows},indent=2)+'\\n');print(mode,i+1,flush=True)\nmedians={m:{n:{k:statistics.median(r[k] for r in rows if r['variant']==n and r['mode']==m) for k in ['wall_seconds','cpu_seconds']} for n in prefixes} for m in ['startup_script','saved_image']}\n(w/'setup-comparison.json').write_text(json.dumps({'rows':rows,'medians':medians,'scope':'Three interleaved fresh processes after one warmup per variant/workload; precise GC and identical preexisting authored artifacts/images; diagnostic native overlay only. Background user workloads active.'},indent=2)+'\\n')\nprint(json.dumps(medians,indent=2),flush=True)\n",
    "compare_variants.py": "import subprocess,time,resource,statistics,json,sys\nfrom pathlib import Path\nsys.path.insert(0,str(Path.cwd()/'scripts'))\nfrom validation_support import clean_environment\nw=Path('/tmp/birnam-runtime-audit-20261019');prefixes={n:w/'setup-prefix' for n in ['control','selected','selected_and_setup']}\nenv=clean_environment();env['BIRNAM_GC_PRECISE']='1';rows=[]\ndef run(n,script):\n env.pop('BIRNAM_AUDIT_SKIP_SDK',None);env.pop('BIRNAM_AUDIT_SKIP_RUNTIME',None)\n if n in ['selected_and_setup']:env['BIRNAM_AUDIT_SKIP_SDK']='1'\n if n in ['selected_and_setup']:env['BIRNAM_AUDIT_SKIP_RUNTIME']='1'\n env.pop('BIRNAM_AUDIT_SELECTED_BODIES',None)\n if n in ['selected','selected_and_setup']:env['BIRNAM_AUDIT_SELECTED_BODIES']='1'\n before=resource.getrusage(resource.RUSAGE_CHILDREN);start=time.perf_counter();p=subprocess.run([prefixes[n]/'bin/birnam',script],env=env,capture_output=True,text=True,timeout=60);wall=time.perf_counter()-start;after=resource.getrusage(resource.RUSAGE_CHILDREN)\n assert p.returncode==0 and p.stdout=='ready\\n' and not p.stderr,(n,p)\n return dict(wall_seconds=wall,cpu_seconds=after.ru_utime+after.ru_stime-before.ru_utime-before.ru_stime)\nfor mode,script in [('startup_script',w/'ready.birnam')]:\n for n in prefixes:run(n,script)\n for i in range(3):\n  for n in (list(prefixes) if i%2==0 else list(reversed(prefixes))):\n   rows.append(dict(mode=mode,variant=n,repeat=i,**run(n,script)))\n  (w/'variants-comparison.json').write_text(json.dumps({'rows':rows},indent=2)+'\\n');print(mode,i+1,flush=True)\nmedians={m:{n:{k:statistics.median(r[k] for r in rows if r['variant']==n and r['mode']==m) for k in ['wall_seconds','cpu_seconds']} for n in prefixes} for m in ['startup_script']}\n(w/'variants-comparison.json').write_text(json.dumps({'rows':rows,'medians':medians,'scope':'Three interleaved fresh processes after one warmup per variant/workload; precise GC and identical preexisting authored artifacts/images; diagnostic native