    "count_required_variants.py": "\"\"\"Read-only image-v8 census, not an admission validator.\"\"\"\nimport struct,json,mmap,hashlib\nfrom pathlib import Path\npath=Path('/tmp/birnam-runtime-audit-20261019/final-prefix/lib/birnam-bootstrap.image')\nwith path.open('rb') as f,mmap.mmap(f.fileno(),0,access=mmap.ACCESS_READ) as data:\n def u32(p):return struct.unpack_from('<I',data,p)[0]\n def u64(p):return struct.unpack_from('<Q',data,p)[0]\n assert data[:8]==b'BIRNAMIM' and u32(8)==8\n def field(p):\n  tag=data[p];p+=1;val=None\n  if tag in (0,1,2,8):pass\n  elif tag in (3,13,14,15):p+=8\n  elif tag in (7,11,12,18):val=u32(p);p+=4\n  elif tag in (5,9,16,17):n=u32(p);p+=4;val=data[p:p+n] if tag in (5,9) else None;p+=n\n  else:raise ValueError(tag)\n  return (tag,val),p\n objects=[];p=28;sizes=[]\n while p<len(data):\n  kind=u32(p);n=u64(p+4);p+=12;end=p+n;assert end<=len(data)\n  if kind==7:\n   inventory=p+40;assert data[inventory:inventory+len(b\"birnam.portable-inventory.v1\\0\")]==b'birnam.portable-inventory.v1\\0';programs=u32(inventory+72)\n  if kind==3:\n   count=u32(p);p+=4\n   for _ in range(count):\n    loc,p=field(p);words=u32(p);p+=4;fields=[]\n    for _ in range(words):v,p=field(p);fields.append(v)\n    objects.append((loc,fields))\n   assert p==end\n  if kind==4:\n   start=data.find(b'BIRNAMO1',p,end);assert start>=0;count=u32(start+40);q=start+44\n   for i in range(count):\n    size=u64(q);q+=8;sizes.append(size);q+=size\n   assert q<=end\n  p=end\n required=set();blocks=0\n for (tag,index),fields in objects:\n  if tag in (12,18):\n   blocks+=1;loc,codefields=objects[index];assert loc==(9,b'CodeObjectVt') and codefields[0][0]==11\n   program=codefields[0][1];assert program<programs;required.add(2*program+(tag==18))\n all_bodies=set(range(2*programs));missing=all_bodies-required\n (path.parent.parent.parent/\"unused-variants.json\").write_text(json.dumps(sorted(missing)))\n result=dict(path=str(path),sha256=hashlib.sha256(data).hexdigest(),heap_objects=