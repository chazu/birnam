// FFI — absorb C library functions into birnam.
//
//   birnam examples/ffi.birnam
//
// birnam's compiler is a C compiler (libtcc), so wrapping a C function means
// generating a tiny shim that marshals arguments, calling it, and installing the
// result as a method — no separate FFI engine. `[Alien wrap: name signature: sig
// as: #sel on: T]` does that; the signature's first type is the return, the rest
// are arguments: i=int, l=long, d=double, f=float, s=cstring, p=pointer, v=void,
// and {…} a struct BY VALUE whose fields map to a positional Vector — a struct
// return arrives as `#[…]` and a struct argument is written as one.
//
// Here we absorb libc functions onto Integer/String/Vector so birnam can call
// them directly. (For a library not already loaded, `[Alien dlopen: path]` loads
// it first; libc is always present.)

// long strlen(const char*)  → String length:  "the length"
[Alien wrap: "strlen" signature: "l s" as: #clen on: String];
[System println: ["strlen via C: " , [["the length" clen] printString]]];

// int abs(int)  → Integer absVia
[Alien wrap: "abs" signature: "i i" as: #absVia on: Integer];
[System println: ["abs(-42) via C: " , [[-42 absVia] printString]]];

// char* getenv(const char*)  → look up an environment variable (nil if unset)
[Alien wrap: "getenv" signature: "s s" as: #getenv on: String];
let path := ["PATH" getenv];
[System println: ["PATH length (via C getenv + strlen): " , [[path clen] printString]]];

// div_t div(int, int)  → a struct RETURNED BY VALUE: div_t { int quot; int rem; }
// comes back as the Vector #[quot rem].
[Alien wrap: "div" signature: "{ii} i i" as: #divBy: on: Integer];
[System println: ["div(7, 2) via C: " , [[7 divBy: 2] printString]]];

// char* inet_ntoa(struct in_addr)  → a struct PASSED BY VALUE: in_addr is one
// 32-bit field, so the receiver is the 1-element Vector #[16777343]
// (0x0100007F, little-endian 127.0.0.1). Wrapped on VectorVt — the vtable whose
// instances are the struct-shaped Vectors.
[Alien wrap: "inet_ntoa" signature: "s {i}" as: #asDottedQuad on: VectorVt];
[System println: ["inet_ntoa(#[16777343]) via C: " , [#[16777343] asDottedQuad]]];

// The OTHER direction — C calling back INTO birnam. `[Alien callback: blk
// signature: sig]` compiles a C function that forwards its arguments to the
// block (sig read from C's side: return first, then what C passes in) and
// answers its address. To prove it end to end we compile our own C caller with
// Tcc right here — birnam's compiler IS a C compiler, after all.
let cb := [Alien callback: [:x | [x * 2]] signature: "l l"];
let unit := [Tcc new];
[unit compile: "extern long birnam_smallIntValue(void*); extern void* birnam_mkSmallInt(long); void* __call(void* self, void** args, long n) { long (*fp)(long) = (long(*)(long))birnam_smallIntValue(self); return birnam_mkSmallInt(fp(21)); }"];
[unit bindRuntime];
[unit relocate];
[unit install: "__call" as: #callWith21 on: Integer];
[System println: ["C calling a birnam block (21 doubled): " , [[cb callWith21] printString]]]
