// linenoise REPL driver — a birnam-authored read-eval-print loop.
//
// Filed in by `birnam` automatically when birnam.toml has `repl = "linenoise"`,
// AFTER linenoise.birnam (so `linenoise` is bound and its wraps resolved). The
// trailing loop reads + edits a line via linenoise, dispatches it, and repeats
// until EOF (^D) — then control returns to the shell, which exits.
//
// Division of labour: this loop (birnam) owns input + line editing + history +
// dispatch; the shell still owns the heavy `:` commands. `[language command:]`
// routes a `:` line back through the shell's handleImageCommand (:in/:save/
// :load/:gc/:prune/:freeze/:asof/:help …) and answers whether it was handled;
// `[language evalLine:]` parses + evaluates + prints a normal line exactly as
// the built-in loop would (and covers the lang `:` commands :reset/:eval-mode).
//
// Rather than one deeply-nested block, the per-line logic is split into named
// blocks (`stop`/`dispatch`/`handle`/`step`), each taking the line as a
// parameter and closing only over the stable outer state (`replRunning`,
// `linenoise`, `language`). The loop at the bottom just reads a line and hands
// it to `step`.

[System println: "[birnam] linenoise REPL — line editing + history (up/down recalls, :quit to exit)"];

[linenoise historyMaxLen: 1000];

// The loop's on/off switch — a reference cell so the handler blocks can flip
// it from inside the loop. `stop` ends the loop.
let replRunning := [db atom: true];
let stop := [| [replRunning set: false]];

// Dispatch a non-empty, non-quit line. A `:`-line goes to the shell first
// (`command:` answers whether it handled it); anything the shell declines — and
// every ordinary line — is parsed + evaluated + printed by `evalLine:`.
let dispatch := [:line | [
    [line startsWith: ":"]
    ifTrue:  [| [[[language command: line] not] ifTrue: [| [language evalLine: line]]]]
    ifFalse: [| [language evalLine: line]]
  ]
];

// One non-empty line: record it in history, then quit on :quit/:exit, else
// dispatch it.
let handle := [:line |
  [linenoise historyAdd: line] ;
  [[[line = ":quit"] | [line = ":exit"]]
    ifTrue:  stop
    ifFalse: [| [dispatch value: line]]]];

// One iteration: EOF (nil) ends the loop, a blank line is ignored, otherwise
// hand off to `handle`.
let step := [:line |
  [[line isNil]
    ifTrue:  stop
    ifFalse: [| [[line isEmpty] ifTrue: [| nil] ifFalse: [| [handle value: line]]]]]];

// Read–eval–print until EOF (^D) or :quit; then control returns to the shell.
[[| [replRunning value]] whileTrue: [|
    let line := [linenoise prompt: "birnam> "] ;
    [step value: line]]
]
