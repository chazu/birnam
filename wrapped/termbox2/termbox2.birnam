// termbox2 — terminal cell grid + keyboard events, wrapped for birnam via Alien.
//
// First-party wrapped C library. All calls go through a thin int-clean C adapter
// (`lg_*`, see termbox2.c), so every signature here is int->int, (ints…)->int, or
// (ints…, cstring)->int — no struct peeks, no uint64 attr-width marshalling.
//
// BUILD the dylib first (single-header lib; TB_IMPL is instantiated in termbox2.c):
//
//   cd wrapped/termbox2 && ./build.sh   # -> libtermbox2.dylib
//
// LOAD it before the renderer. A project build configures Alien's native
// library directory before loading this module. Direct script users should do
// the equivalent with `[Alien libraryDir: …]` first.
//
//   [System load: "../../wrapped/termbox2/termbox2.birnam"];
//
// The wraps declared here resolve at commit, so `Termbox` is only callable in a LATER
// unit — which is exactly how the renderer uses it (System load is one commit,
// the renderer body another).

// Make the library's symbols resolvable by `wrap:` below. The project runner
// points Alien at its private build/lib directory, so this remains relocatable.
[Alien dlopen: "libtermbox2.dylib"];

// Termbox is the public singleton. `on: Termbox` gives it its own copy-on-write
// vtable, so these methods do not leak onto Object.
[Globals at: #Termbox put: [Object clone]];

// Alien compiles one TCC trampoline per `wrap:` declaration. One generic
// native entry point keeps that fixed startup cost small; the public Termbox
// selectors below remain ordinary image methods and preserve the existing API.
[Alien wrap: "lg_dispatch" signature: "i p i i i i i i s p"
  as: #dispatch:a:b:c:d:e:text:output: on: Termbox];

[Reflect defineMethod: #init on: Termbox as: [:self |
  [self dispatch: 1 a: 0 b: 0 c: 0 d: 0 e: 0 text: "" output: 0]]];
[Reflect defineMethod: #shutdown on: Termbox as: [:self |
  [self dispatch: 2 a: 0 b: 0 c: 0 d: 0 e: 0 text: "" output: 0]]];
[Reflect defineMethod: #width on: Termbox as: [:self |
  [self dispatch: 3 a: 0 b: 0 c: 0 d: 0 e: 0 text: "" output: 0]]];
[Reflect defineMethod: #height on: Termbox as: [:self |
  [self dispatch: 4 a: 0 b: 0 c: 0 d: 0 e: 0 text: "" output: 0]]];
[Reflect defineMethod: #clear on: Termbox as: [:self |
  [self dispatch: 5 a: 0 b: 0 c: 0 d: 0 e: 0 text: "" output: 0]]];
[Reflect defineMethod: #present on: Termbox as: [:self |
  [self dispatch: 6 a: 0 b: 0 c: 0 d: 0 e: 0 text: "" output: 0]]];
[Reflect defineMethod: #hideCursor on: Termbox as: [:self |
  [self dispatch: 7 a: 0 b: 0 c: 0 d: 0 e: 0 text: "" output: 0]]];
[Reflect defineMethod: #poll on: Termbox as: [:self |
  [self dispatch: 8 a: 0 b: 0 c: 0 d: 0 e: 0 text: "" output: 0]]];
[Reflect defineMethod: #evType on: Termbox as: [:self |
  [self dispatch: 9 a: 0 b: 0 c: 0 d: 0 e: 0 text: "" output: 0]]];
[Reflect defineMethod: #evKey on: Termbox as: [:self |
  [self dispatch: 10 a: 0 b: 0 c: 0 d: 0 e: 0 text: "" output: 0]]];
[Reflect defineMethod: #evCh on: Termbox as: [:self |
  [self dispatch: 11 a: 0 b: 0 c: 0 d: 0 e: 0 text: "" output: 0]]];
[Reflect defineMethod: #setCursor:y: on: Termbox as: [:self :x :y |
  [self dispatch: 12 a: x b: y c: 0 d: 0 e: 0 text: "" output: 0]]];
[Reflect defineMethod: #setX:y:ch:fg:bg: on: Termbox as: [:self :x :y :ch :fg :bg |
  [self dispatch: 13 a: x b: y c: ch d: fg e: bg text: "" output: 0]]];
[Reflect defineMethod: #printX:y:fg:bg:str: on: Termbox as: [:self :x :y :fg :bg :str |
  [self dispatch: 14 a: x b: y c: fg d: bg e: 0 text: str output: 0]]];
[Reflect defineMethod: #evChar on: Termbox as: [:self |
  let out := [Alien alloc: 5];
  [self dispatch: 15 a: 0 b: 0 c: 0 d: 0 e: 0 text: "" output: out];
  let character := [out peekStringAt: 0];
  [out free];
  character]];
