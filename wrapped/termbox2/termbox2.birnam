// termbox2 — native terminal cell grid + keyboard event module.
//
// The wrapped dylib binds the public Termbox selectors directly through IdApi;
// keeping this loader in Birnam preserves the ordinary project-module boundary
// without paying for runtime Alien trampoline compilation during UI startup.

let path := [[Module libDir] , "/libtermbox2.dylib"];
let loaded := [System loadModule: path];
[[loaded isError] ifTrue: [| loaded] ifFalse: [| Termbox]]
