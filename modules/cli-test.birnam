// cli-test.birnam — the test suite for modules/cli.birnam, plus the guarantee
// behind it: the modules the subcommands drive stay loadable from code with
// their APIs usable OUTSIDE any CLI context — Cli is one more client of the
// library APIs, never their owner. Loading only registers the suite; run via
// modules/run-tests.birnam. Run from the repo root.

[[Globals includes: #TestSuite] ifTrue: [| nil] ifFalse: [| [System load: "modules/test.birnam"]]];
[[Globals includes: #Cli]    ifTrue: [| nil] ifFalse: [| [System load: "modules/cli.birnam"]]];
[[Globals includes: #Socket] ifTrue: [| nil] ifFalse: [| [System load: "modules/socket.birnam"]]];
[[Globals includes: #Repl]   ifTrue: [| nil] ifFalse: [| [System load: "modules/repl.birnam"]]];
[[Globals includes: #Lsp]    ifTrue: [| nil] ifFalse: [| [System load: "modules/json.birnam"]]];
[[Globals includes: #Lsp]    ifTrue: [| nil] ifFalse: [| [System load: "modules/lsp.birnam"]]];
[[Globals includes: #File]   ifTrue: [| nil] ifFalse: [| [System load: "modules/file.birnam"]]];

let s := [TestSuite named: "Cli" module: #cli];

[s test: "validPort: accepts in-range integers, rejects nil and out-of-range" do: [:t |
  [t expect: [Cli validPort: 8080]  equals: true  describes: "8080 valid"];
  [t expect: [Cli validPort: 0]     equals: true  describes: "0 valid"];
  [t expect: [Cli validPort: 65535] equals: true  describes: "65535 valid"];
  [t expect: [Cli validPort: 65536] equals: false describes: "65536 out of range"];
  [t expect: [Cli validPort: ["abc" asInteger]] equals: false describes: "a non-number (asInteger → nil) invalid"]]];

// run:dir: is callable like any other module API (its printed lines are the
// CLI's user-facing output, so these pick the quiet-ish paths).
[s test: "run:dir: answers 1 for an unknown subcommand, 0 for a usage display" do: [:t |
  [t expect: [Cli run: #["frobnicate"] dir: "modules"] equals: 1 describes: "unknown subcommand fails"];
  [t expect: [Cli run: #["doc"] dir: "modules"] equals: 0 describes: "usage display is help, not failure"]]];

[s test: "runFile: answers 1 for an unreadable file" do: [:t |
  [t expect: [Cli runFile: "/nonexistent/nope.birnam"] equals: 1 describes: "missing file is a failure"]]];

// initAt: on a scratch path — the fresh write, the template's self-description,
// and the refuse-to-overwrite guard. (`run: #["init"]` writes ./birnam.toml, so
// the dispatcher path is exercised against the repo root's existing config,
// where refusing IS the correct answer.)
[s test: "initAt: writes the starter birnam.toml once, then refuses to overwrite" do: [:t |
  let p := "/tmp/birnam-cli-init-test.toml";
  [File delete: p];
  [t expect: [Cli initAt: p] equals: 0 describes: "fresh init succeeds"];
  let text := [System readFile: p];
  [t assert: [text includesSubstring: "main = "] describes: "template shows the main key"];
  [t assert: [text includesSubstring: "load = "] describes: "template shows the module load key"];
  [t assert: [text includesSubstring: "[Config at: "] describes: "template documents the Config read surface"];
  [t expect: [Cli initAt: p] equals: 1 describes: "an existing file is refused"];
  [t expect: [File delete: p] equals: true describes: "scratch file cleanup"]]];

[s test: "run:dir: routes init; a cwd with a birnam.toml is refused, not clobbered" do: [:t |
  [t expect: [Cli run: #["init"] dir: "modules"] equals: 1 describes: "repo root already has birnam.toml"]]];

// wrapLib:into:dir: — the scaffolder against a scratch base dir (never the
// repo's real wrapped/ tree). Refusal is a benign no-op (status 0), matching
// the old Zig scaffolder; the author's edited file is never clobbered.
[s test: "wrap scaffolds <base>/<name>/<name>.birnam once, never clobbers" do: [:t |
  let base := "/tmp/birnam-wrap-test";
  let path := "/tmp/birnam-wrap-test/foo/foo.birnam";
  [File delete: path];
  [File removeDir: "/tmp/birnam-wrap-test/foo"];
  [File removeDir: base];
  [t expect: [Cli wrapLib: "foo" into: base dir: "modules"] equals: 0 describes: "fresh scaffold succeeds"];
  let text := [System readFile: path];
  [t assert: [text includesSubstring: "#Foo"] describes: "capitalized singleton bound"];
  [t assert: [text includesSubstring: "libfoo.dylib"] describes: "dlopen line names the lib"];
  [t expect: [text includesSubstring: "%N%"] equals: false describes: "no unsubstituted placeholders"];
  [System writeFile: path contents: "EDITED"];
  [t expect: [Cli wrapLib: "foo" into: base dir: "modules"] equals: 0 describes: "existing wrapper is a no-op, not a failure"];
  [t expect: [System readFile: path] equals: "EDITED" describes: "the author's edits win"];
  [File delete: path];
  [File removeDir: "/tmp/birnam-wrap-test/foo"];
  [File removeDir: base]]];

[s test: "wrap usage: missing name is a usage display (0), not a crash" do: [:t |
  [t expect: [Cli run: #["wrap"] dir: "modules"] equals: 0 describes: "no operand shows usage"]]];

// -- the library-use guarantee for the modules the subcommands drive -----------

[s test: "Repl is a library: isComplete: balances brackets, no server involved" do: [:t |
  [t expect: [Repl isComplete: "[1 + 2]"]  equals: true  describes: "balanced form complete"];
  [t expect: [Repl isComplete: "[1 + [2"]  equals: false describes: "open form incomplete"]]];

// The form reader's full rule set — the same scanner serves the console REPL, so
// these mirror what the console goldens (scripts/repl-golden.sh) observe from
// outside: strings and // comments hide brackets; over-closed reads as done.
[s test: "isComplete: skips strings and // comments; over-closed is done" do: [:t |
  [t expect: [Repl isComplete: "{\"a\" -> 1}"]  equals: true  describes: "braces balance"];
  [t expect: [Repl isComplete: "{ #a -> [b"]    equals: false describes: "open brace + bracket"];
  [t expect: [Repl isComplete: "[\"a ] b\"]"]   equals: true  describes: "bracket inside a string ignored"];
  [t expect: [Repl isComplete: "[\"unterminated"] equals: false describes: "unterminated string holds the form open"];
  [t expect: [Repl isComplete: "[1] // a ] comment ["] equals: true  describes: "brackets inside a // comment ignored"];
  [t expect: [Repl isComplete: "[1 // open
]"] equals: true describes: "a // comment ends at its newline"];
  [t expect: [Repl isComplete: "a]"] equals: true describes: "over-closed evaluates (parser reports it)"]]];

[s test: "Lsp is a library: header parse + compile diagnostics, no stdio involved" do: [:t |
  [t expect: [Lsp contentLengthOf: "Content-Length: 42\r\n"] equals: 42 describes: "contentLengthOf:"];
  [t expect: [[Lsp compileDiagnostics: "[1 + 2]"] size] equals: 0 describes: "clean source, no diagnostics"];
  [t assert: [[[Lsp compileDiagnostics: "[1 + ]"] size] >= 1] describes: "a syntax error yields a diagnostic"]]];

[s test: "Lsp translates UTF-8 byte spans and UTF-16 positions" do: [:t |
  [t expect: [Lsp utf16Offset: 3 in: "aé"] equals: 2 describes: "a two-byte code point is one UTF-16 unit"];
  [t expect: [Lsp byteOffsetForUtf16: 2 in: "aé"] equals: 3 describes: "a UTF-16 cursor advances over the full UTF-8 code point"]]];
