// cli-test.birnam — the test suite for modules/cli.birnam, plus the guarantee
// behind it: the modules the subcommands drive stay loadable from code with
// their APIs usable OUTSIDE any CLI context — Cli is one more client of the
// library APIs, never their owner. Loading only registers the suite; run via
// modules/run-tests.birnam. Run from the repo root.

[[Globals includes: #TestSuite] ifTrue: [| nil] ifFalse: [| [System load: "modules/test.birnam"]]];
[[Globals includes: #Cli]    ifTrue: [| nil] ifFalse: [| [System load: "modules/cli.birnam"]]];
[[Globals includes: #Socket] ifTrue: [| nil] ifFalse: [| [System load: "modules/socket.birnam"]]];
[[Globals includes: #Repl]   ifTrue: [| nil] ifFalse: [| [System load: "modules/repl.birnam"]]];
[[Globals includes: #Lsp]    ifTrue: [| nil] ifFalse: [| [System load: "modules/json.birnam"]]];
[[Globals includes: #Lsp]    ifTrue: [| nil] ifFalse: [| [System load: "modules/lsp.birnam"]]];
[[Globals includes: #File]   ifTrue: [| nil] ifFalse: [| [System load: "modules/file.birnam"]]];

let s := [TestSuite named: "Cli" module: #cli];

[s test: "LSP startup selects only its own dependency closure" do: [:t |
  [t assert: [System load: "tests/fixtures/cli-lsp-boundary.birnam"]
     describes: "LSP startup does not load the documentation catalog or unrelated libraries"]]];


[s test: "validPort: accepts in-range integers, rejects nil and out-of-range" do: [:t |
  [t expect: [Cli validPort: 8080]  equals: true  describes: "8080 valid"];
  [t expect: [Cli validPort: 0]     equals: true  describes: "0 valid"];
  [t expect: [Cli validPort: 65535] equals: true  describes: "65535 valid"];
  [t expect: [Cli validPort: 65536] equals: false describes: "65536 out of range"];
  [t expect: [Cli validPort: ["abc" asInteger]] equals: false describes: "a non-number (asInteger → nil) invalid"]]];

// run:rustWorkspace:guides: is callable like any other module API (its printed lines are the
// CLI's user-facing output, so these pick the quiet-ish paths).
[s test: "run:rustWorkspace:guides: answers 1 for an unknown subcommand, 0 for usage" do: [:t |
  [t expect: [Cli run: #["frobnicate"] rustWorkspace: "." guides: "docs/guide"] equals: 1 describes: "unknown subcommand fails"];
  [t expect: [Cli run: #["doc"] rustWorkspace: "." guides: "docs/guide"] equals: 0 describes: "usage display is help, not failure"]]];

[s test: "runFile: answers 1 for an unreadable file" do: [:t |
  [t expect: [Cli runFile: "/nonexistent/nope.birnam"] equals: 1 describes: "missing file is a failure"]]];

// initAt: on a scratch path — the fresh write, the template's self-description,
// and the refuse-to-overwrite guard. (`run: #["init"]` writes ./birnam.toml, so
// the dispatcher path is exercised against the repo root's existing config,
// where refusing IS the correct answer.)
[s test: "initAt: writes the starter birnam.toml once, then refuses to overwrite" do: [:t |
  let p := "/tmp/birnam-cli-init-test.toml";
  [File delete: p];
  [t expect: [Cli initAt: p] equals: 0 describes: "fresh init succeeds"];
  let text := [System readFile: p];
  [t assert: [text includesSubstring: "main = "] describes: "template shows the main key"];
  [t assert: [text includesSubstring: "load = "] describes: "template shows the module load key"];
  [t assert: [text includesSubstring: "[test]"] describes: "template shows project test discovery"];
  [t assert: [text includesSubstring: "[Config at: "] describes: "template documents the Config read surface"];
  [t expect: [Cli initAt: p] equals: 1 describes: "an existing file is refused"];
  [t expect: [File delete: p] equals: true describes: "scratch file cleanup"]]];

[s test: "run:rustWorkspace:guides: routes init" do: [:t |
  [t expect: [Cli run: #["init"] rustWorkspace: "." guides: "docs/guide"] equals: 1 describes: "repo root already has birnam.toml"]]];

// wrapLib:into:dir: — the scaffolder against a scratch base dir (never the
// repo's real wrapped/ tree). Refusal is a benign no-op (status 0), matching
// the old scaffolder; the author's edited file is never clobbered.
[s test: "wrap scaffolds <base>/<name>/<name>.birnam once, never clobbers" do: [:t |
  let base := "/tmp/birnam-wrap-test";
  let path := "/tmp/birnam-wrap-test/foo/foo.birnam";
  [File delete: path];
  [File removeDir: "/tmp/birnam-wrap-test/foo"];
  [File removeDir: base];
  [t expect: [Cli wrapLib: "foo" into: base] equals: 0 describes: "fresh scaffold succeeds"];
  let text := [System readFile: path];
  [t assert: [text includesSubstring: "#Foo"] describes: "capitalized singleton bound"];
  [t assert: [text includesSubstring: "libfoo.dylib"] describes: "dlopen line names the lib"];
  [t expect: [text includesSubstring: "%N%"] equals: false describes: "no unsubstituted placeholders"];
  [System writeFile: path contents: "EDITED"];
  [t expect: [Cli wrapLib: "foo" into: base] equals: 0 describes: "existing wrapper is a no-op, not a failure"];
  [t expect: [System readFile: path] equals: "EDITED" describes: "the author's edits win"];
  [File delete: path];
  [File removeDir: "/tmp/birnam-wrap-test/foo"];
  [File removeDir: base]]];

[s test: "wrap usage: missing name is a usage display (0), not a crash" do: [:t |
  [t expect: [Cli run: #["wrap"] rustWorkspace: "." guides: "docs/guide"] equals: 0 describes: "no operand shows usage"]]];

// -- the library-use guarantee for the modules the subcommands drive -----------

[s test: "Repl is a library: isComplete: balances brackets, no server involved" do: [:t |
  [t expect: [Repl isComplete: "[1 + 2]"]  equals: true  describes: "balanced form complete"];
  [t expect: [Repl isComplete: "[1 + [2"]  equals: false describes: "open form incomplete"]]];

// The form reader's full rule set — the same scanner serves the console REPL, so
// these mirror what the console goldens (scripts/repl-golden.sh) observe from
// outside: strings and // comments hide brackets; over-closed reads as done.
[s test: "isComplete: skips strings and // comments; over-closed is done" do: [:t |
  [t expect: [Repl isComplete: "{\"a\" -> 1}"]  equals: true  describes: "braces balance"];
  [t expect: [Repl isComplete: "{ #a -> [b"]    equals: false describes: "open brace + bracket"];
  [t expect: [Repl isComplete: "[\"a ] b\"]"]   equals: true  describes: "bracket inside a string ignored"];
  [t expect: [Repl isComplete: "[\"unterminated"] equals: false describes: "unterminated string holds the form open"];
  [t expect: [Repl isComplete: "[1] // a ] comment ["] equals: true  describes: "brackets inside a // comment ignored"];
  [t expect: [Repl isComplete: "[1 // open
]"] equals: true describes: "a // comment ends at its newline"];
  [t expect: [Repl isComplete: "a]"] equals: true describes: "over-closed evaluates (parser reports it)"]]];

[s test: "Lsp is a library: framing + static diagnostics, no stdio involved" do: [:t |
  [t expect: [Lsp contentLengthOf: "Content-Length: 42\r\n"] equals: 42 describes: "contentLengthOf:"];
  [t expect: [[Lsp compileDiagnostics: "[1 + 2]"] size] equals: 0 describes: "clean source, no diagnostics"];
  [t assert: [[[Lsp compileDiagnostics: "[1 + ]"] size] >= 1] describes: "a syntax error yields a diagnostic"];
  let arity := [Lsp compileDiagnostics: "[Reflect defineMethod: #needs: on: Integer as: [:self | 1]]"];
  [t expect: [[arity size] = 1] equals: true describes: "a provable selector arity mismatch yields one diagnostic"];
  [t expect: [[arity at: 0] at: "code"] equals: "selectorArity" describes: "selector arity diagnostics preserve their code"];
  [t expect: [[Lsp compileDiagnostics: "[Globals at: #answer put: 1]; [answer + 1]"] size] equals: 0 describes: "late-bound names do not produce false positives"];
  let symbols := [Lsp sourceSymbolsFor: "let answer := 1; [Reflect defineMethod: #needs: on: Integer as: [:self | 1]]"];
  [t expect: [[symbols size] = 2] equals: true describes: "source symbols include top-level lets and methods"];
  [t expect: [[symbols at: 0] at: "name"] equals: "answer" describes: "let symbol keeps its name"];
  [t expect: [[symbols at: 1] at: "name"] equals: "needs:" describes: "method symbol keeps its selector"];
  let occurrences := [Lsp sourceOccurrencesOf: "let answer := 1; [answer + 1]"];
  [t expect: [[occurrences size] = 2] equals: true describes: "source occurrences include the declaration and use"];
  [t expect: [[occurrences at: 0] at: "name"] equals: "answer" describes: "occurrence keeps the declaration spelling"];
  let bindings := [Lsp sourceBindingsOf: "let x := 10; let f := [:y | [x plus: y]]; [f value: 32]"];
  [t expect: [[bindings size] = 3] equals: true describes: "source bindings include locals and parameters"];
  [t expect: [[bindings at: 0] at: "kind"] equals: "local" describes: "binding marks top-level locals"];
  [t expect: [[bindings at: 2] at: "kind"] equals: "parameter" describes: "binding marks block parameters"]]];

[s test: "Lsp traverses every => leg and diagnoses restricted heads" do: [:t |
  let occurrences := [Lsp sourceOccurrencesOf:
    "[value => normalize => at: key put: [other => render]]"];
  [t assert: [occurrences anySatisfy: [:entry | [[entry at: "name"] = "normalize"]]]
     describes: "occurrences reach a unary threaded leg"];
  [t assert: [occurrences anySatisfy: [:entry | [[entry at: "name"] = "at:"]]]
     describes: "occurrences reach keyword selector parts"];
  [t assert: [occurrences anySatisfy: [:entry | [[entry at: "name"] = "render"]]]
     describes: "occurrences reach nested threaded arguments"];
  let nested := [Lsp compileDiagnostics:
    "[value => at: 0 put: [Reflect defineMethod: #needs: on: Integer as: [:self | 1]]]"];
  [t expect: [[nested at: 0] at: "code"] equals: "selectorArity"
     describes: "static diagnostics traverse a threaded keyword argument"];
  let restricted := [Lsp compileDiagnostics: "[System => embedFile: \"x\"]"];
  [t expect: [[restricted at: 0] at: "code"] equals: "threadedSpecialForm"
     describes: "the editor reports the source-sensitive head restriction"]]];

[s test: "Lsp translates UTF-8 byte spans and UTF-16 positions" do: [:t |
  [t expect: [Lsp utf16Offset: 3 in: "aé"] equals: 2 describes: "a two-byte code point is one UTF-16 unit"];
  [t expect: [Lsp byteOffsetForUtf16: 2 in: "aé"] equals: 3 describes: "a UTF-16 cursor advances over the full UTF-8 code point"]]];

[s test: "Lsp caches bounded runtime completion items per receiver" do: [:t |
  [Lsp clearRuntimeCompletionCache];
  let first := [Lsp runtimeCompletionItemsFor: System named: "System"];
  let second := [Lsp runtimeCompletionItemsFor: System named: "System"];
  let prefixedFirst := [Lsp runtimeCompletionItemsFor: System named: "System" prefix: "pri"];
  let prefixedSecond := [Lsp runtimeCompletionItemsFor: System named: "System" prefix: "pri"];
  [t assert: [[first size] >= 1] describes: "System exposes runtime completion items"];
  [t expect: first equals: second describes: "a repeated lookup reuses the cached item vector"];
  [t expect: prefixedFirst equals: prefixedSecond describes: "a repeated prefix lookup filters the same bounded receiver snapshot"];
  [t assert: [prefixedFirst anySatisfy: [:item | [[item at: "label"] = "println:"]]]
     describes: "the prefix index retains matching runtime selectors"];
  [t expect: [[Lsp runtimeCompletionCacheMap] keys] equals: #["System"]
     describes: "the cache is bounded by receiver name"]]];

[s test: "Lsp runtime receiver completion bypasses authored index traversal" do: [:t |
  [Lsp clearRuntimeCompletionCache];
  let position := [Map => new => at: "line" put: 0 => at: "character" put: 12];
  let items := [Lsp completionItemsFor: "[ System pri" uri: "file:///main.birnam"
    position: position index: [Map new]];
  [t assert: [items anySatisfy: [:item | [[item at: "label"] = "println:"]]]
     describes: "an exact runtime receiver completes without a project document"]]];

[s test: "Lsp completes exported globals in receiver position" do: [:t |
  [Lsp clearRuntimeGlobalCompletionCache];
  let position := [Map => new => at: "line" put: 0 => at: "character" put: 6];
  let names := [Reflect allGlobalNames];
  [t assert: [names anySatisfy: [:name | [[Reflect nameOf: name] = "System"]]]
     describes: "reflection exposes the actual System export"];
  [t expect: [Lsp completionGlobalReceiverPrefixAtPosition: position in: "[ Syst"]
     equals: "Syst" describes: "receiver-position parsing keeps the partial global"];
  let tokenStart := [Map => new => at: "line" put: 0 => at: "character" put: 2];
  [t expect: [Lsp completionGlobalReceiverPrefixAtPosition: tokenStart in: "[ Syst"]
     equals: "" describes: "prefetch at the token start requests the complete global snapshot"];
  [t expect: [Lsp completionLiteralReceiverAtPosition: position in: "[ Syst"]
     equals: "" describes: "a partial receiver is not mistaken for a method receiver"];
  [t assert: [[Lsp runtimeGlobalCompletionItemsForPrefix: "Syst"]
     anySatisfy: [:item | [[item at: "label"] = "System"]]]
     describes: "the cached runtime export snapshot filters System"];
  let items := [Lsp completionItemsFor: "[ Syst" uri: "file:///main.birnam"
    position: position index: [Map new]];
  [t assert: [items anySatisfy: [:item | [[item at: "label"] = "System"]]]
     describes: "a partial receiver completes an exported runtime global"];
  let allItems := [Lsp completionItemsFor: "[ Syst" uri: "file:///main.birnam"
    position: tokenStart index: [Map new]];
  [t assert: [allItems anySatisfy: [:item | [[item at: "label"] = "System"]]]
     describes: "token-start prefetch includes System in the complete snapshot"];
  [t expect: [Lsp runtimeGlobalCompletionBuildCount] equals: 1
     describes: "the first global lookup builds one bounded snapshot"];
  [Lsp completionItemsFor: "[ Obj" uri: "file:///main.birnam"
    position: position index: [Map new]];
  [t expect: [Lsp runtimeGlobalCompletionBuildCount] equals: 1
     describes: "later prefixes reuse the runtime global snapshot"]]];

[s test: "Lsp reuses only an exact document completion result" do: [:t |
  [Lsp clearCompletionResponseCache];
  let position := [Map => new => at: "line" put: 0 => at: "character" put: 12];
  let result := #[[Map => new => at: "label" put: "print:"]];
  [Lsp rememberCompletion: result text: "[ System pri" uri: "file:///main.birnam" position: position];
  [t expect: [Lsp cachedCompletionFor: "[ System pri" uri: "file:///main.birnam" position: position]
     equals: result describes: "unchanged text and position reuse the bounded result"];
  [t assert: [[Lsp cachedCompletionFor: "[ System print" uri: "file:///main.birnam" position: position] isNil]
     describes: "changed text cannot reuse a completion result"]]];

[s test: "Lsp chunk framing consumes complete messages and retains overread bytes" do: [:t |
  [Lsp inputBuffer: "Content-Length: 3\r\n\r\noneContent-Length: 3\r\n\r\ntwo"];
  [t expect: [Lsp takeBufferedMessage] equals: "one" describes: "the first complete body is consumed"];
  [t expect: [Lsp takeBufferedMessage] equals: "two" describes: "overread bytes retain the following frame"];
  [Lsp inputBuffer: "Content-Length: 4\r\n\r\nabc"];
  [t assert: [[Lsp takeBufferedMessage] isNil] describes: "an incomplete body waits for another chunk"];
  [t expect: [Lsp inputBuffer] equals: "Content-Length: 4\r\n\r\nabc"
     describes: "an incomplete frame remains byte-identical"];
  [Lsp inputBuffer: ""]]];
