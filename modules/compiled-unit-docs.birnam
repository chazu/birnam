// compiled-unit-docs.birnam — reference-only registrations for the staged
// CompiledUnit lifecycle. Kept separate from compiled-unit.birnam so adding or
// revising prose cannot change its portable executable method-operation stream.

[Module named: #compiledUnitDocs requires: #[#doc]];

[Doc module: #compiledUnit is: "Explicit source baselines and scoped candidate edits: inspect/map CompiledUnits, then activate or roll back through ordinary sends. Image loading does not adopt a baseline."];

[Doc for: #state in: #compiledUnit says:
  "The unit's recorded lifecycle state (reading it performs no reconciliation): #candidate, #active, #superseded or #rolledBack. Explicit validation never changes it."];
[Doc for: #kind in: #compiledUnit says:
  "The executable origin kind; #candidateArtifact identifies a staged native unit."];
[Doc for: #adoptCurrent in: #compiledUnit says:
  "Send to DispatchGeneration to explicitly create or refresh a source certificate. It validates current registered definitions against live code without changing candidate undo. Candidate operations and ordinary startup do not require it."];
[Doc for: #releaseCurrent in: #compiledUnit says:
  "Send to DispatchGeneration to explicitly release certificate observation roots and clear current. Returns self or Error. Retained descriptions, installed code and candidate undo remain; physical reclamation follows ordinary GC/checkpoints."];
[Doc for: #unitName in: #compiledUnit says:
  "The stable Symbol naming this candidate generation."];
[Doc for: #generation in: #compiledUnit says:
  "The monotonically increasing generation number within unitName."];
[Doc for: #requires in: #compiledUnit says:
  "The Vector of module Symbols declared as dependencies by this candidate."];
[Doc for: #provides in: #compiledUnit says:
  "The Vector of reflected install/remove operation entities provided by this candidate."];
[Doc for: #compile:named:output: in: #compiledUnit says:
  "Compile candidate-safe source named by Symbol `name` to `path` and its `.candidate` envelope without opening, mapping, or activating it. Answers path or an Error."];
[Doc for: #open: in: #compiledUnit says:
  "Inspect and verify the candidate bundle at `path` without mapping native code or changing dispatch. Answers a #candidate CompiledUnit or an Error."];
[Doc for: #missingDependencies in: #compiledUnit says:
  "The Vector of declared dependency Symbols that Module has not loaded."];
[Doc for: #prepareDependencies in: #compiledUnit says:
  "Explicitly load every missing dependency using ordinary Module semantics. These initializer effects are not part of candidate rollback. Answers self or an Error."];
[Doc for: #map in: #compiledUnit says:
  "Map and mechanically verify this trusted native candidate after its dependencies are loaded, without publishing its methods. Answers self or an Error."];
[Doc for: #validate in: #compiledUnit says:
  "Check the mapped candidate against its selected bindings and current source lineage, then discard the one-shot prepared capability. Answers self or an Error."];
[Doc for: #activate in: #compiledUnit says:
  "Apply the selected module changes through ordinary sends, including from entered code. Answers the unit or an Error."];
[Doc for: #rollback in: #compiledUnit says:
  "Apply conditional undo through ordinary sends. A relevant conflict or unavailable process-local capability answers an Error without overwriting it."];
[Doc for: #activeFor: in: #compiledUnit says:
  "The retained active candidate whose source record is current for Symbol `name`, or nil. This describes a handle, not proof that every live binding still matches its source."]

[Doc for: #generationNumbers in: #compiledUnit says:
  "Inspect the owned Map of last allocated generation numbers by module name; this does not increment a counter or read Store."];
[Doc for: #generationNumbers: in: #compiledUnit says:
  "Replace the owned numbering Map explicitly. The nextGenerationFor: algorithm uses the current accessor methods."];

[Doc for: #discard in: #compiledUnit says:
  "Release this handle, its prepared tokens and inverse reservation. Answers self; installed bindings and files remain. Does not force GC or native retirement."];
[Doc for: #removeFiles in: #compiledUnit says:
  "Explicitly remove matching admitted artifact/sidecar contents while this handle is open. Answers self or Error; does not discard the handle. Partial file cleanup is not rolled back."];
