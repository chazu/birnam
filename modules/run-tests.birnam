// run-tests.birnam — the test gate: load every *-test suite, run them all, and
// EXIT with the process status the result implies (0 all-pass, 1 any-fail). That
// exit code is what lets a shell or CI depend on the birnam-level suites.
//
//   ./zig-out/bin/birnam modules/run-tests.birnam   # from the repo root
//   echo $?                                          # 0 green, 1 red
//
// Register-then-run: each loaded *-test file only defines + registers its suite
// (via TestSuite, which registers itself with Test); nothing runs until the
// explicit runAllSuitesWithRunner: below. Add a new module's tests by loading its
// *-test file here.

[System load: "modules/os.birnam"];

// -- register every suite (loading defines + registers, runs nothing) ---------
[System load: "modules/html-test.birnam"];
[System load: "modules/markdown-test.birnam"];
[System load: "modules/random-test.birnam"];
[System load: "modules/doc-test.birnam"];
[System load: "modules/cli-test.birnam"];
[System load: "modules/stdlib-test.birnam"];
[System load: "modules/block-test.birnam"];
[System load: "modules/modules-test.birnam"];
[System load: "src/id/project-policy.birnam"];
[System load: "modules/project-policy-test.birnam"];
[System load: "modules/compiled-unit-test.birnam"];
[System load: "modules/app-config-test.birnam"];
[System load: "modules/digla/digla-test.birnam"];
[System load: "modules/digla/inspection.birnam"];
[System load: "modules/digla/inspection-test.birnam"];
[System load: "modules/digla/local-session.birnam"];
[System load: "modules/digla/session-test.birnam"];
[System load: "modules/digla/protocol.birnam"];
[System load: "modules/digla/protocol-test.birnam"];
[System load: "modules/digla/socket-protocol.birnam"];
[System load: "modules/digla/socket-protocol-test.birnam"];
[System load: "modules/digla/position-map.birnam"];
[System load: "modules/digla/position-map-test.birnam"];
[System load: "modules/digla/editor.birnam"];
[System load: "modules/digla/editor-test.birnam"];
[System load: "modules/digla/display-layout.birnam"];
[System load: "modules/digla/display-layout-test.birnam"];
[System load: "modules/digla/analysis.birnam"];
[System load: "modules/digla/analysis-test.birnam"];
[System load: "modules/digla/language-service.birnam"];
[System load: "modules/digla/language-service-test.birnam"];
[System load: "modules/digla/render.birnam"];
[System load: "modules/digla/render-test.birnam"];

// -- run them all through the console runner, then gate the exit code ----------
[Test runAllSuitesWithRunner: ConsoleRunner];
[[ConsoleRunner allPassed]
  ifTrue:  [| [OS exit: 0]]
  ifFalse: [| [OS exit: 1]]]
