// run-tests.birnam — the test gate: load every *-test suite, run them all, and
// EXIT with the process status the result implies (0 all-pass, 1 any-fail). That
// exit code is what lets a shell or CI depend on the birnam-level suites.
//
//   ~/.local/bin/birnam modules/run-tests.birnam   # from an installed prefix
//   echo $?                                          # 0 green, 1 red
//
// Register-then-run: each loaded *-test file only defines + registers its suite
// (via TestSuite, which registers itself with Test); nothing runs until the
// explicit runAllSuitesWithRunner: below. Add a new module's tests by loading its
// *-test file here.

[System load: "modules/os.birnam"];

// Do not turn a failed suite load into an apparently passing smaller run.
let loadTestSource := [:path |
  let answer := [System load: path];
  [[answer isError] ifTrue: [|
    [System println: answer]; [OS exit: 1]]];
  answer];

// -- register every suite (loading defines + registers, runs nothing) ---------
[loadTestSource value: "modules/html-test.birnam"];
[loadTestSource value: "modules/json-test.birnam"];
[loadTestSource value: "modules/markdown-test.birnam"];
[loadTestSource value: "modules/random-test.birnam"];
[loadTestSource value: "modules/doc-test.birnam"];
[loadTestSource value: "modules/cli-test.birnam"];
[loadTestSource value: "modules/stdlib-test.birnam"];
[loadTestSource value: "modules/block-test.birnam"];
[loadTestSource value: "modules/portable-code-test.birnam"];
[loadTestSource value: "modules/lang-test.birnam"];
[loadTestSource value: "modules/modules-test.birnam"];
[loadTestSource value: "modules/project-policy.birnam"];
[loadTestSource value: "modules/project-policy-test.birnam"];
// CompiledUnit commits run at idle Host boundaries in compiled-unit-cli-test.py.
[loadTestSource value: "modules/app-config-test.birnam"];

// -- run them all through the console runner, then gate the exit code ----------
[Test runAllSuitesWithRunner: ConsoleRunner];
[[ConsoleRunner allPassed]
  ifTrue:  [| [OS exit: 0]]
  ifFalse: [| [OS exit: 1]]]
