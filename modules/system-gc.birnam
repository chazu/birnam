// System-level GC policy. Owner messages exchange only Oops.
[Module named: #systemGc requires: #[]];
let gcOwner := GC;
let gcInteger := Integer;
let gcId := Vtable;
[Reflect defineMethod: #gc on: System as: [:self |
  [gcInteger fromWord: [gcOwner collect]]
]];
[Reflect defineMethod: #liveObjects on: System as: [:self |
  [gcInteger fromWord: [gcId allocationCount]]
]];
[Reflect defineMethod: #autoGc: on: System as: [:self :enabled |
  [[[enabled == true] | [enabled == false]] ifTrue: [|
    [gcOwner automaticCollection: [gcInteger wordOf: [enabled ifTrue: [| 1] ifFalse: [| 0]]]]; self
  ] ifFalse: [| nil]]
]];
[Reflect defineMethod: #preciseGc: on: System as: [:self :enabled |
  [[[enabled == true] | [enabled == false]] ifTrue: [|
    [gcOwner precisePayloads: [gcInteger wordOf: [enabled ifTrue: [| 1] ifFalse: [| 0]]]]; self
  ] ifFalse: [| nil]]
]];
[Module markLoaded: #systemGc];
