// System-level GC policy. Owners provide only native Word conversion bridges.
[Module named: #systemGc requires: #[#nativeValues]];
let gcOwner := GC;
let gcInteger := Integer;
let gcId := Vtable;
let gcBoolean := Boolean;
[Reflect defineMethod: #gc on: System as: [:self |
  [gcInteger fromWordResultOf: gcOwner selector: #collect]
]];
[Reflect defineMethod: #liveObjects on: System as: [:self |
  [gcInteger fromWordResultOf: gcId selector: #allocationCount]
]];
[Reflect defineMethod: #autoGc: on: System as: [:self :enabled |
  [[[enabled == true] | [enabled == false]] ifTrue: [|
    [gcBoolean sendWordOf: enabled to: gcOwner selector: #automaticCollection:]; self
  ] ifFalse: [| nil]]
]];
[Reflect defineMethod: #preciseGc: on: System as: [:self :enabled |
  [[[enabled == true] | [enabled == false]] ifTrue: [|
    [gcBoolean sendWordOf: enabled to: gcOwner selector: #precisePayloads:]; self
  ] ifFalse: [| nil]]
]];
[Module markLoaded: #systemGc];
