// Module owns its registry and directory in ordinary slots. Registry Maps are
// persistent snapshots: module-name Symbols map to field Maps. Mutation is
// authored and late-bound; Store is an optional description of this state.
//
// This unit loads before stdlib and uses the bootstrap Map/Vector/Cell protocol.
// Kernel entries describe already-loaded native modules. Authored declarations
// register dependencies; loading still validates a complete artifact plan before
// activation. The single source declaration stays at the end, after installation.
// Existing task transitions protect registry read/modify/write from time slicing.

[Globals at: #Module put: [ObjectModel newSlots: #[nil [Map new]] parent: ObjectVt]];

// -- declaration + query -------------------------------------------------------

// A self-hosted module declaring its own dependencies. Records the edges +
// marks it registered. Answers self, or stops at the first failed field edit.
[Reflect defineMethod: #named:requires: on: Module as: [:self :name :reqs |
  let registered := [self field: #registered of: name put: true];
  [[registered isError] ifTrue: [| registered] ifFalse: [|
    let kind := [self field: #kind of: name put: #selfHosted];
    [[kind isError] ifTrue: [| kind] ifFalse: [| [self field: #requires of: name put: reqs]]]
  ]]]];

// Represent a kernel (Rust native) module: registered, kind #kernel, already
// up (loaded), no dependencies. This completes the graph; nothing is loaded.
[Reflect defineMethod: #kernel: on: Module as: [:self :name |
  let registered := [self field: #registered of: name put: true];
  [[registered isError] ifTrue: [| registered] ifFalse: [|
    let kind := [self field: #kind of: name put: #kernel];
    [[kind isError] ifTrue: [| kind] ifFalse: [| [self field: #loaded of: name put: true]]]
  ]]]];

// The declared dependency Vector; an unregistered (or kernel) module has no
// #requires field and is a leaf (empty Vector) — absence rides the nil read.
[Reflect defineMethod: #requiresOf: on: Module as: [:self :name |
  let r := [self field: #requires of: name];
  [[r isNil] ifTrue: [| #[]] ifFalse: [| r]]]];

// #kernel / #selfHosted, or nil if unregistered.
[Reflect defineMethod: #kindOf: on: Module as: [:self :name |
  [self field: #kind of: name]]];

// Only `true` is ever asserted under these attrs, so non-nil reads as true.
[Reflect defineMethod: #isRegistered: on: Module as: [:self :name |
  let v := [self field: #registered of: name];
  [[v isNil] ifTrue: [| false] ifFalse: [| v]]]];

[Reflect defineMethod: #isLoaded: on: Module as: [:self :name |
  let v := [self field: #loaded of: name];
  [[v isNil] ifTrue: [| false] ifFalse: [| v]]]];

// Record that a module is installed (the driver calls this for the boot-time
// self-hosted layer; `kernel:` marks the kernel tier; `load:` marks its own).
[Reflect defineMethod: #markLoaded: on: Module as: [:self :name |
  [self field: #loaded of: name put: true]]];

// -- owned registry ------------------------------------------------------------
// These are generic inspection/edit paths, not a second authoritative mirror.
[Reflect defineMethod: #registry on: Module as: [:self |
  [ObjectModel slot: 1 in: self]]];
[Reflect defineMethod: #registry: on: Module as: [:self :records |
  [ObjectModel slot: 1 in: self put: records]; self]];
[Reflect defineMethod: #recordNames on: Module as: [:self | [[self registry] keys]]];
[Reflect defineMethod: #recordOf: on: Module as: [:self :name |
  [[self registry] at: name]]];

// Before the executor exists, bootstrap holds the owner thread. Later, reuse its
// ordinary transition policy for this short internal read/modify/write sequence.
// This is not a transaction around module loading, nor a retry of replaced sends.
[Reflect defineMethod: #registryMutation: on: Module as: [:self :body |
  let executor := TaskExecutor;
  [[executor isNil] ifTrue: [| [body value]] ifFalse: [| [executor transition: body]]]
]];
// Conditional publication protects synchronous reentry as well as time slicing.
// No method identity is guarded and no failed callback is replayed. Explicit
// registry: remains a whole-value replacement; edits use this live protocol.
[Reflect defineMethod: #publishRegistry:from: on: Module as: [:self :next :expected |
  [[ObjectModel replaceSlot: 1 in: self expected: expected with: next]
    ifTrue: [| self] ifFalse: [| [Error kind: #compensationConflict]]]
]];
[Reflect defineMethod: #record:put: on: Module as: [:self :name :record |
  [self registryMutation: [|
    let records := [self registry];
    let next := [records at: name put: record];
    [[next isError] ifTrue: [| next] ifFalse: [| [self publishRegistry: next from: records]]]
  ]]
]];
[Reflect defineMethod: #field:of: on: Module as: [:self :field :name |
  let record := [self recordOf: name];
  [[record isNil] ifTrue: [| nil] ifFalse: [| [record at: field]]]
]];
[Reflect defineMethod: #field:of:put: on: Module as: [:self :field :name :value |
  [self registryMutation: [|
    let records := [self registry];
    let old := [self recordOf: name];
    let record := [[old isNil] ifTrue: [| [Map new]] ifFalse: [| old]];
    let changed := [record at: field put: value];
    [[changed isError] ifTrue: [| changed] ifFalse: [|
      let next := [records at: name put: changed];
      [[next isError] ifTrue: [| next] ifFalse: [| [self publishRegistry: next from: records]]]
    ]]
  ]]
]];
// Removing bookkeeping does not unload code. A later load follows normal
// artifact admission again; clients must choose that policy deliberately.
[Reflect defineMethod: #removeRecord: on: Module as: [:self :name |
  [self registryMutation: [|
    let records := [self registry];
    let next := [[records keys] inject: [Map new] into: [:result :key |
      [[key == name] ifTrue: [| result] ifFalse: [| [result at: key put: [records at: key]]]]]];
    [[next isError] ifTrue: [| next] ifFalse: [| [self publishRegistry: next from: records]]]
  ]]
]];

// -- topological load order -----------------------------------------------------

// DFS post-order: finish every dependency of `name`, then append `name` to the
// `ord` cell. `ord` doubles as the finished set (a node is appended exactly when
// it finishes). `path` is the in-progress chain DOWN this recursion — a plain
// persistent Vector, grown per call, so there is nothing to pop; re-meeting a
// path member is a cycle. Answers nil, or the #circularDependency error.
[Reflect defineMethod: #visit:order:path: on: Module as: [:self :name :ord :path |
  [[[[ord value] indexOf: name] notNil]
    ifTrue:  [| nil]
    ifFalse: [|
      [[[path indexOf: name] notNil]
        ifTrue:  [| [Error kind: #circularDependency
                       message: ["circular dependency at module: " , [Reflect nameOf: name]]]]
        ifFalse: [|
          let me := self;
          let deeper := [path add: name];
          let r := [[self requiresOf: name] inject: nil into: [:acc :dep |
            [[acc isNil]
              ifTrue:  [| [me visit: dep order: ord path: deeper]]
              ifFalse: [| acc]]]];
          [[r isNil]
            ifTrue:  [| [ord set: [[ord value] add: name]]; nil]
            ifFalse: [| r]]]]]]]];

// The given names plus their transitive dependencies, sorted so every module's
// deps precede it; a cycle answers #circularDependency (naming the offender).
// Scratch belongs to this traversal, including collecting/reentrant calls.
[Reflect defineMethod: #loadOrder: on: Module as: [:self :names |
  let ord := [Cell with: #[]];
  let me := self;
  let r := [names inject: nil into: [:acc :nm |
    [[acc isNil]
      ifTrue:  [| [me visit: nm order: ord path: #[]]]
      ifFalse: [| acc]]]];
  [[r isNil] ifTrue: [| [ord value]] ifFalse: [| r]]]];

// -- runtime dylib loading -------------------------------------------------------

// The directory searched for module dylibs; the driver sets it at every boot
// (fresh-resolved, so an image moved between trees still loads from ITS tree).
[Reflect defineMethod: #slotNames on: Module as: [:self | #[#libDir #registry]]];

[Reflect defineMethod: #libDir: on: Module as: [:self :dir |
  [ObjectModel slot: 0 in: self put: dir];
  self]];

[Reflect defineMethod: #libDir on: Module as: [:self |
  let d := [ObjectModel slot: 0 in: self];
  [[d isNil] ifTrue: [| "lib"] ifFalse: [| d]]]];

[Reflect defineMethod: #dylibPathFor: on: Module as: [:self :name |
  [[[[self libDir] , "/libbirnam_"] , [Reflect nameOf: name]] , ".dylib"]]];

// Compose an explicitly ordered set of source files into one module document.
// The project adapter observes source declarations and ProjectPolicy owns
// provider validation/order; the actual file reads and source assembly stay in
// Birnam so the same operation is available to future file-backed tooling and
// live-module workflows. Every part after the entry is ordinary source and must
// not carry another Module named:requires: declaration.
[Reflect defineMethod: #composeSources: on: Module as: [:self :paths |
  [paths inject: "" into: [:text :path |
    [[text isError]
      ifTrue: [| text]
      ifFalse: [|
        let part := [System readFile: path];
        [[part isError]
          ifTrue: [| part]
          ifFalse: [| [[text , part] , "\n"]]]]]]]]];

// Inspect and validate one requested identity before walking any dependency.
[Reflect defineMethod: #descriptionOf:path: on: Module as: [:self :name :p |
  let descriptor := [Artifact inspect: p];
  [[descriptor isNil]
    ifTrue: [| [Error kind: [Artifact lastFailure]
                   message: ["could not inspect artifact: " , p]]]
    ifFalse: [|
      let kindOk := [[descriptor kind] == #module];
      [kindOk
        ifTrue: [|
          let identityOk := [[descriptor identity] == name];
          [identityOk
            ifTrue: [|
              [[[[descriptor capabilities] indexOf: ["id-object-v3" asSymbol]] notNil]
                ifTrue: [| descriptor]
                ifFalse: [| [Error kind: #artifactAbiMismatch
                               message: ["artifact has no Id native-object contract: " , p]]]]]
            ifFalse: [| [Error kind: #artifactIdentityMismatch
                           message: ["artifact identity does not match requested module: " , p]]]]]
        ifFalse: [| [Error kind: #artifactKindMismatch
                       message: ["artifact is not a module: " , p]]]]]]]];

// Build a complete dependency-first activation plan without installing any
// artifact. `within` is the in-progress chain (cycle guard); `order` contains
// already-planned descriptors and also prevents duplicate diamond dependencies.
[Reflect defineMethod: #plan:path:within:order: on: Module as: [:self :name :p :path :order |
  [[self isLoaded: name]
    ifTrue: [| order]
    ifFalse: [|
      [[[path indexOf: name] notNil]
        ifTrue: [| [Error kind: #circularDependency
                       message: ["circular dependency loading module: " , [Reflect nameOf: name]]]]
        ifFalse: [|
          let descriptor := [self descriptionOf: name path: p];
          [[descriptor isError]
            ifTrue: [| descriptor]
            ifFalse: [|
              let me := self;
              let deeper := [path add: name];
              let planned := [[descriptor requires] inject: order into: [:prior :dep |
                [[prior isError]
                  ifTrue: [| prior]
                  ifFalse: [| [me plan: dep within: deeper order: prior]]]]];
              [[planned isError]
                ifTrue: [| planned]
                ifFalse: [|
                  let existing := [planned detect: [:item | [[item identity] = name]]];
                  [[existing isNil]
                    ifTrue: [| [planned add: descriptor]]
                    ifFalse: [| planned]]]]]]]]]]]];

[Reflect defineMethod: #plan:within:order: on: Module as: [:self :name :path :order |
  [self plan: name path: [self dylibPathFor: name] within: path order: order]]];

[Reflect defineMethod: #planFor:path: on: Module as: [:self :name :p |
  [self plan: name path: p within: #[] order: #[]]]];

// Activate only a completely validated plan. A failure during inspection never
// reaches this method and therefore cannot leave a partially installed closure.
[Reflect defineMethod: #activate: on: Module as: [:self :plan |
  let me := self;
  [plan inject: self into: [:prior :descriptor |
    [[prior isError]
      ifTrue: [| prior]
      ifFalse: [|
        let name := [descriptor identity];
        [[me isLoaded: name]
          ifTrue: [| me]
          ifFalse: [|
            let installed := [Codegen load: [descriptor path]];
            [[installed isError]
              ifTrue: [| installed]
              ifFalse: [|
                [[installed isNil]
                  ifTrue: [| [Error kind: #loadFailed
                                 message: ["could not install module dylib: " , [descriptor path]]]]
                  ifFalse: [| [me markLoaded: name]]]]]]]]]]]]];

[Reflect defineMethod: #load:path: on: Module as: [:self :name :p |
  let plan := [self planFor: name path: p];
  [[plan isError]
    ifTrue: [| plan]
    ifFalse: [| [self activate: plan]]]]];

// Load module `name` and its transitive dependencies at runtime, deps first,
// each installed once. A no-op if already loaded.
[Reflect defineMethod: #load: on: Module as: [:self :name |
  [self load: name path: [self dylibPathFor: name]]]];

// Load an explicitly located root artifact. Its dependencies still resolve by
// canonical identity beside it; only the user-selected root may have an
// arbitrary filename.
[Reflect defineMethod: #loadArtifact: on: Module as: [:self :p |
  let descriptor := [Artifact inspect: p];
  [[descriptor isNil]
    ifTrue: [| [Error kind: [Artifact lastFailure]
                   message: ["could not inspect artifact: " , p]]]
    ifFalse: [|
      let name := [descriptor identity];
      [self load: name path: p]]]]];

// -- self-registration (deliberately LAST — see the header) ----------------------

[Module named: #modules requires: #[]];
// Early owner registration is runtime work, not another source declaration.
// This document and its compiled artifact must retain the identity #modules.
let earlyModuleManager := Module;
[earlyModuleManager named: #cell requires: #[]];
[earlyModuleManager markLoaded: #cell];
[Module markLoaded: #modules]
