// doc-test.birnam — the test suite for modules/doc.birnam, live style.
// Loading only registers the suite; run via modules/run-tests.birnam or:
//   [Test runTestsForModule: #doc withRunner: ConsoleRunner]
// Run from the repo root.

[[Globals includes: #TestSuite] ifTrue: [| nil] ifFalse: [| [System load: "modules/test.birnam"]]];
[[Globals includes: #Doc] ifTrue: [| nil] ifFalse: [| [System load: "modules/doc.birnam"]]];
// This suite intentionally exercises the source registration sequence. Mark it
// loaded so the compiledUnitDocs dependency does not replace that test fixture.
[Module markLoaded: #doc];
[Module load: #compiledUnitDocs];
[Module load: #nativedoc];

let s := [TestSuite named: "Doc" module: #doc];

[s test: "native scanner extracts attributed Rust declarations" do: [:t |
  let path := "/tmp/birnam-doc-test-native.rs";
  [File write: path contents: "//! Rust fixture summary.\n/// Documented structure.\n#[repr(C)]\npub(crate) struct NativeThing {\n}\n"];
  [NativeDoc scanRust: path as: #rustFixture];
  [t assert: [Doc isRustFloor: #rustFixture] describes: "Rust scan records the distinct doc kind"];
  [t expect: [[db cellFor: #rustFixture attr: #docSummary] value]
     equals: "Rust fixture summary."
     describes: "//! supplies the module summary"];
  [t assert: [[Doc cli: #rustFixture] includesSubstring: "NativeThing"]
     describes: "an attribute does not detach /// docs from the Rust declaration"];
  [File delete: path]]];

// Use a throwaway module symbol so the suite is self-contained and order-stable.
[s test: "markdown renders summary + ordered method list" do: [:t |
  [Doc module: #demoDoc is: "a demo module"];
  [Doc for: #alpha in: #demoDoc says: "the first"];
  [Doc for: #beta:  in: #demoDoc says: "the second"];
  [t expect: [Doc markdownForModule: #demoDoc]
     equals: "# demoDoc\n\na demo module\n\n- `alpha` — the first\n- `beta:` — the second\n"
     describes: "markdownForModule:"]]];

[s test: "html render composes the Html module and escapes text" do: [:t |
  [Doc module: #demoH is: "needs <escaping>"];
  [Doc for: #zzDemoHFoo in: #demoH says: "a & b"];
  let h := [Doc htmlForModule: #demoH];
  [t assert: [h includesSubstring: "<h2><a href=\"#demoH\">demoH</a></h2>"]
     describes: "h2 heading self-links the module anchor"];
  [t assert: [h includesSubstring: "needs &lt;escaping&gt;"] describes: "summary text escaped"];
  [t assert: [h includesSubstring: "<dt id=\"demoH-zzDemoHFoo\"><code>zzDemoHFoo</code></dt>"]
     describes: "entry is a <dt> with a per-selector anchor"];
  [t assert: [h includesSubstring: "<dd>a &amp; b</dd>"] describes: "docstring escaped in the <dd>"];
  [t assert: [[h includesSubstring: "class=\"kind\""] not] describes: "no native-floor badge on a birnam module"]]];

// The doc: define path records the receiver prototype; the html render badges
// it (Globals reverse lookup — prototypes print as anObject) and folds the
// method's recorded source into a collapsed <details>.
[s test: "html render shows the receiver and the recorded source" do: [:t |
  let h := [Doc htmlForModule: #doc];
  [t assert: [h includesSubstring: "<span class=\"proto\">on Doc</span>"]
     describes: "receiver prototype badged from Globals"];
  [t assert: [h includesSubstring: "<details><summary>source</summary>"]
     describes: "recorded source folded into <details>"];
  [t assert: [h includesSubstring: "selectorInSource: on: Doc"]
     describes: "the source shown is this definition's own span"]]];

// The whole-site page: a name-sorted sidebar with all native source groups apart.
[s test: "htmlIndex sorts modules and distinguishes native source groups" do: [:t |
  [Doc module: #zzOrderB is: "later"];
  [Doc module: #zzOrderA is: "earlier"];
  [Doc module: #zzOrderR is: "rust"];
  [Doc module: #zzOrderN is: "native rust"];
  [db assert: #zzOrderB attr: #docKind value: #nativeRust];
  [db assert: #zzOrderR attr: #docKind value: #rustFloor];
  [db assert: #zzOrderN attr: #docKind value: #nativeRust];
  [t assert: [Doc isNativeRust: #zzOrderB] describes: "docKind fact makes native Rust true"];
  [t assert: [[Doc isNativeRust: #zzOrderA] not] describes: "unmarked module is not native Rust"];
  [t assert: [Doc isRustFloor: #zzOrderR] describes: "docKind fact makes isRustFloor: true"];
  [t assert: [[Doc isRustFloor: #zzOrderA] not] describes: "unmarked module is not Rust floor"];
  [t assert: [Doc isNativeRust: #zzOrderN] describes: "docKind fact makes isNativeRust: true"];
  [t assert: [[Doc isNativeRust: #zzOrderR] not] describes: "Rust floor is not a higher native crate"];
  let names := [[Doc sortedModules] inject: "" into: [:acc :m | [[acc , [Doc nameOf: m]] , " "]]];
  [t assert: [[names indexOf: "zzOrderA "] < [names indexOf: "zzOrderB "]]
     describes: "sortedModules orders by display name"];
  let page := [Doc htmlIndex];
  [t assert: [page includesSubstring: "<style>"] describes: "page carries the inline stylesheet"];
  [t assert: [page includesSubstring: "Rust floor"] describes: "nav has the Rust-floor group"];
  [t assert: [page includesSubstring: "Native Rust"] describes: "nav has the native-Rust group"];
  [t assert: [page includesSubstring: "<section id=\"zzOrderA\">"] describes: "a section per module"];
  [t assert: [page includesSubstring: "<meta charset=\"utf-8\">"] describes: "charset meta present"]]];

[s test: "a documented module shows up in the registry query" do: [:t |
  [Doc module: #demoReg is: "registered"];
  let names   := [[Doc modules] inject: "" into: [:acc :m | [acc , [m printString] , " "]]];
  let without := [names replace: "#demoReg" with: ""];
  [t assert: [[without size] < [names size]] describes: "#demoReg present in [Doc modules]"];
  [t assert: [[[Doc methodsOf: #demoReg] size] = 0] describes: "methodsOf: empty when none registered"]]];

[s test: "selectorInSource: reads the selector out of a definition span" do: [:t |
  [t expect: [Doc selectorInSource: "[Reflect defineMethod: #tag:body: on: Html as: [x]]"]
     equals: "tag:body:"
     describes: "selectorInSource: keeps a keyword selector's colons"];
  [t expect: [Doc selectorInSource: "[Reflect defineMethod: #go on: X as: [:s | [s at: #k]]]"]
     equals: "go"
     describes: "a symbol in the BODY is not the selector (first-# parse)"];
  [t expect: [Doc selectorInSource: "[x at: #k]"]
     equals: ""
     describes: "not a definition -> empty"]]];

// Undocumented methods in the current generation remain queryable from their
// complete module documents.
[s test: "source fallback surfaces a generation method's own source" do: [:t |
  let srcs := [Doc sourcesForSelector: "escape:"];
  [t assert: [[srcs size] >= 1] describes: "sourcesForSelector: finds the recorded source"];
  let body := [Doc hoverBodyFor: "escape:"];
  [t assert: [body includesSubstring: "escape"] describes: "hoverBodyFor: includes the source"];
  [t assert: [body includesSubstring: "```birnam"] describes: "hoverBodyFor: fences source as birnam"]]];

// A hand-written docstring wins over the source fallback.
[s test: "hoverBodyFor: prefers a registered docstring over source" do: [:t |
  [Doc module: #demoHov is: "hover demo"];
  [Doc for: #zzHovSel in: #demoHov says: "the registered docstring"];
  [t assert: [[Doc hoverBodyFor: "zzHovSel"] includesSubstring: "the registered docstring"]
     describes: "docstring beats source"]]];

// `[System load:]` records the whole file under `#__modsrc__` keyed by basename, so
// moduleSource: works for a from-source load too (running this suite loaded #doc).
[s test: "a from-source load records the whole-module source" do: [:t |
  let src := [Doc moduleSource: #doc];
  [t assert: [[src size] > 0] describes: "moduleSource: #doc is recorded"];
  [t assert: [src includesSubstring: "defineMethod: #module:is:"]
     describes: "it is the actual doc.birnam source"]]];

// The header prose = the leading `//` block of the recorded source; stripping
// eats "// " but keeps deeper indentation (example alignment survives).
[s test: "headerOf: extracts the leading comment block" do: [:t |
  [t expect: [Doc stripSlashes: "// plain prose"] equals: "plain prose"
     describes: "marker and one space eaten"];
  [t expect: [Doc stripSlashes: "//   [an example]"] equals: "  [an example]"
     describes: "deeper indentation kept"];
  [t expect: [Doc stripSlashes: "//"] equals: "" describes: "bare marker is empty"];
  let h := [Doc headerOf: #doc];
  [t assert: [h startsWith: "doc.birnam"] describes: "header opens with the file's own first line"];
  [t assert: [[h includesSubstring: "defineMethod: #module:is:"] not]
     describes: "the block stops at the first non-comment line"];
  [t expect: [Doc headerOf: #zzNeverLoaded] equals: "" describes: "no recorded source -> empty"]]];

// Html escape is generation-owned and undocumented, so the gap audit lists it;
// zzHovSel was documented, so it must not appear.
[s test: "undocumentedSelectors lists recorded-but-undocumented names" do: [:t |
  let gaps := [Doc undocumentedSelectors];
  [t assert: [gaps includes: "escape:"] describes: "the generation method is a gap"];
  [t assert: [[gaps includes: "zzHovSel"] not] describes: "a documented selector is not"]]];

[s test: "coverage count uses the supplied index and any module's documentation" do: [:t |
  [Doc module: #coverageFixture is: "coverage"];
  [Doc for: #zzDocumentedCoverage in: #coverageFixture says: "known"];
  let idx := [[[Map new] at: "zzDocumentedCoverage" put: #[]]
    at: "zzSourceOnlyCoverage" put: #[]];
  [t expect: [Doc undocumentedSelectorCountIn: idx] equals: 1
     describes: "only source-only keys counted"];
  [t expect: [Doc undocumentedSelectorCountIn: [Map new]] equals: 0
     describes: "an empty provided index stays empty"]]];

// Guides: static .md pages load in filename order, take their title from the
// first heading, and render into #guide-<slug> sections ahead of the modules.
[s test: "loadGuides: reads, orders, titles, and renders markdown pages" do: [:t |
  let dir := "/tmp/birnam-doc-test-guides";
  [File makeDir: dir];
  [File write: [dir , "/02-second.md"] contents: "# Second page\n\nlater."];
  [File write: [dir , "/01-first.md"]  contents: "# First page\n\nwith `code`."];
  let gs := [Doc loadGuides: dir];
  [t expect: [gs size] equals: 2 describes: "both pages loaded"];
  [t expect: [[db cellFor: [gs first] attr: #title] value] equals: "First page"
     describes: "filename order, title from the # heading"];
  let page := [Doc htmlIndex];
  [t assert: [page includesSubstring: "<section id=\"guide-01-first\" class=\"guide\">"]
     describes: "a guide section with the slug anchor"];
  [t assert: [page includesSubstring: "<h2 id=\"first-page\">First page</h2>"]
     describes: "the page # heading renders shifted to h2"];
  [t assert: [page includesSubstring: ">guide</h2>"] describes: "nav has the guide group"];
  [Doc loadGuides: "/tmp/birnam-doc-test-no-such-dir"];
  [t expect: [[[db cellFor: Doc attr: #guides] value] size] equals: 0
     describes: "a missing dir is an empty guide set"]]];

// The whole-site page grows the interactive bits: filter box, script, footer.
[s test: "htmlIndex carries the filter box and the coverage footer" do: [:t |
  let page := [Doc htmlIndex];
  [t assert: [page includesSubstring: "<input id=\"q\""] describes: "filter input in the nav"];
  [t assert: [page includesSubstring: "addEventListener"] describes: "filter script inlined"];
  [t assert: [page includesSubstring: "still source-only</footer>"] describes: "coverage footer closes the main column"];
  [t assert: [page includesSubstring: "module notes"] describes: "a header-prose details rendered (doc module has one)"]]];

// Lifecycle reference prose is registered separately so documentation changes do
// not alter CompiledUnit's executable method-operation stream.
[s test: "CompiledUnit reference registrations cover the public lifecycle" do: [:t |
  [t expect: [[Doc methodsOf: #compiledUnit] size] equals: 18
     describes: "documented lifecycle selectors registered"];
  let md := [Doc markdownForModule: #compiledUnit];
  [t assert: [md includesSubstring: "`activate` — Apply the selected"]
     describes: "authored activation reference is rendered"];
  [t assert: [md includesSubstring: "`rollback` — Apply conditional"]
     describes: "guarded rollback reference is rendered"]]];

// Scan the real workspace after fixture rendering: the scan registers all native
// documentation, which would otherwise inflate every htmlIndex fixture below it.
[s test: "workspace scanner distinguishes the floor from other native Rust crates" do: [:t |
  let mods := [NativeDoc scanRustWorkspace: "."];
  let floorMod := ["rust-lib" asSymbol];
  let abiMod := ["rust-abi" asSymbol];
  [t assert: [mods includes: floorMod] describes: "birnam-id lib.rs keeps the Rust-floor identity"];
  [t assert: [mods includes: abiMod] describes: "birnam-abi lib.rs gets its crate identity"];
  [t assert: [Doc isRustFloor: floorMod] describes: "birnam-id source is #rustFloor"];
  [t assert: [Doc isNativeRust: abiMod] describes: "birnam-abi source is #nativeRust"];
  [t assert: [[Doc isNativeRust: floorMod] not] describes: "floor source is not conflated with higher native Rust"];
  [t assert: [[Doc isRustFloor: abiMod] not] describes: "shared native crate is not conflated with the floor"]]];

s
