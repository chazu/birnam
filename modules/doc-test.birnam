// doc-test.birnam — the test suite for modules/doc.birnam, live style.
// Loading only registers the suite; run via modules/run-tests.birnam or:
//   [Test runTestsForModule: #doc withRunner: ConsoleRunner]
// Run from the repo root.

[[Globals includes: #TestSuite] ifTrue: [| nil] ifFalse: [| [System load: "modules/test.birnam"]]];
[[Globals includes: #Doc]       ifTrue: [| nil] ifFalse: [| [System load: "modules/doc.birnam"]]];

let s := [TestSuite named: "Doc" module: #doc];

// Use a throwaway module symbol so the suite is self-contained and order-stable.
[s test: "markdown renders summary + ordered method list" do: [:t |
  [Doc module: #demoDoc is: "a demo module"];
  [Doc for: #alpha in: #demoDoc says: "the first"];
  [Doc for: #beta:  in: #demoDoc says: "the second"];
  [t expect: [Doc markdownForModule: #demoDoc]
     equals: "# demoDoc\n\na demo module\n\n- `alpha` — the first\n- `beta:` — the second\n"
     describes: "markdownForModule:"]]];

[s test: "html render composes the Html module and escapes text" do: [:t |
  [Doc module: #demoH is: "needs <escaping>"];
  [Doc for: #foo in: #demoH says: "a & b"];
  [t expect: [Doc htmlForModule: #demoH]
     equals: "<h1>demoH</h1><p>needs &lt;escaping&gt;</p><ul><li><code>foo</code> — a &amp; b</li></ul>"
     describes: "htmlForModule:"]]];

[s test: "a documented module shows up in the registry query" do: [:t |
  [Doc module: #demoReg is: "registered"];
  let names   := [[Doc modules] inject: "" into: [:acc :m | [acc , [m printString] , " "]]];
  let without := [names replace: "#demoReg" with: ""];
  [t assert: [[without size] < [names size]] describes: "#demoReg present in [Doc modules]"];
  [t assert: [[[Doc methodsOf: #demoReg] size] = 0] describes: "methodsOf: empty when none registered"]]];

[s test: "selectorInSource: reads the selector out of a definition span" do: [:t |
  [t expect: [Doc selectorInSource: "[Reflect defineMethod: #tag:body: on: Html as: [x]]"]
     equals: "tag:body:"
     describes: "selectorInSource: keeps a keyword selector's colons"]]];

// A bare `defineMethod:on:as:` records its source on `#__methods__`, so an
// undocumented selector is still queryable — Doc falls back to that source.
[s test: "source fallback surfaces an undocumented method's own source" do: [:t |
  let demo := [Object clone];
  [Reflect defineMethod: #zzDemoSrc on: demo as: [:self | 42]];
  let srcs := [Doc sourcesForSelector: "zzDemoSrc"];
  [t assert: [[srcs size] >= 1] describes: "sourcesForSelector: finds the recorded source"];
  let body := [Doc hoverBodyFor: "zzDemoSrc"];
  [t assert: [body includesSubstring: "zzDemoSrc"] describes: "hoverBodyFor: includes the source"];
  [t assert: [body includesSubstring: "```birnam"] describes: "hoverBodyFor: fences source as birnam"]]];

// A hand-written docstring wins over the source fallback.
[s test: "hoverBodyFor: prefers a registered docstring over source" do: [:t |
  [Doc module: #demoHov is: "hover demo"];
  [Doc for: #zzHovSel in: #demoHov says: "the registered docstring"];
  [t assert: [[Doc hoverBodyFor: "zzHovSel"] includesSubstring: "the registered docstring"]
     describes: "docstring beats source"]]];

// `[System load:]` records the whole file under `#__modsrc__` keyed by basename, so
// moduleSource: works for a from-source load too (running this suite loaded #doc).
[s test: "a from-source load records the whole-module source" do: [:t |
  let src := [Doc moduleSource: #doc];
  [t assert: [[src size] > 0] describes: "moduleSource: #doc is recorded"];
  [t assert: [src includesSubstring: "defineMethod: #module:is:"]
     describes: "it is the actual doc.birnam source"]]];

s
