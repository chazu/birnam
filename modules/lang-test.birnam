// lang-test.birnam — the test suite for the birnam grammar itself, focused on
// statement separation. The separator `;` is OPTIONAL: every expr form is
// self-delimiting (a bracketed group `[..]`/`#[..]`/`{..}`, or a single token)
// and nothing juxtaposes at statement level, so whitespace alone already tells
// two statements apart. Both spellings, and any mixture, must parse to the same
// program — that equivalence is what these cases pin. Loading only registers the
// suite; run via modules/run-tests.birnam.

[[Globals includes: #TestSuite] ifTrue: [| nil] ifFalse: [| [System load: "modules/test.birnam"]]];

let s := [TestSuite named: "Lang" module: #lang];

[s test: "whitespace alone separates two statements" do: [:t |
  [t expect: [Codegen evalPersisting: "[1 + 2]
[3 + 4]"] equals: 7 describes: "answers the last statement's value"];
  [t expect: [[Lang parse: "[1 + 2]
[3 + 4]"] isNil] equals: false describes: "and it parses"]]];

[s test: "`;` still separates, and still ends a unit" do: [:t |
  [t expect: [Codegen evalPersisting: "[1 + 2]; [3 + 4]"] equals: 7
     describes: "separator form"];
  [t expect: [Codegen evalPersisting: "[1 + 2]; [3 + 4];"] equals: 7
     describes: "trailing terminator form"]]];

[s test: "the two spellings are one program" do: [:t |
  let withSemis := [Lang parse: "let langTestA := 1; let langTestB := 2; [langTestA + langTestB]"];
  let without := [Lang parse: "let langTestA := 1
let langTestB := 2
[langTestA + langTestB]"];
  [t expect: [withSemis childCount] equals: [without childCount]
     describes: "same program shape"];
  [t expect: [Codegen evalPersisting: "let langTestC := 1
let langTestD := 2
[langTestC + langTestD]"] equals: 3 describes: "and the same value"]]];

[s test: "separators may be mixed within one unit" do: [:t |
  [t expect: [Codegen evalPersisting: "let langTestE := 10; let langTestF := 20
[langTestE + langTestF];"] equals: 30 describes: "`;` and newline in the same unit"]]];

[s test: "a block body separates the same way" do: [:t |
  [t expect: [Codegen evalPersisting: "[[| [1 + 1] [2 + 2]] value]"] equals: 4
     describes: "two statements, no separator, last one wins"];
  [t expect: [Codegen evalPersisting: "[[:x | [x + 1]; [x + 2]] value: 10]"] equals: 12
     describes: "and the `;` spelling still works"]]];

// A syntax failure answers nil or a kinded error, never a CST — the same test
// `Lsp analysisParsed:` makes before it trusts a parse.
[s test: "dropping the separator does not make broken source parse" do: [:t |
  let unclosed := [Lang parse: "let x := [foo bar"];
  [t expect: [[unclosed isNil] | [unclosed isError]] equals: true
     describes: "an unclosed bracket is still a syntax failure"];
  let malformed := [Lang parse: "let := 3"];
  [t expect: [[malformed isNil] | [malformed isError]] equals: true
     describes: "a malformed binding is still a syntax failure"]]];

[s test: "=> parses one dispatch per marked leg in every category" do: [:t |
  let forms := #[
    "[x => foo]"
    "[x => + 1]"
    "[x => at: 0]"
    "[x => foo => bar]"
    "[x => foo => + 1]"
    "[x => foo => at: 0 put: 1]"
    "[x => + 1 => foo]"
    "[x => + 1 => * 2]"
    "[x => + 1 => at: 0]"
    "[x => at: 0 => foo]"
    "[x => at: 0 => + 1]"
    "[x => at: 0 => at: 1 put: 2]"];
  [t assert: [forms allSatisfy: [:source |
     let parsed := [Lang parse: source];
     [[[parsed isNil] | [parsed isError]] not]]]
     describes: "unary, binary, and whole keyword legs may follow each other"]]];

[s test: "=> spacing, nesting, and exact operator reservation" do: [:t |
  let accepted := #[
    "[x => foo]"
    "[x =>\nfoo]"
    "[x => // marker comment\nfoo]"
    "[m at: k put: [n => foo]]"
    "[1 =>+ 2]"
    "#=>"];
  [t assert: [accepted allSatisfy: [:source |
     let parsed := [Lang parse: source];
     [[[parsed isNil] | [parsed isError]] not]]]
     describes: "marker whitespace/comments work while #=> and =>+ remain data/messages"];
  let rejected := #["[x =>]" "[x =>foo]" "[x => => foo]" "[x + 1 => foo]" "[x foo => bar]"];
  [t assert: [rejected allSatisfy: [:source |
     let parsed := [Lang parse: source];
     [[parsed isNil] | [parsed isError]]]]
     describes: "malformed and mixed threaded forms do not fall back to ordinary sends"]]];

[s test: "=> lowers to ordinary left-to-right result threading" do: [:t |
  [t expect: [Codegen evalPersisting: "[1 => + 2 => * 3]"] equals: 9
     describes: "each result is the next receiver"];
  [t expect: [Codegen evalPersisting: "let threadCount := [0 asCell]
let threadedValue := [[threadCount inc] => + 1 => * 2]
#[threadedValue [threadCount value]]"] equals: #[4 1]
     describes: "the original receiver expression runs once"];
  [t expect: [Codegen evalPersisting: "[{#a -> 1} at: #b put: [2 => + 3]]"]
     equals: {#a -> 1 #b -> 5} describes: "a threaded argument remains bracketed"];
  let threadedError := [Codegen evalPersisting: "[[\"boom\" error: #threadTest] => ifNotError: [:x | 9]]"];
  [t expect: [threadedError kind] equals: #threadTest
     describes: "threading adds no error behavior of its own"];
  // Source spans and revision digests deliberately differ in emitted artifacts.
  // Compare the executable Portable Code after dropping only provenance.
  let threaded := [[[:x | [x => + 2 => * 3]] codeObject] withoutSourceProvenance];
  let nested := [[[:x | [[x + 2] * 3]] codeObject] withoutSourceProvenance];
  [t expect: [threaded format] equals: #portableProgramV1 describes: "threading produces Portable Code"];
  [t expect: [nested format] equals: #portableProgramV1 describes: "nested sends produce Portable Code"];
  [t assert: [[threaded digest] = [nested digest]]
     describes: "portable operations are identical to nested sends"]]];

[s test: "source-sensitive special forms reject a threaded head" do: [:t |
  let forms := #[
    "[System => embedFile: \"missing.txt\"]"
    "[Module => named: #bad requires: #[]]"
    "[Alien => dlopen: \"missing\"]"
    "[Reflect => defineMethod: #x on: Object as: [:self | self]]"
    "[Reflect => defineMethod: #x on: Object as: [:self | self] doc: \"x\"]"
    "[Reflect => removeMethod: #x on: Object]"];
  [forms do: [:source |
     [t expect: [Codegen evalPersisting: source] equals: nil
        describes: "the threaded special form does not compile"];
     [t assert: [[Codegen lastError] includesSubstring: "source-sensitive special forms"]
        describes: "the diagnostic names the source-form restriction"]]]]];
