// time.birnam — wall-clock time for birnam, implemented IN birnam over libc.
//
// A birnam-native OS module. The only irreducible capability it needs is "call a
// C function and read raw memory" — and `Alien` already provides both (FFI +
// `alloc:`/`peek*At:`), so this module is pure birnam with NO new native code. libc's
// `gettimeofday` fills a `struct timeval` we allocate; we read the seconds and
// microseconds back out and fold them into epoch milliseconds.
//
// Load it (from the repo root) with:
//   [Module load: #time]

// int gettimeofday(struct timeval *tv, struct timezone *tz)
//   struct timeval { long tv_sec; int tv_usec; }   // macOS: 8 + 4 bytes (16 w/ pad)
// Alien marshals the method receiver as the FIRST C argument, so the receiver IS
// the tv buffer (a ForeignAddress from `Alien alloc:`) and `tz` is the argument.
[Alien wrap: "gettimeofday" signature: "i p p" as: #fillTimeval: on: ForeignAddress];

// uint64_t clock_gettime_nsec_np(clockid_t) — macOS-only: a monotonic clock in
// ONE call, no out-param buffer. The receiver (an Integer) is the clock id;
// `u` marshals the uint64 return as an Integer (ns-since-boot fits i64 easily).
[Alien wrap: "clock_gettime_nsec_np" signature: "u i" as: #clockNanos on: Integer];

// The module: a named singleton, the same shape as the self-hosted Config / Toml.
[Module named: #time requires: #[]];
[Globals at: #Time put: [Object clone]];
[Reflect docModule: #time is: "Wall-clock time over libc gettimeofday()."];

[Reflect defineMethod: #nowMillis on: Time as: [:self |
  let tv := [Alien alloc: 16];
  let tz := [Alien alloc: 8];
  [tv fillTimeval: tz];
  let sec  := [tv peekIntAt: 0];
  let usec := [tv peekIntAt: 8];
  [tv free];
  [tz free];
  [[sec * 1000] + [usec / 1000]]] doc:
  "Epoch milliseconds as an Integer (full i64 — no year-2038 wrap)."];

[Reflect defineMethod: #nowSeconds on: Time as: [:self |
  [[self nowMillis] / 1000]] doc:
  "Epoch seconds as an Integer."];

// CLOCK_MONOTONIC = 6 on Darwin. Monotonic: never steps backward (NTP-immune),
// so deltas are safe for interval timing — this is the benchmark timer
// (docs/design/46). NOT epoch-anchored: only differences mean anything.
[Reflect defineMethod: #monotonicMicros on: Time as: [:self |
  [[6 clockNanos] / 1000]] doc:
  "Monotonic microseconds (CLOCK_MONOTONIC) — for interval timing; not epoch-anchored."]
