// digla-test.birnam — headless contract for the composed Digla module.

[[Globals includes: #TestSuite] ifTrue: [| nil] ifFalse: [| [System load: "modules/test.birnam"]]];
[[Globals includes: #AppConfig] ifTrue: [| nil] ifFalse: [| [System load: "src/id/app-config.birnam"]]];
[[Globals includes: #Digla]
  ifTrue: [| nil]
  ifFalse: [|
    [System load: "modules/digla/digla.birnam"];
    [System load: "modules/digla/config.birnam"];
    [System load: "modules/digla/session.birnam"];
    [System load: "modules/digla/render.birnam"]]];

let s := [TestSuite named: "Digla" module: #digla];

[s test: "Digla defaults resolve through AppConfig" do: [:t |
  let env := [Map new];
  let config := [Digla configAtPath: nil environment: env args: #[]];
  [t expect: [config at: "mode"] equals: "local" describes: "default mode"];
  [t expect: [config at: "port"] equals: 4400 describes: "default port"];
  [t expect: [config at: "evaluation-timeout-ms"] equals: 0
    describes: "interactive evaluation is unlimited by default"];
  [t expect: [config originAt: "history"] equals: "default" describes: "default origin"]]];

[s test: "Digla keeps AppConfig precedence and exposes session state" do: [:t |
  let env0 := [Map new];
  let env := [env0 at: "DIGLA_CONNECT" put: "remote"];
  let config := [Digla configAtPath: nil environment: env
    args: #["--port=5555" "--evaluation-timeout-ms=25"]];
  let state := [Digla sessionStateFor: config];
  [t expect: [config at: "connect"] equals: "remote" describes: "environment connection"];
  [t expect: [config at: "port"] equals: 5555 describes: "CLI port"];
  [t expect: [config at: "evaluation-timeout-ms"] equals: 25
    describes: "CLI evaluation deadline"];
  [t expect: [state at: "buffer"] equals: "" describes: "empty editor buffer"];
  [t expect: [state at: "cursor"] equals: 0 describes: "initial cursor"]]];

[s test: "Digla summary is stable and reports the selected config path" do: [:t |
  let config := [Digla configAtPath: "/tmp/digla-test.toml" environment: [Map new] args: #[]];
  let summary := [Digla summary: config];
  [t assert: [summary includesSubstring: "Digla mode=local"] describes: "summary app name and mode"];
  [t assert: [summary includesSubstring: "endpoint=127.0.0.1:4400"] describes: "summary endpoint"];
  [t assert: [summary includesSubstring: "config=/tmp/digla-test.toml"] describes: "summary path"]]];
