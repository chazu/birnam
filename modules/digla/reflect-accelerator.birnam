// reflect-accelerator.birnam — Digla-local runtime and display acceleration.
//
// The wrapped module exports a private DiglaAccelerator prototype. Digla methods
// delegate to that application-owned interface; the only core hooks (System
// output and cooperative loops) are installed through Store's tracked MOP.

[Module named: #diglaReflect requires: #[#digla]];
[Reflect docModule: #diglaReflect is:
  "Digla-owned native acceleration behind explicit session and evaluation contexts."];
let path := [[Module libDir] , "/libdiglareflect.dylib"];
let loaded := [System loadModule: path];
[[loaded isError] ifTrue: [| loaded] ifFalse: [| Module]];

[Reflect defineMethod: #newEvaluationContext on: Digla as: [:self |
  [DiglaAccelerator new]]];
[Reflect defineMethod: #effectiveMethodsOf: on: Digla as: [:self :value |
  [DiglaAccelerator allMethodsOf: value]]];
[Reflect defineMethod: #outputCaptureAvailable on: Digla as: [:self |
  [DiglaAccelerator outputCaptureAvailable]]];
[Reflect defineMethod: #beginEvaluationOutputCaptureIn: on: Digla as: [:self :context |
  [context beginEvaluationOutputCapture]]];
[Reflect defineMethod: #endEvaluationOutputCaptureIn: on: Digla as: [:self :context |
  [context endEvaluationOutputCapture]]];
[Reflect defineMethod: #evaluationOutputStreamingAvailable on: Digla as: [:self |
  [DiglaAccelerator evaluationOutputStreamingAvailable]]];
[Reflect defineMethod: #beginEvaluationOutputStreaming:in: on: Digla as:
  [:self :sink :context | [context beginEvaluationOutputStreaming: sink]]];
[Reflect defineMethod: #endEvaluationOutputStreamingIn: on: Digla as: [:self :context |
  [context endEvaluationOutputStreaming]]];
[Reflect defineMethod: #evaluationDeadlineAvailable on: Digla as: [:self |
  [DiglaAccelerator evaluationDeadlineAvailable]]];
[Reflect defineMethod: #beginEvaluationDeadline:in: on: Digla as:
  [:self :timeoutMs :context | [context beginEvaluationDeadline: timeoutMs]]];
[Reflect defineMethod: #endEvaluationDeadlineIn: on: Digla as: [:self :context |
  [context endEvaluationDeadline]]];
[Reflect defineMethod: #beginEvaluationInterruptProbe:in: on: Digla as:
  [:self :probe :context | [context beginEvaluationInterruptProbe: probe]]];
[Reflect defineMethod: #endEvaluationInterruptProbeIn: on: Digla as: [:self :context |
  [context endEvaluationInterruptProbe]]];
[Reflect defineMethod: #runtimeNamed: on: Digla as: [:self :name |
  [DiglaAccelerator runtimeNamed: name]]];
[Reflect defineMethod: #wrapTranscriptLine:width: on: Digla as: [:self :text :width |
  [DiglaAccelerator wrapTranscriptLine: text width: width]]]
