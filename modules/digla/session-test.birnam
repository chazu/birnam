// session-test.birnam — transport-neutral live-image session contracts.

let e := [TestSuite named: "Digla session" module: #diglaSession];

[e test: "local session handshake is transport-safe and truthful" do: [:t |
  let config := [Digla configAtPath: nil environment: [Map new] args: #[]];
  let session := [Digla localSessionFor: config];
  let reply := [Digla callSession: "birnam/session/open" params: [Map new] in: session];
  let result := [Digla sessionResultOf: reply];
  let capabilities := [result at: "capabilities"];
  let encoded := [Json stringify: [reply at: "message"]];
  let decoded := [Json parse: encoded];
  [t expect: [result at: "adapter"] equals: "local" describes: "adapter identity"];
  [t expect: [capabilities at: "evaluate"] equals: true describes: "evaluation advertised"];
  [t expect: [capabilities at: "snapshot"] equals: true describes: "snapshot advertised"];
  [t expect: [capabilities at: "interrupt"] equals: false describes: "interrupt is truthful"];
  [t expect: [capabilities at: "outputEvents"] equals: false
    describes: "headless adapter does not claim an unloaded capture wrapper"];
  [t expect: [capabilities at: "cooperativeDeadline"] equals: false
    describes: "headless adapter does not claim unloaded loop safepoints"];
  [t assert: [encoded startsWith: "{"] describes: "handshake is JSON-shaped"];
  [t expect: [decoded isError] equals: false describes: "handshake round-trips as JSON"]]];

[e test: "read-only sessions carry inspection without evaluation authority" do: [:t |
  let config := [Digla configAtPath: nil environment: [Map new] args: #[]];
  let session := [Digla inspectionSessionFor: config];
  let capabilities := [session at: "capabilities"];
  let inspected := [Digla callSession: "birnam/snapshot" params: {
    "target" -> "String", "sections" -> #["object"] } in: session];
  let evaluated := [Digla callSession: "birnam/evaluate"
    params: { "source" -> "[40 + 2]" } in: [inspected at: "session"]];
  [t expect: [capabilities at: "inspect"] equals: true describes: "inspection is explicit"];
  [t expect: [capabilities at: "evaluate"] equals: false describes: "evaluation is absent"];
  [t expect: [DiglaOption isSome: [session at: "evaluationCapability"]] equals: false
    describes: "session holds no hidden evaluator"];
  [t expect: [[[[Digla sessionResultOf: inspected] at: "snapshot"] at: "target"] at: "globalName"]
    equals: "String" describes: "inspection capability remains usable"];
  [t expect: [[[evaluated at: "message"] at: "error"] at: "code"] equals: -32002
    describes: "evaluation is rejected at the capability boundary"]]];

[e test: "snapshot protocol returns selected method source as copied data" do: [:t |
  let config := [Digla configAtPath: nil environment: [Map new] args: #[]];
  let reply := [Digla callSession: "birnam/snapshot" params: {
    "target" -> "String", "sections" -> #["object" "methods" "source"],
    "selector" -> "asUppercase", "includeSource" -> true }
    in: [Digla localSessionFor: config]];
  let snapshot := [[Digla sessionResultOf: reply] at: "snapshot"];
  let method := [[snapshot at: "methods"] at: 0];
  let encoded := [Json stringify: [reply at: "message"]];
  [t expect: [method at: "sourceAvailable"] equals: true describes: "source lookup succeeds"];
  [t assert: [[method at: "source"] includesSubstring: "#asUppercase"]
    describes: "source crosses the session seam"];
  [t assert: [encoded includesSubstring: "asUppercase"] describes: "snapshot is JSON-safe"]]];

[e test: "snapshot protocol carries historical facts and since changes as copied data" do: [:t |
  let fixture := [Object clone];
  [Globals at: #DiglaSessionTemporal put: fixture];
  [db assert: #diglaSessionHistoried attr: #history value: true];
  [db assert: fixture attr: #diglaSessionHistoried value: "old"];
  let basis := [db basis];
  [db assert: fixture attr: #diglaSessionHistoried value: "new"];
  let config := [Digla configAtPath: nil environment: [Map new] args: #[]];
  let reply := [Digla callSession: "birnam/snapshot" params: {
    "target" -> "DiglaSessionTemporal",
    "sections" -> #["facts" "changes"], "asOf" -> basis, "since" -> basis }
    in: [Digla localSessionFor: config]];
  let snapshot := [[Digla sessionResultOf: reply] at: "snapshot"];
  let fact := [[snapshot at: "facts"] detect: [:card |
    [[card at: "attribute"] = "diglaSessionHistoried"]]];
  let change := [[snapshot at: "changes"] detect: [:card |
    [[card at: "attribute"] = "diglaSessionHistoried"]]];
  let encoded := [Json stringify: [reply at: "message"]];
  [t expect: [fact at: "value"] equals: "old" describes: "old fact crosses session seam"];
  [t expect: [change at: "value"] equals: "new" describes: "change crosses session seam"];
  [t assert: [encoded includesSubstring: "diglaSessionHistoried"]
    describes: "temporal snapshot remains JSON-safe"]]];

[e test: "evaluation copies values and preserves the last success across errors" do: [:t |
  let config := [Digla configAtPath: nil environment: [Map new] args: #[]];
  let first := [Digla callSession: "birnam/evaluate" params: { "source" -> "[40 + 2]" }
    in: [Digla localSessionFor: config]];
  let firstResult := [Digla sessionResultOf: first];
  let failed := [Digla callSession: "birnam/evaluate" params: { "source" -> "[40 +" }
    in: [first at: "session"]];
  let failedResult := [Digla sessionResultOf: failed];
  let inspected := [Digla callSession: "birnam/inspect" params: [Map new]
    in: [failed at: "session"]];
  let snapshot := [[Digla sessionResultOf: inspected] at: "snapshot"];
  [t expect: [firstResult at: "ok"] equals: true describes: "successful evaluation"];
  [t expect: [[firstResult at: "value"] at: "value"] equals: 42 describes: "copied scalar value"];
  [t expect: [failedResult at: "phase"] equals: "compile" describes: "structured compile failure"];
  [t expect: [[[failedResult at: "diagnostics"] at: 0] at: "kind"]
    equals: "syntaxError" describes: "compile failure carries a structured diagnostic"];
  [t expect: [[[failedResult at: "diagnostics"] at: 0] at: "start"]
    equals: 5 describes: "diagnostic retains its source-byte position"];
  [t expect: [[snapshot at: "target"] at: "printString"] equals: "42"
    describes: "failed evaluation does not erase the last success"];
  [t assert: [[[Json stringify: [first at: "message"]] includesSubstring: "structured"] not]
    describes: "serialization succeeds without raw capabilities"]]];

[e test: "a successful nil evaluation is present and inspectable" do: [:t |
  let config := [Digla configAtPath: nil environment: [Map new] args: #[]];
  let evaluated := [Digla callSession: "birnam/evaluate" params: { "source" -> "nil" }
    in: [Digla localSessionFor: config]];
  let session := [evaluated at: "session"];
  let lastValue := [session at: "lastValue"];
  let value := [DiglaOption valueOf: lastValue ifAbsent: [| "absent"]];
  let inspected := [Digla callSession: "birnam/inspect" params: [Map new] in: session];
  [t expect: [DiglaOption isSome: lastValue] equals: true
    describes: "successful evaluation records presence independently of value"];
  [t expect: [value isNil] equals: true describes: "the recorded value remains real nil"];
  [t expect: [[[evaluated at: "message"] at: "error" ifAbsent: [| nil]] isNil]
    equals: true describes: "nil evaluation is not mistaken for a request failure"];
  [t expect: [[[[Digla sessionResultOf: inspected] at: "snapshot"] at: "target"]
    at: "printString"] equals: "nil" describes: "present nil remains inspectable"]]];

[e test: "requested deadlines fail explicitly when no safepoint adapter is loaded" do: [:t |
  let config := [Digla configAtPath: nil environment: [Map new] args: #[]];
  let reply := [Digla callSession: "birnam/evaluate" params: {
    "source" -> "42", "timeoutMs" -> 5 } in: [Digla localSessionFor: config]];
  let result := [Digla sessionResultOf: reply];
  [t expect: [result at: "ok"] equals: false describes: "request is rejected"];
  [t expect: [result at: "phase"] equals: "request" describes: "failure is pre-evaluation"];
  [t assert: [[result at: "message"] includesSubstring: "deadline adapter"]
    describes: "unsupported safety request is not silently ignored"]]];

[e test: "inspection, globals, close, and protocol failures are explicit" do: [:t |
  [Globals at: #DiglaSessionVisible put: 7];
  [Globals at: #__DiglaSessionInternal put: 8];
  let config := [Digla configAtPath: nil environment: [Map new] args: #[]];
  let session := [Digla localSessionFor: config];
  let inspected := [Digla callSession: "birnam/inspect"
    params: { "globalName" -> "DiglaSessionVisible" } in: session];
  let globalsReply := [Digla callSession: "birnam/globals" params: [Map new]
    in: [inspected at: "session"]];
  let names := [[Digla sessionResultOf: globalsReply] at: "globals"];
  let completionReply := [Digla callSession: "birnam/runtimeCompletion"
    params: { "prefix" -> "DiglaSessionV" } in: [globalsReply at: "session"]];
  let completionItems := [[Digla sessionResultOf: completionReply] at: "items"];
  let closed := [Digla callSession: "birnam/close" params: [Map new]
    in: [completionReply at: "session"]];
  let rejected := [Digla callSession: "birnam/evaluate" params: { "source" -> "1" }
    in: [closed at: "session"]];
  let unknown := [Digla callSession: "birnam/nope" params: [Map new] in: session];
  [t expect: [[[[Digla sessionResultOf: inspected] at: "snapshot"] at: "target"] at: "globalName"]
    equals: "DiglaSessionVisible" describes: "named inspection"];
  [t expect: [names includes: "DiglaSessionVisible"] equals: true describes: "visible global listed"];
  [t expect: [names includes: "__DiglaSessionInternal"] equals: false describes: "internal global hidden"];
  [t expect: [[completionItems at: 0] at: "label"] equals: "DiglaSessionVisible"
    describes: "runtime completion is prefix-filtered"];
  [t expect: [[[rejected at: "message"] at: "error"] at: "code"] equals: -32001 describes: "closed session rejected"];
  [t expect: [[[unknown at: "message"] at: "error"] at: "code"] equals: -32601 describes: "unknown method rejected"]]];

[e test: "runtime completion caches global names and refreshes after evaluation" do: [:t |
  let config := [Digla configAtPath: nil environment: [Map new] args: #[]];
  let session := [Digla localSessionFor: config];
  let first := [Digla callSession: "birnam/runtimeCompletion"
    params: { "prefix" -> "DiglaCacheRefresh" } in: session];
  let cachedSession := [first at: "session"];
  let second := [Digla callSession: "birnam/runtimeCompletion"
    params: { "prefix" -> "DiglaCacheRefresh" } in: cachedSession];
  let evaluated := [Digla callSession: "birnam/evaluate"
    params: { "source" -> "[Globals at: #DiglaCacheRefresh put: 1]" }
    in: [second at: "session"]];
  let refreshed := [Digla callSession: "birnam/runtimeCompletion"
    params: { "prefix" -> "DiglaCacheRefresh" } in: [evaluated at: "session"]];
  let refreshedItems := [[Digla sessionResultOf: refreshed] at: "items"];
  [t expect: [DiglaOption isSome: [cachedSession at: "globalNamesCache"]] equals: true
    describes: "first request populates session cache"];
  [t expect: [[DiglaOption valueOf: [cachedSession at: "globalNamesCache"] ifAbsent: [| #[]]] ==
    [DiglaOption valueOf: [[second at: "session"] at: "globalNamesCache"]
      ifAbsent: [| #[]]]] equals: true
    describes: "unchanged session reuses cached vector"];
  [t expect: [[[refreshedItems at: 0] at: "label"] = "DiglaCacheRefresh"] equals: true
    describes: "evaluation invalidates and refreshes runtime names"]]];

[e test: "runtime-name inspection is distinct from Store-global inspection" do: [:t |
  [Globals at: #DiglaRuntimeNameProbe put: 11];
  [Globals at: #DiglaStoreNameProbe put: 22];
  let config := [Digla configAtPath: nil environment: [Map new] args: #[]];
  let reply := [Digla callSession: "birnam/inspect" params: {
    "runtimeName" -> "DiglaRuntimeNameProbe",
    "globalName" -> "DiglaStoreNameProbe" }
    in: [Digla localSessionFor: config]];
  let target := [[[Digla sessionResultOf: reply] at: "snapshot"] at: "target"];
  [t expect: [target at: "printString"] equals: "11"
    describes: "runtimeName has explicit precedence over globalName"]]];

[e test: "session selection keeps remote transport state out of the editor" do: [:t |
  let config := [Digla configAtPath: nil environment: [Map new]
    args: #["--connect=remote"]];
  let state := [Digla sessionStateFor: config];
  let session := [state at: "session"];
  [t expect: [session at: "adapter"] equals: "tcp" describes: "remote adapter selected"];
  [t expect: [session at: "status"] equals: "disconnected" describes: "connection is lazy"];
  [t expect: [state at: "buffer"] equals: "" describes: "editor remains transport-neutral"]]];

[e test: "releasing a lazy remote session does not connect it" do: [:t |
  let config := [Digla configAtPath: nil environment: [Map new]
    args: #["--connect=remote"]];
  let released := [Digla releaseSession: [Digla tcpSessionFor: config]];
  [t expect: [released at: "status"] equals: "disconnected"
    describes: "unused remote session remains lazy"];
  [t expect: [DiglaOption isSome: [released at: "connection"]] equals: false
    describes: "release does not allocate a connection"]]];
