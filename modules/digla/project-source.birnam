// project-source.birnam — lazy authored-source lookup for Digla.
//
// Project owns manifest and dependency resolution. Lsp owns CST-backed source
// analysis. This layer joins those value-only services for Digla without
// depending on Termbox or evaluating any source. Lookups parse only files that
// contain the requested token, so opening the terminal does not eagerly index
// the whole project.

[Reflect defineMethod: #projectSourceRecordsFor: on: Digla as: [:self :snapshot |
  let projectRoot := [snapshot at: "projectRoot" ifAbsent: [| ""]];
  let records := [#[] asCell];
  let modules := [snapshot at: "modules" ifAbsent: [| #[]]];
  [modules do: [:module |
    let moduleName := [module at: "name" ifAbsent: [| ""]];
    let moduleRoot := [module at: "projectRoot" ifAbsent: [| projectRoot]];
    let entryPath := [module at: "path" ifAbsent: [| ""]];
    let paths := [module at: "sources" ifAbsent: [| #[entryPath]]];
    [paths do: [:path |
      let r0 := [Map new];
      let r1 := [r0 at: "module" put: moduleName];
      let r2 := [r1 at: "path" put: path];
      let r3 := [r2 at: "projectRoot" put: moduleRoot];
      [records set: [[records value] add: r3]]]]]];
  [records value]
  ] doc:
  "Flatten a resolver snapshot into ordered authored source-part records." ];

[Reflect defineMethod: #definitionNamed:inSourceRecord: on: Digla as: [:self :name :record |
  let path := [record at: "path"];
  let text := [System readFile: path];
  let usable := [[text isError] not];
  let candidate := [usable ifTrue: [| [text includesSubstring: name]] ifFalse: [| false]];
  [candidate
    ifTrue: [|
      let symbols := [Lsp sourceSymbolsOf: text];
      let exact := [symbols detect: [:entry |
        [[entry at: "name" ifAbsent: [| ""]] = name]] ifNone: [| nil]];
      let entry := [[exact notNil]
        ifTrue: [| exact]
        ifFalse: [| [symbols detect: [:item |
          [Lsp symbolMatchesToken: item token: name]] ifNone: [| nil]]]];
      [[entry isNil]
        ifTrue: [| nil]
        ifFalse: [|
          let start := [entry at: "start" ifAbsent: [| 0]];
          let finish := [entry at: "end" ifAbsent: [| start]];
          let selectionStart := [entry at: "selectionStart" ifAbsent: [| start]];
          let selectionEnd := [entry at: "selectionEnd" ifAbsent: [| finish]];
          let d0 := [Map new];
          let d1 := [d0 at: "found" put: true];
          let d2 := [d1 at: "name" put: [entry at: "name" ifAbsent: [| name]]];
          let d3 := [d2 at: "kind" put: [entry at: "kind" ifAbsent: [| 13]]];
          let d4 := [d3 at: "module" put: [record at: "module"]];
          let d5 := [d4 at: "projectRoot" put: [record at: "projectRoot"]];
          let d6 := [d5 at: "path" put: path];
          let d7 := [d6 at: "uri" put: ["file://" , path]];
          let d8 := [d7 at: "source" put: text];
          let d9 := [d8 at: "start" put: start];
          let d10 := [d9 at: "end" put: finish];
          let d11 := [d10 at: "selectionStart" put: selectionStart];
          [d11 at: "selectionEnd" put: selectionEnd]]]]
    ifFalse: [| nil]]
  ] doc:
  "Resolve one authored symbol in one source part without evaluating the file." ];

[Reflect defineMethod: #definitionNamed:inSourceRecords:where: on: Digla as:
  [:self :name :records :predicate |
  let found := [nil asCell];
  [records do: [:record |
    let pending := [[found value] isNil];
    let eligible := [pending & [predicate value: record]];
    [eligible ifTrue: [|
      let candidate := [self definitionNamed: name inSourceRecord: record];
      let hasCandidate := [candidate notNil];
      [hasCandidate ifTrue: [| [found set: candidate]]]]]]];
  [found value]
  ] doc:
  "Return the first source definition accepted by `predicate`, preserving resolver order." ];

[Reflect defineMethod: #projectDefinitionNamed:inSnapshot:preferredPath: on: Digla as:
  [:self :name :snapshot :preferredPath |
  let valid := [[snapshot notNil] & [snapshot at: "ok" ifAbsent: [| false]]];
  [valid
    ifTrue: [|
      let records := [self projectSourceRecordsFor: snapshot];
      let root := [snapshot at: "projectRoot" ifAbsent: [| ""]];
      let preferred := [[[preferredPath isNil] | [preferredPath isEmpty]]
        ifTrue: [| nil]
        ifFalse: [| [self definitionNamed: name inSourceRecords: records where: [:record |
          [[record at: "path"] = preferredPath]]]]];
      let local := [[preferred notNil]
        ifTrue: [| preferred]
        ifFalse: [| [self definitionNamed: name inSourceRecords: records where: [:record |
          let sameRoot := [[record at: "projectRoot"] = root];
          let differentPath := [[preferredPath isNil] | [[record at: "path"] != preferredPath]];
          [sameRoot & differentPath]]]]];
      let dependency := [[local notNil]
        ifTrue: [| local]
        ifFalse: [| [self definitionNamed: name inSourceRecords: records where: [:record |
          [[record at: "projectRoot"] != root]]]]];
      [[dependency notNil]
        ifTrue: [| dependency]
        ifFalse: [| { "found" -> false, "name" -> name,
          "message" -> "authored definition not found" }]]]
    ifFalse: [|
      let message := [[snapshot isNil]
        ifTrue: [| "project resolver unavailable"]
        ifFalse: [| [snapshot at: "message" ifAbsent: [| "project resolution failed"]]]];
      { "found" -> false, "name" -> name, "message" -> message }]]
  ] doc:
  "Resolve a token to authored project or dependency source, preferring the current file and root project." ];

[Reflect defineMethod: #projectSnapshotForWorkspace: on: Digla as: [:self :workspace |
  [[Globals includes: #Project]
    ifTrue: [| [Project snapshotForUri: workspace]]
    ifFalse: [| nil]]
  ] doc:
  "Request one immutable resolver snapshot for a configured workspace path or file URI." ];
