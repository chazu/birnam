// inspection-test.birnam — read-only runtime exploration contracts.

let e := [TestSuite named: "Digla inspection" module: #diglaInspection];

let fixtureBase := [Object clone];
[Reflect defineMethod: #inspectionInherited on: fixtureBase as: [:self | "base"] doc:
  "A fixture method inherited by the inspected object."];
let fixture := [fixtureBase clone];
[Reflect defineMethod: #inspectionDirect on: fixture as: [:self | "direct"] doc:
  "A fixture method directly owned by the inspected object."];
[Globals at: #DiglaInspectionFixture put: fixture];
[db assert: fixture attr: #name value: "Ada"];
[db assert: fixture attr: #unsafe value: [Object clone]];

let temporalFixture := [Object clone];
[Globals at: #DiglaTemporalFixture put: temporalFixture];
[db assert: #diglaHistoried attr: #history value: true];
[db assert: temporalFixture attr: #diglaHistoried value: "before"];
[db assert: temporalFixture attr: #diglaCurrentOnly value: "lost"];
let temporalBasis := [db basis];
[db assert: temporalFixture attr: #diglaHistoried value: "after"];
[db assert: temporalFixture attr: #diglaCurrentOnly value: "now"];

[e test: "named inspection returns deterministic safe object facts and methods" do: [:t |
  let before := [db basis];
  let snapshot := [Digla inspectGlobal: "DiglaInspectionFixture"];
  let after := [db basis];
  let target := [snapshot at: "target"];
  let facts := [snapshot at: "facts"];
  let methods := [snapshot at: "methods"];
  let nameFact := [facts detect: [:fact | [[fact at: "attribute"] = "name"]]];
  let unsafeFact := [facts detect: [:fact | [[fact at: "attribute"] = "unsafe"]]];
  let inherited := [methods detect: [:method | [[method at: "selector"] = "inspectionInherited"]]];
  let direct := [methods detect: [:method | [[method at: "selector"] = "inspectionDirect"]]];
  let primitive := [methods detect: [:method | [[method at: "kind"] = "primitive"]]];
  [t expect: [snapshot at: "schema"] equals: 1 describes: "snapshot schema"];
  [t expect: [target at: "globalName"] equals: "DiglaInspectionFixture" describes: "stable global name"];
  [t expect: [nameFact at: "value"] equals: "Ada" describes: "scalar fact survives"];
  [t expect: [unsafeFact at: "rendered"] equals: true describes: "object fact is rendered, not leaked"];
  [t expect: [inherited at: "kind"] equals: "compiled" describes: "inherited method card"];
  [t expect: [direct at: "kind"] equals: "compiled" describes: "direct method card"];
  [t expect: [direct at: "sourceAvailable"] equals: nil
    describes: "ordinary inspection does not probe source"];
  [t expect: [primitive notNil] equals: true describes: "native protocol is represented"];
  [t expect: after equals: before describes: "inspection performs no Store writes"]]];

[e test: "method cards preserve the reflected owner independently of target" do: [:t |
  let card := [Digla inspectionMethodCard: {
    #selector -> #probe, #target -> #TargetName, #owner -> #OwnerName,
    #method -> #compiled }];
  [t expect: [card at: "target"] equals: "TargetName" describes: "target is retained"];
  [t expect: [card at: "owner"] equals: "OwnerName" describes: "owner is not rewritten"]]];

[e test: "data-driven snapshot selects and sources exactly one method" do: [:t |
  let before := [db basis];
  let snapshot := [Digla snapshot: {
    "target" -> "String",
    "sections" -> #["object" "methods" "source"],
    "selector" -> "asUppercase",
    "includeSource" -> true }];
  let after := [db basis];
  let methods := [snapshot at: "methods"];
  let method := [methods at: 0];
  [t expect: [methods size] equals: 1 describes: "selector narrows the snapshot"];
  [t expect: [method at: "selector"] equals: "asUppercase" describes: "selected method"];
  [t expect: [method at: "sourceAvailable"] equals: true describes: "source was probed"];
  [t assert: [[method at: "source"] includesSubstring: "#asUppercase"]
    describes: "recorded source is copied into the card"];
  [t expect: [[snapshot at: "facts"] size] equals: 0 describes: "unrequested facts omitted"];
  [t expect: [[snapshot at: "warnings"] size] equals: 0 describes: "valid source request is clean"];
  [t expect: after equals: before describes: "snapshot performs no Store writes"]]];

[e test: "section-filtered snapshots do not build an unrequested method inventory" do: [:t |
  let snapshot := [Digla snapshot: {
    "target" -> "DiglaInspectionFixture", "sections" -> #["facts"] }];
  [t expect: [[snapshot at: "methods"] size] equals: 0 describes: "methods are omitted"];
  [t expect: [[snapshot at: "target"] at: "vtableName"] equals: nil
    describes: "fact-only snapshot does not derive type through method traversal"];
  [t expect: [[snapshot at: "facts"] isEmpty] equals: false describes: "requested facts remain"]]];

[e test: "snapshot reports invalid and missing source selections explicitly" do: [:t |
  let unselected := [Digla snapshot: {
    "target" -> "String", "sections" -> #["source"], "includeSource" -> true }];
  let missing := [Digla snapshot: {
    "target" -> "String", "sections" -> #["source"],
    "selector" -> "definitelyMissingSelector", "includeSource" -> true }];
  [t assert: [[[unselected at: "warnings"] at: 0] includesSubstring: "requires a selected method"]
    describes: "source requires a narrow selector"];
  [t expect: [[missing at: "methods"] size] equals: 0 describes: "missing selector has no card"];
  [t assert: [[[missing at: "warnings"] at: 0] includesSubstring: "method not found"]
    describes: "missing selector is visible"]]];

[e test: "snapshot reports unavailable primitive source truthfully" do: [:t |
  let methods := [[Digla inspectGlobal: "DiglaInspectionFixture"] at: "methods"];
  let primitive := [methods detect: [:method | [[method at: "kind"] = "primitive"]]];
  let snapshot := [Digla snapshot: {
    "target" -> "DiglaInspectionFixture", "sections" -> #["source"],
    "selector" -> [primitive at: "selector"], "includeSource" -> true }];
  let selected := [[snapshot at: "methods"] at: 0];
  [t expect: [selected at: "sourceAvailable"] equals: false describes: "source probe is truthful"];
  [t expect: [selected at: "source"] equals: nil describes: "primitive has no invented source"];
  [t assert: [[[snapshot at: "warnings"] at: 0] includesSubstring: "source unavailable"]
    describes: "unavailable source carries a warning"]]];

[e test: "missing globals and anonymous values remain explicit" do: [:t |
  let missing := [Digla inspectGlobal: "DefinitelyMissingDiglaGlobal"];
  let anonymous := [Digla inspect: [Object clone]];
  [t expect: [missing at: "object"] equals: nil describes: "missing global has no object card"];
  [t expect: [[missing at: "warnings"] size] equals: 1 describes: "missing global carries a warning"];
  [t expect: [[anonymous at: "target"] at: "globalName"] equals: nil describes: "anonymous identity is not invented"]]];

[e test: "text rendering exposes the shared exploration card" do: [:t |
  let text := [Digla renderInspectionText: [Digla inspectGlobal: #DiglaInspectionFixture]];
  [t assert: [text includesSubstring: "target:     #DiglaInspectionFixture"] describes: "target heading"];
  [t assert: [text includesSubstring: "facts:"] describes: "facts section"];
  [t assert: [text includesSubstring: "#name  Ada"] describes: "fact row"];
  [t assert: [text includesSubstring: "inspectionInherited  compiled"] describes: "method row"]]];

[e test: "text rendering includes explicitly selected method source" do: [:t |
  let snapshot := [Digla snapshot: {
    "target" -> "String", "sections" -> #["source"],
    "selector" -> "asUppercase", "includeSource" -> true }];
  let text := [Digla renderInspectionText: snapshot];
  [t assert: [text includesSubstring: "asUppercase  compiled"] describes: "selected method row"];
  [t assert: [text includesSubstring: "#asUppercase"] describes: "selected source body"]]];

[e test: "historical snapshots distinguish retained facts from unavailable history" do: [:t |
  let before := [db basis];
  let snapshot := [Digla snapshot: {
    "target" -> "DiglaTemporalFixture",
    "sections" -> #["object" "facts" "changes"],
    "asOf" -> temporalBasis,
    "since" -> temporalBasis }];
  let after := [db basis];
  let historical := [[snapshot at: "facts"] detect: [:fact |
    [[fact at: "attribute"] = "diglaHistoried"]]];
  let currentOnly := [[snapshot at: "facts"] detect: [:fact |
    [[fact at: "attribute"] = "diglaCurrentOnly"]]];
  let changed := [[snapshot at: "changes"] detect: [:change |
    [[change at: "attribute"] = "diglaHistoried"]]];
  [t expect: [snapshot at: "basis"] equals: temporalBasis describes: "snapshot uses requested basis"];
  [t expect: [snapshot at: "asOf"] equals: temporalBasis describes: "asOf is explicit"];
  [t expect: [snapshot at: "since"] equals: temporalBasis describes: "since is explicit"];
  [t expect: [historical at: "value"] equals: "before" describes: "retained value is historical"];
  [t expect: currentOnly equals: nil describes: "unretained old value is not fabricated"];
  [t expect: [changed at: "value"] equals: "after" describes: "since reports current changed value"];
  [t assert: [[[snapshot at: "warnings"] at: 0] includesSubstring:
    "history unavailable: #diglaCurrentOnly"] describes: "missing history is explicit"];
  [t expect: after equals: before describes: "historical snapshot performs no Store writes"]]];

[e test: "historical text labels its fact and change windows" do: [:t |
  let snapshot := [Digla snapshot: {
    "target" -> "DiglaTemporalFixture",
    "sections" -> #["facts" "changes"],
    "asOf" -> temporalBasis,
    "since" -> temporalBasis }];
  let text := [Digla renderInspectionText: snapshot];
  [t assert: [text includesSubstring: ["facts as of " , [temporalBasis printString] , ":"]]
    describes: "historical facts are labelled"];
  [t assert: [text includesSubstring: ["changes since " , [temporalBasis printString] , ":"]]
    describes: "change window is labelled"];
  [t assert: [[text includesSubstring: "methods:"] not]
    describes: "unrequested current methods are omitted"]]];

[e test: "invalid historical bases are rejected without querying" do: [:t |
  let snapshot := [Digla snapshot: {
    "target" -> "DiglaTemporalFixture", "sections" -> #["facts" "changes"],
    "asOf" -> -1, "since" -> "old" }];
  let current := [[snapshot at: "facts"] detect: [:fact |
    [[fact at: "attribute"] = "diglaHistoried"]]];
  [t expect: [snapshot at: "asOf"] equals: nil describes: "invalid asOf is cleared"];
  [t expect: [snapshot at: "since"] equals: nil describes: "invalid since is cleared"];
  [t expect: [current at: "value"] equals: "after"
    describes: "invalid asOf falls back to current facts"];
  [t expect: [[snapshot at: "changes"] size] equals: 0 describes: "invalid since has no changes"];
  [t expect: [[snapshot at: "warnings"] size] equals: 2 describes: "both invalid fields warn"]]];
