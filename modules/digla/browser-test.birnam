// browser-test.birnam — pure snapshot-browser model contracts.

let e := [TestSuite named: "Digla browser" module: #diglaBrowser];

[e test: "browser filters copied method cards and cycles snapshot sections" do: [:t |
  let snapshot := {
    "target" -> { "globalName" -> "Fixture", "printString" -> "fixture", "vtableName" -> "Fixture" },
    "facts" -> #[
      { "attribute" -> "status", "value" -> "healthy", "rendered" -> false }
      { "attribute" -> "version", "value" -> 2, "rendered" -> false }
    ],
    "methods" -> #[
      { "selector" -> "alpha", "kind" -> "compiled", "target" -> "Fixture" }
      { "selector" -> "beta:", "kind" -> "method", "target" -> "Fixture" }
    ],
    "changes" -> #[], "warnings" -> #[] };
  let opened := [Digla browserForSnapshot: snapshot];
  [t expect: [opened at: "section"] equals: "methods" describes: "methods open first"];
  [t expect: [[opened at: "items"] size] equals: 2 describes: "method cards cached"];
  let filtered := [Digla browserWithQuery: "BETA" in: opened];
  [t expect: [[filtered at: "items"] size] equals: 1 describes: "filter ignores ASCII case"];
  [t expect: [[Digla browserSelectedItemIn: filtered] at: "selector"] equals: "beta:"
    describes: "selected item stays structured"];
  let facts := [Digla cycleBrowserSectionBy: -1 in: filtered];
  [t expect: [facts at: "section"] equals: "facts" describes: "section cycles backward"];
  [t expect: [[facts at: "items"] size] equals: 0
    describes: "the same explicit filter is retained across sections"];
  let allFacts := [Digla browserWithQuery: "" in: facts];
  [t expect: [[allFacts at: "items"] size] equals: 2 describes: "clearing filter restores facts"]]];

[e test: "browser selection, warnings, and detail scroll remain pure value state" do: [:t |
  let snapshot := {
    "target" -> { "globalName" -> "Fixture", "printString" -> "fixture", "vtableName" -> "Fixture" },
    "facts" -> #[],
    "methods" -> #[
      { "selector" -> "alpha", "kind" -> "compiled", "target" -> "Fixture" }
      { "selector" -> "beta", "kind" -> "compiled", "target" -> "Fixture" }
    ],
    "changes" -> #[], "warnings" -> #["source unavailable"] };
  let opened := [Digla browserForSnapshot: snapshot];
  let wrapped := [Digla moveBrowserSelectionBy: -1 in: opened];
  [t expect: [wrapped at: "index"] equals: 1 describes: "selection wraps"];
  let warnings := [Digla cycleBrowserSectionBy: 1 in: wrapped];
  [t expect: [warnings at: "section"] equals: "warnings" describes: "warnings are navigable"];
  [t expect: [Digla browserSelectedItemIn: warnings] equals: "source unavailable"
    describes: "warning remains a copied string"];
  let detailed := [Digla browserWithDetail: snapshot in: opened];
  let scrolled := [Digla scrollBrowserDetailBy: 10 in: detailed];
  let clamped := [Digla scrollBrowserDetailBy: -20 in: scrolled];
  [t expect: [scrolled at: "detailTopRow"] equals: 10 describes: "detail viewport advances"];
  [t expect: [clamped at: "detailTopRow"] equals: 0 describes: "detail viewport stays nonnegative"];
  [t expect: [[Digla closeBrowserDetailIn: scrolled] at: "detail"] equals: nil
    describes: "detail closes without discarding list state"]]];
