// terminal.birnam — the effectful local terminal loop for Digla.

[Reflect defineMethod: #handleCurrentTerminalEventIn: on: Digla as: [:self :state |
  let key := [Termbox evKey];
  let modifier := [Termbox evMod];
  let character := [Termbox evChar];
  let canBurst := [[key = 0] & [[character isEmpty] not]];
  let input := [canBurst ifTrue: [| [Termbox textBurst]] ifFalse: [| character]];
  [self handleKey: key
    modifier: modifier
    character: input
    state: state]
  ] doc:
  "Apply the event currently held by Termbox to the terminal-independent editor state." ];

[Reflect defineMethod: #drainTerminalEventsFrom: on: Digla as: [:self :state |
  let current := [[self handleCurrentTerminalEventIn: state] asCell];
  let draining := [[[current value] at: "running"] asCell];
  [[| [draining value]] whileTrue: [|
    let ready := [Termbox peek];
    [[ready = 1]
      ifTrue: [|
        [current set: [self handleCurrentTerminalEventIn: [current value]]];
        [draining set: [[current value] at: "running"]]]
      ifFalse: [| [draining set: false]]]]];
  [current value]
  ] doc:
  "Coalesce already-buffered terminal events before the next expensive frame projection." ];

[Reflect defineMethod: #runTerminalLoop: on: Digla as: [:self :state |
  let current := [[self renderTerminal: state] asCell];
  [[| [[current value] at: "running"]] whileTrue: [|
    let before := [current value];
    let evaluating := [DiglaOption isSome: [before at: "evaluation"]];
    let waitMs := [evaluating ifTrue: [| 16] ifFalse: [| 250]];
    let ready := [Termbox wait: waitMs];
    let handled := [[ready = 1]
      ifTrue: [| [self drainTerminalEventsFrom: before]]
      ifFalse: [| before]];
    let advanced := [self advanceEvaluationIn: handled];
    let changed := [[ready = 1] | [[advanced == before] not]];
    [changed
      ifTrue: [| [current set: [self renderTerminal: advanced]]]
      ifFalse: [| [current set: advanced]]]]];
  let final := [current value];
  let released := [self releaseSession: [final at: "session"]];
  [final at: "session" put: released]
  ] doc:
  "Interleave timed terminal input with incremental session progress, then release the active session."];
