// local-session.birnam — synchronous live-image adapter for Digla sessions.
//
// This is the only Digla layer that evaluates source or retains a raw result.
// Its responses are copied-value Maps/Vectors suitable for JSON, terminal text,
// tests, or framed transports. A project-local adapter may capture System output
// around the synchronous evaluation and provide cooperative loop deadlines
// without changing the core evaluator.

[Reflect defineMethod: #outputCaptureAvailable on: Digla as: [:self |
  false
  ] doc:
  "Answer whether the loaded application adapter can capture System output." ];

[Reflect defineMethod: #newEvaluationContext on: Digla as: [:self |
  nil
  ] doc:
  "Create adapter-owned state for one session, or nil when no adapter is loaded." ];

[Reflect defineMethod: #beginEvaluationOutputCaptureIn: on: Digla as: [:self :context |
  context
  ] doc:
  "Begin output capture in one explicitly owned evaluation context." ];

[Reflect defineMethod: #endEvaluationOutputCaptureIn: on: Digla as: [:self :context |
  #[]
  ] doc:
  "End output capture in one context and answer copied output events, or none." ];

[Reflect defineMethod: #evaluationOutputStreamingAvailable on: Digla as: [:self |
  false
  ] doc:
  "Answer whether captured writes can be delivered through a temporary session sink." ];

[Reflect defineMethod: #beginEvaluationOutputStreaming:in: on: Digla as: [:self :sink :context |
  context
  ] doc:
  "Install an output sink in one explicitly owned evaluation context." ];

[Reflect defineMethod: #endEvaluationOutputStreamingIn: on: Digla as: [:self :context |
  context
  ] doc:
  "Remove the output sink from one explicitly owned evaluation context." ];

[Reflect defineMethod: #evaluationDeadlineAvailable on: Digla as: [:self |
  false
  ] doc:
  "Answer whether the loaded application adapter provides cooperative loop deadlines." ];

[Reflect defineMethod: #beginEvaluationDeadline:in: on: Digla as: [:self :timeoutMs :context |
  context
  ] doc:
  "Begin a cooperative deadline in one explicitly owned evaluation context." ];

[Reflect defineMethod: #endEvaluationDeadlineIn: on: Digla as: [:self :context |
  context
  ] doc:
  "Clear the cooperative deadline from one explicitly owned evaluation context." ];

[Reflect defineMethod: #beginEvaluationInterruptProbe:in: on: Digla as:
  [:self :probe :context | context] doc:
  "Install an interrupt probe in one explicitly owned evaluation context." ];

[Reflect defineMethod: #endEvaluationInterruptProbeIn: on: Digla as: [:self :context |
  context
  ] doc:
  "Remove the interrupt probe from one explicitly owned evaluation context." ];

[Reflect defineMethod: #localSessionCapabilities on: Digla as: [:self |
  let output := [self outputCaptureAvailable];
  let streaming := [self evaluationOutputStreamingAvailable];
  let deadline := [self evaluationDeadlineAvailable];
  { "evaluate" -> true,
    "inspect" -> true,
    "snapshot" -> true,
    "globals" -> true,
    "runtimeCompletion" -> true,
    "interrupt" -> false,
    "cooperativeInterrupt" -> false,
    "interruptSafeBoundaries" -> #[],
    "structuredValues" -> true,
    "outputEvents" -> output,
    "outputNotifications" -> output,
    "cooperativeDeadline" -> deadline,
    "deadlineSafeBoundaries" -> [deadline
      ifTrue: [| #["Block whileTrue:/whileFalse:" "Integer to:do:"]]
      ifFalse: [| #[]]],
    "streamedOutput" -> streaming }
  ] doc:
  "Return the truthful capabilities of the synchronous local image adapter." ];

[Reflect defineMethod: #inspectionSessionCapabilities on: Digla as: [:self |
  { "evaluate" -> false,
    "inspect" -> true,
    "snapshot" -> true,
    "globals" -> true,
    "runtimeCompletion" -> true,
    "interrupt" -> false,
    "cooperativeInterrupt" -> false,
    "interruptSafeBoundaries" -> #[],
    "structuredValues" -> true,
    "outputEvents" -> false,
    "outputNotifications" -> false,
    "cooperativeDeadline" -> false,
    "deadlineSafeBoundaries" -> #[],
    "streamedOutput" -> false }
  ] doc:
  "Return the capabilities of a session that cannot evaluate source." ];

[Reflect defineMethod: #localSessionFor: on: Digla as: [:self :config |
  { "adapter" -> "local",
    "id" -> "local",
    "status" -> "open",
    "nextId" -> 1,
    "config" -> config,
    "asyncEvaluation" -> false,
    "capabilities" -> [self localSessionCapabilities],
    "adapterObject" -> DiglaLocalSessionAdapter,
    "inspectionCapability" -> DiglaInspectionCapability,
    "evaluationCapability" -> DiglaEvaluationCapability,
    "evaluationContext" -> [self newEvaluationContext],
    "lastValue" -> nil,
    "hasLastValue" -> false,
    "lastError" -> nil,
    "globalNamesCache" -> nil }
  ] doc:
  "Create the internal state of a synchronous session against this live image." ];

[Reflect defineMethod: #inspectionSessionFor: on: Digla as: [:self :config |
  let session := [self localSessionFor: config];
  let s1 := [session at: "capabilities" put: [self inspectionSessionCapabilities]];
  let s2 := [s1 at: "evaluationCapability" put: nil];
  [s2 at: "evaluationContext" put: nil]
  ] doc:
  "Create a read-only local session carrying inspection but no evaluation capability." ];

[Reflect defineMethod: #tcpSessionFor: on: Digla as: [:self :config |
  { "adapter" -> "tcp",
    "id" -> "remote",
    "status" -> "disconnected",
    "nextId" -> 1,
    "config" -> config,
    "asyncEvaluation" -> true,
    "capabilities" -> [Map new],
    "adapterObject" -> DiglaTcpSessionAdapter,
    "inspectionCapability" -> nil,
    "evaluationCapability" -> nil,
    "connection" -> nil,
    "pending" -> ["" asCell],
    "lastError" -> nil }
  ] doc:
  "Create lazy internal state for a serial framed TCP image session." ];

[Reflect defineMethod: #evaluate:session: on: DiglaEvaluationCapability as:
  [:self :params :session | [Digla localEvaluate: params session: session]] doc:
  "Exercise the explicit evaluation authority carried by a programming session." ];

[Reflect defineMethod: #inspect:session: on: DiglaInspectionCapability as:
  [:self :params :session | [Digla localInspect: params session: session]] doc:
  "Inspect through a read capability without acquiring evaluation authority." ];

[Reflect defineMethod: #snapshot:session: on: DiglaInspectionCapability as:
  [:self :params :session | [Digla localSnapshot: params session: session]] doc:
  "Build a copied snapshot through a read capability." ];

[Reflect defineMethod: #globals:session: on: DiglaInspectionCapability as:
  [:self :params :session |
    let listing := [Digla localGlobalNamesIn: session];
    { "result" -> { "globals" -> [listing at: "names"] },
      "session" -> [listing at: "session"] }
  ] doc:
  "List visible globals through a read capability." ];

[Reflect defineMethod: #runtimeCompletion:session: on: DiglaInspectionCapability as:
  [:self :params :session |
    let prefix := [params at: "prefix" ifAbsent: [| ""]];
    let listing := [Digla localGlobalNamesIn: session];
    let names := [Digla userGlobalNamesStartingWith: prefix in: [listing at: "names"]];
    let items := [names collect: [:name |
      { "label" -> name, "kind" -> "global", "detail" -> "live image global",
        "source" -> "runtime" }]];
    { "result" -> { "items" -> items }, "session" -> [listing at: "session"] }
  ] doc:
  "Complete visible runtime names through a read capability." ];

[Reflect defineMethod: #sessionForConfig: on: Digla as: [:self :config |
  let connect := [config at: "connect"];
  let remote := [[connect = "remote"] | [connect = "tcp"]];
  [remote
    ifTrue: [| [self tcpSessionFor: config]]
    ifFalse: [| [self localSessionFor: config]]]
  ] doc:
  "Select a local or lazy TCP session from the resolved application configuration." ];

[Reflect defineMethod: #sessionDisplayValue: on: Digla as: [:self :value |
  [[value isNil] ifTrue: [| "nil"] ifFalse: [| [value printString]]]
  ] doc:
  "Render a local result once for the copied-value session response." ];

[Reflect defineMethod: #sessionValueKindOf: on: Digla as: [:self :value |
  let vt := [Reflect vtableOf: value];
  [[value isNil] ifTrue: [| "nil"] ifFalse: [|
    [[Reflect isString: value] ifTrue: [| "string"] ifFalse: [|
      [[Reflect isSymbol: value] ifTrue: [| "symbol"] ifFalse: [|
        [[vt == [Reflect vtableOf: true]] ifTrue: [| "boolean"] ifFalse: [|
          [[vt == [Reflect vtableOf: 0]] ifTrue: [| "integer"] ifFalse: [|
            [[vt == [Reflect vtableOf: 0.0]] ifTrue: [| "float"] ifFalse: [| "object"]]]]]]]]]]]]
  ] doc:
  "Classify a runtime value using only kinds supported by the session wire contract." ];

[Reflect defineMethod: #sessionValue: on: Digla as: [:self :value |
  let normalized := [self inspectionValue: value];
  { "kind" -> [self sessionValueKindOf: value],
    "value" -> [normalized at: "value"],
    "display" -> [self sessionDisplayValue: value],
    "rendered" -> [normalized at: "rendered"] }
  ] doc:
  "Copy a live result into a typed transport-safe value record." ];

[Reflect defineMethod: #sessionImageIdentity on: Digla as: [:self |
  { "kind" -> "live-image",
    "basis" -> [db basis],
    "generationDigest" -> [self inspectionGenerationDigest] }
  ] doc:
  "Describe the currently running image without exposing an image capability." ];

[Reflect defineMethod: #sessionOpenResult: on: Digla as: [:self :session |
  { "sessionId" -> [session at: "id"],
    "adapter" -> [session at: "adapter"],
    "image" -> [self sessionImageIdentity],
    "capabilities" -> [session at: "capabilities"] }
  ] doc:
  "Return the handshake payload for an open local image session." ];

[Reflect defineMethod: #visibleUserGlobalNames on: Digla as: [:self |
  let names := [#[] asCell];
  let attributes := [db findAll: ?name where: #[ #[ #__globals__ ?name ?value ] ]];
  [attributes do: [:attribute |
    let name := [Reflect nameOf: attribute];
    [[name startsWith: "__"]
      ifTrue: [| nil]
      ifFalse: [| [names set: [[names value] add: name]]]]]];
  [[names value] sortBy: [:name | name]]
  ] doc:
  "Return every sorted user-visible global name with one indexed relational read." ];

[Reflect defineMethod: #userGlobalNamesStartingWith:in: on: Digla as: [:self :prefix :allNames |
  let names := [#[] asCell];
  [allNames do: [:name |
    let belowLimit := [[[names value] size] < 64];
    [[belowLimit & [name startsWith: prefix]]
      ifTrue: [| [names set: [[names value] add: name]]]
      ifFalse: [| nil]]]];
  [names value]
  ] doc:
  "Filter a sorted global-name snapshot to at most 64 prefix matches." ];

[Reflect defineMethod: #userGlobalNamesStartingWith: on: Digla as: [:self :prefix |
  [self userGlobalNamesStartingWith: prefix in: [self visibleUserGlobalNames]]
  ] doc:
  "Return at most 64 sorted visible global names matching a prefix." ];

[Reflect defineMethod: #userGlobalNames on: Digla as: [:self |
  [self visibleUserGlobalNames]
  ] doc:
  "Return all sorted user-visible persisted global names." ];

[Reflect defineMethod: #evaluationDeadlineFor:session: on: Digla as: [:self :params :session |
  let configured := [[session at: "config"] at: "evaluation-timeout-ms"];
  let timeout := [params at: "timeoutMs" ifAbsent: [| configured]];
  let integer := [[Reflect vtableOf: timeout] == [Reflect vtableOf: 0]];
  let valid := [integer & [integer ifTrue: [| [timeout >= 0]] ifFalse: [| false]]];
  [valid
    ifTrue: [|
      let supported := [[timeout = 0] | [self evaluationDeadlineAvailable]];
      [supported
        ifTrue: [| { "ok" -> true, "timeoutMs" -> timeout }]
        ifFalse: [| { "ok" -> false,
          "message" -> "evaluation deadline adapter is unavailable" }]]]
    ifFalse: [| { "ok" -> false,
      "message" -> "timeoutMs must be a nonnegative Integer" }]]
  ] doc:
  "Validate an explicit or configured cooperative evaluation deadline." ];

[Reflect defineMethod: #runtimeCompletionItemsFor: on: Digla as: [:self :prefix |
  [[self userGlobalNamesStartingWith: prefix] collect: [:name |
    { "label" -> name, "kind" -> "global", "detail" -> "live image global",
      "source" -> "runtime" }]]
  ] doc:
  "Return copied-value runtime completion items for visible globals matching a prefix." ];

[Reflect defineMethod: #localGlobalNamesIn: on: Digla as: [:self :session |
  let cached := [session at: "globalNamesCache"];
  [[cached notNil]
    ifTrue: [| { "names" -> cached, "session" -> session, "cached" -> true }]
    ifFalse: [|
      let names := [self visibleUserGlobalNames];
      let next := [session at: "globalNamesCache" put: names];
      { "names" -> names, "session" -> next, "cached" -> false }]]
  ] doc:
  "Return the session's global-name snapshot, populating it on first use." ];

[Reflect defineMethod: #localEvaluate:session: on: Digla as: [:self :params :session |
  let source := [params at: "source" ifAbsent: [| nil]];
  let context := [session at: "evaluationContext"];
  [[source isNil]
    ifTrue: [|
      { "result" -> { "ok" -> false, "kind" -> "error",
                       "phase" -> "request", "message" -> "evaluate requires source",
                       "display" -> "evaluate requires source", "events" -> #[],
                       "diagnostics" -> #[] },
        "session" -> session }]
    ifFalse: [|
      let deadline := [self evaluationDeadlineFor: params session: session];
      [[[deadline at: "ok"] not]
        ifTrue: [|
          let message := [deadline at: "message"];
          { "result" -> { "ok" -> false, "kind" -> "error", "phase" -> "request",
                           "message" -> message, "display" -> message, "events" -> #[],
                           "diagnostics" -> #[] },
            "session" -> session }]
        ifFalse: [|
          let timeoutMs := [deadline at: "timeoutMs"];
          [self beginEvaluationOutputCaptureIn: context];
          [self beginEvaluationDeadline: timeoutMs in: context];
          let value := [Codegen evalPersisting: source];
          [self endEvaluationDeadlineIn: context];
          let events := [self endEvaluationOutputCaptureIn: context];
          let compileError := [Codegen lastError];
          let runtimeError := [[compileError isNil] & [value isError]];
          let failed := [[compileError notNil] | runtimeError];
          [failed
            ifTrue: [|
              let message := [[compileError notNil]
                ifTrue: [| [compileError printString]]
                ifFalse: [| [value printString]]];
              let timedOut := [runtimeError
                ifTrue: [| [[value kind] = #evaluationDeadline]]
                ifFalse: [| false]];
              let interrupted := [runtimeError
                ifTrue: [| [[value kind] = #evaluationInterrupted]]
                ifFalse: [| false]];
              let phase := [[compileError notNil]
                ifTrue: [| "compile"]
                ifFalse: [| [timedOut
                  ifTrue: [| "timeout"]
                  ifFalse: [| [interrupted ifTrue: [| "interrupted"] ifFalse: [| "runtime"]]]]]];
              let diagnostics := [[compileError notNil]
                ifTrue: [| [Lsp staticDiagnosticsOf: source]]
                ifFalse: [| #[]]];
              let next0 := [session at: "lastError" put: message];
              let next := [next0 at: "globalNamesCache" put: nil];
              { "result" -> { "ok" -> false, "kind" -> "error", "phase" -> phase,
                               "timedOut" -> timedOut, "interrupted" -> interrupted,
                               "timeoutMs" -> timeoutMs,
                               "message" -> message, "display" -> message, "events" -> events,
                               "diagnostics" -> diagnostics },
                "session" -> next }]
            ifFalse: [|
              let copied := [self sessionValue: value];
              let s1 := [session at: "lastValue" put: value];
              let s2 := [s1 at: "hasLastValue" put: true];
              let next0 := [s2 at: "lastError" put: nil];
              let next := [next0 at: "globalNamesCache" put: nil];
              { "result" -> { "ok" -> true, "kind" -> "value", "value" -> copied,
                               "display" -> [copied at: "display"], "events" -> events,
                               "diagnostics" -> #[] },
                "session" -> next }]]]]]]
  ] doc:
  "Evaluate one explicit source form and return structured success or failure data." ];

[Reflect defineMethod: #localInspect:session: on: Digla as: [:self :params :session |
  let runtimeName := [params at: "runtimeName" ifAbsent: [| nil]];
  let globalName := [params at: "globalName" ifAbsent: [| nil]];
  let selector := [params at: "selector" ifAbsent: [| nil]];
  let includeSource := [params at: "includeSource" ifAbsent: [| false]];
  [[runtimeName notNil]
    ifTrue: [|
      { "result" -> { "snapshot" -> [self inspectRuntimeNamed: runtimeName] }, "session" -> session }]
    ifFalse: [|
      [[globalName notNil]
        ifTrue: [|
          let snapshot := [[selector notNil]
            ifTrue: [| [self snapshot: {
              "target" -> globalName,
              "sections" -> #["object" "methods" "source"],
              "selector" -> selector,
              "includeSource" -> includeSource }]]
            ifFalse: [| [self inspectRuntimeNamed: globalName]]];
          { "result" -> { "snapshot" -> snapshot }, "session" -> session }]
        ifFalse: [|
          [[session at: "hasLastValue"]
            ifTrue: [|
              { "result" -> { "snapshot" -> [self inspect: [session at: "lastValue"]] },
                "session" -> session }]
            ifFalse: [| { "error" -> "nothing has been evaluated yet", "session" -> session }]]]]]]
  ] doc:
  "Inspect a runtime/export name, a Store global, or the session's last successful result." ];

[Reflect defineMethod: #localSnapshot:session: on: Digla as: [:self :params :session |
  { "result" -> { "snapshot" -> [self snapshot: params] }, "session" -> session }
  ] doc:
  "Return one data-driven, capability-free named snapshot through the local session." ];

[Reflect defineMethod: #localSessionMethod:params:session: on: Digla as: [:self :method :params :session |
  let outcome := [nil asCell];
  [[method = "birnam/session/open"]
    ifTrue: [| [outcome set: { "result" -> [self sessionOpenResult: session], "session" -> session }]]
    ifFalse: [| nil]];
  [[method = "birnam/evaluate"]
    ifTrue: [|
      let capability := [session at: "evaluationCapability"];
      [outcome set: [[capability isNil]
        ifTrue: [| { "error" -> "evaluation capability is unavailable", "session" -> session }]
        ifFalse: [| [capability evaluate: params session: session]]]]]
    ifFalse: [| nil]];
  [[method = "birnam/inspect"]
    ifTrue: [|
      let capability := [session at: "inspectionCapability"];
      [outcome set: [capability inspect: params session: session]]]
    ifFalse: [| nil]];
  [[method = "birnam/snapshot"]
    ifTrue: [|
      let capability := [session at: "inspectionCapability"];
      [outcome set: [capability snapshot: params session: session]]]
    ifFalse: [| nil]];
  [[method = "birnam/globals"]
    ifTrue: [|
      let capability := [session at: "inspectionCapability"];
      [outcome set: [capability globals: params session: session]]]
    ifFalse: [| nil]];
  [[method = "birnam/runtimeCompletion"]
    ifTrue: [|
      let capability := [session at: "inspectionCapability"];
      [outcome set: [capability runtimeCompletion: params session: session]]]
    ifFalse: [| nil]];
  [[method = "birnam/interrupt"]
    ifTrue: [| [outcome set: {
      "result" -> { "interrupted" -> false,
        "reason" -> [[self evaluationDeadlineAvailable]
          ifTrue: [| "synchronous session; use evaluate timeoutMs for cooperative loop deadlines"]
          ifFalse: [| "synchronous session is idle"]] },
      "session" -> session }]]
    ifFalse: [| nil]];
  [[method = "birnam/close"]
    ifTrue: [|
      let next := [session at: "status" put: "closed"];
      [outcome set: { "result" -> { "closed" -> true }, "session" -> next }]]
    ifFalse: [| nil]];
  [[[outcome value] isNil]
    ifTrue: [| { "unknown" -> true, "session" -> session }]
    ifFalse: [| [outcome value]]]
  ] doc:
  "Dispatch the runtime method subset implemented by a local image session." ];

[Reflect defineMethod: #performLocalSessionRequest:in: on: Digla as: [:self :request :session |
  let id := [request at: "id" ifAbsent: [| nil]];
  let method := [request at: "method" ifAbsent: [| ""]];
  let params := [request at: "params" ifAbsent: [| [Map new]]];
  let closed := [[session at: "status"] = "closed"];
  [[closed & [[method = "birnam/session/open"] not]]
    ifTrue: [|
      [self sessionReply:
        [self sessionError: id code: -32001 message: "session is closed" data: nil]
        state: session]]
    ifFalse: [|
      let outcome := [self localSessionMethod: method params: params session: session];
      let next := [outcome at: "session"];
      let unknown := [outcome at: "unknown" ifAbsent: [| false]];
      [unknown
        ifTrue: [|
          [self sessionReply:
            [self sessionError: id code: -32601 message: "method not found" data: method]
            state: next]]
        ifFalse: [|
          let localError := [outcome at: "error" ifAbsent: [| nil]];
          [[localError notNil]
            ifTrue: [|
              [self sessionReply:
                [self sessionError: id code: -32002 message: localError data: nil]
                state: next]]
            ifFalse: [|
              [self sessionReply:
                [self sessionSuccess: id result: [outcome at: "result"]]
                state: next]]]]]]]
  ] doc:
  "Handle one JSON-RPC-shaped request against the synchronous local adapter." ];

[Reflect defineMethod: #performSessionRequest:in: on: Digla as: [:self :request :session |
  let adapter := [session at: "adapterObject" ifAbsent: [| nil]];
  [[adapter isNil]
    ifTrue: [|
      let id := [request at: "id" ifAbsent: [| nil]];
      [self sessionReply:
        [self sessionError: id code: -32000 message: "unsupported session adapter"
          data: [session at: "adapter" ifAbsent: [| nil]]]
        state: session]]
    ifFalse: [| [adapter perform: request in: session]]]
  ] doc:
  "Route a runtime request through the session's adapter prototype." ];

[Reflect defineMethod: #perform:in: on: DiglaLocalSessionAdapter as:
  [:self :request :session | [Digla performLocalSessionRequest: request in: session]] doc:
  "Perform one request through the synchronous local-image adapter." ];

[Reflect defineMethod: #perform:in: on: DiglaTcpSessionAdapter as:
  [:self :request :session | [Digla performTcpSessionRequest: request in: session]] doc:
  "Perform one request through the optional TCP adapter implementation." ];

[Reflect defineMethod: #performTcpSessionRequest:in: on: Digla as: [:self :request :session |
  let id := [request at: "id" ifAbsent: [| nil]];
  [self sessionReply:
    [self sessionError: id code: -32005 message: "TCP session adapter is not loaded" data: nil]
    state: session]
  ] doc:
  "Return an explicit failure when the optional TCP client adapter is absent." ];
