// editor-test.birnam — headless editor-model contract.

let e := [TestSuite named: "Digla editor" module: #diglaEditor];

[e test: "insert and UTF-8 boundary deletion" do: [:t |
  let config := [Digla configAtPath: nil environment: [Map new] args: #[]];
  let s0 := [Digla editorStateFor: config];
  let s1 := [Digla insertText: "a🙂b" into: s0];
  let s2 := [Digla backspaceIn: s1];
  [t expect: [s1 at: "buffer"] equals: "a🙂b" describes: "inserted text"];
  [t expect: [s1 at: "cursor"] equals: 6 describes: "cursor uses UTF-8 bytes"];
  [t expect: [s2 at: "buffer"] equals: "a🙂" describes: "backspace removes one codepoint"];
  [t expect: [s2 at: "cursor"] equals: 5 describes: "cursor retreats to codepoint boundary"]]];

[e test: "line movement clamps to adjacent line" do: [:t |
  let config := [Digla configAtPath: nil environment: [Map new] args: #[]];
  let s0 := [Digla editorStateFor: config];
  let s1 := [Digla insertText: "long\nx" into: s0];
  let s2 := [Digla moveHomeIn: s1];
  let s3 := [Digla moveUpIn: s2];
  let s4 := [Digla moveEndIn: s3];
  let s5 := [Digla moveDownIn: s4];
  [t expect: [s2 at: "cursor"] equals: 5 describes: "home starts second line"];
  [t expect: [s3 at: "cursor"] equals: 0 describes: "up clamps at first line"];
  [t expect: [s4 at: "cursor"] equals: 4 describes: "end reaches first line"];
  [t expect: [s5 at: "cursor"] equals: 6 describes: "down clamps to second line"]]];

[e test: "Shift movement selects source bytes and ordinary movement clears it" do: [:t |
  let config := [Digla configAtPath: nil environment: [Map new] args: #[]];
  let s0 := [Digla editorStateFor: config];
  let s1 := [s0 at: "buffer" put: "a🙂bc"];
  let first := [Digla handleKey: 65514 modifier: 4 character: "" state: s1];
  let firstRange := [Digla selectionRangeIn: first];
  [t expect: [first at: "cursor"] equals: 1 describes: "first Shift-Right moves one codepoint"];
  [t expect: [firstRange at: "start"] equals: 0 describes: "selection starts at anchor"];
  [t expect: [firstRange at: "end"] equals: 1 describes: "selection ends at cursor"];
  let second := [Digla handleKey: 65514 modifier: 4 character: "" state: first];
  let secondRange := [Digla selectionRangeIn: second];
  [t expect: [second at: "cursor"] equals: 5 describes: "selection crosses UTF-8 as one codepoint"];
  [t expect: [secondRange at: "end"] equals: 5 describes: "selection range remains byte-based"];
  let reversed := [Digla handleKey: 65515 modifier: 4 character: "" state: second];
  let reversedRange := [Digla selectionRangeIn: reversed];
  [t expect: [reversedRange at: "end"] equals: 1 describes: "Shift-Left contracts toward anchor"];
  let cleared := [Digla handleKey: 65514 modifier: 0 character: "" state: reversed];
  [t expect: [cleared at: "selection"] equals: nil describes: "ordinary movement clears selection"]]];

[e test: "typing and deletion replace the selected range" do: [:t |
  let config := [Digla configAtPath: nil environment: [Map new] args: #[]];
  let s0 := [Digla editorStateFor: config];
  let s1 := [s0 at: "buffer" put: "a🙂bc"];
  let s2 := [s1 at: "cursor" put: 5];
  let s3 := [s2 at: "selection" put: { "anchor" -> 1 }];
  let typed := [Digla insertText: "Z" into: s3];
  [t expect: [typed at: "buffer"] equals: "aZbc" describes: "typing replaces selection"];
  [t expect: [typed at: "cursor"] equals: 2 describes: "cursor follows replacement"];
  [t expect: [typed at: "selection"] equals: nil describes: "replacement clears selection"];
  let s4 := [typed at: "cursor" put: 3];
  let s5 := [s4 at: "selection" put: { "anchor" -> 1 }];
  let deleted := [Digla backspaceIn: s5];
  [t expect: [deleted at: "buffer"] equals: "ac" describes: "backspace removes selection"];
  [t expect: [deleted at: "cursor"] equals: 1 describes: "deletion returns to selection start"]]];

[e test: "editor viewport follows a cursor outside the visible logical rows" do: [:t |
  let config := [Digla configAtPath: nil environment: [Map new] args: #[]];
  let s0 := [Digla editorStateFor: config];
  let text := "zero\none\ntwo\nthree\nfour\nfive";
  let s1 := [s0 at: "buffer" put: text];
  let s2 := [s1 at: "cursor" put: [text size]];
  let atBottom := [Digla ensureEditorViewportRows: 3 in: s2];
  [t expect: [[atBottom at: "viewport"] at: "editorTopRow"] equals: 3
    describes: "viewport reveals bottom cursor"];
  let s3 := [atBottom at: "cursor" put: 0];
  let atTop := [Digla ensureEditorViewportRows: 3 in: s3];
  [t expect: [[atTop at: "viewport"] at: "editorTopRow"] equals: 0
    describes: "viewport follows cursor back to top"]]];

[e test: "submit evaluates and records history" do: [:t |
  let config := [Digla configAtPath: nil environment: [Map new] args: #[]];
  let s0 := [Digla editorStateFor: config];
  let s1 := [Digla insertText: "[1 + 2]" into: s0];
  let s2 := [Digla submitIn: s1];
  let s3 := [Digla historyMove: -1 in: s2];
  [t expect: [s2 at: "buffer"] equals: "" describes: "submit clears buffer"];
  [t expect: [s2 at: "lastResult"] equals: 3 describes: "submit evaluates locally"];
  [t expect: [[s2 at: "history"] at: 0] equals: "[1 + 2]" describes: "submit records history"];
  [t expect: [s3 at: "buffer"] equals: "[1 + 2]" describes: "history recalls form"]]];

[e test: "structured output is inserted before the evaluation value" do: [:t |
  let events := #[
    { "kind" -> "output", "channel" -> "stdout", "text" -> "hello\n", "sequence" -> 1 }
    { "kind" -> "output", "channel" -> "stdout", "text" -> "there", "sequence" -> 2 }
  ];
  let entries := [Digla evaluationTranscriptEntriesFor: "[probe]"
    events: events display: "42"];
  [t expect: [entries size] equals: 4 describes: "input, output, and value are distinct"];
  [t expect: [entries at: 0] equals: "> [probe]" describes: "input stays first"];
  [t expect: [entries at: 1] equals: "hello\n" describes: "first output follows input"];
  [t expect: [entries at: 2] equals: "there" describes: "second output remains ordered"];
  [t expect: [entries at: 3] equals: "42" describes: "value follows emitted output"]]];

[e test: "key handling separates newline from evaluation" do: [:t |
  let config := [Digla configAtPath: nil environment: [Map new] args: #[]];
  let s0 := [Digla editorStateFor: config];
  let s1 := [Digla handleKey: 0 character: "x" state: s0];
  let s2 := [Digla handleKey: 10 character: "" state: s1];
  let s3 := [Digla handleKey: 13 character: "" state: s2];
  let s4 := [Digla handleKey: 0 character: "a" state: s0];
  [t expect: [s2 at: "buffer"] equals: "x\n" describes: "control-j inserts newline"];
  [t expect: [s3 at: "buffer"] equals: "" describes: "enter submits form"];
  [t expect: [s4 at: "running"] equals: true describes: "ordinary characters keep the editor running"]]];

[e test: "terminal continuation stops only after the state says so" do: [:t |
  let config := [Digla configAtPath: nil environment: [Map new] args: #[]];
  let s0 := [Digla editorStateFor: config];
  let remaining := [2 asCell];
  let step := [:state |
    [remaining set: [[remaining value] - 1]];
    [state at: "running" put: [[remaining value] > 0]]];
  let final := [Digla runWhileRunning: s0 step: step];
  [t expect: [final at: "running"] equals: false describes: "loop returns the stopped state"];
  [t expect: [remaining value] equals: 0 describes: "loop applies each transition"]]];

[e test: "F3 opens project-authored source and F5 restores the prior buffer" do: [:t |
  let config := [Digla configAtPath: nil environment: [Map new]
    args: #["--workspace" "examples/digla"]];
  let initial0 := [Digla editorStateFor: config];
  let initial1 := [initial0 at: "buffer" put: "definitionFor:"];
  let initial := [initial1 at: "cursor" put: 4];
  let opened := [Digla handleKey: 65533 character: "" state: initial];
  let document := [opened at: "document"];
  [t assert: [[document at: "path"] endsWith: "/modules/digla/language-service.birnam"]
    describes: "F3 opens authored source part"];
  [t expect: [document at: "module"] equals: "digla" describes: "module provenance"];
  [t expect: [[opened at: "navigation"] size] equals: 1 describes: "prior buffer retained"];
  [t assert: [[opened at: "buffer"] includesSubstring: "#definitionFor:cursor:"]
    describes: "source loaded without evaluation"];
  let edited := [Digla insertText: "x" into: opened];
  [t expect: [[edited at: "document"] at: "dirty"] equals: true
    describes: "authored buffer edit is explicit"];
  let returned := [Digla handleKey: 65531 character: "" state: edited];
  [t expect: [returned at: "buffer"] equals: "definitionFor:" describes: "F5 restores source"];
  [t expect: [returned at: "cursor"] equals: 4 describes: "F5 restores cursor"];
  [t expect: [[returned at: "navigation"] size] equals: 0 describes: "navigation stack pops"]]];

[e test: "terminal commands inspect globals and the last result without eval" do: [:t |
  let config := [Digla configAtPath: nil environment: [Map new] args: #[]];
  let initial := [Digla editorStateFor: config];
  let evaluated := [Digla submitIn: [initial at: "buffer" put: "[20 + 1]"]];
  let inspectedResult := [Digla submitIn: [evaluated at: "buffer" put: ":inspect"]];
  let inspectedGlobal := [Digla submitIn: [inspectedResult at: "buffer" put: ":inspect String"]];
  let resultText := [[inspectedResult at: "transcript"] last];
  let globalText := [[inspectedGlobal at: "transcript"] last];
  [t assert: [resultText includesSubstring: "value:      21"] describes: "last result inspection"];
  [t assert: [globalText includesSubstring: "target:     #String"] describes: "named global inspection"];
  [t expect: [inspectedGlobal at: "lastResult"] equals: 21 describes: "commands preserve the last result"];
  [t expect: [inspectedGlobal at: "status"] equals: "inspected global" describes: "command status"]]];

[e test: "terminal command help and failures stay structured" do: [:t |
  let config := [Digla configAtPath: nil environment: [Map new] args: #[]];
  let initial := [Digla editorStateFor: config];
  let help := [Digla submitIn: [initial at: "buffer" put: ":help"]];
  let missing := [Digla submitIn: [help at: "buffer" put: ":inspect NoSuchDiglaGlobal"]];
  let unknown := [Digla submitIn: [missing at: "buffer" put: ":wat"]];
  [t assert: [[[help at: "transcript"] last] includesSubstring: ":inspect NAME"] describes: "help lists inspect"];
  [t assert: [[[help at: "transcript"] last] includesSubstring: ":connect TARGET"] describes: "help lists session switching"];
  [t assert: [[[missing at: "transcript"] last] includesSubstring: "global not found"] describes: "missing global warning"];
  [t expect: [unknown at: "status"] equals: "command error" describes: "unknown command status"]]];

[e test: "connect command switches session adapters without terminal state" do: [:t |
  let config := [Digla configAtPath: nil environment: [Map new]
    args: #["--connect=remote"]];
  let initial := [Digla editorStateFor: config];
  let switched := [Digla submitIn: [initial at: "buffer" put: ":connect local"]];
  [t expect: [[switched at: "session"] at: "adapter"] equals: "local"
    describes: "command selects the local adapter"];
  [t expect: [[switched at: "config"] at: "connect"] equals: "remote"
    describes: "runtime switching leaves the startup snapshot immutable"];
  [t expect: [switched at: "status"] equals: "connected local"
    describes: "switch is visible in terminal-independent state"]]];

[e test: "editor routes runtime work through one session and preserves last success" do: [:t |
  let config := [Digla configAtPath: nil environment: [Map new] args: #[]];
  let initial := [Digla editorStateFor: config];
  let evaluated := [Digla submitIn: [initial at: "buffer" put: "[6 * 7]"]];
  let failed := [Digla submitIn: [evaluated at: "buffer" put: "[6 *"]];
  let inspected := [Digla submitIn: [failed at: "buffer" put: ":inspect"]];
  let globals := [Digla submitIn: [inspected at: "buffer" put: ":globals"]];
  let sessionInfo := [Digla submitIn: [globals at: "buffer" put: ":session"]];
  [t expect: [[[evaluated at: "session"] at: "nextId"] > [[initial at: "session"] at: "nextId"]]
    equals: true describes: "evaluation advances session request ids"];
  [t expect: [failed at: "status"] equals: "error" describes: "structured evaluation failure"];
  [t assert: [[[inspected at: "transcript"] last] includesSubstring: "value:      42"]
    describes: "last successful value survives a failure"];
  [t assert: [[[globals at: "transcript"] last] includesSubstring: "#String"]
    describes: "globals command uses session result"];
  [t assert: [[[sessionInfo at: "transcript"] last] includesSubstring: "structuredValues=true"]
    describes: "session command exposes capabilities"]]];

[e test: "completion opens through the session, cycles, and replaces the source prefix" do: [:t |
  [Globals at: #DiglaCompletionAlpha put: 1];
  [Globals at: #DiglaCompletionBeta put: 2];
  let config := [Digla configAtPath: nil environment: [Map new] args: #[]];
  let initial0 := [Digla editorStateFor: config];
  let initial1 := [initial0 at: "buffer" put: "DiglaCompletion"];
  let initial := [initial1 at: "cursor" put: [[initial1 at: "buffer"] size]];
  let opened := [Digla handleKey: 9 character: "" state: initial];
  let menu := [opened at: "completion"];
  let firstLabel := [[[menu at: "items"] at: 0] at: "label"];
  let moved := [Digla handleKey: 9 character: "" state: opened];
  let selectedLabel := [[[[moved at: "completion"] at: "items"]
    at: [[moved at: "completion"] at: "index"]] at: "label"];
  let accepted := [Digla handleKey: 13 character: "" state: moved];
  [t expect: [[menu at: "items"] size] equals: 2 describes: "runtime candidates opened"];
  [t expect: [[[opened at: "session"] at: "nextId"] > [[initial at: "session"] at: "nextId"]]
    equals: true describes: "completion advances session request ids"];
  [t expect: [[selectedLabel = firstLabel] not] equals: true describes: "Tab cycles the menu"];
  [t expect: [accepted at: "buffer"] equals: selectedLabel describes: "Enter accepts selection"];
  [t expect: [accepted at: "cursor"] equals: [selectedLabel size] describes: "cursor follows insertion"];
  [t expect: [accepted at: "completion"] equals: nil describes: "acceptance closes menu"]]];

[e test: "Escape dismisses completion before it quits the editor" do: [:t |
  let config := [Digla configAtPath: nil environment: [Map new] args: #[]];
  let initial0 := [Digla editorStateFor: config];
  let initial1 := [initial0 at: "buffer" put: "le"];
  let initial := [initial1 at: "cursor" put: 2];
  let opened := [Digla handleKey: 9 character: "" state: initial];
  let dismissed := [Digla handleKey: 27 character: "" state: opened];
  let stopped := [Digla handleKey: 27 character: "" state: dismissed];
  [t expect: [[opened at: "completion"] notNil] equals: true describes: "Tab opens menu"];
  [t expect: [dismissed at: "completion"] equals: nil describes: "first Escape dismisses"];
  [t expect: [dismissed at: "running"] equals: true describes: "dismissal keeps editor alive"];
  [t expect: [stopped at: "running"] equals: false describes: "second Escape quits"]]];

[e test: "source completion survives an unavailable runtime provider" do: [:t |
  let config := [Digla configAtPath: nil environment: [Map new] args: #[]];
  let initial0 := [Digla editorStateFor: config];
  let closedSession := [[initial0 at: "session"] at: "status" put: "closed"];
  let initial1 := [initial0 at: "session" put: closedSession];
  let initial2 := [initial1 at: "buffer" put: "le"];
  let initial := [initial2 at: "cursor" put: 2];
  let opened := [Digla openCompletionIn: initial];
  let labels := [[[opened at: "completion"] at: "items"]
    collect: [:item | [item at: "label"]]];
  [t expect: [labels includes: "let"] equals: true describes: "source candidate remains"];
  [t assert: [[opened at: "status"] includesSubstring: "source only"]
    describes: "provider failure is visible without suppressing source results"]]];

[e test: "function keys open assistance and Escape dismisses before quitting" do: [:t |
  [Globals at: #DiglaFunctionKeyProbe put: [Object clone]];
  let config := [Digla configAtPath: nil environment: [Map new] args: #[]];
  let initial0 := [Digla editorStateFor: config];
  let initial1 := [initial0 at: "buffer" put: "DiglaFunctionKeyProbe"];
  let initial := [initial1 at: "cursor" put: 4];
  let hovered := [Digla handleKey: 65535 modifier: 0 character: "" state: initial];
  [t expect: [[hovered at: "assistance"] at: "kind"] equals: "hover"
    describes: "F1 opens hover"];
  let dismissed := [Digla handleKey: 27 modifier: 0 character: "" state: hovered];
  [t expect: [dismissed at: "assistance"] equals: nil describes: "Escape dismisses assistance"];
  [t expect: [dismissed at: "running"] equals: true describes: "dismissal keeps editor running"];
  let stopped := [Digla handleKey: 27 modifier: 0 character: "" state: dismissed];
  [t expect: [stopped at: "running"] equals: false describes: "next Escape quits"]]];

[e test: "typing only dirties cached diagnostics until an explicit refresh" do: [:t |
  let config := [Digla configAtPath: nil environment: [Map new] args: #[]];
  let initial := [Digla editorStateFor: config];
  let typed := [Digla insertText: "let x := [3 +" into: initial];
  [t expect: [[typed at: "diagnostics"] size] equals: 0
    describes: "typing does not synchronously parse the buffer"];
  [t expect: [typed at: "diagnosticsDirty"] equals: true
    describes: "source edits mark the diagnostic cache stale"];
  let checked := [Digla handleKey: 65532 modifier: 0 character: "" state: typed];
  [t expect: [[[checked at: "diagnostics"] size] > 0] equals: true
    describes: "F4 refreshes parser diagnostics"];
  [t expect: [checked at: "diagnosticsDirty"] equals: false
    describes: "explicit refresh marks the cache clean"]]];

[e test: "Page Up and Page Down move the transcript viewport and evaluation follows the tail" do: [:t |
  let config := [Digla configAtPath: nil environment: [Map new] args: #[]];
  let initial := [Digla editorStateFor: config];
  let up := [Digla handleKey: 65519 modifier: 0 character: "" state: initial];
  let farther := [Digla handleKey: 65519 modifier: 0 character: "" state: up];
  let down := [Digla handleKey: 65518 modifier: 0 character: "" state: farther];
  [t expect: [[up at: "viewport"] at: "transcriptOffset"] equals: 10
    describes: "Page Up moves one transcript page from the tail"];
  [t expect: [[down at: "viewport"] at: "transcriptOffset"] equals: 10
    describes: "Page Down moves back toward the tail"];
  let source := [down at: "buffer" put: "[1 + 1]"];
  let submitted := [Digla submitIn: source];
  [t expect: [[submitted at: "viewport"] at: "transcriptOffset"] equals: 0
    describes: "new transcript output resumes tail following"]]];
