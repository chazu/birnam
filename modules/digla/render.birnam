// render.birnam — stable text for the first runnable Digla slice.
//
// Terminal-cell rendering will be added behind Termbox. Keeping this first
// report value-oriented gives the configuration and session seams a headless
// acceptance path.

[Reflect defineMethod: #summary: on: Digla as: [:self :config |
  let mode := [config at: "mode"];
  let connect := [config at: "connect"];
  let bind := [config at: "bind"];
  let port := [[config at: "port"] printString];
  let path := [config path];
  let pathText := [[path isNil] ifTrue: [| "(default)" ] ifFalse: [| path]];
  let a := ["Digla mode=" , mode];
  let b := [a , " connect=" , connect];
  let c := [b , " endpoint=" , bind];
  let d := [c , ":" , port];
  [d , " config=" , pathText]] doc:
  "Render the resolved startup configuration as a deterministic one-line summary."];

[Reflect defineMethod: #highlightColorFor: on: Digla as: [:self :kind |
  [[kind = "comment"] ifTrue: [| 5] ifFalse: [|
    [[kind = "string"] ifTrue: [| 3] ifFalse: [|
      [[kind = "number"] ifTrue: [| 6] ifFalse: [|
        [[kind = "symbol"] ifTrue: [| 6] ifFalse: [|
          [[kind = "keyword"] ifTrue: [| 7] ifFalse: [|
            [[kind = "selector"] ifTrue: [| 4] ifFalse: [| 8]]]]]]]]]]]]
  ] doc:
  "Map a lexical highlight kind to a Termbox foreground color." ];

[Reflect defineMethod: #diagnosticIntersects:start:end:in: on: Digla as: [:self :diagnostic :start :finish :text |
  let diagnosticStart := [diagnostic at: "start"];
  let diagnosticEnd := [diagnostic at: "end"];
  let span := [[diagnosticStart < finish] & [diagnosticEnd > start]];
  let point := [[[diagnosticStart = diagnosticEnd] & [diagnosticStart >= start]]
    & [diagnosticStart < finish]];
  [span | point]
  ] doc:
  "Answer whether one static diagnostic overlaps a half-open source byte span." ];

[Reflect defineMethod: #diagnosticTouchesRow:start:end:in: on: Digla as: [:self :diagnostic :start :finish :text |
  let diagnosticStart := [diagnostic at: "start"];
  let diagnosticEnd := [diagnostic at: "end"];
  let span := [[diagnosticStart < finish] & [diagnosticEnd > start]];
  let point := [[[diagnosticStart = diagnosticEnd] & [diagnosticStart >= start]]
    & [diagnosticStart <= finish]];
  [span | point]
  ] doc:
  "Answer whether a diagnostic touches a logical row, including its end boundary." ];

[Reflect defineMethod: #highlightColorFor:diagnostics:start:end:text: on: Digla as: [:self :entry :diagnostics :start :finish :text |
  let color := [[self highlightColorFor: [entry at: "kind"]] asCell];
  [diagnostics do: [:diagnostic |
    [[self diagnosticIntersects: diagnostic start: start end: finish in: text]
      ifTrue: [| [color set: 2]]]]];
  [color value]
  ] doc:
  "Choose syntax color, overriding a span with red when a diagnostic overlaps it." ];

[Reflect defineMethod: #diagnosticColorForRow:analysis:text: on: Digla as: [:self :row :analysis :text |
  let start := [row at: "sourceStart"];
  let finish := [row at: "sourceEnd"];
  let color := [8 asCell];
  [[analysis at: "diagnostics"] do: [:diagnostic |
    [[self diagnosticTouchesRow: diagnostic start: start end: finish in: text]
      ifTrue: [| [color set: 2]]]]];
  [color value]
  ] doc:
  "Choose the prompt color for a source line containing a diagnostic." ];

[Reflect defineMethod: #renderSourceRange:start:end:y:promptWidth:fg:text: on: Digla as: [:self :rowStart :start :finish :y :promptWidth :fg :text |
  let x := [promptWidth + [self displayWidthIn: text from: rowStart to: start]];
  [[start < finish]
    ifTrue: [| [Termbox printX: x y: y fg: fg bg: 0 str: [text copyFrom: start to: finish]]]
    ifFalse: [| nil]];
  nil
  ] doc:
  "Render one source byte range at its projected terminal-cell x coordinate." ];

[Reflect defineMethod: #renderSourceRow:analysis:y:promptWidth:in: on: Digla as: [:self :row :analysis :y :promptWidth :text |
  let lineStart := [row at: "sourceStart"];
  let lineEnd := [row at: "sourceEnd"];
  let cursor := [lineStart asCell];
  let highlights := [analysis at: "highlights"];
  let diagnostics := [analysis at: "diagnostics"];
  [highlights do: [:entry |
    let entryStart := [entry at: "start"];
    let entryEnd := [entry at: "end"];
    [[[entryStart < lineEnd] & [entryEnd > lineStart]] ifTrue: [|
      let start := [[entryStart < lineStart] ifTrue: [| lineStart] ifFalse: [| entryStart]];
      let finish := [[entryEnd > lineEnd] ifTrue: [| lineEnd] ifFalse: [| entryEnd]];
      [[[cursor value] < start]
        ifTrue: [|
          [self renderSourceRange: lineStart start: [cursor value] end: start
            y: y promptWidth: promptWidth fg: 8 text: text]]
        ifFalse: [| nil]];
      [[start < finish]
        ifTrue: [|
          let color := [self highlightColorFor: entry diagnostics: diagnostics
            start: start end: finish text: text];
          [self renderSourceRange: lineStart start: start end: finish
            y: y promptWidth: promptWidth fg: color text: text]]
        ifFalse: [| nil]];
      [cursor set: finish]]]]];
  [[[cursor value] < lineEnd]
    ifTrue: [|
      [self renderSourceRange: lineStart start: [cursor value] end: lineEnd
        y: y promptWidth: promptWidth fg: 8 text: text]]
    ifFalse: [| nil]];
  nil
  ] doc:
  "Render one logical source row from byte spans through terminal-cell positions." ];

[Reflect defineMethod: #renderSelectionForRow:state:y:promptWidth:in: on: Digla as:
  [:self :row :state :y :promptWidth :text |
  let range := [self selectionRangeIn: state];
  [[range isNil]
    ifTrue: [| nil]
    ifFalse: [|
      let lineStart := [row at: "sourceStart"];
      let lineEnd := [row at: "sourceEnd"];
      let rangeStart := [range at: "start"];
      let rangeEnd := [range at: "end"];
      let start := [[rangeStart < lineStart] ifTrue: [| lineStart] ifFalse: [| rangeStart]];
      let finish := [[rangeEnd > lineEnd] ifTrue: [| lineEnd] ifFalse: [| rangeEnd]];
      [[start < finish]
        ifTrue: [|
          let x := [promptWidth + [self displayWidthIn: text from: lineStart to: start]];
          [Termbox printX: x y: y fg: 0 bg: 7 str: [text copyFrom: start to: finish]]]
        ifFalse: [| nil]]]]
  ] doc:
  "Overlay the normalized source selection on one rendered logical row." ];

[Reflect defineMethod: #bracketMarksForRow:match: on: Digla as: [:self :row :match |
  [[match isNil]
    ifTrue: [| #[]]
    ifFalse: [|
      let offsets0 := #[[match at: "anchor"]];
      let paired := [match at: "match"];
      let offsets := [[paired isNil] ifTrue: [| offsets0] ifFalse: [| [offsets0 add: paired]]];
      let start := [row at: "sourceStart"];
      let finish := [row at: "sourceEnd"];
      [offsets select: [:offset | [[offset >= start] & [offset < finish]]]]]]
  ] doc:
  "Return active bracket byte offsets that intersect one soft-wrapped source row." ];

[Reflect defineMethod: #bracketColorFor: on: Digla as: [:self :match |
  [[match at: "matched"] ifTrue: [| 6] ifFalse: [| 2]]
  ] doc:
  "Use cyan for a matched pair and red for an unmatched active bracket." ];

[Reflect defineMethod: #renderBracketMatchForRow:frame:y:promptWidth:in: on: Digla as:
  [:self :row :frame :y :promptWidth :text |
    let match := [frame at: "bracketMatch" ifAbsent: [| nil]];
    let color := [[match isNil] ifTrue: [| 0] ifFalse: [| [self bracketColorFor: match]]];
    [[self bracketMarksForRow: row match: match] do: [:offset |
      let x := [promptWidth + [self displayWidthIn: text
        from: [row at: "sourceStart"] to: offset]];
      [Termbox printX: x y: y fg: 0 bg: color
        str: [text copyFrom: offset to: [offset + 1]]]]];
    nil
  ] doc:
  "Overlay the active matched or unmatched bracket pair on one terminal source row." ];

[Reflect defineMethod: #wrapTranscriptLine:width: on: Digla as: [:self :text :requestedWidth |
  let width := [[requestedWidth < 1] ifTrue: [| 1] ifFalse: [| requestedWidth]];
  let lines := [#[] asCell];
  let start := [0 asCell];
  let byte := [0 asCell];
  let column := [0 asCell];
  [[| [[byte value] < [text size]]] whileTrue: [|
    let i := [byte value];
    let glyphWidth := [self terminalCellWidthAt: i column: [column value] in: text];
    let overflows := [[[column value] > 0] & [[[column value] + glyphWidth] > width]];
    [overflows
      ifTrue: [|
        [lines set: [[lines value] add: [text copyFrom: [start value] to: i]]];
        [start set: i];
        [column set: 0]]
      ifFalse: [|
        [byte set: [i + [self utf8WidthAt: i in: text]]];
        [column set: [[column value] + glyphWidth]]]]]];
  [lines set: [[lines value] add: [text copyFrom: [start value] to: [text size]]]];
  [lines value]
  ] doc:
  "Hard-wrap one transcript line at terminal-cell boundaries without splitting UTF-8." ];

[Reflect defineMethod: #transcriptLines:width: on: Digla as: [:self :transcript :width |
  let lines := [#[] asCell];
  [transcript do: [:entry |
    let logicalLines := [entry split: "\n"];
    [logicalLines do: [:logicalLine |
      let wrapped := [self wrapTranscriptLine: logicalLine width: width];
      [wrapped do: [:line |
        [lines set: [[lines value] add: line]]
      ]]
    ]]
  ]];
  [lines value]
  ] doc:
  "Flatten transcript entries into terminal-width display rows." ];

[Reflect defineMethod: #completionRowsFor:limit: on: Digla as: [:self :state :requestedLimit |
  let menu := [state at: "completion"];
  [[menu isNil]
    ifTrue: [| #[]]
    ifFalse: [|
      let items := [menu at: "items"];
      let count := [items size];
      [[count = 0]
        ifTrue: [| #[]]
        ifFalse: [|
          let limit := [count min: requestedLimit];
          let index := [menu at: "index"];
          let desiredStart := [[index >= limit] ifTrue: [| [[index - limit] + 1]] ifFalse: [| 0]];
          let latestStart := [count - limit];
          let start := [[desiredStart > latestStart] ifTrue: [| latestStart] ifFalse: [| desiredStart]];
          let rows := [#[] asCell];
          [start to: [[start + limit] - 1] do: [:i |
            let item := [items at: i];
            let selected := [i = index];
            let marker := [selected ifTrue: [| "> "] ifFalse: [| "  "]];
            let text := [marker , [item at: "label"] , "  " , [item at: "kind"]
              , "  " , [item at: "detail"]];
            [rows set: [[rows value] add: {
              "text" -> text, "selected" -> selected, "itemIndex" -> i }]]]];
          [rows value]]]]]
  ] doc:
  "Project the active completion menu into a bounded window of display rows." ];

[Reflect defineMethod: #assistanceRowsFor:width:limit: on: Digla as: [:self :state :width :requestedLimit |
  let assistance := [state at: "assistance"];
  [[assistance isNil]
    ifTrue: [| #[]]
    ifFalse: [|
      let heading := [[assistance at: "kind"] , ": " , [assistance at: "title"]];
      let lines := [self transcriptLines: #[heading [assistance at: "text"]] width: width];
      let limit := [[lines size] min: requestedLimit];
      let rows := [#[] asCell];
      [[limit > 0] ifTrue: [|
        [0 to: [limit - 1] do: [:i |
          [rows set: [[rows value] add: {
            "text" -> [lines at: i], "selected" -> false, "itemIndex" -> i }]]]]]];
      [rows value]]]
  ] doc:
  "Project copied hover/signature text into bounded terminal-width rows." ];

[Reflect defineMethod: #transcriptWindowFor:availableRows:offset: on: Digla as:
  [:self :lineCount :requestedRows :requestedOffset |
  let rows := [[requestedRows < 0] ifTrue: [| 0] ifFalse: [| requestedRows]];
  let maxOffset0 := [lineCount - rows];
  let maxOffset := [[maxOffset0 < 0] ifTrue: [| 0] ifFalse: [| maxOffset0]];
  let nonnegative := [[requestedOffset < 0] ifTrue: [| 0] ifFalse: [| requestedOffset]];
  let offset := [[nonnegative > maxOffset] ifTrue: [| maxOffset] ifFalse: [| nonnegative]];
  let finish := [lineCount - offset];
  let start0 := [finish - rows];
  let start := [[start0 < 0] ifTrue: [| 0] ifFalse: [| start0]];
  { "start" -> start, "end" -> finish, "offset" -> offset }
  ] doc:
  "Clamp a tail-relative transcript offset and answer its half-open visible row window." ];

[Reflect defineMethod: #browserSectionTabsFor: on: Digla as: [:self :browser |
  let sb := [StringBuilder new];
  let active := [browser at: "section"];
  [[browser at: "sections"] do: [:section |
    let label := [[section = active]
      ifTrue: [| ["[" , section , "]"]]
      ifFalse: [| section]];
    [sb add: label];
    [sb add: "  "]]];
  [sb asString]
  ] doc:
  "Project browser sections to compact tabs without querying snapshot data." ];

[Reflect defineMethod: #browserListRowsFor:limit: on: Digla as:
  [:self :browser :requestedLimit |
    let items := [browser at: "items"];
    let count := [items size];
    [[requestedLimit <= 0]
      ifTrue: [| #[]]
      ifFalse: [| [[count = 0]
        ifTrue: [| #[{ "text" -> "  (no matching items)", "selected" -> false }]]
        ifFalse: [|
          let limit := [count min: requestedLimit];
          let index := [browser at: "index"];
          let desiredStart := [[index >= limit] ifTrue: [| [[index - limit] + 1]] ifFalse: [| 0]];
          let latestStart := [count - limit];
          let start := [[desiredStart > latestStart]
            ifTrue: [| latestStart]
            ifFalse: [| desiredStart]];
          let rows := [#[] asCell];
          [start to: [[start + limit] - 1] do: [:i |
            let item := [items at: i];
            let selected := [i = index];
            let marker := [selected ifTrue: [| "> "] ifFalse: [| "  "]];
            let label := [self browserItemLabel: item section: [browser at: "section"]];
            [rows set: [[rows value] add: {
              "text" -> [marker , label], "selected" -> selected,
              "itemIndex" -> i }]]]];
          [rows value]]]]]
  ] doc:
  "Project a bounded browser item window while retaining the selected row." ];

[Reflect defineMethod: #browserDetailTextFor: on: Digla as: [:self :browser |
  let snapshot := [browser at: "detail"];
  let methods := [snapshot at: "methods" ifAbsent: [| #[]]];
  let method := [methods at: 0 ifAbsent: [| nil]];
  let source := [[method isNil]
    ifTrue: [| nil]
    ifFalse: [| [method at: "source" ifAbsent: [| nil]]]];
  [[source notNil]
    ifTrue: [| source]
    ifFalse: [|
      let warnings := [snapshot at: "warnings" ifAbsent: [| #[]]];
      [[warnings isEmpty]
        ifTrue: [| "(source unavailable)"]
        ifFalse: [|
          let sb := [StringBuilder new];
          [warnings do: [:warning | [sb addLine: warning]]];
          [sb asString]]]]]
  ] doc:
  "Return copied method source or truthful snapshot warnings for browser detail." ];

[Reflect defineMethod: #browserDetailTitleFor: on: Digla as: [:self :browser |
  let snapshot := [browser at: "detail"];
  let method := [[snapshot at: "methods" ifAbsent: [| #[]]] at: 0 ifAbsent: [| nil]];
  [[method isNil]
    ifTrue: [| "source"]
    ifFalse: [| ["source #" , [method at: "selector"]]]]
  ] doc:
  "Return the selected copied method label for the source-detail heading." ];

[Reflect defineMethod: #browserDetailProjectionFor:width:limit: on: Digla as:
  [:self :browser :width :requestedLimit |
    let limit := [[requestedLimit < 0] ifTrue: [| 0] ifFalse: [| requestedLimit]];
    let title := [self browserDetailTitleFor: browser];
    let text := [self browserDetailTextFor: browser];
    let content := [self transcriptLines: #[text] width: width];
    let available := [[limit > 0] ifTrue: [| [limit - 1]] ifFalse: [| 0]];
    let maxTop0 := [[content size] - available];
    let maxTop := [[maxTop0 < 0] ifTrue: [| 0] ifFalse: [| maxTop0]];
    let requestedTop := [browser at: "detailTopRow"];
    let top := [[requestedTop > maxTop] ifTrue: [| maxTop] ifFalse: [| requestedTop]];
    let finish := [[[top + available] < [content size]]
      ifTrue: [| [top + available]]
      ifFalse: [| [content size]]];
    let rows := [#[] asCell];
    [[limit > 0] ifTrue: [|
      [rows set: [[rows value] add: { "text" -> title, "selected" -> false }]]]];
    [[finish > top] ifTrue: [|
      [top to: [finish - 1] do: [:i |
        [rows set: [[rows value] add: {
          "text" -> [content at: i], "selected" -> false }]]]]]];
    { "rows" -> [rows value], "detailTopRow" -> top,
      "detailRowCount" -> [content size] }
  ] doc:
  "Wrap and clamp copied source detail into a bounded display-row projection." ];

[Reflect defineMethod: #browserProjectionFor:width:limit: on: Digla as:
  [:self :browser :width :requestedLimit |
    let detail := [browser at: "detail"];
    [[detail notNil]
      ifTrue: [| [self browserDetailProjectionFor: browser width: width limit: requestedLimit]]
      ifFalse: [|
        let snapshot := [browser at: "snapshot"];
        let target := [snapshot at: "target"];
        let name := [target at: "globalName" ifAbsent: [| nil]];
        let shownName := [[name isNil] ifTrue: [| "(anonymous)"] ifFalse: [| ["#" , name]]];
        let vtable := [target at: "vtableName" ifAbsent: [| nil]];
        let shownVtable := [[vtable isNil] ifTrue: [| "(unknown)"] ifFalse: [| ["#" , vtable]]];
        let basis := [[snapshot at: "basis" ifAbsent: [| nil]] printString];
        let heading := [shownName , "  vtable=" , shownVtable , "  basis=" , basis];
        let value := ["value: " , [target at: "printString"]];
        let tabs := [self browserSectionTabsFor: browser];
        let query := [browser at: "query"];
        let filter := [[query isEmpty]
          ifTrue: [| "filter: (type to filter; Ctrl-U clears)"]
          ifFalse: [| ["filter: " , query]]];
        let fixedLines := [self transcriptLines: #[heading value tabs filter] width: width];
        let limit := [[requestedLimit < 0] ifTrue: [| 0] ifFalse: [| requestedLimit]];
        let rows := [#[] asCell];
        [fixedLines do: [:line |
          [[[[rows value] size] < limit] ifTrue: [|
            [rows set: [[rows value] add: { "text" -> line, "selected" -> false }]]]]]];
        let remaining := [limit - [[rows value] size]];
        [[remaining > 0] ifTrue: [|
          [[self browserListRowsFor: browser limit: remaining] do: [:row |
            [rows set: [[rows value] add: row]]]]]];
        { "rows" -> [rows value], "detailTopRow" -> 0,
          "detailRowCount" -> 0 }]]
  ] doc:
  "Project a copied snapshot browser into bounded terminal-width rows." ];

[Reflect defineMethod: #renderBrowserTerminal:width:height: on: Digla as:
  [:self :state :width :height |
    let browser := [state at: "browser"];
    let detail := [browser at: "detail"];
    let bodyRows := [[height - 2] max: 0];
    let projection := [self browserProjectionFor: browser width: width limit: bodyRows];
    let shownBrowser := [browser at: "detailTopRow" put: [projection at: "detailTopRow"]];
    let shownState := [state at: "browser" put: shownBrowser];
    [Termbox clear];
    let header := [[detail notNil]
      ifTrue: [| "Digla browser | source | Up/Dn/PgUp/PgDn scroll | Esc back"]
      ifFalse: [| "Digla browser | type filter | Tab/Left/Right section | Up/Dn | Enter source | Esc"]];
    [Termbox printX: 0 y: 0 fg: 8 bg: 0 str: header];
    let y := [1 asCell];
    [[projection at: "rows"] do: [:row |
      let selected := [row at: "selected"];
      let fg := [selected ifTrue: [| 0] ifFalse: [| 8]];
      let bg := [selected ifTrue: [| 7] ifFalse: [| 0]];
      [Termbox printX: 0 y: [y value] fg: fg bg: bg str: [row at: "text"]];
      [y set: [[y value] + 1]]]];
    let target := [shownBrowser at: "targetName"];
    let shownTarget := [[target isNil] ifTrue: [| "(anonymous)"] ifFalse: [| ["#" , target]]];
    let detailScroll := [[detail isNil]
      ifTrue: [| ""]
      ifFalse: [| ["  row=" , [[[projection at: "detailTopRow"] + 1] printString]
        , "/" , [[projection at: "detailRowCount"] printString]]]];
    let status := [shownTarget , "  " , [shownState at: "status"] , detailScroll];
    [Termbox printX: 0 y: [height - 1] fg: 7 bg: 0 str: status];
    [Termbox setCursor: 0 y: 0];
    [Termbox present];
    shownState
  ] doc:
  "Render the copied-value browser as a dedicated full-screen terminal view." ];

[Reflect defineMethod: #renderEditorTerminal: on: Digla as: [:self :state |
  let width := [Termbox width];
  let height := [Termbox height];
  let buffer := [state at: "buffer"];
  let frame := [self renderFrameFor: buffer cursor: [state at: "cursor"]
    promptWidth: 2 width: width];
  let analysis := { "highlights" -> [frame at: "highlights"],
    "diagnostics" -> [state at: "diagnostics"] };
  let layout := [frame at: "layout"];
  let rows := [layout at: "lines"];
  let editorRows := [rows size];
  let menuRows := [self completionRowsFor: state limit: 6];
  let assistanceRows := [self assistanceRowsFor: state width: width limit: 8];
  let completionRows := [[menuRows isEmpty] ifTrue: [| assistanceRows] ifFalse: [| menuRows]];
  let completionRowCount := [completionRows size];
  let completionStart := [height - completionRowCount - 1];
  let maxEditorRows0 := [completionStart - 1];
  let maxEditorRows := [[maxEditorRows0 < 1] ifTrue: [| 1] ifFalse: [| maxEditorRows0]];
  let visibleEditorRows := [editorRows min: maxEditorRows];
  let framePosition := [frame at: "position"];
  let visibleState := [self ensureEditorViewportRows: visibleEditorRows
    cursorRow: [framePosition at: "line"] rowCount: editorRows in: state];
  let editorTopRow := [[visibleState at: "viewport"] at: "editorTopRow"];
  let start := [completionStart - visibleEditorRows];
  [Termbox clear];
  let evaluating := [[visibleState at: "evaluation" ifAbsent: [| nil]] notNil];
  let searching := [[visibleState at: "historySearch" ifAbsent: [| nil]] notNil];
  let header := [evaluating
    ifTrue: [| "Digla | evaluating | Ctrl-C/Esc interrupt | PgUp/Dn scroll"]
    ifFalse: [| [searching
      ifTrue: [| "Digla | reverse search | type query | Ctrl-R older | Enter accept | Esc cancel"]
      ifFalse: [| "Digla | Ctrl-S save | Ctrl-Z/Y undo/redo | Ctrl-R history | Tab | F1-5"]]]];
  [Termbox printX: 0 y: 0 fg: 8 bg: 0 str: header];
  let transcriptLines := [self transcriptLines: [visibleState at: "transcript"] width: width];
  let availableTranscriptRows := [start - 1];
  let viewport := [visibleState at: "viewport"];
  let requestedOffset := [viewport at: "transcriptOffset" ifAbsent: [| 0]];
  let transcriptWindow := [self transcriptWindowFor: [transcriptLines size]
    availableRows: availableTranscriptRows offset: requestedOffset];
  let nextViewport := [viewport at: "transcriptOffset" put: [transcriptWindow at: "offset"]];
  let scrolledState := [visibleState at: "viewport" put: nextViewport];
  let firstTranscriptLine := [transcriptWindow at: "start"];
  let lastTranscriptLine := [transcriptWindow at: "end"];
  let transcriptY := [1 asCell];
  [[[lastTranscriptLine > firstTranscriptLine] & [availableTranscriptRows > 0]]
    ifTrue: [|
      [firstTranscriptLine to: [lastTranscriptLine - 1] do: [:i |
        [Termbox printX: 0 y: [transcriptY value] fg: 8 bg: 0 str: [transcriptLines at: i]];
        [transcriptY set: [[transcriptY value] + 1]]]]]
    ifFalse: [| nil]];
  [rows do: [:row |
    let i := [row at: "row"];
    let logicalLine := [row at: "line"];
    let prompt := [[row at: "continuation"]
      ifTrue: [| ": "]
      ifFalse: [| [[logicalLine = 0]
        ifTrue: [| [searching ifTrue: [| "? "] ifFalse: [| "> "]]]
        ifFalse: [| "| "]]]];
    let y := [start + [i - editorTopRow]];
    let visibleTop := [i >= editorTopRow];
    let visibleBottom := [i < [editorTopRow + visibleEditorRows]];
    [[visibleTop & visibleBottom]
      ifTrue: [|
        let promptColor := [self diagnosticColorForRow: row analysis: analysis text: buffer];
        [Termbox printX: 0 y: y fg: promptColor bg: 0 str: prompt];
        [self renderSourceRow: row analysis: analysis y: y promptWidth: 2 in: buffer];
        [self renderSelectionForRow: row state: scrolledState y: y promptWidth: 2 in: buffer];
        [self renderBracketMatchForRow: row frame: frame y: y promptWidth: 2 in: buffer]]
      ifFalse: [| nil]]]];
  let completionY := [completionStart asCell];
  [completionRows do: [:row |
    let selected := [row at: "selected"];
    let fg := [selected ifTrue: [| 0] ifFalse: [| 8]];
    let bg := [selected ifTrue: [| 7] ifFalse: [| 0]];
    [Termbox printX: 0 y: [completionY value] fg: fg bg: bg str: [row at: "text"]];
    [completionY set: [[completionY value] + 1]]]];
  let diagnosticCount := [[[analysis at: "diagnostics"] size] printString];
  let selected := [self selectionRangeIn: scrolledState];
  let selectionStatus := [[selected isNil]
    ifTrue: [| ""]
    ifFalse: [| ["  selected=" , [[[selected at: "end"] - [selected at: "start"]] printString]]]];
  let dirty := [[scrolledState at: "diagnosticsDirty"] ifTrue: [| "*"] ifFalse: [| ""]];
  let document := [scrolledState at: "document" ifAbsent: [| [Map new]]];
  let path := [document at: "path" ifAbsent: [| nil]];
  let documentText := [[path isNil]
    ifTrue: [| "<scratch>"]
    ifFalse: [| ["#" , [document at: "module" ifAbsent: [| "?"]]
      , " " , [[path split: "/"] last]]]];
  let documentDirty := [document at: "dirty" ifAbsent: [| false]];
  let documentMark := [documentDirty ifTrue: [| "*"] ifFalse: [| ""]];
  let transcriptOffset := [[scrolledState at: "viewport"] at: "transcriptOffset"];
  let scrollStatus := [[transcriptOffset = 0] ifTrue: [| ""]
    ifFalse: [| ["  transcript=-" , [transcriptOffset printString]]]];
  let status := [documentText , documentMark , "  " , [scrolledState at: "status"]
    , "  bytes=" , [[buffer size] printString]
    , selectionStatus , scrollStatus , "  diagnostics=" , diagnosticCount , dirty];
  [Termbox printX: 0 y: [height - 1] fg: 7 bg: 0 str: status];
  let position := framePosition;
  let cursorX := [position at: "x"];
  let cursorY := [start + [[position at: "line"] - editorTopRow]];
  [[[cursorY >= 1] & [cursorY < completionStart]]
    ifTrue: [| [Termbox setCursor: cursorX y: cursorY]]
    ifFalse: [| [Termbox setCursor: 0 y: 0]]];
  [Termbox present];
  scrolledState] doc:
  "Render the transcript and active source buffer to Termbox. Source cursor positions remain byte offsets."];

[Reflect defineMethod: #renderTerminal: on: Digla as: [:self :state |
  let browser := [state at: "browser" ifAbsent: [| nil]];
  [[browser isNil]
    ifTrue: [| [self renderEditorTerminal: state]]
    ifFalse: [| [self renderBrowserTerminal: state width: [Termbox width] height: [Termbox height]]]]
  ] doc:
  "Render either the editor or copied-value browser without leaking terminal state into either model." ];
