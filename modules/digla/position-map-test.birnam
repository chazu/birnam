// position-map-test.birnam — source/LSP coordinate contract.

let p := [TestSuite named: "Digla position map" module: #diglaPositionMap];

[p test: "UTF-8 widths and UTF-16 units" do: [:t |
  [t expect: [Digla utf8WidthAt: 0 in: "é"] equals: 2 describes: "accented byte width"];
  [t expect: [Digla utf8WidthAt: 0 in: "🙂"] equals: 4 describes: "emoji byte width"];
  [t expect: [Digla utf16UnitsAt: 0 in: "é"] equals: 1 describes: "accented UTF-16 width"];
  [t expect: [Digla utf16UnitsAt: 0 in: "🙂"] equals: 2 describes: "emoji UTF-16 width"]]];

[p test: "byte and UTF-16 columns round-trip at boundaries" do: [:t |
  let line := "aé🙂x";
  [t expect: [Digla utf16Offset: 0 in: line] equals: 0 describes: "column at start"];
  [t expect: [Digla utf16Offset: 3 in: line] equals: 2 describes: "column before emoji"];
  [t expect: [Digla utf16Offset: 7 in: line] equals: 4 describes: "column before x"];
  [t expect: [Digla byteOffsetForUtf16: 2 in: line] equals: 3 describes: "byte before emoji"];
  [t expect: [Digla byteOffsetForUtf16: 4 in: line] equals: 7 describes: "byte before x"]]];

[p test: "absolute positions handle multiline and CRLF" do: [:t |
  let text := "aé\r\n🙂x";
  let pos := [Digla positionAtByte: 5 in: text];
  let back := [Digla byteAtLine: [pos at: "line"] character: [pos at: "character"] in: text];
  [t expect: [pos at: "line"] equals: 1 describes: "second logical line"];
  [t expect: [pos at: "character"] equals: 0 describes: "second line starts at zero"];
  [t expect: back equals: 5 describes: "position round-trip"];
  [t expect: [Digla byteAtLine: 1 character: 2 in: text] equals: 9 describes: "UTF-16 emoji column"]]];
