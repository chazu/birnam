// render-test.birnam — headless tests for renderer decisions.

let e := [TestSuite named: "Digla render" module: #diglaRender];

[e test: "highlight colors and diagnostics" do: [:t |
  let text := "let x := [3 +";
  let analysis := [Digla analysisFor: text];
  let row := { "sourceStart" -> 0, "sourceEnd" -> [text size] };
  let promptColor := [Digla diagnosticColorForRow: row analysis: analysis text: text];
  [t expect: [Digla highlightColorFor: "keyword"] equals: 7 describes: "keywords use cyan"];
  [t expect: [Digla highlightColorFor: "string"] equals: 3 describes: "strings use green"];
  [t expect: promptColor equals: 2 describes: "diagnostic lines use red prompts"]]];

[e test: "an end-of-input diagnostic does not black out the preceding word" do: [:t |
  let text := "[word";
  let analysis := [Digla analysisFor: text];
  let word := [[analysis at: "highlights"] detect: [:entry | [[entry at: "kind"] = "identifier"]]];
  let color := [Digla highlightColorFor: word diagnostics: [analysis at: "diagnostics"]
    start: [word at: "start"] end: [word at: "end"] text: text];
  let row := { "sourceStart" -> 0, "sourceEnd" -> [text size] };
  [t expect: color equals: 8 describes: "the word keeps the visible default foreground"];
  [t expect: [Digla diagnosticColorForRow: row analysis: analysis text: text]
    equals: 2 describes: "the row still reports the end-of-input diagnostic in red"]]];

[e test: "transcript lines wrap at terminal-cell boundaries" do: [:t |
  let ascii := [Digla transcriptLines: #["abcdef"] width: 4];
  let unicode := [Digla transcriptLines: #["a🙂b"] width: 3];
  let explicit := [Digla transcriptLines: #["ab\ncdef"] width: 3];
  [t expect: ascii equals: #["abcd" "ef"] describes: "ASCII results hard-wrap to terminal width"];
  [t expect: unicode equals: #["a🙂" "b"] describes: "wide glyphs wrap by display cells, not bytes"];
  [t expect: explicit equals: #["ab" "cde" "f"] describes: "explicit newlines and width wrapping compose"]]];

[e test: "completion display rows keep the selected item inside a bounded window" do: [:t |
  let items := #[
    { "label" -> "alpha", "kind" -> "binding", "detail" -> "buffer binding" }
    { "label" -> "beta", "kind" -> "global", "detail" -> "live image global" }
    { "label" -> "gamma", "kind" -> "keyword", "detail" -> "Birnam keyword" }
  ];
  let menu := { "items" -> items, "index" -> 2, "start" -> 0, "end" -> 0 };
  let rows := [Digla completionRowsFor: { "completion" -> menu } limit: 2];
  [t expect: [rows size] equals: 2 describes: "menu height is bounded"];
  [t assert: [[rows at: 0] at: "text"] includesSubstring: "beta" describes: "window follows selection"];
  [t expect: [[rows at: 1] at: "selected"] equals: true describes: "selected row retained"];
  [t assert: [[rows at: 1] at: "text"] includesSubstring: "> gamma" describes: "selected marker shown"]]];

[e test: "transcript windows scroll from the tail and clamp at the oldest row" do: [:t |
  let middle := [Digla transcriptWindowFor: 20 availableRows: 5 offset: 10];
  let oldest := [Digla transcriptWindowFor: 20 availableRows: 5 offset: 99];
  let tail := [Digla transcriptWindowFor: 3 availableRows: 5 offset: -4];
  [t expect: middle equals: { "start" -> 5, "end" -> 10, "offset" -> 10 }
    describes: "offset selects a half-open middle page"];
  [t expect: oldest equals: { "start" -> 0, "end" -> 5, "offset" -> 15 }
    describes: "overscroll clamps to the oldest full page"];
  [t expect: tail equals: { "start" -> 0, "end" -> 3, "offset" -> 0 }
    describes: "negative offsets and short transcripts follow the tail"]]];
