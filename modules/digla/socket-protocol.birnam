// socket-protocol.birnam — loopback TCP delivery for Digla sessions.
//
// Framing is pure copied-value logic over accumulated String chunks. Socket
// ownership and blocking accept live only in this optional adapter module; the
// editor, language service, and session dispatcher remain transport-neutral.

[Module named: #diglaSocket requires: #[#diglaReflect #socket]];
[Reflect docModule: #diglaSocket is:
  "The optional loopback TCP adapter for framed Digla image sessions." ];

[Reflect defineMethod: #sessionFrameStep: on: Digla as: [:self :pending |
  let marker := "\r\n\r\n";
  let headerEnd := [pending indexOf: marker];
  [[headerEnd isNil]
    ifTrue: [|
      [[[pending size] > 8192]
        ifTrue: [| { "status" -> "invalid", "reason" -> "session header exceeds 8192 bytes" }]
        ifFalse: [| { "status" -> "incomplete" }]]]
    ifFalse: [|
      let bodyStart := [headerEnd + [marker size]];
      let header := [pending copyFrom: 0 to: bodyStart];
      let length := [Lsp contentLengthOf: header];
      [[length isNil]
        ifTrue: [| { "status" -> "invalid", "reason" -> "missing Content-Length" }]
        ifFalse: [|
          let validLength := [[length >= 0] & [length <= 1048576]];
          [validLength
            ifTrue: [|
              let finish := [bodyStart + length];
              [[[pending size] < finish]
                ifTrue: [| { "status" -> "incomplete" }]
                ifFalse: [|
                  { "status" -> "ready",
                    "body" -> [pending copyFrom: bodyStart to: finish],
                    "rest" -> [pending copyFrom: finish to: [pending size]] }]]]
            ifFalse: [| { "status" -> "invalid",
                           "reason" -> "session body exceeds 1 MiB limit" }]]]]]]
  ] doc:
  "Decode at most one Content-Length frame from accumulated connection bytes." ];

[Reflect defineMethod: #readSocketSessionBody:pending: on: Digla as: [:self :conn :pending |
  let reading := [true asCell];
  let answer := [nil asCell];
  [[| [reading value]] whileTrue: [|
    let frame := [self sessionFrameStep: [pending value]];
    let status := [frame at: "status"];
    [[status = "ready"]
      ifTrue: [|
        [pending set: [frame at: "rest"]];
        [answer set: [frame at: "body"]];
        [reading set: false]]
      ifFalse: [|
        [[status = "invalid"]
          ifTrue: [| [pending set: ""]; [reading set: false]]
          ifFalse: [|
            let chunk := [conn recv];
            [[chunk isEmpty]
              ifTrue: [| [reading set: false]]
              ifFalse: [| [pending set: [[pending value] , chunk]]]]]]]]]];
  [answer value]
  ] doc:
  "Read chunks iteratively until one framed JSON body is ready, or answer nil on EOF/invalid framing." ];

[Reflect defineMethod: #sendSocketSessionBody:on: on: Digla as: [:self :body :conn |
  let frame := ["Content-Length: " , [[body size] printString] , "\r\n\r\n" , body];
  [conn sendString: frame]
  ] doc:
  "Write one Content-Length-framed JSON body to a connected socket." ];

[Reflect defineMethod: #performTcpSessionRequest:in:write:read: on: Digla as:
  [:self :request :session :write :read |
    let requestId := [request at: "id" ifAbsent: [| nil]];
    let failureFor := [:code :message :state :status |
      let s1 := [state at: "status" put: status];
      let next := [s1 at: "lastError" put: message];
      [self sessionReply:
        [self sessionError: requestId code: code message: message data: nil]
        state: next]];
    let encoded := [Json stringify: request];
    let sent := [write value: encoded];
    [[sent < 0]
      ifTrue: [| [failureFor value: -32005 value: "could not write TCP session request"
        value: session value: "disconnected"]]
      ifFalse: [|
        let events := [#[] asCell];
        let response := [nil asCell];
        let failure := [nil asCell];
        let reading := [true asCell];
        [[| [reading value]] whileTrue: [|
          let body := [read value];
          [[body isNil]
            ifTrue: [|
              [failure set: { "code" -> -32003, "message" -> "TCP session closed by peer" }];
              [reading set: false]]
            ifFalse: [|
              let message := [Json parse: body];
              let step := [[message isError]
                ifTrue: [| { "status" -> "failure", "code" -> -32004,
                  "message" -> "invalid TCP session JSON" }]
                ifFalse: [|
                  let messageId := [message at: "id" ifAbsent: [| nil]];
                  [[messageId isNil]
                    ifTrue: [|
                      let method := [message at: "method" ifAbsent: [| ""]];
                      let params := [message at: "params" ifAbsent: [| [Map new]]];
                      let output := [[method = "birnam/output"] &
                        [[params at: "requestId" ifAbsent: [| nil]] = requestId]];
                      [output
                        ifTrue: [| { "status" -> "notification",
                          "event" -> [params at: "event" ifAbsent: [| nil]] }]
                        ifFalse: [| { "status" -> "ignored" }]]]
                    ifFalse: [|
                      [[messageId = requestId]
                        ifTrue: [| { "status" -> "response", "message" -> message }]
                        ifFalse: [| { "status" -> "failure", "code" -> -32004,
                          "message" -> "mismatched TCP session response id" }]]]]]];
              let status := [step at: "status"];
              [[status = "notification"] ifTrue: [|
                let event := [step at: "event"];
                let bounded := [[[events value] size] < 4096];
                [[[event notNil] & bounded]
                  ifTrue: [| [events set: [[events value] add: event]]]
                  ifFalse: [| nil]]
              ] ifFalse: [| nil]];
              [[status = "response"]
                ifTrue: [| [response set: [step at: "message"]]; [reading set: false]]
                ifFalse: [| nil]];
              [[status = "failure"]
                ifTrue: [|
                  [failure set: { "code" -> [step at: "code"],
                    "message" -> [step at: "message"] }];
                  [reading set: false]]
                ifFalse: [| nil]]]]]];
        let failed := [failure value];
        [[failed notNil]
          ifTrue: [| [failureFor value: [failed at: "code"] value: [failed at: "message"]
            value: session value: "closed"]]
          ifFalse: [|
            let rawMessage := [response value];
            let rawResult := [rawMessage at: "result" ifAbsent: [| nil]];
            let message := [[rawResult isNil]
              ifTrue: [| rawMessage]
              ifFalse: [|
                let buffered := [rawResult at: "events" ifAbsent: [| #[]]];
                let selected := [[buffered isEmpty]
                  ifTrue: [| [events value]]
                  ifFalse: [| buffered]];
                let nextResult := [rawResult at: "events" put: selected];
                [rawMessage at: "result" put: nextResult]]];
            let method := [request at: "method" ifAbsent: [| ""]];
            let result := [message at: "result" ifAbsent: [| nil]];
            let connected := [session at: "status" put: "connected"];
            let clean := [connected at: "lastError" put: nil];
            let opened := [[[method = "birnam/session/open"] & [result notNil]]
              ifTrue: [|
                let s1 := [clean at: "id" put: [result at: "sessionId"]];
                [s1 at: "capabilities" put: [result at: "capabilities"]]]
              ifFalse: [| clean]];
            let next := [[method = "birnam/close"]
              ifTrue: [| [opened at: "status" put: "closed"]]
              ifFalse: [| opened]];
            [self sessionReply: message state: next]]]]]
  ] doc:
  "Perform one serial TCP request through injected body I/O, collecting correlated notifications." ];

[Reflect defineMethod: #performTcpSessionRequest:in: on: Digla as: [:self :request :session |
  let requestId := [request at: "id" ifAbsent: [| nil]];
  let failureFor := [:code :message :state :status |
    let s1 := [state at: "status" put: status];
    let next := [s1 at: "lastError" put: message];
    [self sessionReply:
      [self sessionError: requestId code: code message: message data: nil]
      state: next]];
  [[[session at: "status"] = "closed"]
    ifTrue: [| [failureFor value: -32001 value: "session is closed"
      value: session value: "closed"]]
    ifFalse: [|
      let existing := [session at: "connection"];
      let prepared := [[existing notNil]
        ifTrue: [| { "ok" -> true, "session" -> session }]
        ifFalse: [|
          let config := [session at: "config"];
          let connection := [Socket connectTo: [config at: "bind"] port: [config at: "port"]];
          let failed := [[Reflect vtableOf: connection] == [Reflect vtableOf: 0]];
          [failed
            ifTrue: [| { "ok" -> false, "session" -> session }]
            ifFalse: [|
              let s1 := [session at: "connection" put: connection];
              let s2 := [s1 at: "pending" put: ["" asCell]];
              { "ok" -> true, "session" -> [s2 at: "status" put: "connected"] }]]]];
      [[[prepared at: "ok"] not]
        ifTrue: [| [failureFor value: -32005 value: "could not connect TCP session"
          value: [prepared at: "session"] value: "disconnected"]]
        ifFalse: [|
          let connected := [prepared at: "session"];
          let connection := [connected at: "connection"];
          let pending := [connected at: "pending"];
          let write := [:body | [self sendSocketSessionBody: body on: connection]];
          let read := [| [self readSocketSessionBody: connection pending: pending]];
          let reply := [self performTcpSessionRequest: request in: connected
            write: write read: read];
          let next := [reply at: "session"];
          [[[next at: "status"] = "closed"]
            ifTrue: [|
              [connection close];
              let released := [next at: "connection" put: nil];
              [reply at: "session" put: released]]
            ifFalse: [| reply]]]]]]
  ] doc:
  "Connect lazily and perform one request against a framed TCP image session." ];

[Reflect defineMethod: #serveSessionConnection:config: on: Digla as: [:self :conn :config |
  let pending := ["" asCell];
  let me := self;
  let read := [| [me readSocketSessionBody: conn pending: pending]];
  let write := [:body | [me sendSocketSessionBody: body on: conn]];
  let interruptAvailable := [self evaluationDeadlineAvailable];
  let base := [self localSessionFor: config];
  let capabilities0 := [base at: "capabilities"];
  let capabilities1 := [capabilities0 at: "interrupt" put: interruptAvailable];
  let capabilities2 := [capabilities1 at: "cooperativeInterrupt" put: interruptAvailable];
  let safeBoundaries := [interruptAvailable
    ifTrue: [| #["Block whileTrue:/whileFalse:" "Integer to:do:"]]
    ifFalse: [| #[]]];
  let capabilities := [capabilities2 at: "interruptSafeBoundaries" put: safeBoundaries];
  let configured := [base at: "capabilities" put: capabilities];
  let interruptProbeFor := [:evaluationRequest |
    let evaluationId := [evaluationRequest at: "id" ifAbsent: [| nil]];
    let blocked := [false asCell];
    [|
      [[blocked value]
        ifTrue: [| false]
        ifFalse: [|
          let buffer := [conn buffer];
          let received := [[conn fd] recvInto: buffer len: 65535 flags: 128];
          let chunk := [[received < 0]
            ifTrue: [| nil]
            ifFalse: [|
              [[received = 0]
                ifTrue: [| ""]
                ifFalse: [|
                  [buffer pokeByte: 0 at: received];
                  [buffer peekStringAt: 0]]]]];
          [[chunk notNil]
            ifTrue: [| [pending set: [[pending value] , chunk]]]
            ifFalse: [| nil]];
          let frame := [me sessionFrameStep: [pending value]];
          [[[frame at: "status"] = "ready"]
            ifTrue: [|
              let message := [Json parse: [frame at: "body"]];
              let valid := [[message isError]
                ifTrue: [| false]
                ifFalse: [| [me sessionRequestIsValid: message]]];
              let method := [valid
                ifTrue: [| [message at: "method"]]
                ifFalse: [| ""]];
              [[method = "birnam/interrupt"]
                ifTrue: [|
                  let params := [message at: "params"];
                  let target := [params at: "requestId" ifAbsent: [| evaluationId]];
                  let matches := [target = evaluationId];
                  [pending set: [frame at: "rest"]];
                  let result := { "interrupted" -> matches,
                    "requestId" -> evaluationId, "cooperative" -> true,
                    "reason" -> [matches
                      ifTrue: [| "interrupt accepted at a safe boundary"]
                      ifFalse: [| "request is not active"]] };
                  let response := [me sessionSuccess:
                    [message at: "id" ifAbsent: [| nil]] result: result];
                  [write value: [Json stringify: response]];
                  matches]
                ifFalse: [| [blocked set: true]; false]]]
            ifFalse: [|
              [[[frame at: "status"] = "invalid"]
                ifTrue: [| [blocked set: true]]
                ifFalse: [| nil]];
              false]]]]]];
  let session := [configured at: "interruptProbeFor" put: interruptProbeFor];
  [self serveSessionJson: session read: read write: write]
  ] doc:
  "Serve one connected socket with framed output and cooperative interrupt probing." ];

[Reflect defineMethod: #sessionTcpBindAllowed:allowRemote: on: Digla as: [:self :bind :allowRemote |
  let loopback := [[bind = "127.0.0.1"] | [bind = "localhost"]];
  [loopback | allowRemote]
  ] doc:
  "Authorize loopback binds by default and non-loopback binds only by explicit opt-in." ];

[Reflect defineMethod: #sessionSocketError:bind:port: on: Digla as: [:self :kind :bind :port |
  [Error kind: kind message: ["could not serve Digla session on " , bind , ":" , [port printString]]]
  ] doc:
  "Build a structured socket-session failure for the configured endpoint." ];

[Reflect defineMethod: #serveOneSessionTcpWith:allowRemote: on: Digla as: [:self :config :allowRemote |
  let bind := [config at: "bind"];
  let port := [config at: "port"];
  [[self sessionTcpBindAllowed: bind allowRemote: allowRemote]
    ifTrue: [|
      let fd := [Socket listenOn: port bind: bind];
      [[fd < 0]
        ifTrue: [| [self sessionSocketError: #socketBindFailed bind: bind port: port]]
        ifFalse: [|
          let cfd := [Socket rawAccept: fd];
          [[cfd < 0]
            ifTrue: [|
              [fd closeFd];
              [self sessionSocketError: #socketAcceptFailed bind: bind port: port]]
            ifFalse: [|
              let conn := [Socket wrapFd: cfd];
              let final := [self serveSessionConnection: conn config: config];
              [conn close];
              [fd closeFd];
              final]]]]]
    ifFalse: [| [Error kind: #unsafeSocketBind message:
      ["refusing non-loopback Digla bind without --allow-remote: " , bind]]]]
  ] doc:
  "Serve one framed TCP session and close the listener, for scripts and smoke tests." ];

[Reflect defineMethod: #serveSessionTcpWith:allowRemote: on: Digla as: [:self :config :allowRemote |
  let bind := [config at: "bind"];
  let port := [config at: "port"];
  [[self sessionTcpBindAllowed: bind allowRemote: allowRemote]
    ifTrue: [|
      let me := self;
      let status := [Socket serve: port bind: bind with: [:conn |
        [me serveSessionConnection: conn config: config]]];
      [[status < 0]
        ifTrue: [| [self sessionSocketError: #socketBindFailed bind: bind port: port]]
        ifFalse: [| self]]]
    ifFalse: [| [Error kind: #unsafeSocketBind message:
      ["refusing non-loopback Digla bind without --allow-remote: " , bind]]]]
  ] doc:
  "Serve framed TCP sessions serially, enforcing loopback unless explicitly overridden." ];
