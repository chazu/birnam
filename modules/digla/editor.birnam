// editor.birnam — the value-only editor model used by Digla.
//
// Cursor positions are UTF-8 byte boundaries. The model never stores terminal
// x/y coordinates; render.birnam projects the current source position into the
// terminal after it has chosen a viewport. This first slice handles codepoint
// boundaries and line movement, while full UTF-16 and cell maps remain the
// shared PositionMap slice described in design 58.

[Reflect defineMethod: #editorStateFor: on: Digla as: [:self :config |
  let s0 := [self sessionStateFor: config];
  let s1 := [s0 at: "running" put: true];
  let s2 := [s1 at: "status" put: "ready"];
  let s3 := [s2 at: "historyIndex" put: nil];
  let s4 := [s3 at: "lastResult" put: nil];
  let s5 := [s4 at: "hasLastResult" put: false];
  let s6 := [s5 at: "lastError" put: nil];
  let s7 := [s6 at: "completion" put: nil];
  let s8 := [s7 at: "selection" put: nil];
  [s8 at: "viewport" put: { "editorTopLine" -> 0 }]] doc:
  "Create the serializable editor state for a local or remote Digla session."];

[Reflect defineMethod: #selectionRangeIn: on: Digla as: [:self :state |
  let selection := [state at: "selection"];
  [[selection isNil]
    ifTrue: [| nil]
    ifFalse: [|
      let anchor := [selection at: "anchor"];
      let cursor := [state at: "cursor"];
      [[anchor = cursor]
        ifTrue: [| nil]
        ifFalse: [|
          [[anchor < cursor]
            ifTrue: [| { "start" -> anchor, "end" -> cursor }]
            ifFalse: [| { "start" -> cursor, "end" -> anchor }]]]]]]
  ] doc:
  "Return the normalized half-open source range selected by anchor and cursor." ];

[Reflect defineMethod: #clearSelectionIn: on: Digla as: [:self :state |
  [state at: "selection" put: nil]
  ] doc:
  "Clear the source selection without moving the cursor." ];

[Reflect defineMethod: #selectionAfterMoveFrom:extend:previous:in: on: Digla as:
  [:self :oldCursor :extend :previous :state |
    [extend
      ifTrue: [|
        let anchor := [[previous isNil]
          ifTrue: [| oldCursor]
          ifFalse: [| [previous at: "anchor"]]];
        [[[state at: "cursor"] = anchor]
          ifTrue: [| [state at: "selection" put: nil]]
          ifFalse: [| [state at: "selection" put: { "anchor" -> anchor }]]]]
      ifFalse: [| [self clearSelectionIn: state]]]
  ] doc:
  "Preserve or create an anchor for Shift movement, otherwise clear selection." ];

[Reflect defineMethod: #replaceSelectionWith:in: on: Digla as: [:self :text :state |
  let range := [self selectionRangeIn: state];
  [[range isNil]
    ifTrue: [| nil]
    ifFalse: [|
      let buffer := [state at: "buffer"];
      let start := [range at: "start"];
      let finish := [range at: "end"];
      let prefix := [buffer copyFrom: 0 to: start];
      let suffix := [buffer copyFrom: finish to: [buffer size]];
      let s1 := [state at: "buffer" put: [[prefix , text] , suffix]];
      let s2 := [s1 at: "cursor" put: [start + [text size]]];
      let s3 := [s2 at: "selection" put: nil];
      let s4 := [s3 at: "historyIndex" put: nil];
      [s4 at: "status" put: "editing"]]]
  ] doc:
  "Replace the selected half-open source range, or answer nil when none is selected." ];

[Reflect defineMethod: #previousBoundaryStep:in: on: Digla as: [:self :p :text |
  [[[p <= 0] | [[self isContinuationByte: [text byteAt: p]] not]]
    ifTrue: [| p]
    ifFalse: [| [self previousBoundaryStep: [p - 1] in: text]]]] doc:
  "Recursive worker for moving a cursor left to a UTF-8 codepoint boundary."];

[Reflect defineMethod: #previousBoundaryIn:at: on: Digla as: [:self :text :cursor |
  [[cursor = 0]
    ifTrue: [| 0]
    ifFalse: [| [self previousBoundaryStep: [cursor - 1] in: text]]]] doc:
  "Move a source cursor one UTF-8 codepoint to the left."];

[Reflect defineMethod: #nextBoundaryIn:at: on: Digla as: [:self :text :cursor |
  [[cursor >= [text size]]
    ifTrue: [| [text size]]
    ifFalse: [|
      let width := [self utf8WidthAt: cursor in: text];
      let next := [cursor + width];
      [[next > [text size]] ifTrue: [| [text size]] ifFalse: [| next]]]]] doc:
  "Move a source cursor one UTF-8 codepoint to the right."];

[Reflect defineMethod: #lineStartStep:in: on: Digla as: [:self :p :text |
  [[[p <= 0] | [[text byteAt: [p - 1]] = 10]]
    ifTrue: [| p]
    ifFalse: [| [self lineStartStep: [p - 1] in: text]]]] doc:
  "Recursive worker for finding the beginning of a logical line."];

[Reflect defineMethod: #lineStartIn:at: on: Digla as: [:self :text :cursor |
  [self lineStartStep: cursor in: text]] doc:
  "Return the byte offset of the logical line containing `cursor`."];

[Reflect defineMethod: #lineEndStep:in: on: Digla as: [:self :p :text |
  [[[p >= [text size]] | [[text byteAt: p] = 10]]
    ifTrue: [| p]
    ifFalse: [| [self lineEndStep: [p + 1] in: text]]]] doc:
  "Recursive worker for finding the end of a logical line."];

[Reflect defineMethod: #lineEndIn:at: on: Digla as: [:self :text :cursor |
  [self lineEndStep: cursor in: text]] doc:
  "Return the byte offset just before the newline or end of the line."];

[Reflect defineMethod: #lineIndexIn:at: on: Digla as: [:self :text :cursor |
  let n := [0 asCell];
  [0 to: [cursor - 1] do: [:i |
    [[[text byteAt: i] = 10] ifTrue: [| [n set: [[n value] + 1]]] ifFalse: [| nil]]]];
  [n value]] doc:
  "Return the zero-based logical line index for a byte cursor."];

[Reflect defineMethod: #lineColumnIn:at: on: Digla as: [:self :text :cursor |
  [cursor - [self lineStartIn: text at: cursor]]] doc:
  "Return the byte column within the logical line for a source cursor."];

[Reflect defineMethod: #insertText:into: on: Digla as: [:self :text :state |
  let replaced := [self replaceSelectionWith: text in: state];
  [[replaced notNil]
    ifTrue: [| replaced]
    ifFalse: [|
      let buffer := [state at: "buffer"];
      let cursor := [state at: "cursor"];
      let prefix := [buffer copyFrom: 0 to: cursor];
      let suffix := [buffer copyFrom: cursor to: [buffer size]];
      let nextBuffer := [[prefix , text] , suffix];
      let nextCursor := [cursor + [text size]];
      let s1 := [state at: "buffer" put: nextBuffer];
      let s2 := [s1 at: "cursor" put: nextCursor];
      let s3 := [s2 at: "historyIndex" put: nil];
      [s3 at: "status" put: "editing"]]]] doc:
  "Insert UTF-8 text at the source cursor and answer the next editor state."];

[Reflect defineMethod: #backspaceIn: on: Digla as: [:self :state |
  let replaced := [self replaceSelectionWith: "" in: state];
  [[replaced notNil]
    ifTrue: [| replaced]
    ifFalse: [|
      let buffer := [state at: "buffer"];
      let cursor := [state at: "cursor"];
      [[cursor = 0]
        ifTrue: [| state]
        ifFalse: [|
          let previous := [self previousBoundaryIn: buffer at: cursor];
          let prefix := [buffer copyFrom: 0 to: previous];
          let suffix := [buffer copyFrom: cursor to: [buffer size]];
          let s1 := [state at: "buffer" put: [prefix , suffix]];
          let s2 := [s1 at: "cursor" put: previous];
          let s3 := [s2 at: "historyIndex" put: nil];
          [s3 at: "status" put: "editing"]]]]]] doc:
  "Delete the codepoint immediately before the source cursor."];

[Reflect defineMethod: #deleteForwardIn: on: Digla as: [:self :state |
  let replaced := [self replaceSelectionWith: "" in: state];
  [[replaced notNil]
    ifTrue: [| replaced]
    ifFalse: [|
      let buffer := [state at: "buffer"];
      let cursor := [state at: "cursor"];
      [[cursor >= [buffer size]]
        ifTrue: [| state]
        ifFalse: [|
          let next := [self nextBoundaryIn: buffer at: cursor];
          let prefix := [buffer copyFrom: 0 to: cursor];
          let suffix := [buffer copyFrom: next to: [buffer size]];
          let s1 := [state at: "buffer" put: [prefix , suffix]];
          let s2 := [s1 at: "historyIndex" put: nil];
          [s2 at: "status" put: "editing"]]]]]] doc:
  "Delete the codepoint immediately after the source cursor."];

[Reflect defineMethod: #moveLeftIn: on: Digla as: [:self :state |
  let buffer := [state at: "buffer"];
  let cursor := [self previousBoundaryIn: buffer at: [state at: "cursor"]];
  [state at: "cursor" put: cursor]] doc:
  "Move the source cursor left by one UTF-8 codepoint."];

[Reflect defineMethod: #moveRightIn: on: Digla as: [:self :state |
  let buffer := [state at: "buffer"];
  let cursor := [self nextBoundaryIn: buffer at: [state at: "cursor"]];
  [state at: "cursor" put: cursor]] doc:
  "Move the source cursor right by one UTF-8 codepoint."];

[Reflect defineMethod: #moveHomeIn: on: Digla as: [:self :state |
  let buffer := [state at: "buffer"];
  [state at: "cursor" put: [self lineStartIn: buffer at: [state at: "cursor"]]]] doc:
  "Move the source cursor to the beginning of its logical line."];

[Reflect defineMethod: #moveEndIn: on: Digla as: [:self :state |
  let buffer := [state at: "buffer"];
  [state at: "cursor" put: [self lineEndIn: buffer at: [state at: "cursor"]]]] doc:
  "Move the source cursor to the end of its logical line."];

[Reflect defineMethod: #moveUpIn: on: Digla as: [:self :state |
  let buffer := [state at: "buffer"];
  let cursor := [state at: "cursor"];
  let start := [self lineStartIn: buffer at: cursor];
  [[start = 0]
    ifTrue: [| state]
    ifFalse: [|
      let previousEnd := [start - 1];
      let previousStart := [self lineStartIn: buffer at: previousEnd];
      let previousLength := [previousEnd - previousStart];
      let column := [cursor - start];
      let targetColumn := [[column < previousLength] ifTrue: [| column] ifFalse: [| previousLength]];
      [state at: "cursor" put: [previousStart + targetColumn]]]]] doc:
  "Move up one logical line, clamping the byte column at the previous line's end."];

[Reflect defineMethod: #moveDownIn: on: Digla as: [:self :state |
  let buffer := [state at: "buffer"];
  let cursor := [state at: "cursor"];
  let end := [self lineEndIn: buffer at: cursor];
  [[end >= [buffer size]]
    ifTrue: [| state]
    ifFalse: [|
      let nextStart := [end + 1];
      let nextEnd := [self lineEndIn: buffer at: nextStart];
      let nextLength := [nextEnd - nextStart];
      let column := [cursor - [self lineStartIn: buffer at: cursor]];
      let targetColumn := [[column < nextLength] ifTrue: [| column] ifFalse: [| nextLength]];
      [state at: "cursor" put: [nextStart + targetColumn]]]]] doc:
  "Move down one logical line, clamping the byte column at the next line's end."];

[Reflect defineMethod: #recordSubmission:shown:status:in: on: Digla as: [:self :input :shown :status :state |
  let transcript0 := [state at: "transcript"];
  let transcript1 := [transcript0 add: ["> " , input]];
  let transcript2 := [transcript1 add: shown];
  let history := [[state at: "history"] add: input];
  let s1 := [state at: "buffer" put: ""];
  let s2 := [s1 at: "cursor" put: 0];
  let s3 := [s2 at: "history" put: history];
  let s4 := [s3 at: "historyIndex" put: nil];
  let s5 := [s4 at: "transcript" put: transcript2];
  let s6 := [s5 at: "selection" put: nil];
  [s6 at: "status" put: status]
  ] doc:
  "Record one evaluated form or editor command in history and the transcript." ];

[Reflect defineMethod: #commandHelpText on: Digla as: [:self |
  "Digla commands:\n  :inspect NAME  inspect a named global\n  :inspect       inspect the last successful result\n  :globals       list visible live-image globals\n  :session       show image identity and capabilities\n  :help          show this help"
  ] doc:
  "Return the terminal-native command summary." ];

[Reflect defineMethod: #sessionReplyErrorText: on: Digla as: [:self :reply |
  let message := [reply at: "message"];
  let error := [message at: "error" ifAbsent: [| nil]];
  [[error isNil] ifTrue: [| nil] ifFalse: [| [error at: "message"]]]
  ] doc:
  "Return a session protocol error message, or nil for a successful response." ];

[Reflect defineMethod: #renderGlobalsResult: on: Digla as: [:self :result |
  let names := [result at: "globals"];
  [[names isEmpty]
    ifTrue: [| "(no visible globals)"]
    ifFalse: [|
      let sb := [StringBuilder new];
      [names do: [:name | [sb addLine: ["#" , name]]]];
      [sb asString]]]
  ] doc:
  "Render the copied-value global-name result for a terminal transcript." ];

[Reflect defineMethod: #renderSessionResult: on: Digla as: [:self :result |
  let image := [result at: "image"];
  let capabilities := [result at: "capabilities"];
  let sb := [StringBuilder new];
  [sb addLine: ["session:    " , [result at: "sessionId"]]];
  [sb addLine: ["adapter:    " , [result at: "adapter"]]];
  [sb addLine: ["image:      " , [image at: "kind"]]];
  [sb addLine: ["basis:      " , [[image at: "basis"] printString]]];
  let digest := [image at: "generationDigest"];
  let shownDigest := [[digest isNil] ifTrue: [| "(unavailable)"] ifFalse: [| digest]];
  [sb addLine: ["generation: " , shownDigest]];
  [sb addLine: "capabilities:"];
  [[[capabilities keys] sortBy: [:name | name]] do: [:name |
    [sb addLine: [["  " , name] , "=" , [[capabilities at: name] printString]]]]];
  [sb asString]
  ] doc:
  "Render a session handshake without reaching into the adapter or live image." ];

[Reflect defineMethod: #inspectCommand:state: on: Digla as: [:self :words :state |
  [[[words size] > 2]
    ifTrue: [| { "text" -> "usage: :inspect [GLOBAL]", "status" -> "command error",
                  "session" -> [state at: "session"] }]
    ifFalse: [|
      let named := [[words size] = 2];
      let params := [named
        ifTrue: [| { "globalName" -> [words at: 1] }]
        ifFalse: [| [Map new]]];
      let reply := [self callSession: "birnam/inspect" params: params in: [state at: "session"]];
      let error := [self sessionReplyErrorText: reply];
      [[error notNil]
        ifTrue: [| { "text" -> error, "status" -> "command error",
                      "session" -> [reply at: "session"] }]
        ifFalse: [|
          let snapshot := [[self sessionResultOf: reply] at: "snapshot"];
          let status := [named ifTrue: [| "inspected global"] ifFalse: [| "inspected result"]];
          { "text" -> [self renderInspectionText: snapshot], "status" -> status,
            "session" -> [reply at: "session"] }]]]]
  ] doc:
  "Execute the read-only inspect editor command and return its display result." ];

[Reflect defineMethod: #sessionCommand:state: on: Digla as: [:self :method :state |
  let reply := [self callSession: method params: [Map new] in: [state at: "session"]];
  let error := [self sessionReplyErrorText: reply];
  [[error notNil]
    ifTrue: [| { "text" -> error, "status" -> "command error",
                  "session" -> [reply at: "session"] }]
    ifFalse: [|
      let result := [self sessionResultOf: reply];
      let globals := [method = "birnam/globals"];
      let text := [globals
        ifTrue: [| [self renderGlobalsResult: result]]
        ifFalse: [| [self renderSessionResult: result]]];
      { "text" -> text, "status" -> [globals ifTrue: [| "globals"] ifFalse: [| "session"]],
        "session" -> [reply at: "session"] }]]
  ] doc:
  "Execute a copied-value globals or session-information editor command." ];

[Reflect defineMethod: #commandResultFor:state: on: Digla as: [:self :input :state |
  let words := [input words];
  let command := [words at: 0 ifAbsent: [| ""]];
  [[command = ":help"]
    ifTrue: [| { "text" -> [self commandHelpText], "status" -> "help",
                  "session" -> [state at: "session"] }]
    ifFalse: [|
      [[command = ":inspect"]
        ifTrue: [| [self inspectCommand: words state: state]]
        ifFalse: [|
          [[command = ":globals"]
            ifTrue: [| [self sessionCommand: "birnam/globals" state: state]]
            ifFalse: [|
              [[command = ":session"]
                ifTrue: [| [self sessionCommand: "birnam/session/open" state: state]]
                ifFalse: [| { "text" -> ["unknown Digla command: " , command],
                              "status" -> "command error", "session" -> [state at: "session"] }]]]]]]]]
  ] doc:
  "Dispatch one terminal-native Digla command without evaluating source." ];

[Reflect defineMethod: #submitCommandIn: on: Digla as: [:self :state |
  let input := [state at: "buffer"];
  let result := [self commandResultFor: input state: state];
  let next := [state at: "session" put: [result at: "session"]];
  [self recordSubmission: input shown: [result at: "text"]
    status: [result at: "status"] in: next]
  ] doc:
  "Run one Digla editor command and append its result to the transcript." ];

[Reflect defineMethod: #submitIn: on: Digla as: [:self :state |
  let input := [state at: "buffer"];
  [[input isEmpty]
    ifTrue: [| [state at: "status" put: "empty form"]]
    ifFalse: [|
      [[input startsWith: ":"]
        ifTrue: [| [self submitCommandIn: state]]
        ifFalse: [|
          let reply := [self callSession: "birnam/evaluate" params: { "source" -> input }
            in: [state at: "session"]];
          let protocolError := [self sessionReplyErrorText: reply];
          let result := [[protocolError notNil]
            ifTrue: [| { "ok" -> false, "display" -> protocolError, "message" -> protocolError }]
            ifFalse: [| [self sessionResultOf: reply]]];
          let ok := [result at: "ok"];
          let status := [ok ifTrue: [| "ready"] ifFalse: [| "error"]];
          let next0 := [state at: "session" put: [reply at: "session"]];
          let recorded := [self recordSubmission: input shown: [result at: "display"]
            status: status in: next0];
          let error := [ok ifTrue: [| nil] ifFalse: [| [result at: "message"]]];
          let withError := [recorded at: "lastError" put: error];
          [ok
            ifTrue: [|
              let copied := [result at: "value"];
              let s1 := [withError at: "lastResult" put: [copied at: "value"]];
              [s1 at: "hasLastResult" put: true]]
            ifFalse: [| withError]]]]]]] doc:
  "Evaluate through the selected runtime session and append its structured result to the transcript."];

[Reflect defineMethod: #historyMove:in: on: Digla as: [:self :direction :state |
  let history := [state at: "history"];
  let count := [history size];
  [[count = 0]
    ifTrue: [| state]
    ifFalse: [|
      let old := [state at: "historyIndex"];
      let index := [[old isNil]
        ifTrue: [| [[direction < 0] ifTrue: [| [count - 1]] ifFalse: [| 0]]]
        ifFalse: [| [old + direction]]];
      [[index < 0]
        ifTrue: [| state]
        ifFalse: [|
          [[index >= count]
            ifTrue: [|
              let s1 := [state at: "historyIndex" put: nil];
              let s2 := [s1 at: "buffer" put: ""];
              let s3 := [s2 at: "cursor" put: 0];
              let s4 := [s3 at: "selection" put: nil];
              [s4 at: "status" put: "editing"]]
            ifFalse: [|
              let text := [history at: index];
              let s1 := [state at: "historyIndex" put: index];
              let s2 := [s1 at: "buffer" put: text];
              let s3 := [s2 at: "cursor" put: [text size]];
              let s4 := [s3 at: "selection" put: nil];
              [s4 at: "status" put: "history"]]]]]]]] doc:
  "Recall a prior form with direction -1 for older or +1 for newer history."];

[Reflect defineMethod: #clearCompletionIn: on: Digla as: [:self :state |
  [state at: "completion" put: nil]
  ] doc:
  "Dismiss the transient completion menu without changing the source buffer." ];

[Reflect defineMethod: #openCompletionIn: on: Digla as: [:self :state |
  let completion := [self completionFor: [state at: "buffer"]
    cursor: [state at: "cursor"] session: [state at: "session"]];
  let withSession := [state at: "session" put: [completion at: "session"]];
  let error := [completion at: "error"];
  let items := [completion at: "items"];
  [[items isEmpty]
    ifTrue: [|
      let withoutMenu := [withSession at: "completion" put: nil];
      let status := [[error isNil] ifTrue: [| "no completions"]
        ifFalse: [| ["completion error: " , error]]];
      [withoutMenu at: "status" put: status]]
    ifFalse: [|
      let menu := [completion at: "index" put: 0];
      let withMenu := [withSession at: "completion" put: menu];
      let suffix := [[error isNil] ifTrue: [| ""] ifFalse: [| " (source only)"]];
      [withMenu at: "status" put: ["completion 1/" , [[items size] printString] , suffix]]]]
  ] doc:
  "Request source and live-image candidates and open a terminal-independent menu." ];

[Reflect defineMethod: #moveCompletion:in: on: Digla as: [:self :direction :state |
  let menu := [state at: "completion"];
  [[menu isNil]
    ifTrue: [| state]
    ifFalse: [|
      let items := [menu at: "items"];
      let count := [items size];
      [[count = 0]
        ifTrue: [| [self clearCompletionIn: state]]
        ifFalse: [|
          let candidate := [[menu at: "index"] + direction];
          let wrappedLow := [[candidate < 0] ifTrue: [| [count - 1]] ifFalse: [| candidate]];
          let index := [[wrappedLow >= count] ifTrue: [| 0] ifFalse: [| wrappedLow]];
          let nextMenu := [menu at: "index" put: index];
          let next := [state at: "completion" put: nextMenu];
          [next at: "status" put: ["completion " , [[index + 1] printString]
            , "/" , [count printString]]]]]]]
  ] doc:
  "Move the active completion selection cyclically by `direction`." ];

[Reflect defineMethod: #acceptCompletionIn: on: Digla as: [:self :state |
  let menu := [state at: "completion"];
  [[menu isNil]
    ifTrue: [| state]
    ifFalse: [|
      let items := [menu at: "items"];
      [[items isEmpty]
        ifTrue: [| [self clearCompletionIn: state]]
        ifFalse: [|
          let item := [items at: [menu at: "index"]];
          let label := [item at: "label"];
          let buffer := [state at: "buffer"];
          let prefix := [buffer copyFrom: 0 to: [menu at: "start"]];
          let suffix := [buffer copyFrom: [menu at: "end"] to: [buffer size]];
          let nextBuffer := [[prefix , label] , suffix];
          let s1 := [state at: "buffer" put: nextBuffer];
          let s2 := [s1 at: "cursor" put: [[menu at: "start"] + [label size]]];
          let s3 := [s2 at: "historyIndex" put: nil];
          let s4 := [s3 at: "completion" put: nil];
          let s5 := [s4 at: "selection" put: nil];
          [s5 at: "status" put: ["completed " , label]]]]]]
  ] doc:
  "Replace the requested source prefix with the selected copied-value candidate." ];

[Reflect defineMethod: #ensureEditorViewportRows:in: on: Digla as: [:self :requestedRows :state |
  let visibleRows := [[requestedRows < 1] ifTrue: [| 1] ifFalse: [| requestedRows]];
  let buffer := [state at: "buffer"];
  let lineCount := [[buffer split: "\n"] size];
  let cursorLine := [self lineIndexIn: buffer at: [state at: "cursor"]];
  let viewport := [state at: "viewport"];
  let currentTop := [viewport at: "editorTopLine"];
  let maxTop0 := [lineCount - visibleRows];
  let maxTop := [[maxTop0 < 0] ifTrue: [| 0] ifFalse: [| maxTop0]];
  let clampedTop0 := [[currentTop < 0] ifTrue: [| 0] ifFalse: [| currentTop]];
  let clampedTop := [[clampedTop0 > maxTop] ifTrue: [| maxTop] ifFalse: [| clampedTop0]];
  let top := [clampedTop asCell];
  [[cursorLine < [top value]] ifTrue: [| [top set: cursorLine]] ifFalse: [| nil]];
  let below := [cursorLine >= [[top value] + visibleRows]];
  [below ifTrue: [| [top set: [[cursorLine - visibleRows] + 1]]] ifFalse: [| nil]];
  let nextViewport := [viewport at: "editorTopLine" put: [top value]];
  [state at: "viewport" put: nextViewport]
  ] doc:
  "Keep the source cursor within a bounded logical-line viewport." ];

[Reflect defineMethod: #applyMovementKey:extend:in: on: Digla as: [:self :key :extend :state |
  let moving := [[[[[[key = 65515] | [key = 65514]] | [key = 65517]]
    | [key = 65516]] | [key = 65521]] | [key = 65520]];
  [moving
    ifTrue: [|
      let oldCursor := [state at: "cursor"];
      let previous := [state at: "selection"];
      let s1 := [[key = 65515] ifTrue: [| [self moveLeftIn: state]] ifFalse: [| state]];
      let s2 := [[key = 65514] ifTrue: [| [self moveRightIn: s1]] ifFalse: [| s1]];
      let s3 := [[key = 65517] ifTrue: [| [self moveUpIn: s2]] ifFalse: [| s2]];
      let s4 := [[key = 65516] ifTrue: [| [self moveDownIn: s3]] ifFalse: [| s3]];
      let s5 := [[key = 65521] ifTrue: [| [self moveHomeIn: s4]] ifFalse: [| s4]];
      let s6 := [[key = 65520] ifTrue: [| [self moveEndIn: s5]] ifFalse: [| s5]];
      [self selectionAfterMoveFrom: oldCursor extend: extend previous: previous in: s6]]
    ifFalse: [| state]]
  ] doc:
  "Apply one cursor movement and maintain a source-byte selection anchor." ];

[Reflect defineMethod: #handleEditorKey:modifier:character:state: on: Digla as:
  [:self :key :modifier :character :state |
  let shift := [modifier >= 4];
  let s0 := [self applyMovementKey: key extend: shift in: state];
  let s1 := [[key = 27] ifTrue: [| [s0 at: "running" put: false]] ifFalse: [| s0]];
  let backspace := [[key = 8] | [key = 127]];
  let s2 := [backspace ifTrue: [| [self backspaceIn: s1]] ifFalse: [| s1]];
  let s3 := [[key = 65522] ifTrue: [| [self deleteForwardIn: s2]] ifFalse: [| s2]];
  let s4 := [[key = 16] ifTrue: [| [self historyMove: -1 in: s3]] ifFalse: [| s3]];
  let s5 := [[key = 14] ifTrue: [| [self historyMove: 1 in: s4]] ifFalse: [| s4]];
  let s6 := [[key = 13] ifTrue: [| [self submitIn: s5]] ifFalse: [| s5]];
  let s7 := [[key = 10] ifTrue: [| [self insertText: "\n" into: s6]] ifFalse: [| s6]];
  [[character isEmpty] ifTrue: [| s7] ifFalse: [| [self insertText: character into: s7]]]] doc:
  "Apply one ordinary editing key after completion-menu dispatch." ];

[Reflect defineMethod: #handleEditorKey:character:state: on: Digla as: [:self :key :character :state |
  [self handleEditorKey: key modifier: 0 character: character state: state]
  ] doc:
  "Apply an unmodified editing key for headless clients and compatibility." ];

[Reflect defineMethod: #handleCompletionKey:modifier:character:state: on: Digla as:
  [:self :key :modifier :character :state |
  let forward := [[[key = 9] | [key = 14]] | [key = 65516]];
  let backward := [[[key = 16] | [key = 65517]] | [key = 65513]];
  let outcome := [nil asCell];
  [[key = 27]
    ifTrue: [|
      let next := [self clearCompletionIn: state];
      [outcome set: [next at: "status" put: "completion closed"]]]
    ifFalse: [| nil]];
  [[[[outcome value] isNil] & forward]
    ifTrue: [| [outcome set: [self moveCompletion: 1 in: state]]]
    ifFalse: [| nil]];
  [[[[outcome value] isNil] & backward]
    ifTrue: [| [outcome set: [self moveCompletion: -1 in: state]]]
    ifFalse: [| nil]];
  [[[[outcome value] isNil] & [key = 13]]
    ifTrue: [| [outcome set: [self acceptCompletionIn: state]]]
    ifFalse: [| nil]];
  [[[outcome value] isNil]
    ifTrue: [|
      [outcome set: [self handleEditorKey: key modifier: modifier character: character
        state: [self clearCompletionIn: state]]]]
    ifFalse: [| nil]];
  [outcome value]
  ] doc:
  "Dispatch a key while completion is open, with Escape reserved for dismissal." ];

[Reflect defineMethod: #handleCompletionKey:character:state: on: Digla as: [:self :key :character :state |
  [self handleCompletionKey: key modifier: 0 character: character state: state]
  ] doc:
  "Dispatch an unmodified completion key for headless clients and compatibility." ];

[Reflect defineMethod: #handleKey:modifier:character:state: on: Digla as:
  [:self :key :modifier :character :state |
  let menu := [state at: "completion"];
  [[menu notNil]
    ifTrue: [| [self handleCompletionKey: key modifier: modifier character: character state: state]]
    ifFalse: [|
      [[key = 9]
        ifTrue: [| [self openCompletionIn: state]]
        ifFalse: [| [self handleEditorKey: key modifier: modifier character: character state: state]]]]]
  ] doc:
  "Apply one Termbox key and character event to the pure editor state." ];

[Reflect defineMethod: #handleKey:character:state: on: Digla as: [:self :key :character :state |
  [self handleKey: key modifier: 0 character: character state: state]
  ] doc:
  "Apply an unmodified key event for headless clients and compatibility." ];

[Reflect defineMethod: #runWhileRunning:step: on: Digla as: [:self :state :step |
  let next := [step value: state];
  [[next at: "running"]
    ifTrue: [| [self runWhileRunning: next step: step]]
    ifFalse: [| next]]] doc:
  "Apply a state transition repeatedly until the editor state is no longer running."];
