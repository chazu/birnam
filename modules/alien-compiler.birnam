[Reflect defineMethod: #floatMembers:aggregates: on: AlienCompiler as: [:self :field :aggregates |
[[[field at: 0] == #aggregate] ifTrue: [| [self hfa: [field at: 1] aggregates: aggregates]] ifFalse: [| let scalar := [[[field at: 0] == #array] ifTrue: [| [field at: 2]] ifFalse: [| [field at: 1]]];
let count := [[[field at: 0] == #array] ifTrue: [|
 let text := [field at: 1];
 [[self decimalGreater: text than: "4"] ifTrue: [| 5] ifFalse: [| [[text byteAt: 0] - 48]]]] ifFalse: [| 1]];
[[[[scalar = "f"] | [scalar = "d"]] & [count <= 4]] ifTrue: [| #[scalar count]] ifFalse: [| nil]]]]
]];

[Reflect defineMethod: #hfa:aggregates: on: AlienCompiler as: [:self :index :aggregates |
let state := {#kind -> [self cell: nil] #count -> [self cell: 0] #valid -> [self cell: true]};
[self indexes: [aggregates at: index] do: [:field :i |
 let members := [self floatMembers: field aggregates: aggregates];
[[members isNil] ifTrue: [| [self state: state at: #valid put: false]] ifFalse: [| let old := [self state: state at: #kind]; let kind := [members at: 0];
[[old notNil] ifTrue: [| [[[old = kind] not] ifTrue: [| [self state: state at: #valid put: false]]]]];
[self state: state at: #kind put: kind];
[self state: state at: #count put: [[self state: state at: #count] + [members at: 1]]]
]]
]];
let count := [self state: state at: #count];
[[[[self state: state at: #valid] & [count >= 1]] & [count <= 4]] ifTrue: [| #[[self state: state at: #kind] count]] ifFalse: [| nil]]
]];

[Reflect defineMethod: #classifyType:aggregates: on: AlienCompiler as: [:self :type :aggregates |
[[[type at: 0] == #scalar] ifTrue: [| let classes := {"i" -> #signedInteger32, "l" -> #signedInteger64, "u" -> #unsignedInteger64, "d" -> #float64, "f" -> #float32, "s" -> #stringPointer, "p" -> #pointer, "v" -> #void}; #[#scalar [classes at: [type at: 1]]]] ifFalse: [| #[#aggregate [type at: 1] [self hfa: [type at: 1] aggregates: aggregates]]]]
]];

[Reflect defineMethod: #classify: on: AlienCompiler as: [:self :signature |
let classes := {#arguments -> [self cell: #[]]};
[self indexes: [signature at: 1] do: [:arg :i |
 [self state: classes at: #arguments put: [[self state: classes at: #arguments] add: [self classifyType: arg aggregates: [signature at: 2]]]]]];
#[[self classifyType: [signature at: 0] aggregates: [signature at: 2]] [self state: classes at: #arguments]]
]];
