// json.birnam — a JSON parser + serializer written entirely in birnam, over the
// PEG engine. The data layer under an LSP server. No new Zig, no C JSON lib: a C
// lib would hand back a recursive `cJSON*` tree that you'd have to walk through
// Alien peek/poke to get native values anyway — more code and more fragile than
// parsing in birnam, which yields native Map/Vector/String/number/bool/nil directly.
//
// Load it into a running image (needs the PEG engine + self-hosted stdlib), then:
//   [System load: "modules/json.birnam"];
//   let v := [Json parse: "{\"port\": 8080, \"tags\": [\"a\", true, null]}"];
//   [v at: "port"]                        "=> 8080"
//   [[v at: "tags"] at: 0]                "=> a"
//   [Json stringify: v]                   "=> the JSON text again"
//
// parse: answers a Map (objects), Vector (arrays), String, Integer/Float, true/
// false, or nil — or a #jsonParse error if the text isn't valid JSON. Object keys
// are Strings; Maps key by value, so `[obj at: "method"]` works.
//
// STRINGIFY is double dispatch: `[Json stringify: v]` just sends `[v asJson]`, and
// each type's prototype renders itself (see the asJson methods). Adding a new
// representable type is one method — no central type switch.
//
// v1 LIMITS: `\uXXXX` escapes are not decoded (kept literal — rare in editor JSON,
// which is ASCII with simple escapes); `\b`/`\f` decode to themselves. Fine for
// LSP; extend jsonEscChar later.

// -- the grammar: built once, cached in Globals -------------------------------
// Only the rules (`[g rule: …]`) make CST nodes; the block-local lets are inline
// patterns. `value` is an inline choice of rule refs, so the matched TYPED node
// (string/number/object/array/literal) becomes the enclosing node's child directly
// and its ruleName drives lowering.

[Globals at: #jsonGrammar put: [[|
  let g := [Peg newGrammar];

  let ws0    := [Peg star: [Peg anyOf: " \t\r\n"]];
  let digit  := [Peg range: "0" to: "9"];
  let digits := [Peg plus: digit];

  // string body: an escape (\ + any byte) or any byte that is not " or \
  let esc     := [Peg seqOf: #[ [Peg literal: "\\"] [Peg anyByte] ]];
  let strByte := [Peg seqOf: #[ [Peg not: [Peg literal: "\""]] [Peg not: [Peg literal: "\\"]] [Peg anyByte] ]];
  let strChar := [Peg choiceOf: #[ esc strByte ]];

  let value := [Peg choiceOf: #[
    [Peg ruleRef: #string] [Peg ruleRef: #number]
    [Peg ruleRef: #object] [Peg ruleRef: #array]
    [Peg ruleRef: #literal] ]];

  // ---- rules (these make CST nodes) ----
  [g rule: #string is: [Peg seqOf: #[
    [Peg literal: "\""] [Peg star: strChar] [Peg literal: "\""] ]]];

  // -? digits (.digits)? ([eE][+-]?digits)?
  [g rule: #number is: [Peg seqOf: #[
    [Peg opt: [Peg literal: "-"]]
    digits
    [Peg opt: [Peg seqOf: #[ [Peg literal: "."] digits ]]]
    [Peg opt: [Peg seqOf: #[ [Peg anyOf: "eE"] [Peg opt: [Peg anyOf: "+-"]] digits ]]] ]]];

  [g rule: #literal is: [Peg choiceOf: #[
    [Peg literal: "true"] [Peg literal: "false"] [Peg literal: "null"] ]]];

  [g rule: #member is: [Peg seqOf: #[
    [Peg ruleRef: #string] ws0 [Peg literal: ":"] ws0 value ]]];

  [g rule: #object is: [Peg seqOf: #[
    [Peg literal: "{"] ws0
    [Peg opt: [Peg seqOf: #[
      [Peg ruleRef: #member]
      [Peg star: [Peg seqOf: #[ ws0 [Peg literal: ","] ws0 [Peg ruleRef: #member] ]]] ]]]
    ws0 [Peg literal: "}"] ]]];

  [g rule: #array is: [Peg seqOf: #[
    [Peg literal: "["] ws0
    [Peg opt: [Peg seqOf: #[
      value
      [Peg star: [Peg seqOf: #[ ws0 [Peg literal: ","] ws0 value ]]] ]]]
    ws0 [Peg literal: "]"] ]]];

  [g rule: #json is: [Peg seqOf: #[ ws0 value ws0 ]]];

  g] value]];

// -- string escapes (parse side) ----------------------------------------------

// The unescaped meaning of the byte after a backslash. Default (else) is the byte
// itself, covering \" \\ \/ (and, for v1, \b \f \uXXXX — not specially handled).
[Reflect defineMethod: #jsonEscChar on: String as: [:self |
  let a := [[self = "n"] ifTrue: [| "\n"] ifFalse: [| self]];
  let b := [[self = "t"] ifTrue: [| "\t"] ifFalse: [| a]];
  let c := [[self = "r"] ifTrue: [| "\r"] ifFalse: [| b]];
  c]];

// Process backslash escapes in a string body (a fold that skips the byte each
// escape consumes). Lifted from the TOML unescaper.
[Reflect defineMethod: #jsonUnescape on: String as: [:self |
  let n := [self size];
  let step := [:st :i |
    let out := [st at: 0];
    let wasEsc := [st at: 1];
    let ch := [self at: i];
    [[wasEsc = 1]
      ifTrue: [| #[ out 0 ]]
      ifFalse: [| [[ch = "\\"]
        ifTrue: [| #[ [out , [[self at: [i + 1]] jsonEscChar]] 1 ]]
        ifFalse: [| #[ [out , ch] 0 ]]]]]];
  let r := [[n = 0]
    ifTrue: [| self]
    ifFalse: [| [[[0 to: [n - 1]] inject: #[ "" 0 ] into: step] at: 0]]];
  r]];

// A quoted JSON string token → its decoded content (strip the quotes, unescape).
[Reflect defineMethod: #jsonDecodeString on: String as: [:self |
  let body := [self copyFrom: 1 to: [[self size] - 1]];
  let r := [body jsonUnescape];
  r]];

// -- string escapes (stringify side) ------------------------------------------

// Escape a raw string for embedding in JSON (backslash FIRST so we don't
// double-escape the escapes we add). Shared by string values, symbols, and keys.
[Reflect defineMethod: #jsonEscaped on: String as: [:self |
  let a := [self replace: "\\" with: "\\\\"];
  let b := [a replace: "\"" with: "\\\""];
  let c := [b replace: "\n" with: "\\n"];
  let d := [c replace: "\t" with: "\\t"];
  let e := [d replace: "\r" with: "\\r"];
  e]];

// -- CST → native value lowering (on the parse-tree node vtable) --------------

[Reflect defineMethod: #jsonText: on: PegCstVt as: [:self :src |
  let r := [src copyFrom: [self start] to: [self end]];
  r]];

// A #number span → Integer, or Float when it has a fraction or exponent.
[Reflect defineMethod: #jsonNumber: on: PegCstVt as: [:self :src |
  let t := [self jsonText: src];
  let isF := [[t includesSubstring: "."] | [[t includesSubstring: "e"] | [t includesSubstring: "E"]]];
  let r := [isF ifTrue: [| [t asNumber]] ifFalse: [| [t asInteger]]];
  r]];

// A #literal span → true / false / nil.
[Reflect defineMethod: #jsonLiteral: on: PegCstVt as: [:self :src |
  let t := [self jsonText: src];
  let r := [[t = "true"]
    ifTrue:  [| true]
    ifFalse: [| [[t = "false"] ifTrue: [| false] ifFalse: [| nil]]]];
  r]];

// An #object node → a Map (its children are #member nodes: [keyString, value]).
[Reflect defineMethod: #jsonObject: on: PegCstVt as: [:self :src |
  let step := [:m :mem |
    let k := [[[[mem children] at: 0] jsonText: src] jsonDecodeString];
    let v := [[[mem children] at: 1] jsonValue: src];
    [m at: k put: v]];
  let r := [[self children] inject: [Map new] into: step];
  r]];

// A typed value node → the birnam value it denotes (recursive for object/array).
[Reflect defineMethod: #jsonValue: on: PegCstVt as: [:self :src |
  let r := [self ruleName];
  let vStr := [[r = "string"]  ifTrue: [| [[self jsonText: src] jsonDecodeString]] ifFalse: [| nil]];
  let vNum := [[r = "number"]  ifTrue: [| [self jsonNumber: src]] ifFalse: [| vStr]];
  let vObj := [[r = "object"]  ifTrue: [| [self jsonObject: src]] ifFalse: [| vNum]];
  let vArr := [[r = "array"]   ifTrue: [| [[self children] collect: [:c | [c jsonValue: src]]]] ifFalse: [| vObj]];
  let vLit := [[r = "literal"] ifTrue: [| [self jsonLiteral: src]] ifFalse: [| vArr]];
  vLit]];

// -- parse entry point --------------------------------------------------------

[Reflect defineMethod: #parseJson on: String as: [:self |
  let g   := [Globals at: #jsonGrammar];
  let cst := [g parse: self from: #json];
  let ok  := [[cst notNil] & [[cst end] = [self size]]];
  let r := [ok
    ifTrue:  [| [[[cst children] at: 0] jsonValue: self]]
    ifFalse: [| ["not valid JSON" error: #jsonParse]]];
  r]];

// -- stringify: double dispatch (each type renders itself) --------------------

[Reflect defineMethod: #asJson on: nil     as: [:self | "null"]];
[Reflect defineMethod: #asJson on: Boolean as: [:self | [self ifTrue: [| "true"] ifFalse: [| "false"]]]];
[Reflect defineMethod: #asJson on: Integer as: [:self | [self printString]]];
[Reflect defineMethod: #asJson on: Float   as: [:self | [self printString]]];
[Reflect defineMethod: #asJson on: String  as: [:self | let r := [Json quote: self]; r]];
[Reflect defineMethod: #asJson on: Symbol  as: [:self | let r := [Json quote: [self asString]]; r]];

[Reflect defineMethod: #asJson on: VectorVt as: [:self |
  let parts := [self collect: [:e | [e asJson]]];
  let r := [["[" , [Json joinComma: parts]] , "]"];
  r]];

[Reflect defineMethod: #asJson on: MapVt as: [:self |
  let me := self;
  let parts := [[self keys] collect: [:k |
    [[[Json quote: [k asString]] , ":"] , [[me at: k] asJson]]]];
  let r := [["{" , [Json joinComma: parts]] , "}"];
  r]];

// Fallback: anything without a specific asJson is not representable.
[Reflect defineMethod: #asJson on: Object as: [:self |
  let r := ["value is not JSON-serializable" error: #notSerializable];
  r]];

// -- the Json namespace object ------------------------------------------------

[Globals at: #Json put: [Object clone]];
[Reflect docModule: #json is: "JSON parse + stringify (native values <-> text), over Peg."];
[Reflect defineMethod: #parse:     on: Json as: [:self :src | [src parseJson]] doc:
  "Parse JSON `src` into native Map/Vector/String/Integer/Float/true/false/nil, or a #jsonParse error."];
[Reflect defineMethod: #stringify: on: Json as: [:self :v   | [v asJson]] doc:
  "Serialize a native value `v` to JSON text (double dispatch via each type's asJson)."];

// Quote + escape a raw string as a JSON string literal (shared by values/keys).
[Reflect defineMethod: #quote: on: Json as: [:self :s |
  let r := [["\"" , [s jsonEscaped]] , "\""];
  r]];

// Join already-rendered parts with commas (shared by array + object rendering).
// StringBuilder-backed: an LSP response serializes per message, and the old
// inject `,` fold copied O(n²) bytes over large arrays/objects.
[Reflect defineMethod: #joinComma: on: Json as: [:self :parts |
  let sb := [StringBuilder new];
  [parts do: [:p |
    [[[sb size] = 0] ifTrue: [| [sb add: p]] ifFalse: [| [[sb add: ","] add: p]]]]];
  [sb asString]]]
