// bench.birnam — the benchmark harness (docs/design/46), pure birnam.
//
// Mirrors test.birnam's shape: a BenchSuite is a named bag of deferred cases;
// the Bench singleton runs them and accumulates result records. The measurement
// contract (docs/design/46 rev. 2):
//
//   - the timed-loop shape is native `to:do:` — its counter lives in the runtime
//     frame, so an "empty" loop really is empty (NO cell traffic inside any
//     timed window; the harness's own bookkeeping writes cells only BETWEEN
//     windows)
//   - case bodies UNROLL K copies of the op per `to:do:` iteration (declared
//     via opsPerIter:) so the loop's own overhead stays well below the raw
//     time and the baseline subtraction is well-conditioned
//   - the runner times an empty loop at the same iteration count and
//     subtracts; results carry BOTH net and raw ns/op so the subtraction is
//     auditable. rawCase:… cases (the loops.* family — their subject IS the
//     loop) skip the subtraction and report raw as net
//   - GC discipline: `[System autoGc: false]` for the whole run, `[System gc]`
//     immediately before every timed window — collections never land inside
//     one (a case measuring allocation+collection opts out by being a macro
//     case, not a micro one)
//   - calibration doubles the iteration count until one timed run exceeds the
//     floor (~100ms); then R reps after one untimed warmup; the MEDIAN is the
//     tracked number, the MIN is the noise floor
//   - BENCH_QUICK (any value, read via a libc getenv wrap) lowers the floor
//     and reps for the dev loop; BENCH_OUT overrides where writeResults: lands
//
// Load it (from the repo root) with:
//   [System load: "modules/bench.birnam"]
//
// DEFINE (registers; runs nothing):
//   let s := [BenchSuite named: "micro"];
//   [s case: "sends.unary" opsPerIter: 8 do: [:n |
//     [1 to: n do: [:i | ...eight copies of the op under test...]]]];
//   [s rawCase: "loops.to-do" opsPerIter: 1 do: [:n |
//     [1 to: n do: [:i | nil]]]];
// RUN + WRITE:
//   [Bench runSuite: s];
//   [Bench writeResults: "bench/results/dev/micro.json"]

// -- dependencies (guarded — a second load would re-wrap noisily) ---------------
[Module named: #bench requires: #[#time #file]];
[[Globals includes: #Time] ifTrue: [| nil] ifFalse: [| [Module load: #time]]];
[[Globals includes: #File] ifTrue: [| nil] ifFalse: [| [Module load: #file]]];

// char *getenv(const char *) — the receiver (a String) is the variable name; a
// missing variable answers nil (the shim maps a NULL char* to nil).
[Alien wrap: "getenv" signature: "s s" as: #getenvValue on: String];

// Everything here is cwd-relative (module loads, the results layout) — warn
// loudly if this isn't the repo root. (bench.sh is the sanctioned entry.)
[[File isDir: "modules"] ifTrue: [| nil] ifFalse: [|
  [System println: "bench: WARNING — cwd is not the repo root; modules/ and bench/ paths will misresolve"]]];

// ===========================================================================
// BenchSuite — a named bag of deferred cases.
// ===========================================================================
[Globals at: #BenchSuite put: [ObjectModel newSlots: #[nil nil] parent: ObjectVt]];
[Reflect defineMethod: #slotNames on: BenchSuite as: [:self | #[#name #cases]]];
[Reflect docModule: #bench is: "The benchmark harness — calibrated, GC-disciplined timing over a native to:do: loop (docs/design/46)."];

[Reflect defineMethod: #name on: BenchSuite as: [:self |
  [ObjectModel slot: 0 in: self]] doc:
  "The suite's name."];
[Reflect defineMethod: #cases on: BenchSuite as: [:self |
  [ObjectModel slot: 1 in: self]] doc:
  "The suite's registered cases (a Vector of case objects)."];

[Reflect defineMethod: #named: on: BenchSuite as: [:self :nm |
  let s := [BenchSuite clone];
  [ObjectModel slot: 0 in: s put: nm];
  [ObjectModel slot: 1 in: s put: #[]];
  s] doc:
  "A fresh suite named `nm`."];

[Globals at: #BenchCase put: [ObjectModel newSlots: #[nil nil nil nil nil] parent: ObjectVt]];
[Reflect defineMethod: #slotNames on: BenchCase as: [:self | #[#cname #k #raw #fixedN #cblock]]];
[Reflect defineMethod: #cname on: BenchCase as: [:self | [ObjectModel slot: 0 in: self]]];
[Reflect defineMethod: #k on: BenchCase as: [:self | [ObjectModel slot: 1 in: self]]];
[Reflect defineMethod: #raw on: BenchCase as: [:self | [ObjectModel slot: 2 in: self]]];
[Reflect defineMethod: #fixedN on: BenchCase as: [:self | [ObjectModel slot: 3 in: self]]];
[Reflect defineMethod: #cblock on: BenchCase as: [:self | [ObjectModel slot: 4 in: self]]];

[Globals at: #BenchResult put: [ObjectModel newSlots: #[nil nil nil nil nil nil nil nil nil] parent: ObjectVt]];
[Reflect defineMethod: #slotNames on: BenchResult as: [:self | #[#rname #nsOp #nsOpRaw #netUs #ops #iters #nreps #medianUs #minUs]]];
[Reflect defineMethod: #rname on: BenchResult as: [:self | [ObjectModel slot: 0 in: self]]];
[Reflect defineMethod: #nsOp on: BenchResult as: [:self | [ObjectModel slot: 1 in: self]]];
[Reflect defineMethod: #nsOpRaw on: BenchResult as: [:self | [ObjectModel slot: 2 in: self]]];
[Reflect defineMethod: #netUs on: BenchResult as: [:self | [ObjectModel slot: 3 in: self]]];
[Reflect defineMethod: #ops on: BenchResult as: [:self | [ObjectModel slot: 4 in: self]]];
[Reflect defineMethod: #iters on: BenchResult as: [:self | [ObjectModel slot: 5 in: self]]];
[Reflect defineMethod: #nreps on: BenchResult as: [:self | [ObjectModel slot: 6 in: self]]];
[Reflect defineMethod: #medianUs on: BenchResult as: [:self | [ObjectModel slot: 7 in: self]]];
[Reflect defineMethod: #minUs on: BenchResult as: [:self | [ObjectModel slot: 8 in: self]]];

// The shared case constructor. rawFlag 1 = report raw only (no subtraction);
// fixedN 0 = calibrate, else run exactly fixedN iterations (for cases whose
// per-op cost grows with accumulated process state — e.g. store-appending ops
// — where a calibrated, machine-dependent n would make runs incomparable).
// Kept ≤4 block params (self + 3) by splitting the public surface below.
[Reflect defineMethod: #addCase:k:blk: on: BenchSuite as: [:self :nm :k :blk |
  let cse := [BenchCase clone];
  [ObjectModel slot: 0 in: cse put: nm];
  [ObjectModel slot: 1 in: cse put: k];
  [ObjectModel slot: 2 in: cse put: 0];
  [ObjectModel slot: 3 in: cse put: 0];
  [ObjectModel slot: 4 in: cse put: blk];
  [ObjectModel slot: 1 in: self put: [[self cases] add: cse]];
  cse] doc:
  "The shared case constructor: registers case `nm` with `k` ops per iteration and body `blk`; answers the case object."];

[Reflect defineMethod: #case:opsPerIter:do: on: BenchSuite as: [:self :nm :k :blk |
  [self addCase: nm k: k blk: blk];
  self] doc:
  "Add a subtracted case: `blk` is [:n | one to:do: loop of n iterations, K ops each]. Net ns/op = (median - empty-loop baseline) / (n*K). Chainable."];

[Reflect defineMethod: #rawCase:opsPerIter:do: on: BenchSuite as: [:self :nm :k :blk |
  let cse := [self addCase: nm k: k blk: blk];
  [ObjectModel slot: 2 in: cse put: 1];
  self] doc:
  "Add a raw-only case (no baseline subtraction) — for cases whose subject IS the loop. Chainable."];

[Reflect defineMethod: #fixedCase:iters:do: on: BenchSuite as: [:self :nm :n0 :blk |
  let cse := [self addCase: nm k: 1 blk: blk];
  [ObjectModel slot: 3 in: cse put: n0];
  self] doc:
  "Add a fixed-iteration case (no calibration; k=1): exactly n0 iterations per rep. For ops whose cost grows with accumulated process state — a calibrated n would make runs incomparable. Chainable."];

// ===========================================================================
// Bench — the runner. Results accumulate on #results (reset per runSuite:).
// ===========================================================================
[Globals at: #Bench put: [ObjectModel newSlots: #[nil 0 nil] parent: ObjectVt]];
[Reflect defineMethod: #slotNames on: Bench as: [:self | #[#results #failures #suiteName]]];

[Reflect defineMethod: #results on: Bench as: [:self |
  [ObjectModel slot: 0 in: self]] doc:
  "The result records of the last runSuite: (a Vector of record objects)."];

[Reflect defineMethod: #failures on: Bench as: [:self |
  [ObjectModel slot: 1 in: self]] doc:
  "How many cases FAILed (erroring bodies) in the last runSuite: — the exit-code gate."];
[Reflect defineMethod: #suiteName on: Bench as: [:self |
  [ObjectModel slot: 2 in: self]] doc:
  "The name of this runner's last suite."];

// Quick mode: BENCH_QUICK set (to anything) — the dev loop.
[Reflect defineMethod: #quick on: Bench as: [:self |
  [[["BENCH_QUICK" getenvValue] isNil] ifTrue: [| false] ifFalse: [| true]]] doc:
  "True iff BENCH_QUICK is set (to anything) in the environment — the dev loop's lower floor and rep count."];

// Calibration floor (µs a single timed run must exceed) and rep count.
[Reflect defineMethod: #floorUs on: Bench as: [:self |
  [[self quick] ifTrue: [| 20000] ifFalse: [| 100000]]] doc:
  "The calibration floor in µs one timed run must exceed (20000 quick, 100000 full)."];
[Reflect defineMethod: #benchReps on: Bench as: [:self |
  [[self quick] ifTrue: [| 2] ifFalse: [| 5]]] doc:
  "How many timed reps per case (2 quick, 5 full)."];

// A fresh empty-loop Block is the baseline. Registered cases own their Blocks
// through ordinary slots; imageability follows the normal Block/capture contract.
[Reflect defineMethod: #emptyLoop on: Bench as: [:self |
  [:m | [1 to: m do: [:i | nil]]]] doc:
  "A fresh empty-loop block — the baseline every subtracted case measures against (a fresh Block on each send)."];

// -- the ONLY timed window in the module ----------------------------------------
// GC immediately before, then start..run..stop. Nothing else may read the clock.
[Reflect defineMethod: #timeOnce:iters: on: Bench as: [:self :blk :m |
  [System gc];
  let t0 := [Time monotonicMicros];
  [blk value: m];
  let t1 := [Time monotonicMicros];
  [t1 - t0]] doc:
  "One GC-preceded timed run of `blk` at m iterations; answers elapsed µs."];

// Double m until one timed run exceeds the floor. Recursive — depth is log2.
// Ceiling at 2^30: a body that costs ~nothing (broken case, broken timer)
// must terminate with garbage-but-visible numbers, not spiral into overflow.
[Reflect defineMethod: #calibrate:from: on: Bench as: [:self :blk :m |
  let e := [self timeOnce: blk iters: m];
  [[e >= [self floorUs]]
    ifTrue:  [| m]
    ifFalse: [| [[m >= 1073741824]
      ifTrue:  [| m]
      ifFalse: [| [self calibrate: blk from: [m * 2]]]]]]] doc:
  "Doubles `m` until one timed run of `blk` exceeds the floor (ceiling 2^30); answers the iteration count."];

// R timed runs at m iterations; answers the Vector of elapsed µs. The cell
// writes land BETWEEN timed windows (timeOnce: brackets only the block).
[Reflect defineMethod: #sample:iters: on: Bench as: [:self :blk :m |
  let acc := [#[] asCell];
  [1 to: [self benchReps] do: [:r |
    let e := [self timeOnce: blk iters: m];
    [acc set: [[acc value] add: e]]]];
  [acc value]] doc:
  "benchReps timed runs of `blk` at `m` iterations; answers the Vector of elapsed µs (cell writes land between windows)."];

// Median = middle element of the sorted runs; min via fold. NOTE: `sortBy:`
// takes a one-arg KEY block (elements sort by `<` on their keys), NOT a
// two-arg comparator — identity is the ascending sort of Integers.
[Reflect defineMethod: #medianOf: on: Bench as: [:self :v |
  let sorted := [v sortBy: [:x | x]];
  [sorted at: [[v size] / 2]]] doc:
  "The median of `v` — the middle element of the ascending sort."];
[Reflect defineMethod: #minOf: on: Bench as: [:self :v |
  [v inject: [v at: 0] into: [:acc :x | [[x < acc] ifTrue: [| x] ifFalse: [| acc]]]]] doc:
  "The minimum element of `v`, via a fold."];

// -- run one case -----------------------------------------------------------------
// The warmup is ONE iteration and doubles as the error gate: an erroring body
// aborts its to:do: at iteration 1, so an unchecked case would calibrate
// forever — FAIL it instead (counted on #failures) and keep the suite going.
// One iteration suffices to warm (tcc compiles at load; calibration's own
// runs warm further), and a heavier warmup would cost seconds on expensive
// k=1 cases and pre-append state before fixed-n cases measure.
[Reflect defineMethod: #runCase: on: Bench as: [:self :cse |
  let blk := [cse cblock];
  let nm  := [cse cname];
  let w := [blk value: 1];
  [[w isError]
    ifTrue:  [|
      [ObjectModel slot: 1 in: self put: [[self failures] + 1]];
      [System println: ["  FAIL " , nm , ": " , [w printString]]]]
    ifFalse: [| [self measureCase: cse]]];
  self] doc:
  "Run one case: a one-iteration warmup doubles as the error gate — an erroring body FAILs (counts on #failures), else measure."];

[Reflect defineMethod: #measureCase: on: Bench as: [:self :cse |
  let blk := [cse cblock];
  let k   := [cse k];
  let nm  := [cse cname];
  let raw := [cse raw];
  let fixedN := [cse fixedN];
  let n := [[fixedN = 0]
    ifTrue:  [| [self calibrate: blk from: 1]]
    ifFalse: [| fixedN]];
  let runs   := [self sample: blk iters: n];
  let rawMed := [self medianOf: runs];
  let rawMin := [self minOf: runs];
  let baseMed := [[raw = 1]
    ifTrue:  [| 0]
    ifFalse: [| [self medianOf: [self sample: [self emptyLoop] iters: n]]]];
  let netUs := [rawMed - baseMed];
  [[netUs < 0] ifTrue: [|
    [System println: ["  WARN " , nm , ": negative net (baseline > case) — ill-conditioned; raise opsPerIter"]]]
    ifFalse: [| nil]];
  let netClamped := [[netUs < 0] ifTrue: [| 0] ifFalse: [| netUs]];
  let ops := [n * k];
  let rec := [BenchResult clone];
  [ObjectModel slot: 0 in: rec put: nm];
  [ObjectModel slot: 1 in: rec put: [[netClamped * 1000] / ops]];
  [ObjectModel slot: 2 in: rec put: [[rawMed * 1000] / ops]];
  [ObjectModel slot: 3 in: rec put: netUs];
  [ObjectModel slot: 4 in: rec put: ops];
  [ObjectModel slot: 5 in: rec put: n];
  [ObjectModel slot: 6 in: rec put: [self benchReps]];
  [ObjectModel slot: 7 in: rec put: rawMed];
  [ObjectModel slot: 8 in: rec put: rawMin];
  [ObjectModel slot: 0 in: self put: [[self results] add: rec]];
  [System println: ["  " , nm , ": " , [[rec nsOp] printString]
                   , " ns/op (raw " , [[rec nsOpRaw] printString]
                   , ", n=" , [n printString] , ", k=" , [k printString] , ")"]];
  self] doc:
  "Measure one case: calibrate (or use fixedN), sample, subtract the empty-loop baseline (unless raw); record and print."];

// -- one-shot external measurements ---------------------------------------------
// For work that can run exactly ONCE per process (e.g. a store-seeding pass:
// re-running it would hit the idempotent-assert no-op path, not the write
// path). The caller times it and records the result; reps=1, median=min=us.
[Reflect defineMethod: #record:us:ops: on: Bench as: [:self :nm :us :ops |
  let rec := [BenchResult clone];
  [ObjectModel slot: 0 in: rec put: nm];
  [ObjectModel slot: 1 in: rec put: [[us * 1000] / ops]];
  [ObjectModel slot: 2 in: rec put: [[us * 1000] / ops]];
  [ObjectModel slot: 3 in: rec put: us];
  [ObjectModel slot: 4 in: rec put: ops];
  [ObjectModel slot: 5 in: rec put: 1];
  [ObjectModel slot: 6 in: rec put: 1];
  [ObjectModel slot: 7 in: rec put: us];
  [ObjectModel slot: 8 in: rec put: us];
  [ObjectModel slot: 0 in: self put: [[self results] add: rec]];
  [System println: ["  " , nm , ": " , [[rec nsOp] printString]
                   , " ns/op (one-shot, ops=" , [ops printString] , ")"]];
  self] doc:
  "Record an externally timed one-shot measurement: `us` elapsed microseconds over `ops` operations."];

// -- run a suite --------------------------------------------------------------------
[Reflect defineMethod: #runSuite: on: Bench as: [:self :s |
  [System autoGc: false];
  [ObjectModel slot: 0 in: self put: #[]];
  [ObjectModel slot: 1 in: self put: 0];
  [ObjectModel slot: 2 in: self put: [s name]];
  [System println: ["== bench: " , [s name] , [[self quick] ifTrue: [| " (quick) =="] ifFalse: [| " =="]]]];
  [[s cases] do: [:cse | [self runCase: cse]]];
  [System autoGc: true];
  s] doc:
  "Run every case of suite `s` under the GC discipline (autoGc off for the run, re-enabled after — safe to run from a live REPL). Results land on [Bench results]; erroring cases FAIL and count on [Bench failures]."];

// -- JSON emit ----------------------------------------------------------------------
// Assembled by hand with StringBuilder for a STABLE field/case order (Json
// stringify over a HAMT Map would order keys arbitrarily — bad for diffing).
[Reflect defineMethod: #jsonFor: on: Bench as: [:self :rec |
  let sb := [StringBuilder new];
  [sb add: "{\"name\":\""];
  [sb add: [rec rname]];
  [sb add: "\",\"ns_per_op\":"];
  [sb add: [[rec nsOp] printString]];
  [sb add: ",\"ns_per_op_raw\":"];
  [sb add: [[rec nsOpRaw] printString]];
  [sb add: ",\"net_us\":"];
  [sb add: [[rec netUs] printString]];
  [sb add: ",\"ops\":"];
  [sb add: [[rec ops] printString]];
  [sb add: ",\"iters\":"];
  [sb add: [[rec iters] printString]];
  [sb add: ",\"reps\":"];
  [sb add: [[rec nreps] printString]];
  [sb add: ",\"median_us\":"];
  [sb add: [[rec medianUs] printString]];
  [sb add: ",\"min_us\":"];
  [sb add: [[rec minUs] printString]];
  [sb add: "}"];
  [sb asString]] doc:
  "One result record `rec` as a JSON object string, hand-assembled for a stable field order."];

[Reflect defineMethod: #jsonString on: Bench as: [:self |
  let sb := [StringBuilder new];
  let first := [1 asCell];
  [sb add: "{\"suite\":\""];
  [sb add: [ObjectModel slot: 2 in: self]];
  [sb add: "\",\"cases\":["];
  [[self results] do: [:rec |
    [[[first value] = 1] ifTrue: [| [first set: 0]] ifFalse: [| [sb add: ","]]];
    [sb add: [self jsonFor: rec]]]];
  [sb add: "]}"];
  [sb asString]] doc:
  "The last run's results as one JSON object (stable field order)."];

// -- write --------------------------------------------------------------------------
[Reflect defineMethod: #ensureDir: on: Bench as: [:self :p |
  [[File isDir: p] ifTrue: [| nil] ifFalse: [| [File makeDir: p]]]] doc:
  "Creates directory `p` unless it already exists."];

[Reflect defineMethod: #writeResults: on: Bench as: [:self :path |
  let env := ["BENCH_OUT" getenvValue];
  let out := [[env isNil] ifTrue: [| path] ifFalse: [| env]];
  [self ensureDir: "bench"];
  [self ensureDir: "bench/results"];
  [self ensureDir: "bench/results/dev"];
  let res := [File write: out contents: [self jsonString]];
  [[res isError]
    ifTrue:  [|
      [System println: ["write FAILED -> " , out , ": " , [res printString]]];
      res]
    ifFalse: [|
      [System println: ["results -> " , out]];
      out]]] doc:
  "Write the last run's JSON to `path` (BENCH_OUT overrides). Answers the path, or the error if the write failed (gate on [result isError]). Ensures the standard bench/results/dev layout; a custom path's directory is the caller's job."]
