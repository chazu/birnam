// Ordinary authored JSON decoding: contents, identity, and live operation sends.
[[Globals includes: #TestSuite] ifTrue: [| nil] ifFalse: [| [System load: "modules/test.birnam"]]];
// Exercise this checkout's decoder even if an installed image already loaded Json.
[System load: "modules/json.birnam"];
let s := [TestSuite named: "JSON" module: #json];

[s test: "plain bodies preserve contents and result identity rules" do: [:t |
  let empty := "";
  [t assert: [empty == [empty jsonUnescape]] describes: "empty input returns itself"];
  [#[ "x" "duration_ms" "café/λ/猫" "line\nwith\ttabs" ] do: [:input |
    let first := [input jsonUnescape];
    let second := [input jsonUnescape];
    [t expect: first equals: input describes: "plain bytes unchanged"];
    [t deny: [first == input] describes: "nonempty result is a copy"];
    [t deny: [first == second] describes: "each call makes a fresh result"]]]
]];

[s test: "escape decoding retains current supported meanings" do: [:t |
  let cases := #[
    #[ "\\n" "\n" ] #[ "\\t" "\t" ] #[ "\\r" "\r" ]
    #[ "\\\"" "\"" ] #[ "\\\\" "\\" ] #[ "\\/" "/" ]
    #[ "a\\nb" "a\nb" ] #[ "\\\\n" "\\n" ]
    #[ "a\\\\b\\tend" "a\\b\tend" ]
    #[ "\\b\\f\\u0041" "bfu0041" ]
  ];
  [cases do: [:pair |
    [t expect: [[pair at: 0] jsonUnescape] equals: [pair at: 1] describes: "escape case"]]];
  let input := "a\\nb";
  [t deny: [input == [input jsonUnescape]] describes: "escaped result is fresh"];
  [t expect: ["\"café\\n\"" jsonDecodeString] equals: "café\n" describes: "quoted token"]
]];

[s test: "plain path sends current scanning and slicing operations" do: [:t |
  let input := "abc";
  let scanned := [0 asCell];
  let copied := [0 asCell];
  [Reflect defineMethod: #includesSubstring: on: input as: [:self :needle |
    [scanned inc]; false]];
  [Reflect defineMethod: #copyFrom:to: on: input as: [:self :start :end |
    [copied inc]; #[ start end ]]];
  [t expect: [[input jsonUnescape] at: 0] equals: 0 describes: "copy starts at zero"];
  [t expect: [[input jsonUnescape] at: 1] equals: 3 describes: "copy uses current size"];
  [t expect: [scanned value] equals: 2 describes: "scanner runs on every call"];
  [t expect: [copied value] equals: 2 describes: "slicer runs on every call"];
  [Reflect defineMethod: #copyFrom:to: on: input as: [:self :start :end | "changed"]];
  [t expect: [input jsonUnescape] equals: "changed" describes: "replacement is immediately visible"]
]];

[s test: "escaped path uses current escape-character decoding" do: [:t |
  let input := "\\n";
  let letter := "n";
  [Reflect defineMethod: #jsonEscChar on: letter as: [:self | "custom"]];
  [Reflect defineMethod: #at: on: input as: [:self :index |
    [[index = 1] ifTrue: [| letter] ifFalse: [| "\\"]]]];
  [t expect: [input jsonUnescape] equals: "custom" describes: "current escape decoder is called"]
]];

[s test: "JSON keys and values decode together" do: [:t |
  let value := [Json parse: "{\"plain\":\"café\",\"line\\nkey\":\"tab\\tvalue\",\"empty\":\"\"}"];
  [t expect: [value at: "plain"] equals: "café" describes: "plain key and value"];
  [t expect: [value at: "line\nkey"] equals: "tab\tvalue" describes: "escaped key and value"];
  [t expect: [value at: "empty"] equals: "" describes: "empty value"]
]]
;

[s test: "all value kinds and nested containers" do: [:t |
  [t expect: [Json parse: "7"] equals: 7 describes: "integer root"];
  [t assert: [[Reflect vtableOf: [Json parse: "1.5"]] == FloatVt] describes: "float root"];
  [t assert: [[Json parse: "true"] == true] describes: "true root"];
  [t assert: [[Json parse: "false"] == false] describes: "false root"];
  [t assert: [[Json parse: "null"] isNil] describes: "null root"];
  [t expect: [[Json parse: "[]"] size] equals: 0 describes: "empty array"];
  [t expect: [[[Json parse: "{}"] keys] size] equals: 0 describes: "empty object"];
  let value := [Json parse: "[null,true,false,\"text\",1,{\"a\":[2,3]}]"];
  [t expect: [value at: 3] equals: "text" describes: "nested string"];
  [t expect: [[[value at: 5] at: "a"] at: 1] equals: 3 describes: "nested object and array"]
]];

[s test: "type dispatch stops and uses the current handler" do: [:t |
  let node := [[[[Json grammar] parse: "7" from: #json] children] at: 0];
  let tag := "number";
  let comparisons := [0 asCell];
  [Reflect defineMethod: #= on: tag as: [:self :other |
    [comparisons inc]; [other = "number"]]];
  [Reflect defineMethod: #ruleName on: node as: [:self | tag]];
  [Reflect defineMethod: #jsonNumber: on: node as: [:self :src | "first"]];
  [t expect: [node jsonValue: "7"] equals: "first" describes: "current numeric handler"];
  [t expect: [comparisons value] equals: 2 describes: "only string and number tested"];
  [Reflect defineMethod: #jsonNumber: on: node as: [:self :src | "second"]];
  [t expect: [node jsonValue: "7"] equals: "second" describes: "replacement takes effect"];
  [t expect: [comparisons value] equals: 4 describes: "dispatch remains late-bound"];
  [Reflect defineMethod: #ruleName on: node as: [:self | "unknown"]];
  [t assert: [[node jsonValue: "7"] isNil] describes: "unknown kind still returns nil"]
]]
;

[s test: "quoted decoding preserves fresh results" do: [:t |
  let cases := #[ #[ "\"\"" "" ] #[ "\"plain\"" "plain" ]
    #[ "\"café\"" "café" ] #[ "\"a\\nb\"" "a\nb" ] ];
  [cases do: [:pair |
    let input := [pair at: 0];
    let first := [input jsonDecodeString];
    [t expect: first equals: [pair at: 1] describes: "quoted contents"];
    [t deny: [first == input] describes: "result differs from quoted token"];
    [t deny: [first == [input jsonDecodeString]] describes: "successive decoded results are fresh"]
  ]]
]];

[s test: "quoted decoder returns its fresh plain slice using current sends" do: [:t |
  let input := "\"abc\"";
  let body := "abc";
  let copies := [0 asCell];
  let scans := [0 asCell];
  [Reflect defineMethod: #copyFrom:to: on: input as: [:self :start :end |
    [copies inc]; body]];
  [Reflect defineMethod: #includesSubstring: on: body as: [:self :needle |
    [scans inc]; [System gc]; false]];
  [t assert: [[input jsonDecodeString] == body] describes: "plain slice is not copied again"];
  [t expect: [copies value] equals: 1 describes: "token slicing remains a live send"];
  [t expect: [scans value] equals: 1 describes: "scan remains a live send"]
]];

[s test: "quoted escaped bodies use the current unescaper" do: [:t |
  let input := "\"\\n\"";
  let body := "\\n";
  [Reflect defineMethod: #copyFrom:to: on: input as: [:self :start :end | body]];
  [Reflect defineMethod: #jsonUnescape on: body as: [:self | "decoded"]];
  [t expect: [input jsonDecodeString] equals: "decoded" describes: "current unescape handler"];
  [Reflect defineMethod: #jsonUnescape on: body as: [:self | "replacement"]];
  [t expect: [input jsonDecodeString] equals: "replacement" describes: "changed unescape handler"]
]]
;

[s test: "numeric length boundaries preserve Integer and overflow behavior" do: [:t |
  let cases := #[ #[ "0" "0" ] #[ "-0" "0" ]
    #[ "999999999999999999" "999999999999999999" ]
    #[ "1000000000000000000" "1000000000000000000" ]
    #[ "9223372036854775807" "9223372036854775807" ]
    #[ "-9223372036854775808" "-9223372036854775808" ]
    #[ "0000000000000000000000001" "1" ] ];
  [cases do: [:pair |
    let value := [Json parse: [pair at: 0]];
    [t assert: [[Reflect vtableOf: value] == IntegerVt] describes: "integer kind"];
    [t expect: [value printString] equals: [pair at: 1] describes: "exact integer value"]]];
  [#[ "9223372036854775808" "9999999999999999999" "-9223372036854775809" "18446744073709551615" ] do: [:text |
    [t assert: [[Json parse: text] isNil] describes: "overflow does not become Float"]]]
]];

[s test: "short and long decimal and exponent forms remain Floats" do: [:t |
  [#[ "1.5" "-0.0" "1e3" "1E-3" "1e309"
      "1.234567890123456789012345" "-0.000000000000000001"
      "1234567890123456789.0" "1234567890123456789e-5" "1234567890123456789E-5" ] do: [:text |
    [t assert: [[Reflect vtableOf: [Json parse: text]] == FloatVt] describes: "floating syntax keeps Float kind"]]];
  [t expect: [Json parse: "1.5"] equals: 1.5 describes: "decimal value"];
  [t expect: [Json parse: "1e3"] equals: 1000.0 describes: "exponent value"];
  [t expect: [[Json parse: "-0.0"] printString] equals: "-0.0" describes: "negative zero"];
  [#[ "NaN" "Infinity" "+1" "1." "1e" "1e+" "--1" ] do: [:text |
    [t assert: [[Json parse: text] isError] describes: "malformed input rejected by grammar"]]]
]];

[s test: "numeric conversion uses current methods on both paths" do: [:t |
  let node := [[[[Json grammar] parse: "7" from: #json] children] at: 0];
  let short := "123";
  [Reflect defineMethod: #jsonText: on: node as: [:self :src | short]];
  [Reflect defineMethod: #asNumber on: short as: [:self | "short"]];
  [t expect: [node jsonNumber: "7"] equals: "short" describes: "current short conversion"];
  [Reflect defineMethod: #asNumber on: short as: [:self | "replacement"]];
  [t expect: [node jsonNumber: "7"] equals: "replacement" describes: "changed short conversion"];
  let long := "9223372036854775808";
  [Reflect defineMethod: #jsonText: on: node as: [:self :src | long]];
  [Reflect defineMethod: #asInteger on: long as: [:self | "long integer"]];
  [Reflect defineMethod: #asNumber on: long as: [:self | "long float"]];
  [t expect: [node jsonNumber: "7"] equals: "long integer" describes: "current long integer conversion"];
  [Reflect defineMethod: #includesSubstring: on: long as: [:self :needle | [needle = "e"]]];
  [t expect: [node jsonNumber: "7"] equals: "long float" describes: "current classifier and float conversion"]
]]
