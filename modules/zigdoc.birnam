// zigdoc.birnam — pull docs (and facts) out of native floor sources, in pure birnam.
//
// The birnam Doc system documents birnam code; the native Rust floor and retained
// Zig oracle are separate and doc generation must NOT require either compiler.
// This module reads .rs/.zig files as TEXT (via File) and extracts their shared
// `//!` (module) and `///` (declaration) doc-comment convention into Doc FACTS.
// The native docs therefore join the same queryable image and HTML reference.
//
// Load it (from the repo root) with:
//   [Module load: #zigdoc]     (loads File + Doc first)
//   [Zigdoc scan: "src/id/alien.zig" as: #alien]   "=> records #alien's docs"
//   [Doc text: #alien]                             "=> the extracted docs"
//   [Zigdoc scanDir: "src/id"]                     "=> scan every .zig in a dir"
//   [Zigdoc scanRustDir: "rust/birnam-id/src"]      "=> scan every .rs in a dir"

[Module named: #zigdoc requires: #[#file #doc]];
[[Globals includes: #File] ifTrue: [| nil] ifFalse: [| [Module load: #file]]];
[[Globals includes: #Doc]  ifTrue: [| nil] ifFalse: [| [Module load: #doc]]];

[Globals at: #Zigdoc put: [Object clone]];
[Reflect docModule: #zigdoc is: "Native floor doc extraction — scans //! and /// comments out of Rust and Zig sources into Doc facts, without either compiler."];

// The text after a `//` marker on `line` (trimmed). `[line split: mark] last` is
// the tail after the last occurrence of the marker.
[Reflect defineMethod: #after:mark: on: Zigdoc as: [:self :line :mark |
  let r := [[[line split: mark] last] trimmed];
  r] doc:
  "The trimmed text after the last `mark` occurrence on `line` (the whole line, trimmed, when absent)."];

// The declared name on a trimmed native-source line, or "" if it isn't a
// recognized Zig/Rust declaration. Takes the identifier after its declaration
// keyword, up to the first `(`, ` ` or `=`.
[Reflect defineMethod: #identAfter:mark: on: Zigdoc as: [:self :t :mark |
  let rest := [[t split: mark] last];
  let a := [[rest split: "("] first];
  let b := [[a split: " "] first];
  let c := [[b split: "="] first];
  let r := [c trimmed];
  r] doc:
  "The identifier following `mark` in a declaration line — up to the first (, space or =."];

[Reflect defineMethod: #declName: on: Zigdoc as: [:self :t |
  let r := [[t includesSubstring: "fn "]
    ifTrue:  [| [self identAfter: t mark: "fn "]]
    ifFalse: [| [[t includesSubstring: "const "]
      ifTrue:  [| [self identAfter: t mark: "const "]]
      ifFalse: [| [[t includesSubstring: "struct "]
        ifTrue:  [| [self identAfter: t mark: "struct "]]
        ifFalse: [| [[t includesSubstring: "enum "]
          ifTrue:  [| [self identAfter: t mark: "enum "]]
          ifFalse: [| [[t includesSubstring: "type "]
            ifTrue:  [| [self identAfter: t mark: "type "]]
            ifFalse: [| [[t includesSubstring: "trait "]
              ifTrue:  [| [self identAfter: t mark: "trait "]]
              ifFalse: [| [[t includesSubstring: "mod "]
                ifTrue:  [| [self identAfter: t mark: "mod "]]
                ifFalse: [| [[t includesSubstring: "static "]
                  ifTrue:  [| [self identAfter: t mark: "static "]]
                  ifFalse: [| ""]]]]]]]]]]]]]]]];
  r] doc:
  "The declared fn/const/struct/enum/type/trait/mod/static name on a trimmed native-source line, or \"\"."];

// Process one line against the scanner state (cells: #pending doc, #summary).
// //! -> module summary (first one wins); /// -> accumulate a pending docstring;
// any other line either consumes the pending doc (if it's a declaration) or drops
// it. Native `#[...]` attributes are transparent so Rust docs remain associated
// with their attributed declaration.
[Reflect defineMethod: #feedLine:scanner:module: on: Zigdoc as: [:self :line :sc :mod |
  let t := [line trimmed];
  [[line startsWith: "//!"]
    ifTrue: [|
      [[[[db cellFor: sc attr: #summary] value] isEmpty]
        ifTrue:  [| [[db cellFor: sc attr: #summary] set: [self after: line mark: "//!"]]]
        ifFalse: [| sc]]]
    ifFalse: [|
      [[t startsWith: "///"]
        ifTrue: [|
          let p := [[db cellFor: sc attr: #pending] value];
          [[db cellFor: sc attr: #pending] set: [[p , [self after: t mark: "///"]] , " "]]]
        ifFalse: [|
          let p := [[db cellFor: sc attr: #pending] value];
          [[p isEmpty]
            ifTrue:  [| sc]
            ifFalse: [|
              [[t startsWith: "#["]
                ifTrue: [| sc]
                ifFalse: [|
                  let nm := [self declName: t];
                  [[nm isEmpty]
                    ifTrue:  [| sc]
                    ifFalse: [| [Doc for: [nm asSymbol] in: mod says: [p trimmed]]]];
                  [[db cellFor: sc attr: #pending] set: ""]]]]]]]]];
  sc] doc:
  "Feed one native-source line to scanner `sc`: //! seeds the module summary, /// accumulates, attributes preserve pending docs, and a declaration consumes them."];

// Scan one native source file into Doc facts under `mod`, assigning its explicit
// documentation kind and fallback language label. Answers `mod`.
[Reflect defineMethod: #scan:as:kind:language: on: Zigdoc as: [:self :path :mod :kind :language |
  let text  := [File readText: path];
  let lines := [text split: "\n"];
  let sc := [Object clone];
  [[db cellFor: sc attr: #pending] set: ""];
  [[db cellFor: sc attr: #summary] set: ""];
  [Reflect docModule: mod is: ""];
  [db assert: mod attr: #docKind value: kind];
  [0 to: [[lines size] - 1] do: [:i |
    [self feedLine: [lines at: i] scanner: sc module: mod]]];
  let sum := [[db cellFor: sc attr: #summary] value];
  [[db cellFor: mod attr: #docSummary] set: [[sum isEmpty] ifTrue: [| [[path , " ("] , [language , ")"]]] ifFalse: [| sum]]];
  mod] doc:
  "Scan one native source file into Doc facts under `mod`, marking it with `kind`; answers `mod`."];

[Reflect defineMethod: #scan:as: on: Zigdoc as: [:self :path :mod |
  [self scan: path as: mod kind: #zigFloor language: "Zig"]] doc:
  "Scan one .zig file at `path` into Doc facts under `mod`, marking it #zigFloor. Answers `mod`."];

[Reflect defineMethod: #scanRust:as: on: Zigdoc as: [:self :path :mod |
  [self scan: path as: mod kind: #rustFloor language: "Rust"]] doc:
  "Scan one .rs file at `path` into Doc facts under `mod`, marking it #rustFloor. Answers `mod`."];

[Reflect defineMethod: #scanNativeRust:as: on: Zigdoc as: [:self :path :mod |
  [self scan: path as: mod kind: #nativeRust language: "Rust"]] doc:
  "Scan one .rs file at `path` into Doc facts under `mod`, marking it #nativeRust. Answers `mod`."];

// Make `mod` documented if it isn't already: load its compiled unit, and if
// that identity is not a shipped Birnam module, scan the Zig file at `zp`.
[Reflect defineMethod: #ensure:zig: on: Zigdoc as: [:self :mod :zp |
  [[Doc isProductionModule: mod]
    ifTrue:  [| [Module load: mod]]
    ifFalse: [| [[File exists: zp]
      ifTrue:  [| [self scan: zp as: mod]]
      ifFalse: [| mod]]]]] doc:
  "Document `mod` one way or the other: load its compiled unit, else scan the Zig file at `zp`. Answers `mod`."];

// Scan every `*.zig` in `dir` (excluding *_test.zig), each into module #<basename>.
// Answers a Vector of the module symbols documented.
[Reflect defineMethod: #scanDir: on: Zigdoc as: [:self :dir |
  let names := [File listDir: dir];
  let mods := [names inject: #[] into: [:acc :nm |
    [[[nm endsWith: ".zig"] & [[nm includesSubstring: "_test."] not]]
      ifTrue:  [|
        let base := [[nm split: "."] first];
        [self scan: [[dir , "/"] , nm] as: [base asSymbol]];
        [acc add: [base asSymbol]]]
      ifFalse: [| acc]]]];
  mods] doc:
  "Scan every non-test .zig in `dir`, each into module #<basename>; answers the Vector of module symbols documented."];

// Scan every `*.rs` in `dir`, each into module #rust-<basename>. The prefix
// prevents collisions with Birnam modules and Zig-oracle source identities.
[Reflect defineMethod: #scanRustDir: on: Zigdoc as: [:self :dir |
  let names := [File listDir: dir];
  let mods := [names inject: #[] into: [:acc :nm |
    [[nm endsWith: ".rs"]
      ifTrue:  [|
        let base := [[nm split: "."] first];
        let mod := [["rust-" , base] asSymbol];
        [self scanRust: [[dir , "/"] , nm] as: mod];
        [acc add: mod]]
      ifFalse: [| acc]]]];
  mods] doc:
  "Scan every .rs in `dir`, each into module #rust-<basename>; answers the Vector of module symbols documented."];

// Scan one Cargo workspace crate. `birnam-id` retains the established
// #rust-<file> identities and is the #rustFloor. Every other crate is
// #nativeRust and uses #rust-<crate> for lib.rs or
// #rust-<crate>-<file> for additional source files, avoiding cross-crate
// collisions as the workspace grows.
[Reflect defineMethod: #rustModuleFor:inCrate: on: Zigdoc as: [:self :base :crate |
  let suffix := [[crate startsWith: "birnam-"]
    ifTrue: [| [crate copyFrom: 7 to: [crate size]]]
    ifFalse: [| crate]];
  [[crate = "birnam-id"]
    ifTrue: [| ["rust-" , base]]
    ifFalse: [|
      [[base = "lib"]
        ifTrue: [| ["rust-" , suffix]]
        ifFalse: [| [[["rust-" , suffix] , "-"] , base]]]]]] doc:
  "The collision-free documentation module name for Rust source `base` in `crate`."];

[Reflect defineMethod: #scanRustCrate:at:kind: on: Zigdoc as: [:self :crate :root :kind |
  let dir := [[[[root , "/rust/"] , crate] , "/"] , "src"];
  let listed := [File listDir: dir];
  let names := [[[listed isNil] ifTrue: [| #[]] ifFalse: [| listed]] sortBy: [:x | x]];
  let mods := [names inject: #[] into: [:acc :nm |
    [[nm endsWith: ".rs"]
      ifTrue: [|
        let base := [[nm split: "."] first];
        let label := [self rustModuleFor: base inCrate: crate];
        let mod := [label asSymbol];
        [self scan: [[dir , "/"] , nm] as: mod kind: kind language: "Rust"];
        [acc add: mod]]
      ifFalse: [| acc]]]];
  mods] doc:
  "Scan one installed Cargo workspace crate with collision-free module identities and the explicit documentation `kind`."];

[Reflect defineMethod: #scanRustWorkspace: on: Zigdoc as: [:self :root |
  let rustRoot := [root , "/rust"];
  let listed := [File listDir: rustRoot];
  let crates := [[[listed isNil] ifTrue: [| #[]] ifFalse: [| listed]] sortBy: [:x | x]];
  let mods := [crates inject: #[] into: [:acc :crate |
    let cratePath := [[rustRoot , "/"] , crate];
    [[File isDir: cratePath]
      ifTrue: [|
        let kind := [[crate = "birnam-id"] ifTrue: [| #rustFloor] ifFalse: [| #nativeRust]];
        [[self scanRustCrate: crate at: root kind: kind]
          inject: acc into: [:all :mod | [all add: mod]]]]
      ifFalse: [| acc]]]];
  mods] doc:
  "Scan every crate under `<workspace>/rust`: birnam-id as #rustFloor and all other native crates as #nativeRust."];
