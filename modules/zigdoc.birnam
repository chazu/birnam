// zigdoc.birnam — pull docs (and facts) out of the Zig floor, in pure birnam.
//
// The birnam Doc system documents birnam code; the Zig floor (src/id/*.zig) is
// separate and must NOT require Zig to run. This module reads a .zig file as TEXT
// (via the File module) and extracts its `//!` (module) and `///` (declaration)
// doc-comments — which are already dense — recording them as Doc FACTS under a
// module symbol. So the Zig docs join the same queryable image: `[Doc text: #alien]`,
// `birnam doc alien`, and the HTML reference all read them, with zero Zig runtime.
//
// Load it (from the repo root) with:
//   [System load: "modules/zigdoc.birnam"]     (pulls in File + Doc)
//   [Zigdoc scan: "src/id/alien.zig" as: #alien]   "=> records #alien's docs"
//   [Doc text: #alien]                             "=> the extracted docs"
//   [Zigdoc scanDir: "src/id"]                     "=> scan every .zig in a dir"

[[Globals includes: #File] ifTrue: [| nil] ifFalse: [| [System load: "modules/file.birnam"]]];
[[Globals includes: #Doc]  ifTrue: [| nil] ifFalse: [| [System load: "modules/doc.birnam"]]];

[Globals at: #Zigdoc put: [Object clone]];

// The text after a `//` marker on `line` (trimmed). `[line split: mark] last` is
// the tail after the last occurrence of the marker.
[Reflect defineMethod: #after:mark: on: Zigdoc as: [:self :line :mark |
  let r := [[[line split: mark] last] trimmed];
  r]];

// The declared name on a (trimmed) Zig line, or "" if it isn't a fn/const decl.
// Takes the identifier after `fn `/`const `, up to the first `(`, ` ` or `=`.
[Reflect defineMethod: #identAfter:mark: on: Zigdoc as: [:self :t :mark |
  let rest := [[t split: mark] last];
  let a := [[rest split: "("] first];
  let b := [[a split: " "] first];
  let c := [[b split: "="] first];
  let r := [c trimmed];
  r]];

[Reflect defineMethod: #declName: on: Zigdoc as: [:self :t |
  let r := [[t includesSubstring: "fn "]
    ifTrue:  [| [self identAfter: t mark: "fn "]]
    ifFalse: [| [[t includesSubstring: "const "]
      ifTrue:  [| [self identAfter: t mark: "const "]]
      ifFalse: [| ""]]]];
  r]];

// Process one line against the scanner state (cells: #pending doc, #summary).
// //! -> module summary (first one wins); /// -> accumulate a pending docstring;
// any other line either consumes the pending doc (if it's a declaration) or, being
// non-doc non-decl, drops it (docs must sit immediately above their declaration).
[Reflect defineMethod: #feedLine:scanner:module: on: Zigdoc as: [:self :line :sc :mod |
  let t := [line trimmed];
  [[line startsWith: "//!"]
    ifTrue: [|
      [[[[db cellFor: sc attr: #summary] value] isEmpty]
        ifTrue:  [| [[db cellFor: sc attr: #summary] set: [self after: line mark: "//!"]]]
        ifFalse: [| sc]]]
    ifFalse: [|
      [[t startsWith: "///"]
        ifTrue: [|
          let p := [[db cellFor: sc attr: #pending] value];
          [[db cellFor: sc attr: #pending] set: [[p , [self after: t mark: "///"]] , " "]]]
        ifFalse: [|
          let p := [[db cellFor: sc attr: #pending] value];
          [[p isEmpty]
            ifTrue:  [| sc]
            ifFalse: [|
              let nm := [self declName: t];
              [[nm isEmpty]
                ifTrue:  [| sc]
                ifFalse: [| [Doc for: [nm asSymbol] in: mod says: [p trimmed]]]];
              [[db cellFor: sc attr: #pending] set: ""]]]]]]];
  sc]];

// Scan one .zig file into Doc facts under `mod`. Answers `mod`. Also marks the
// module `#docKind #zigFloor` — a fact the doc renderers read to badge/group
// Zig-floor entries apart from loadable birnam modules.
[Reflect defineMethod: #scan:as: on: Zigdoc as: [:self :path :mod |
  let text  := [File readText: path];
  let lines := [text split: "\n"];
  let sc := [Object clone];
  [[db cellFor: sc attr: #pending] set: ""];
  [[db cellFor: sc attr: #summary] set: ""];
  [Reflect docModule: mod is: ""];
  [db assert: mod attr: #docKind value: #zigFloor];
  [0 to: [[lines size] - 1] do: [:i |
    [self feedLine: [lines at: i] scanner: sc module: mod]]];
  let sum := [[db cellFor: sc attr: #summary] value];
  [[db cellFor: mod attr: #docSummary] set: [[sum isEmpty] ifTrue: [| [path , " (Zig)"]] ifFalse: [| sum]]];
  mod]];

// Make `mod` documented if it isn't already: load the birnam module at `bp` (a
// no-op if that file is absent — its `doc:` registrations then fire), and if `mod`
// still isn't documented, scan the Zig file at `zp` (if present). The `birnam doc`
// CLI calls this so one command documents either a birnam module OR a Zig file.
[Reflect defineMethod: #ensure:birnam:zig: on: Zigdoc as: [:self :mod :bp :zp |
  [System load: bp];
  [[Doc isDocumented: mod]
    ifTrue:  [| mod]
    ifFalse: [| [[File exists: zp]
      ifTrue:  [| [self scan: zp as: mod]]
      ifFalse: [| mod]]]]]];

// Scan every `*.zig` in `dir` (excluding *_test.zig), each into module #<basename>.
// Answers a Vector of the module symbols documented.
[Reflect defineMethod: #scanDir: on: Zigdoc as: [:self :dir |
  let names := [File listDir: dir];
  let mods := [names inject: #[] into: [:acc :nm |
    [[[nm endsWith: ".zig"] & [[nm includesSubstring: "_test."] not]]
      ifTrue:  [|
        let base := [[nm split: "."] first];
        [self scan: [[dir , "/"] , nm] as: [base asSymbol]];
        [acc add: [base asSymbol]]]
      ifFalse: [| acc]]]];
  mods]]
