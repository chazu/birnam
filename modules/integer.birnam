// Signed Integer policy over opaque native bit access and generic Word operations.
// Representation/constructors remain with the retained cold-bootstrap owner.
[Module named: #integerValues requires: #[#nativeValues #booleanValues]];
let intWord := Word;
let intExecution := Execution;
let intFactory := Integer;
let intNamespace := Namespace;
let intFloat := Float;
let intZero := [intExecution wordResultOf: 0 selector: #word];
let intSign := [intExecution wordResultOf: -9223372036854775808 selector: #word];
let intMax := [intExecution wordResultOf: 9223372036854775807 selector: #word];
let intShift := [intExecution wordResultOf: 63 selector: #word];

[Reflect defineMethod: #integerBitsOf: on: Integer as: [:self :value |
  [intExecution optionalWordResultOf: intFactory selector: #wordOf: argument: value resultFactory: intWord]
]];
[Reflect defineMethod: #integerFromBits: on: Integer as: [:self :bits |
  [intExecution objectResultOf: self selector: #fromWord: wordArgument: bits]
]];
// A sign is the Word 0 or 2^63. Magnitudes and sign restoration stay unsigned.
[Reflect defineMethod: #integerSignOf: on: Integer as: [:self :bits |
  [bits bitAnd: intSign]
]];
[Reflect defineMethod: #integerMagnitude:sign: on: Integer as: [:self :bits :sign |
  let mask := [intZero wrappingSubtract: [sign shiftRight: intShift]];
  [[bits bitXor: mask] wrappingSubtract: mask]
]];
[Reflect defineMethod: #integerExactError: on: Integer as: [:self :value |
  let family := [intNamespace valueAt: #ErrorVt];
  [[family notNil] & [[Reflect vtableOf: value] == family]]
]];
// Shared handlers receive changing values as arguments, never per-call captures.
let intNil2 := [:a :b | nil];
let intNil3 := [:a :b :c | nil];
let intNil5 := [:a :b :c :d :e | nil];
let intFailure := [:factory :kind :message | [factory kind: kind message: message]];
[Reflect defineMethod: #integerFailure:message: on: Integer as: [:self :kind :message |
  let factory := [intNamespace valueAt: #Error];
  [[[factory isNil] selectIfTrue: intNil3 ifFalse: intFailure otherwise: intNil3]
    value: factory value: kind value: message]
]];
[Reflect defineMethod: #integerOverflow on: Integer as: [:self |
  [self integerFailure: #overflow message: "integer overflow"]
]];
[Reflect defineMethod: #integerZeroDivide on: Integer as: [:self |
  [self integerFailure: #zeroDivide message: "division by zero"]
]];
let intBox := [:factory :bits | [factory integerFromBits: bits]];
let intOverflow2 := [:factory :bits | [factory integerOverflow]];
let intOverflow3 := [:factory :magnitude :sign | [factory integerOverflow]];
let intOverflow5 := [:factory :a :b :sign :limit | [factory integerOverflow]];
let intRestore := [:factory :magnitude :sign |
  [factory integerFromBits: [factory integerMagnitude: magnitude sign: sign]]
];
[Reflect defineMethod: #integerSignedMagnitude:sign: on: Integer as: [:self :magnitude :sign |
  let limit := [sign selectIfZero: intMax ifNonzero: intSign];
  [[[limit unsignedLessThan: magnitude] selectIfTrue: intOverflow3 ifFalse: intRestore otherwise: intNil3]
    value: self value: magnitude value: sign]
]];
[Reflect defineMethod: #integerAddBits:with: on: Integer as: [:self :left :right |
  let result := [left wrappingAdd: right];
  [[[[[left bitXor: result] bitAnd: [right bitXor: result]] unsignedLessThan: intSign]
    selectIfTrue: intBox ifFalse: intOverflow2 otherwise: intNil2] value: self value: result]
]];
[Reflect defineMethod: #integerSubtractBits:with: on: Integer as: [:self :left :right |
  let result := [left wrappingSubtract: right];
  [[[[[left bitXor: right] bitAnd: [left bitXor: result]] unsignedLessThan: intSign]
    selectIfTrue: intBox ifFalse: intOverflow2 otherwise: intNil2] value: self value: result]
]];
let intMultiplyZero := [:factory :a :b :sign :limit | [factory integerFromBits: intZero]];
let intMultiplyResult := [:factory :a :b :sign :limit |
  [factory integerSignedMagnitude: [a wrappingMultiply: b] sign: sign]
];
let intMultiplyCheck := [:factory :a :b :sign :limit |
  [[[[limit unsignedDivide: b] unsignedLessThan: a]
    selectIfTrue: intOverflow5 ifFalse: intMultiplyResult otherwise: intNil5]
    value: factory value: a value: b value: sign value: limit]
];
[Reflect defineMethod: #integerMultiplyBits:with: on: Integer as: [:self :left :right |
  let leftSign := [self integerSignOf: left]; let rightSign := [self integerSignOf: right];
  let sign := [leftSign bitXor: rightSign];
  let a := [self integerMagnitude: left sign: leftSign];
  let b := [self integerMagnitude: right sign: rightSign];
  let limit := [sign selectIfZero: intMax ifNonzero: intSign];
  [[[b = intZero] selectIfTrue: intMultiplyZero ifFalse: intMultiplyCheck otherwise: intNil5]
    value: self value: a value: b value: sign value: limit]
]];
let intZeroDivide := [:factory :a :b :leftSign :rightSign | [factory integerZeroDivide]];
let intDivideResult := [:factory :a :b :leftSign :rightSign |
  [factory integerSignedMagnitude: [a unsignedDivide: b] sign: [leftSign bitXor: rightSign]]
];
let intRemainderResult := [:factory :a :b :leftSign :rightSign |
  [factory integerSignedMagnitude: [a unsignedRemainder: b] sign: leftSign]
];
[Reflect defineMethod: #integerDivideBits:with: on: Integer as: [:self :left :right |
  let leftSign := [self integerSignOf: left]; let rightSign := [self integerSignOf: right];
  let a := [self integerMagnitude: left sign: leftSign];
  let b := [self integerMagnitude: right sign: rightSign];
  [[[b = intZero] selectIfTrue: intZeroDivide ifFalse: intDivideResult otherwise: intNil5]
    value: self value: a value: b value: leftSign value: rightSign]
]];
[Reflect defineMethod: #integerRemainderBits:with: on: Integer as: [:self :left :right |
  let leftSign := [self integerSignOf: left]; let rightSign := [self integerSignOf: right];
  let a := [self integerMagnitude: left sign: leftSign];
  let b := [self integerMagnitude: right sign: rightSign];
  [[[b = intZero] selectIfTrue: intZeroDivide ifFalse: intRemainderResult otherwise: intNil5]
    value: self value: a value: b value: leftSign value: rightSign]
]];
// Each shared operation owns its two live dispatch paths; no per-call table lookup.
let intAddOperation := [Object clone];
[Reflect defineMethod: #arithmeticKind on: intAddOperation as: [:self | #add]];
[Reflect defineMethod: #applyInteger:with: on: intAddOperation as: [:self :a :b | [intFactory integerAddBits: a with: b]]];
[Reflect defineMethod: #applyFloat:with: on: intAddOperation as: [:self :a :b | [a + b]]];
let intSubtractOperation := [Object clone];
[Reflect defineMethod: #arithmeticKind on: intSubtractOperation as: [:self | #subtract]];
[Reflect defineMethod: #applyInteger:with: on: intSubtractOperation as: [:self :a :b | [intFactory integerSubtractBits: a with: b]]];
[Reflect defineMethod: #applyFloat:with: on: intSubtractOperation as: [:self :a :b | [a - b]]];
let intMultiplyOperation := [Object clone];
[Reflect defineMethod: #arithmeticKind on: intMultiplyOperation as: [:self | #multiply]];
[Reflect defineMethod: #applyInteger:with: on: intMultiplyOperation as: [:self :a :b | [intFactory integerMultiplyBits: a with: b]]];
[Reflect defineMethod: #applyFloat:with: on: intMultiplyOperation as: [:self :a :b | [a * b]]];
let intDivideOperation := [Object clone];
[Reflect defineMethod: #arithmeticKind on: intDivideOperation as: [:self | #divide]];
[Reflect defineMethod: #applyInteger:with: on: intDivideOperation as: [:self :a :b | [intFactory integerDivideBits: a with: b]]];
[Reflect defineMethod: #applyFloat:with: on: intDivideOperation as: [:self :a :b | [a / b]]];
let intRemainderOperation := [Object clone];
[Reflect defineMethod: #arithmeticKind on: intRemainderOperation as: [:self | #remainder]];
[Reflect defineMethod: #applyInteger:with: on: intRemainderOperation as: [:self :a :b | [intFactory integerRemainderBits: a with: b]]];
let intReturnOther := [:receiver :other :operation :left :right | other];
let intApplyInteger := [:receiver :other :operation :left :right |
  [operation applyInteger: left with: right]
];
let intApplyFloat := [:receiver :other :operation :left :right |
  let value := [receiver asFloat];
  [operation applyFloat: value with: other]
];
let intRemainderFailure := [:receiver :other :operation :left :right |
  [intFactory integerFailure: #typeMismatch message: "mod: needs an Integer"]
];
let intNumberFailure := [:receiver :other :operation :left :right |
  [intFactory integerFailure: #typeMismatch message: "Integer arithmetic needs a number"]
];
let intUnknownMessageFailure := [:receiver :other :operation :left :right |
  [intFactory integerFailure: #typeMismatch message: nil]
];
let intTypeFailure := [:receiver :other :operation :left :right |
  [[[[operation arithmeticKind] == #remainder] selectIfTrue: intRemainderFailure ifFalse: intNumberFailure otherwise: intUnknownMessageFailure]
    value: receiver value: other value: operation value: left value: right]
];
let intTryFloat := [:receiver :other :operation :left :right |
  let floating := [intExecution optionalWordResultOf: intFloat selector: #bitsOf: argument: other resultFactory: intWord];
  [[[[floating notNil] & [[[operation arithmeticKind] == #remainder] not]] selectIfTrue: intApplyFloat ifFalse: intTypeFailure otherwise: intNil5]
    value: receiver value: other value: operation value: left value: right]
];
let intTryInteger := [:receiver :other :operation :left :ignored |
  let right := [intFactory integerBitsOf: other];
  [[[right notNil] selectIfTrue: intApplyInteger ifFalse: intTryFloat otherwise: intNil5]
    value: receiver value: other value: operation value: left value: right]
];
let intValidateOther := [:receiver :other :operation :left :ignored |
  [[[intFactory integerExactError: other] selectIfTrue: intReturnOther ifFalse: intTryInteger otherwise: intNil5]
    value: receiver value: other value: operation value: left value: left]
];
[Reflect defineMethod: #integerBinary:operation: on: Integer as: [:self :other :operation |
  let left := [intFactory integerBitsOf: self];
  [[[left isNil] selectIfTrue: intNil5 ifFalse: intValidateOther otherwise: intNil5]
    value: self value: other value: operation value: left value: left]
]];
[[intFactory hasBootstrapArithmetic: #+] ifTrue: [|
  [Reflect defineMethod: #+ on: Integer as: [:self :other | [self integerBinary: other operation: intAddOperation]]]
]];
[[intFactory hasBootstrapArithmetic: #-] ifTrue: [|
  [Reflect defineMethod: #- on: Integer as: [:self :other | [self integerBinary: other operation: intSubtractOperation]]]
]];
[[intFactory hasBootstrapArithmetic: #*] ifTrue: [|
  [Reflect defineMethod: #* on: Integer as: [:self :other | [self integerBinary: other operation: intMultiplyOperation]]]
]];
[[intFactory hasBootstrapArithmetic: #/] ifTrue: [|
  [Reflect defineMethod: #/ on: Integer as: [:self :other | [self integerBinary: other operation: intDivideOperation]]]
]];
[[intFactory hasBootstrapArithmetic: #mod:] ifTrue: [|
  [Reflect defineMethod: #mod: on: Integer as: [:self :other | [self integerBinary: other operation: intRemainderOperation]]]
]];
[Module markLoaded: #integerValues];
