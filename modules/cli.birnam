// cli.birnam — the birnam side of the birnam CLI: doc, docgen, init, wrap, --lsp, --listen.
//
// Rust host recognizes a subcommand token, boots the image, loads this compiled
// module by canonical identity, and hands the whole invocation over in ONE send:
//
//   [Cli run: #["doc" "time"] rust: "<rust-dir>" rustAbi: "<abi-dir>" guides: "<guide-dir>"]
//
// Cli loads what the subcommand needs and drives the SAME public API any birnam
// program can call for itself — [Doc cli:], [Doc buildSite:rustWorkspace:guides:],
// [Lsp serveStdio], [Repl serveOn:]. The CLI is one more CLIENT of the module
// APIs, not their owner: nothing in doc/lsp/repl requires Cli, and loading any
// of them from code gives the identical API the subcommands use.
//
// Contract with the Rust host: `run:rustWorkspace:guides:` answers a process status —
// 0 for success (usage displays included, matching the Rust host), 1 for
// failure; the driver exits with it. args[0] is the subcommand token as typed
// (so the --serve alias arrives as "--serve").

[Module named: #cli requires: #[#doc]];
[Globals at: #Cli put: [Object clone]];
[Reflect docModule: #cli is: "The CLI subcommand dispatcher (doc/docgen/init/wrap/--lsp/--listen) — one more client of the module APIs."];

// -- small shared pieces -------------------------------------------------------

// Print a line and answer a status: say = help/progress (0), fail = error (1).
[Reflect defineMethod: #say: on: Cli as: [:self :msg |
  [System println: msg];
  0] doc:
  "Prints `msg` and answers status 0 — for help/progress output."];
[Reflect defineMethod: #fail: on: Cli as: [:self :msg |
  [System println: msg];
  1] doc:
  "Prints `msg` and answers status 1 — for error output."];

// Load a shipped runtime module and its dependencies by canonical identity.
[Reflect defineMethod: #ensure: on: Cli as: [:self :name |
  [Module load: name]] doc:
  "Loads a shipped runtime module and its dependencies by canonical identity."];

// The last compile's outcome as a process status. `status` reports the error;
// `statusQuiet` only answers it (for --lsp, whose stdout is protocol-only).
[Reflect defineMethod: #statusQuiet on: Cli as: [:self |
  [[[Codegen lastError] isNil] ifTrue: [| 0] ifFalse: [| 1]]] doc:
  "The last compile's outcome as a status (0 ok, 1 error) without printing — for --lsp, whose stdout is protocol-only."];
[Reflect defineMethod: #status on: Cli as: [:self |
  let e := [Codegen lastError];
  [[e isNil] ifTrue: [| 0] ifFalse: [| [self fail: ["birnam: " , e]]]]] doc:
  "The last compile's outcome as a status: 0 when clean, else reports the error and answers 1."];

// -- doc: `birnam doc <module> [selector]` --------------------------------------

[Reflect defineMethod: #doc: on: Cli as: [:self :args |
  [[[args size] < 2]
    ifTrue:  [| [self say: "usage: birnam doc <module> [selector]"]]
    ifFalse: [| [self docNamed: [args at: 1] sel: [args at: 2 ifAbsent: [| nil]]]]]] doc:
  "`birnam doc <module> [selector]` — print a module's docs (or one selector's) via [Doc cli:]."];

// Resolve the module from the compiled production closure.
[Reflect defineMethod: #docNamed:sel: on: Cli as: [:self :mod :sel |
  let floor := [#[#compiledUnitDocs #concurrencyDocs] inject: self into: [:answer :name |
    [[answer isError] ifTrue: [| answer] ifFalse: [| [Module load: name]]]]];
  [[floor isError]
    ifTrue: [| [self fail: [floor printString]]]
    ifFalse: [|
      [[sel isNil]
        ifTrue:  [| [System print: [Doc cli: [mod asSymbol]]]]
        ifFalse: [| [System print: [Doc cli: [mod asSymbol] sel: sel]]]];
      [self status]]]] doc:
  "Print docs for module `mod` (all of it, or one selector when `sel` is non-nil) via its compiled unit."];

// -- docgen: `birnam docgen [out.html]` -----------------------------------------

[Reflect defineMethod: #docgen:rustWorkspace:guides: on: Cli as: [:self :args :rwork :gdir |
  let outPath := [args at: 1 ifAbsent: [| "birnam-docs.html"]];
  let built := [Doc buildSite: outPath rustWorkspace: rwork guides: gdir];
  [[built isError]
    ifTrue: [| [self fail: [built printString]]]
    ifFalse: [|
      let status := [self status];
      [[status = 0]
        ifTrue:  [| [self say: ["wrote " , outPath]]]
        ifFalse: [| 1]]]]] doc:
  "`birnam docgen [out.html]` — build the full HTML reference from compiled modules, the installed Rust workspace, and guides."];

// -- lsp: `birnam --lsp` --------------------------------------------------------

// Load Doc + every library module (populating the hover facts), then serve.
// [Lsp serveStdio] owns stdin/stdout and exits the process on `exit`/EOF, so
// reaching the status check at all means startup failed — stay QUIET on stdout
// (it is protocol-only); the driver reports the failure on stderr.
[Reflect defineMethod: #lsp: on: Cli as: [:self :args |
  let loaded := [Doc loadAllModules];
  [[loaded isError]
    ifTrue: [| 1]
    ifFalse: [| [Lsp serveStdio]; [self statusQuiet]]]] doc:
  "`birnam --lsp` — run the language server on stdio via [Lsp serveStdio]."];

// -- listen: `birnam --listen <port> [file]` ------------------------------------

[Reflect defineMethod: #listen: on: Cli as: [:self :args |
  [[[args size] < 2]
    ifTrue:  [| [self say: "usage: birnam --listen <port> [file.birnam]"]]
    ifFalse: [| [self listenOn: [[args at: 1] asInteger]
                       file: [args at: 2 ifAbsent: [| nil]]
                       ]]]] doc:
  "`birnam --listen <port> [file]` — serve the socket REPL via [Repl serveOn:], optionally running FILE first."];

// A usable TCP port: an Integer (asInteger answers nil for a non-number) in range.
[Reflect defineMethod: #validPort: on: Cli as: [:self :port |
  [[port isNil]
    ifTrue:  [| false]
    ifFalse: [| [[port >= 0] & [port <= 65535]]]]] doc:
  "True iff `port` is a usable TCP port: non-nil (asInteger answers nil for a non-number) and in 0..65535."];

[Reflect defineMethod: #listenOn:file: on: Cli as: [:self :port :file |
  [[self validPort: port]
    ifTrue:  [| [self listenGo: port file: file]]
    ifFalse: [| [self say: "birnam --listen: port must be a number in 0..65535"]]]] doc:
  "Serves the socket REPL on `port` (running `file` first when non-nil) after validating it; a bad port prints the range message."];

// Optionally run FILE against the fresh image first (the listener then attaches
// to its state), then load the networking + REPL modules and block in accept().
// Loads resolve through the modules dir, so --listen works from any cwd now.
[Reflect defineMethod: #listenGo:file: on: Cli as: [:self :port :file |
  let fst := [[file isNil] ifTrue: [| 0] ifFalse: [| [self runFile: file]]];
  [[fst = 0]
    ifTrue:  [| [self serveRepl: port]]
    ifFalse: [| 1]]] doc:
  "Runs `file` against the fresh image first when non-nil (a failure answers 1), then serves the REPL on `port`."];

[Reflect defineMethod: #serveRepl: on: Cli as: [:self :port |
  [self ensure: #socket];
  [self ensure: #repl];
  let result := [Repl serveOn: port];
  [[result isError]
    ifTrue: [| [self fail: [result printString]]]
    ifFalse: [| [self status]]]] doc:
  "Loads the socket + repl modules, then blocks in [Repl serveOn: port]; answers the compile status."];

// Evaluate a birnam source file against the live image, reporting a compile
// error the way the script runner does (status 1; the driver exits with it).
[Reflect defineMethod: #runFile: on: Cli as: [:self :path |
  let src := [System readFile: path];
  [[src isError]
    ifTrue:  [| [self fail: ["birnam: could not read " , path]]]
    ifFalse: [| [self evalSource: src from: path]]]] doc:
  "Evaluates birnam file `path` against the live image; an unreadable file answers status 1."];

[Reflect defineMethod: #evalSource:from: on: Cli as: [:self :src :path |
  [Codegen evalPersisting: src];
  let e := [Codegen lastError];
  [[e isNil]
    ifTrue:  [| 0]
    ifFalse: [| [self fail: [[["birnam: compile error in " , path] , ":\n"] , e]]]]] doc:
  "Evaluates `src` via [Codegen evalPersisting:]; a compile error is reported naming `path` (status 1), else 0."];

// -- init: `birnam init` ---------------------------------------------------------

// The starter birnam.toml: the recognised keys, commented out, with the
// [Config at:] read surface documented inline — a new project's config is
// self-describing without opening modules/config.birnam.
[Reflect defineMethod: #initTemplate on: Cli as: [:self |
"# birnam.toml — project configuration, discovered from cwd upward.
#
# Every key here is also readable from code: [Config at: \"key\"] answers
# the value, or nil when the file or key is absent — nothing is required,
# and a project without a birnam.toml just works.

# Compiled modules to load dependency-first before the entry point.
# load = [\"my_module\"]

# Source modules indexed by `birnam check`; omitted means [\"src\"].
# source_roots = [\"src\"]

# Standalone source projects. Path dependencies resolve relative to this
# manifest. Git dependencies require a full 40- or 64-digit commit id and an
# explicit `birnam fetch`; check/build/run/test/LSP never fetch implicitly.
# [dependencies]
# http = { path = \"../birnam-http\" }
# twin = { git = \"https://github.com/chazu/birnam-alien-twin.git\", rev = \"0123456789abcdef0123456789abcdef01234567\" }

# C-library wrappers: each build entry is an argv array; {output} is the
# required staged dylib path. The wrapper source should be under source_roots.
# [[wrapped]]
# name = \"foo\"
# build = [[\"cc\", \"-dynamiclib\", \"native/foo.c\", \"-o\", \"{output}\"]]

# The project-root-relative entry point. A bare `birnam` run anywhere under
# this project validates/loads the latest build, evaluates it after `load`,
# then drops into the REPL. `birnam install` copies that build into the
# runtime library directory for use outside the project tree.
# main = \"main.birnam\"

# birnam run evaluates main once and exits unless a REPL is selected.
# [run]
# repl = \"none\"                 # none, tty, or socket
# socket_bind = \"127.0.0.1\"    # used when repl = \"socket\"
# socket_port = 4400            # used when repl = \"socket\"

# Project tests run in fresh processes against a selected debug/release build.
# Omit this table to discover every .birnam source below test/ and tests/.
# [test]
# sources = [\"tests/app-test.birnam\"]
"] doc:
  "The birnam.toml contents `birnam init` writes — recognised keys commented out, usage documented inline."];

// Refuse-to-overwrite is the whole safety story: an existing config (readable
// at PATH) is never touched, so `init` is safe to run in any directory.
[Reflect defineMethod: #initAt: on: Cli as: [:self :path |
  [[[System readFile: path] isError]
    ifTrue:  [|
      let w := [System writeFile: path contents: [self initTemplate]];
      [[w isError]
        ifTrue:  [| [self fail: ["birnam init: could not write " , path]]]
        ifFalse: [| [self say: ["wrote " , path]]]]]
    ifFalse: [| [self fail: ["birnam init: " , [path , " already exists — not overwriting"]]]]]] doc:
  "`birnam init` — write the starter birnam.toml to PATH unless one already exists. Answers the process status."];

// -- wrap: `birnam wrap <name>` ----------------------------------------------------

// The scaffold body. %N% = the library name as typed (folder/file/dylib), %C% =
// the capitalized module name bound in Globals (the Config/Toml singleton
// convention). Substituted by wrapTemplate: below.
[Reflect defineMethod: #wrapTemplateRaw on: Cli as: [:self |
"// %N% — a C library wrapped for birnam through Alien.
//
// SCAFFOLD generated by `birnam wrap %N%`. A starting point: edit the wrap
// below to match %N%'s real functions, add more, then run it once the dylib
// is built:
//
//   birnam build   (after adding this file to a project's source_roots)
//
// Add a matching `[[wrapped]]` entry to birnam.toml. Its build argv uses
// `{output}` for the dylib path; birnam stages the result beside the compiled
// wrapper and resolves this logical name at project run time.
//
// SIGNATURES are strings: the FIRST type is the return, the rest are the
// arguments (whitespace ignored) — i=int l=long u=ulong d=double f=float
// s=cstring p=pointer v=void, and {ll}=a struct by value (fields ↔ a Vector).
// The RECEIVER is the first C argument, so a K-argument C function becomes a
// method of arity K-1; a no-argument C function is just sent to the module.

// 1. Load the staged shared library so its symbols become resolvable by `wrap:`.
[Module named: #%N% requires: #[]];
[Alien dlopen: \"lib%N%.dylib\"];

// 2. The module: a named singleton bound in Globals to hang the wrapped
//    methods on (the same shape as the self-hosted Config / Toml modules).
[Globals at: #%C% put: [Object clone]];

// 3. Wrap a function as a method on the module. Replace this example with a
//    real one from %N%. Here: `int %N%_version(void)` → `[%C% version]`.
[Alien wrap: \"%N%_version\" signature: \"i\" as: #version on: %C%]

// Add more wraps following the same pattern, e.g. a one-argument call:
//   [Alien wrap: \"%N%_do\" signature: \"i i\" as: #do: on: %C%]
// then `[%C% do: 5]` calls `%N%_do(5)`.
"] doc:
  "The raw wrap scaffold source — %N% = the library name as typed, %C% = the capitalized Globals binding."];

// The template with %N%/%C% substituted for NAME (Config/Toml capitalization).
[Reflect defineMethod: #wrapTemplate: on: Cli as: [:self :name |
  let cap := [[[name copyFrom: 0 to: 1] asUppercase] , [name copyFrom: 1 to: [name size]]];
  [[[self wrapTemplateRaw] replace: "%N%" with: name] replace: "%C%" with: cap]] doc:
  "The wrap scaffold with %N%/%C% substituted for `name` (Config/Toml capitalization)."];

[Reflect defineMethod: #wrap: on: Cli as: [:self :args |
  let name := [args at: 1 ifAbsent: [| nil]];
  [[[name isNil] | [[name size] = 0]]
    ifTrue:  [| [self say: "usage: birnam wrap <name>   scaffold wrapped/<name>/<name>.birnam"]]
    ifFalse: [| [self wrapLib: name into: "wrapped"]]]] doc:
  "`birnam wrap <name>` — scaffold wrapped/<name>/<name>.birnam, a barebones Alien-based wrapper to edit."];

// Never clobber an existing wrapper — the author's edits win (a benign no-op,
// status 0, matching the old scaffolder). BASE is a parameter so tests can
// scaffold outside the repo's real wrapped/ tree.
[Reflect defineMethod: #wrapLib:into: on: Cli as: [:self :name :base |
  [self ensure: #file];
  let dir  := [[base , "/"] , name];
  let path := [[[dir , "/"] , name] , ".birnam"];
  [[File exists: path]
    ifTrue:  [| [self say: [["birnam wrap: " , path] , " already exists — leaving it untouched"]]]
    ifFalse: [|
      [File makeDir: base];
      [File makeDir: dir];
      let w := [System writeFile: path contents: [self wrapTemplate: name]];
      [[w isError]
        ifTrue:  [| [self fail: ["birnam wrap: could not write " , path]]]
        ifFalse: [| [self say: [[[[["[wrap] scaffolded " , path] , "
        edit the wraps, build lib"] , name] , ".dylib, then: birnam "] , path]]]]]]] doc:
  "Scaffold `base`/`name`/`name`.birnam; an existing file is never clobbered (status 0), a write failure answers 1."];

// -- the dispatcher --------------------------------------------------------------

[Reflect defineMethod: #run:rustWorkspace:guides: on: Cli as: [:self :args :rwork :gdir |
  let cmd := [args at: 0 ifAbsent: [| ""]];
  [[cmd = "doc"] ifTrue: [| [self doc: args]] ifFalse: [|
    [[cmd = "docgen"] ifTrue: [| [self docgen: args rustWorkspace: rwork guides: gdir]] ifFalse: [|
      [[cmd = "init"] ifTrue: [| [self initAt: "birnam.toml"]] ifFalse: [|
        [[cmd = "wrap"] ifTrue: [| [self wrap: args]] ifFalse: [|
          [[cmd = "--lsp"] ifTrue: [| [self lsp: args]] ifFalse: [|
            [[[cmd = "--listen"] | [cmd = "--serve"]]
              ifTrue:  [| [self listen: args]]
              ifFalse: [| [self fail: ["birnam: unknown subcommand: " , cmd]]]]]]]]]]]]]]] doc:
  "Dispatch one CLI invocation using compiled modules plus the Rust workspace and guide resource directories. Answers status 0 or 1."];
