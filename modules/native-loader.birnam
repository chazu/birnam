// Language loading policy over Bootstrap's Oop status/result record.
[Module named: #nativeLoader requires: #[]];
[Globals at: #NativeLoader put: [Object clone]];
let loaderNamespace := Namespace;
let loaderStringVt := StringVt;
[Reflect defineMethod: #error:message: on: NativeLoader as: [:self :kind :message |
  let factory := [loaderNamespace valueAt: #Error];
  [[factory isNil] ifTrue: [| nil] ifFalse: [| [factory kind: kind message: message]]]
]];
[Reflect defineMethod: #finish:for: on: NativeLoader as: [:self :result :receiver |
  let status := [result at: 0];
  [[status == #loaded] ifTrue: [|
    [[[result size] = 1] ifTrue: [| receiver] ifFalse: [| [result at: 1]]]
  ] ifFalse: [|
    [[status == #mappingFailed] ifTrue: [| [self error: #ioError message: "could not load module dylib"]] ifFalse: [|
      [[status == #incompatibleModule] ifTrue: [| [self error: #notAModule message: "missing or incompatible Oop native module declaration"]] ifFalse: [|
        [self error: #moduleError message: "native module initialization failed"]
      ]]
    ]]
  ]]
]];
[Reflect defineMethod: #arguments:count: on: NativeLoader as: [:self :sequence :count |
  let state := [ObjectModel newSlots: #[[Vector new]] parent: ObjectVt];
  [0 to: [count - 1] do: [:i |
    [ObjectModel slot: 0 in: state put: [[ObjectModel slot: 0 in: state] add: [sequence at: i]]]; nil
  ]]; [ObjectModel slot: 0 in: state]
]];
[Reflect defineMethod: #load:arguments:for: on: NativeLoader as: [:self :path :sequence :receiver |
  [[[[Reflect vtableOf: path] == loaderStringVt] not] ifTrue: [| nil] ifFalse: [|
    let snapshot := [Bytes fromBytes: [path bytes]];
    let length := [Integer integerValue: [sequence size]];
    [[length isNil] ifTrue: [| [self error: #typeError message: "module arguments need an Integer size"]] ifFalse: [|
      [[length < 0] ifTrue: [| [self error: #typeError message: "module argument count must be nonnegative"]] ifFalse: [|
        let arguments := [self arguments: sequence count: length];
        [self finish: [Bootstrap loadResultAt: snapshot arguments: arguments] for: receiver]
      ]]
    ]]
  ]]
]];
[Reflect defineMethod: #loadModule: on: System as: [:self :path |
  [NativeLoader load: path arguments: #[] for: self]
]];
[Reflect defineMethod: #loadModule:arguments: on: System as: [:self :path :arguments |
  [NativeLoader load: path arguments: arguments for: self]
]];
[Module markLoaded: #nativeLoader];
