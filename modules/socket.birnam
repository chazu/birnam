// socket.birnam — TCP sockets for birnam, implemented IN birnam over libc via Alien.
//
// The Layer-0 networking floor. Same principle as time/file/process: the only
// irreducible capability is "call a C function and read/write raw memory," and
// Alien already provides both (FFI + alloc:/peek*At:/poke*:at:) — so this is pure
// birnam with NO new native code. Everything above it (an HTTP server, an out-of-process
// REPL) rides on this floor.
//
// Load it (from the repo root) with:
//   [Module load: #socket]
// then, the blocking one-connection-at-a-time server:
//   [Socket serve: 8080 with: [:conn |
//     let req := [conn recv];                      "the raw request bytes (a String)"
//     [conn sendString: "HTTP/1.1 200 OK\r\n\r\nhi"]]]
//
// DESIGN NOTES (concurrency-readiness — see the session's networking plan):
//  - The RAW libc wraps below are semantics-free and blocking-agnostic. The
//    BLOCKING accept-loop (`serve:with:`) is a separate helper; a future single-
//    threaded poll() reactor reuses the raw ops but not the loop. "Blocking" is
//    never baked into the primitives.
//  - `fcntl` is wrapped (and `SockConn setNonBlocking` exposed) but UNUSED by the
//    blocking path — it is the switch the reactor will need.
//  - Per-connection state (fd + recv buffer) lives on a `SockConn` object via
//    cells, not in a shared module singleton, so N concurrent connections slot in
//    without a rewrite.
//  - SIGPIPE is ignored process-wide at load (see `ignoreSigpipe`): a write to a
//    peer that hung up would otherwise kill the process — this bites even the
//    blocking server, on the very first dropped connection.
//
// PLATFORM: constants below are macOS (arm64) values — the only tested target
// today. Linux differs (SOL_SOCKET=1, SO_REUSEADDR=2, O_NONBLOCK=0x800, and the
// sockaddr_in has no sin_len byte); those are the lines to touch for a Linux port.
// TEXT ONLY: send marshals the String as a C string, so a body with an embedded
// NUL byte would truncate — fine for HTTP text/markdown/source; binary bodies are
// a later concern (send from a raw buffer instead).

// -- raw libc wraps (the floor) -----------------------------------------------
// Alien marshals the method receiver as the FIRST C argument. Sig chars:
//   i=int  l=long/ssize_t  u=size_t  p=void*  s=const char*  v=void
//
// int socket(int domain, int type, int protocol)          — receiver = domain
[Alien wrap: "socket"     signature: "i i i i"   as: #socketType:proto:        on: Integer];
// int bind(int fd, const struct sockaddr *addr, socklen_t len)   — receiver = fd
[Alien wrap: "bind"       signature: "i i p i"   as: #bindAddr:len:            on: Integer];
// int listen(int fd, int backlog)                                — receiver = fd
[Alien wrap: "listen"     signature: "i i i"     as: #listenBacklog:           on: Integer];
// int accept(int fd, struct sockaddr *addr, socklen_t *len)      — receiver = fd
[Alien wrap: "accept"     signature: "i i p p"   as: #acceptAddr:len:          on: Integer];
// int connect(int fd, const struct sockaddr *addr, socklen_t len)— receiver = fd
[Alien wrap: "connect"    signature: "i i p i"   as: #connectAddr:len:         on: Integer];
// ssize_t recv(int fd, void *buf, size_t len, int flags)         — receiver = fd
[Alien wrap: "recv"       signature: "l i p u i" as: #recvInto:len:flags:      on: Integer];
// ssize_t send(int fd, const void *buf, size_t len, int flags)   — receiver = fd
// buf marshals as `s` (String -> const char*); send reads `len` of those bytes.
[Alien wrap: "send"       signature: "l i s u i" as: #sendStr:len:flags:       on: Integer];
// int setsockopt(int fd, int level, int name, const void *val, socklen_t len)
[Alien wrap: "setsockopt" signature: "i i i i p i" as: #setsockLevel:opt:val:len: on: Integer];
// int fcntl(int fd, int cmd, int arg)   — reactor-only (non-blocking); unused here
[Alien wrap: "fcntl"      signature: "i i i i"   as: #fcntlCmd:arg:            on: Integer];
// int close(int fd)                                              — receiver = fd
[Alien wrap: "close"      signature: "i i"       as: #closeFd                 on: Integer];
// sighandler_t signal(int sig, sighandler_t handler)   — receiver = sig
[Alien wrap: "signal"     signature: "p i p"     as: #signalHandler:          on: Integer];

// -- the module singleton + constants -----------------------------------------

[Module named: #socket requires: #[]];
[Globals at: #Socket put: [Object clone]];
[Reflect docModule: #socket is: "TCP sockets over libc via Alien (the Layer-0 networking floor)."];

// macOS values (see PLATFORM note above).
[Reflect defineMethod: #afInet      on: Socket as: [:self | 2] doc:
  "The AF_INET address-family constant (IPv4) for the libc socket calls."];
[Reflect defineMethod: #sockStream  on: Socket as: [:self | 1] doc:
  "The SOCK_STREAM type constant (TCP) for the libc socket calls."];
[Reflect defineMethod: #solSocket   on: Socket as: [:self | 65535] doc:
  "The SOL_SOCKET level constant (macOS value) for setsockopt."];
[Reflect defineMethod: #soReuseAddr on: Socket as: [:self | 4] doc:
  "The SO_REUSEADDR option constant (macOS value 4)."];

// Ignore SIGPIPE process-wide. SIG_IGN is (void*)1 — pointer arguments require a
// ForeignAddress, so build one via an owned buffer: write 1, then read it as a pointer.
[Reflect defineMethod: #ignoreSigpipe on: Socket as: [:self |
  let h := [Alien alloc: 8];
  [h pokeInt: 1 at: 0];
  [13 signalHandler: [h peekPtrAt: 0]];
  [h free]] doc:
  "Ignore SIGPIPE process-wide (installs SIG_IGN), so a write to a hung-up peer cannot kill the process."];

// Parse a dotted IPv4 address, plus the convenient localhost spelling, into
// four bytes. `nil` means the bind address is not a supported IPv4 literal.
[Reflect defineMethod: #ipv4Bytes: on: Socket as: [:self :bind |
  [[bind = "localhost"]
    ifTrue: [| #[127 0 0 1]]
    ifFalse: [|
      let parts := [bind split: "."];
      let bytes := [parts collect: [:part | [part asInteger]]];
      let valid := [[[bytes size] = 4]
        ifTrue: [| [bytes allSatisfy: [:byte |
          [[byte isNil]
            ifTrue: [| false]
            ifFalse: [| [[byte >= 0] & [byte <= 255]]]]]]]
        ifFalse: [| false]];
      [valid ifTrue: [| bytes] ifFalse: [| nil]]]]] doc:
  "Parse `localhost` or a dotted IPv4 literal into four bytes, or answer nil."];

// Build a 16-byte `struct sockaddr_in` for address:port (macOS layout).
// byte 0 = sin_len (16), byte 1 = sin_family (AF_INET=2), bytes 2..3 = port in
// network (big-endian) order, bytes 4..7 = IPv4 address, bytes 8..15 = zero.
[Reflect defineMethod: #makeSockaddrPort:bind: on: Socket as: [:self :port :bind |
  let ip := [self ipv4Bytes: bind];
  [[ip isNil]
    ifTrue: [| nil]
    ifFalse: [|
      let sa := [Alien alloc: 16];
      [sa pokeByte: 16 at: 0];
      [sa pokeByte: [self afInet] at: 1];
      [sa pokeByte: [port / 256] at: 2];
      [sa pokeByte: [port mod: 256] at: 3];
      [0 to: 3 do: [:i | [sa pokeByte: [ip at: i] at: [i + 4]]]];
      sa]]] doc:
  "A sockaddr_in for a dotted IPv4/localhost bind address and port, or nil for an invalid address; the caller frees it."];

[Reflect defineMethod: #makeSockaddrPort: on: Socket as: [:self :port |
  [self makeSockaddrPort: port bind: "0.0.0.0"]] doc:
  "A sockaddr_in for INADDR_ANY:port; the caller frees it."];

// Create + bind + listen on `port` and `bind`. Answers the listening fd, or a
// negative fd on error (invalid address, socket(), or bind() failure).
[Reflect defineMethod: #listenOn:bind: on: Socket as: [:self :port :bind |
  let fd := [[self afInet] socketType: [self sockStream] proto: 0];
  [[fd < 0]
    ifTrue:  [| fd]
    ifFalse: [|
      let one := [Alien alloc: 4];
      [one pokeInt: 1 at: 0];
      [fd setsockLevel: [self solSocket] opt: [self soReuseAddr] val: one len: 4];
      [one free];
      let sa := [self makeSockaddrPort: port bind: bind];
      [[sa isNil]
        ifTrue: [| [fd closeFd]; -2]
        ifFalse: [|
          let br := [fd bindAddr: sa len: 16];
          [sa free];
          [[br < 0]
            ifTrue:  [| [fd closeFd]; br]
            ifFalse: [| [fd listenBacklog: 16]; fd]]]]]]] doc:
  "Create + bind + listen on `port` and IPv4 `bind`; answers a listening fd or a negative error code."];

[Reflect defineMethod: #listenOn: on: Socket as: [:self :port |
  [self listenOn: port bind: "0.0.0.0"]] doc:
  "Create + bind + listen on `port` on all IPv4 interfaces."];

// Block until a client connects; answer the raw connection fd (negative on a
// spurious error such as EINTR, which the caller skips).
[Reflect defineMethod: #rawAccept: on: Socket as: [:self :serverFd |
  let addr := [Alien alloc: 16];
  let alen := [Alien alloc: 8];
  [alen pokeInt: 16 at: 0];
  let cfd := [serverFd acceptAddr: addr len: alen];
  [addr free];
  [alen free];
  cfd] doc:
  "Block until a client connects on `serverFd`; answers the raw connection fd (negative on a spurious error such as EINTR)."];

// Wrap a connected fd in a SockConn, minting its per-connection recv buffer.
[Reflect defineMethod: #wrapFd: on: Socket as: [:self :cfd |
  let conn := [SockConn clone];
  [[db cellFor: conn attr: #fd]  set: cfd];
  [[db cellFor: conn attr: #buf] set: [Alien alloc: 65536]];
  conn] doc:
  "Wrap connected fd `cfd` in a SockConn, minting its 64 KB per-connection recv buffer."];

[Reflect defineMethod: #connectTo:port: on: Socket as: [:self :host :port |
  let fd := [[self afInet] socketType: [self sockStream] proto: 0];
  [[fd < 0]
    ifTrue: [| fd]
    ifFalse: [|
      let address := [self makeSockaddrPort: port bind: host];
      [[address isNil]
        ifTrue: [| [fd closeFd]; -2]
        ifFalse: [|
          let connected := [fd connectAddr: address len: 16];
          [address free];
          [[connected < 0]
            ifTrue: [| [fd closeFd]; connected]
            ifFalse: [| [self wrapFd: fd]]]]]]]
  ] doc:
  "Connect to a dotted IPv4/localhost TCP endpoint and answer a SockConn or negative error code." ];

// -- Layer 1: the blocking accept loop ----------------------------------------
// One connection at a time: accept, hand a live SockConn to `handler`, close, repeat.
// `to:do:` is a native (iterative) loop, so this does not grow the stack per
// connection; the billion-iteration bound is effectively unbounded and exits cleanly.
[Reflect defineMethod: #serve:with: on: Socket as: [:self :port :handler |
  [self serve: port bind: "0.0.0.0" with: handler]] doc:
  "Listen on `port` on all IPv4 interfaces, then serve connections one at a time."];

[Reflect defineMethod: #serve:bind:with: on: Socket as: [:self :port :bind :handler |
  let fd := [self listenOn: port bind: bind];
  [[fd < 0]
    ifTrue:  [| fd]
    ifFalse: [|
      [1 to: 1000000000 do: [:i |
        let cfd := [self rawAccept: fd];
        [[cfd < 0]
          ifTrue:  [| 0]
          ifFalse: [|
            let conn := [self wrapFd: cfd];
            [handler value: conn];
            [conn close]]];
        // to:do: stops-and-propagates on a body error; one connection's fault
        // (handler or close) must not stop the accept loop — swallow it here.
        0]];
      [fd closeFd]]]] doc:
  "Listen on IPv4 `bind` and `port`, then accept connections one at a time, handing each live SockConn to `handler`; blocks and answers a negative fd if it could not listen."];

// -- SockConn: one live connection --------------------------------------------

[Globals at: #SockConn put: [Object clone]];

[Reflect defineMethod: #fd     on: SockConn as: [:self | [[db cellFor: self attr: #fd] value]] doc:
  "The connection's file descriptor (an Integer), read from its state cell."];
[Reflect defineMethod: #buffer on: SockConn as: [:self | [[db cellFor: self attr: #buf] value]] doc:
  "Answers the connection's per-connection recv buffer (an Alien)."];

// Read one chunk of up to 64 KB. Answers the bytes as a String ("" on EOF/error).
// The bytes are NUL-terminated in the buffer before reading them back, so this is
// text-safe (an embedded NUL would truncate — see the TEXT ONLY note).
[Reflect defineMethod: #recv on: SockConn as: [:self |
  let buf := [self buffer];
  let n := [[self fd] recvInto: buf len: 65535 flags: 0];
  [[n < 1]
    ifTrue:  [| ""]
    ifFalse: [|
      [buf pokeByte: 0 at: n];
      [buf peekStringAt: 0]]]] doc:
  "Read up to 64 KB; answers the bytes as a String (\"\" on EOF/error). Text-safe (an embedded NUL truncates)."];

// Send the whole String, iterating over partial writes.
[Reflect defineMethod: #sendString: on: SockConn as: [:self :s |
  let remaining := [s asCell];
  let total := [0 asCell];
  let failed := [nil asCell];
  [[| [[[[remaining value] isEmpty] not] & [[failed value] isNil]]] whileTrue: [|
    let part := [remaining value];
    let sent := [[self fd] sendStr: part len: [part size] flags: 0];
    [[sent < 1]
      ifTrue: [| [failed set: sent]]
      ifFalse: [|
        [total set: [[total value] + sent]];
        [remaining set: [part copyFrom: sent to: [part size]]]]]]];
  [[[failed value] isNil] ifTrue: [| [total value]] ifFalse: [| [failed value]]]
  ] doc:
  "Send the whole String `s`, looping over any partial writes."];

// Free the recv buffer (libc malloc, not GC'd) and close the fd.
[Reflect defineMethod: #close on: SockConn as: [:self |
  [[self buffer] free];
  [[self fd] closeFd]] doc:
  "Free the recv buffer and close the connection's fd."];

// Reactor stub (Layer 3 will use this; the blocking path does not).
// macOS: F_SETFL = 4, O_NONBLOCK = 4. A real reactor should F_GETFL first and OR
// the bit in — bitwise-or isn't in the Integer surface yet, so this sets the flags
// to exactly O_NONBLOCK.
[Reflect defineMethod: #setNonBlocking on: SockConn as: [:self |
  [[self fd] fcntlCmd: 4 arg: 4]] doc:
  "Set the connection fd non-blocking (reactor stub; the blocking path doesn't use it)."];

// Arm the SIGPIPE guard as the last step of loading. The side effect itself may
// answer nil, so finish with the module object: Codegen load: uses nil to signal
// an artifact-load failure.
[Socket ignoreSigpipe];
Socket
