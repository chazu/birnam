// Public pure-Birnam policy surface over the native candidate mechanism.

[[Globals includes: #TestSuite] ifTrue: [| nil] ifFalse: [| [System load: "modules/test.birnam"]]];

let s := [TestSuite named: "CompiledUnit" module: #compiledUnit];

// The script harness has no host prompt boundary, so install the two fixture
// modules into the boot source stage and seal G0 explicitly before exercising
// successor generations.
let cuPolicyBaseline := "[Module named: #cuPolicy requires: #[]]; [Reflect defineMethod: #cuPolicyReplace on: Integer as: [:self | 11]]; [Reflect defineMethod: #cuPolicyRemove on: Integer as: [:self | 22]]";
let cuChainBaseline := "[Module named: #cuChain requires: #[]]; [Reflect defineMethod: #cuInherited on: Integer as: [:self | 7]]; [Reflect defineMethod: #cuOverlay on: Integer as: [:self | 8]]";
let cuGcBaseline := "[Module named: #cuGc requires: #[]]; [Reflect defineMethod: #cuGcRootProbe on: Integer as: [:self | 9]]";
let livePolicyBaseline := "// exact baseline comment\n[Module named: #livePolicy requires: #[]]; [Reflect defineMethod: #liveReplace on: Integer as: [:self | 10]]; [Reflect defineMethod: #liveRemove on: Integer as: [:self | 20]]";
[Codegen recordModuleSource: cuPolicyBaseline named: #cuPolicy];
[Codegen recordModuleSource: cuChainBaseline named: #cuChain];
[Codegen recordModuleSource: cuGcBaseline named: #cuGc];
[Codegen recordModuleSource: livePolicyBaseline named: #livePolicy];
[DispatchGeneration initializeCurrent];

[s test: "inspect and map are inert; activation and rollback are exact" do: [:t |
  [Reflect defineMethod: #cuPolicyReplace on: Integer as: [:self | 11]];
  [Reflect defineMethod: #cuPolicyRemove on: Integer as: [:self | 22]];
  let source := "[Module named: #cuPolicy requires: #[]]; [Reflect defineMethod: #cuPolicyReplace on: Integer as: [:self | 111]]; [Reflect defineMethod: #cuPolicyAdd on: Integer as: [:self | 222]]; [Reflect removeMethod: #cuPolicyRemove on: Integer]";
  let path := "/tmp/birnam-compiled-unit-test.dylib";
  let compiled := [CompiledUnit compile: source named: #cuPolicy output: path];
  [t expect: [compiled isError] equals: false describes: "candidate compiler accepted the safe subset"];
  let unit := [CompiledUnit open: path];
  [t expect: [unit state] equals: #candidate describes: "open reflects a candidate"];
  [t expect: [3 cuPolicyReplace] equals: 11 describes: "inspection did not replace dispatch"];
  [t expect: [3 cuPolicyRemove] equals: 22 describes: "inspection did not remove dispatch"];
  [unit map];
  [t expect: [3 cuPolicyReplace] equals: 11 describes: "mapping remains inert"];
  [t expect: [[System readFile: path] isError] equals: false describes: "mapping preserves caller-owned artifacts"];
  [[unit activate] fulfill];
  [t expect: [unit state] equals: #active describes: "activation publishes state"];
  [t expect: [CompiledUnit activeFor: #cuPolicy] equals: unit describes: "activation publishes the active generation"];
  let activatedEvent := [db currentValue: unit attr: #activationEvent];
  [t expect: [db currentValue: activatedEvent attr: #action] equals: #activate describes: "native activation commit publishes its event"];
  [t expect: [3 cuPolicyReplace] equals: 111 describes: "replacement activated"];
  [t expect: [3 cuPolicyAdd] equals: 222 describes: "addition activated"];
  [t expect: [[3 cuPolicyRemove] isError] equals: true describes: "explicit removal activated"];
  [[unit rollback] fulfill];
  [t expect: [unit state] equals: #rolledBack describes: "rollback publishes state"];
  [t expect: [[CompiledUnit activeFor: #cuPolicy] isNil] equals: true describes: "first-generation rollback clears the active generation"];
  let rollbackEvent := [db currentValue: unit attr: #activationEvent];
  [t expect: [db currentValue: rollbackEvent attr: #action] equals: #rollback describes: "native rollback commit publishes its event"];
  [t expect: [3 cuPolicyReplace] equals: 11 describes: "replacement restored"];
  [t expect: [3 cuPolicyRemove] equals: 22 describes: "removal restored"];
  [t expect: [[3 cuPolicyAdd] isError] equals: true describes: "addition exactly removed"];
  [t expect: [[unit rollback] fulfill] equals: unit describes: "repeated rollback is an idempotent no-op"]]];

[s test: "missing dependencies keep mapping and dispatch inert" do: [:t |
  [Reflect defineMethod: #cuDependencyGuard on: Integer as: [:self | 31]];
  let source := "[Module named: #cuMissing requires: #[#cuDefinitelyMissing]]; [Reflect defineMethod: #cuDependencyGuard on: Integer as: [:self | 310]]";
  [CompiledUnit compile: source named: #cuMissing output: "/tmp/birnam-compiled-unit-missing.dylib"];
  let unit := [CompiledUnit open: "/tmp/birnam-compiled-unit-missing.dylib"];
  [t expect: [[unit missingDependencies] size] equals: 1 describes: "inspection reports the unresolved dependency"];
  let mapped := [unit map];
  [t expect: [mapped isError] equals: true describes: "mapping rejects unresolved dependencies"];
  [t expect: [mapped kind] equals: #dependenciesMissing describes: "dependency rejection is kinded"];
  [t expect: [3 cuDependencyGuard] equals: 31 describes: "dependency rejection leaves dispatch unchanged"];
  [t expect: [unit state] equals: #candidate describes: "dependency rejection leaves lifecycle unchanged"]]];

[s test: "prepared generation plans remain rooted across collection" do: [:t |
  [Reflect defineMethod: #cuGcRootProbe on: Integer as: [:self | 9]];
  let source := "[Module named: #cuGc requires: #[]]; [Reflect defineMethod: #cuGcRootProbe on: Integer as: [:self | 99]]";
  let path := "/tmp/birnam-compiled-unit-gc.dylib";
  [CompiledUnit compile: source named: #cuGc output: path];
  let unit := [CompiledUnit open: path];
  [unit map];
  let token := [[|
    let current := [DispatchGeneration current];
    let projection := [Codegen successorGenerationProjection: [current sourceMap]
      replacing: #cuGc with: [unit sourceRevision] unit: unit];
    let successor := [DispatchGeneration fromProjection: projection predecessor: current delta: unit];
    [Codegen prepareActivation: unit plan:
      [unit publicationPlan: #activate prior: [current unitFor: #cuGc]
        expected: current successor: successor]]
    ] value];
  [t expect: [token isError] equals: false describes: "activation preparation succeeds"];
  [System gc];
  let committed := [Codegen commitPrepared: token];
  [t expect: [committed isError] equals: false describes: "generation survives collection"];
  [t expect: [3 cuGcRootProbe] equals: 99 describes: "rooted successor publishes dispatch"]]];

[s test: "supersession inherits untouched managed bindings" do: [:t |
  [Reflect defineMethod: #cuInherited on: Integer as: [:self | 7]];
  [Reflect defineMethod: #cuOverlay on: Integer as: [:self | 8]];

  let firstSource := "[Module named: #cuChain requires: #[]]; [Reflect defineMethod: #cuInherited on: Integer as: [:self | 70]]";
  [CompiledUnit compile: firstSource named: #cuChain output: "/tmp/birnam-compiled-unit-chain-1.dylib"];
  let first := [CompiledUnit open: "/tmp/birnam-compiled-unit-chain-1.dylib"];
  [first map];
  [[first activate] fulfill];

  let secondSource := "[Module named: #cuChain requires: #[]]; [Reflect defineMethod: #cuOverlay on: Integer as: [:self | 80]]";
  [CompiledUnit compile: secondSource named: #cuChain output: "/tmp/birnam-compiled-unit-chain-2.dylib"];
  let second := [CompiledUnit open: "/tmp/birnam-compiled-unit-chain-2.dylib"];
  [second map];
  [[second activate] fulfill];
  [t expect: [first state] equals: #superseded describes: "native commit supersedes the prior generation"];
  [t expect: [second state] equals: #active describes: "native commit activates the successor"];
  [t expect: [3 cuInherited] equals: 70 describes: "successor inherits an untouched predecessor binding"];
  [t expect: [3 cuOverlay] equals: 80 describes: "successor overlays its own binding"];

  [[second rollback] fulfill];
  [t expect: [CompiledUnit activeFor: #cuChain] equals: first describes: "rollback atomically republishes the predecessor"];
  [t expect: [first state] equals: #active describes: "rollback restores predecessor state"];
  [t expect: [3 cuInherited] equals: 70 describes: "rollback retains predecessor behavior"];
  [t expect: [3 cuOverlay] equals: 8 describes: "rollback restores the successor's touched binding"];

  [CompiledUnit compile: secondSource named: #cuChain output: "/tmp/birnam-compiled-unit-chain-3.dylib"];
  let third := [CompiledUnit open: "/tmp/birnam-compiled-unit-chain-3.dylib"];
  [third map];
  [[third activate] fulfill];
  [Reflect defineMethod: #cuInherited on: Integer as: [:self | 700]];
  let rejected := [[third rollback] fulfill];
  [t expect: [rejected isError] equals: true describes: "rollback rejects drift in an inherited untouched binding"];
  [t expect: [third state] equals: #drifted describes: "inherited drift marks the active successor"];
  [t expect: [3 cuInherited] equals: 700 describes: "rejected rollback does not clobber the ordinary edit"];
  [t expect: [3 cuOverlay] equals: 80 describes: "rejected rollback performs no partial inverse"]]]
