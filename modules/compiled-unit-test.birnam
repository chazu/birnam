// Public pure-Birnam policy surface over the native candidate mechanism.

[[Globals includes: #TestSuite] ifTrue: [| nil] ifFalse: [| [System load: "modules/test.birnam"]]];

let s := [TestSuite named: "CompiledUnit" module: #compiledUnit];

// The script harness has no host prompt boundary, so install the fixture
// modules into the boot source stage and seal G0 explicitly before exercising
// successor generations.
let cuPolicyBaseline := "[Module named: #cuPolicy requires: #[]]; [Reflect defineMethod: #cuPolicyReplace on: Integer as: [:self | 11]]; [Reflect defineMethod: #cuPolicyRemove on: Integer as: [:self | 22]]";
let cuChainBaseline := "[Module named: #cuChain requires: #[]]; [Reflect defineMethod: #cuInherited on: Integer as: [:self | 7]]; [Reflect defineMethod: #cuOverlay on: Integer as: [:self | 8]]";
let cuGcBaseline := "[Module named: #cuGc requires: #[]]; [Reflect defineMethod: #cuGcRootProbe on: Integer as: [:self | 9]]";
let cuDiscardMethodlessBaseline := "[Module named: #cuDiscardMethodless requires: #[]]; [Reflect defineMethod: #cuDiscardMethodless on: Integer as: [:self | 6]]";
let cuDiscardPinnedBaseline := "[Module named: #cuDiscardPinned requires: #[]]; [Reflect defineMethod: #cuDiscardPinned on: Integer as: [:self | 5]]";
let cuUnmappedBaseline := "[Module named: #cuUnmapped requires: #[]]; [Reflect defineMethod: #cuUnmapped on: Integer as: [:self | 4]]";
let cuDefinitelyMissingBaseline := "[Module named: #cuDefinitelyMissing requires: #[]]";
let cuMissingBaseline := "[Module named: #cuMissing requires: #[#cuDefinitelyMissing]]; [Reflect defineMethod: #cuDependencyGuard on: Integer as: [:self | 31]]";
let stacklessImageBaseline := "[Module named: #stacklessImage requires: #[]]; [Reflect defineMethod: #stacklessImageProbe on: Integer as: [:self | [self + 1]]]";
let livePolicyBaseline := "// exact baseline comment\n[Module named: #livePolicy requires: #[]]; [Reflect defineMethod: #liveReplace on: Integer as: [:self | 10]]; [Reflect defineMethod: #liveRemove on: Integer as: [:self | 20]]";
[Codegen recordModuleSource: cuPolicyBaseline named: #cuPolicy];
[Codegen recordModuleSource: cuChainBaseline named: #cuChain];
[Codegen recordModuleSource: cuGcBaseline named: #cuGc];
[Codegen recordModuleSource: cuDiscardMethodlessBaseline named: #cuDiscardMethodless];
[Codegen recordModuleSource: cuDiscardPinnedBaseline named: #cuDiscardPinned];
[Codegen recordModuleSource: cuUnmappedBaseline named: #cuUnmapped];
[Codegen recordModuleSource: cuDefinitelyMissingBaseline named: #cuDefinitelyMissing];
[Codegen recordModuleSource: cuMissingBaseline named: #cuMissing];
[Codegen recordModuleSource: stacklessImageBaseline named: #stacklessImage];
[Codegen recordModuleSource: livePolicyBaseline named: #livePolicy];
[DispatchGeneration initializeCurrent];

[s test: "inspect and map are inert; activation and rollback are exact" do: [:t |
  [Reflect defineMethod: #cuPolicyReplace on: Integer as: [:self | 11]];
  [Reflect defineMethod: #cuPolicyRemove on: Integer as: [:self | 22]];
  let source := "[Module named: #cuPolicy requires: #[]]; [Reflect defineMethod: #cuPolicyReplace on: Integer as: [:self | 111]]; [Reflect defineMethod: #cuPolicyAdd on: Integer as: [:self | 222]]; [Reflect removeMethod: #cuPolicyRemove on: Integer]";
  let path := "/tmp/birnam-compiled-unit-test.dylib";
  let compiled := [CompiledUnit compile: source named: #cuPolicy output: path];
  [t expect: [compiled isError] equals: false describes: "candidate compiler accepted the safe subset"];
  let unit := [CompiledUnit open: path];
  [t expect: [unit state] equals: #candidate describes: "open reflects a candidate"];
  [t expect: [3 cuPolicyReplace] equals: 11 describes: "inspection did not replace dispatch"];
  [t expect: [3 cuPolicyRemove] equals: 22 describes: "inspection did not remove dispatch"];
  [unit map];
  [t expect: [3 cuPolicyReplace] equals: 11 describes: "mapping remains inert"];
  [t expect: [[System readFile: path] isError] equals: false describes: "mapping preserves caller-owned artifacts"];
  let activated := [[unit activate] fulfill];
  [t expect: activated equals: unit describes: "activation answers its unit"];
  [t expect: [Codegen lastError] equals: nil describes: "activation leaves no native failure"];
  [t expect: [unit state] equals: #active describes: "activation publishes state"];
  [t expect: [CompiledUnit activeFor: #cuPolicy] equals: unit describes: "activation publishes the active generation"];
  let activatedEvent := [db currentValue: unit attr: #activationEvent];
  [t expect: [db currentValue: activatedEvent attr: #action] equals: #activate describes: "native activation commit publishes its event"];
  [t expect: [3 cuPolicyReplace] equals: 111 describes: "replacement activated"];
  [t expect: [3 cuPolicyAdd] equals: 222 describes: "addition activated"];
  [t expect: [[3 cuPolicyRemove] isError] equals: true describes: "explicit removal activated"];
  [[unit rollback] fulfill];
  [t expect: [unit state] equals: #rolledBack describes: "rollback publishes state"];
  [t expect: [[CompiledUnit activeFor: #cuPolicy] isNil] equals: true describes: "first-generation rollback clears the active generation"];
  let rollbackEvent := [db currentValue: unit attr: #activationEvent];
  [t expect: [db currentValue: rollbackEvent attr: #action] equals: #rollback describes: "native rollback commit publishes its event"];
  [t expect: [3 cuPolicyReplace] equals: 11 describes: "replacement restored"];
  [t expect: [3 cuPolicyRemove] equals: 22 describes: "removal restored"];
  [t expect: [[3 cuPolicyAdd] isError] equals: true describes: "addition exactly removed"];
  [t expect: [[unit rollback] fulfill] equals: unit describes: "repeated rollback is an idempotent no-op"]]];

[s test: "missing dependencies keep mapping and dispatch inert" do: [:t |
  [Reflect defineMethod: #cuDependencyGuard on: Integer as: [:self | 31]];
  let source := "[Module named: #cuMissing requires: #[#cuDefinitelyMissing]]; [Reflect defineMethod: #cuDependencyGuard on: Integer as: [:self | 310]]";
  let compiled := [CompiledUnit compile: source named: #cuMissing output: "/tmp/birnam-compiled-unit-missing.dylib"];
  [t expect: [compiled isError] equals: false describes: "authored but unloaded dependency permits artifact compilation"];
  [t expect: [compiled isNil] equals: false describes: "dependency-bearing compilation does not mask a native failure"];
  [t expect: [Codegen lastError] equals: nil describes: "dependency-bearing compilation leaves no native failure"];
  let unit := [CompiledUnit open: "/tmp/birnam-compiled-unit-missing.dylib"];
  [t expect: [[unit requires] size] equals: 1 describes: "inspection retains the authored dependency vector"];
  [t expect: [[unit requires] at: 0] equals: #cuDefinitelyMissing describes: "inspection retains the authored dependency identity"];
  [t expect: [[unit missingDependencies] size] equals: 1 describes: "inspection reports the unresolved dependency"];
  let mapped := [unit map];
  [t expect: [mapped isError] equals: true describes: "mapping rejects unresolved dependencies"];
  [t expect: [mapped kind] equals: #dependenciesMissing describes: "dependency rejection is kinded"];
  [t expect: [3 cuDependencyGuard] equals: 31 describes: "dependency rejection leaves dispatch unchanged"];
  [t expect: [unit state] equals: #candidate describes: "dependency rejection leaves lifecycle unchanged"]]];

[s test: "unmapped preparation failures remain explicit Errors" do: [:t |
  [Reflect defineMethod: #cuUnmapped on: Integer as: [:self | 4]];
  let path := "/tmp/birnam-compiled-unit-unmapped.dylib";
  let source := "[Module named: #cuUnmapped requires: #[]]; [Reflect defineMethod: #cuUnmapped on: Integer as: [:self | 44]]";
  [CompiledUnit compile: source named: #cuUnmapped output: path];
  let unit := [CompiledUnit open: path];
  let validated := [unit validate];
  [t expect: [validated isError] equals: true describes: "validation does not mask native nil preparation"];
  [t expect: [validated kind] equals: #candidatePreparationFailed describes: "validation reports kinded preparation failure"];
  let activated := [[unit activate] fulfill];
  [t expect: [activated isError] equals: true describes: "activation does not mask native nil preparation"];
  [t expect: [activated kind] equals: #candidatePreparationFailed describes: "activation reports kinded preparation failure"];
  [t expect: [unit state] equals: #candidate describes: "failed preparation leaves lifecycle unchanged"];
  [t expect: [3 cuUnmapped] equals: 4 describes: "failed preparation leaves dispatch unchanged"];
  [unit discard]]];

[s test: "collection-induced Store drift safely stales a prepared plan" do: [:t |
  [Reflect defineMethod: #cuGcRootProbe on: Integer as: [:self | 9]];
  let source := "[Module named: #cuGc requires: #[]]; [Reflect defineMethod: #cuGcRootProbe on: Integer as: [:self | 99]]";
  let path := "/tmp/birnam-compiled-unit-gc.dylib";
  [CompiledUnit compile: source named: #cuGc output: path];
  let unit := [CompiledUnit open: path];
  [unit map];
  let token := [[|
    let current := [DispatchGeneration current];
    let projection := [Codegen successorGenerationProjection: [current sourceMap]
      replacing: #cuGc with: [unit sourceRevision] unit: unit];
    let successor := [DispatchGeneration fromProjection: projection predecessor: current delta: unit];
    [Codegen prepareActivation: unit plan:
      [unit publicationPlan: #activate prior: [current unitFor: #cuGc]
        expected: current successor: successor]]
    ] value];
  [t expect: [token isError] equals: false describes: "activation preparation succeeds"];
  [System gc];
  let committed := [Codegen commitPrepared: token];
  [t expect: [committed isNil] equals: true describes: "collection-induced Store drift rejects the prepared token"];
  [t expect: [Codegen lastError] equals: "RustCodegen publication commit is stale" describes: "stale rejection preserves its native reason"];
  [t expect: [unit state] equals: #candidate describes: "stale rejection leaves lifecycle unchanged"];
  [t expect: [3 cuGcRootProbe] equals: 9 describes: "stale rejection leaves dispatch unchanged"]]];

[s test: "logical discard reports disposed methodless mappings" do: [:t |
  [Reflect defineMethod: #cuDiscardMethodless on: Integer as: [:self | 6]];
  let path := "/tmp/birnam-compiled-unit-discard-methodless.dylib";
  let sidecar := [path , ".candidate"];
  let source := "[Module named: #cuDiscardMethodless requires: #[]]; [Reflect removeMethod: #cuDiscardMethodless on: Integer]";
  let compiled := [CompiledUnit compile: source named: #cuDiscardMethodless output: path];
  [t expect: [compiled isError] equals: false describes: "methodless candidate compiles"];
  let unit := [CompiledUnit open: path];
  [t expect: [unit isError] equals: false describes: "methodless candidate opens"];
  let mapped := [unit map];
  [t expect: [mapped isError] equals: false describes: "methodless candidate maps"];
  [t expect: mapped equals: unit describes: "methodless mapping returns its unit"];
  let activated := [[unit activate] fulfill];
  [t expect: activated equals: unit describes: "methodless candidate activates"];
  [t expect: [Codegen lastError] equals: nil describes: "methodless activation leaves no native failure"];
  [t expect: [unit state] equals: #active describes: "methodless activation publishes state"];
  [t expect: [[3 cuDiscardMethodless] isError] equals: true describes: "probe removes rather than installs a method"];
  let rolled := [[unit rollback] fulfill];
  [t expect: rolled equals: unit describes: "methodless candidate rolls back"];
  [t expect: [3 cuDiscardMethodless] equals: 6 describes: "rollback restores the removed method"];
  [t expect: [[DiscardReceipt logical] isError] equals: false describes: "receipt prototype exposes its native accessors"];
  let retainedBefore := [Codegen retainedGenerationCount];
  let receipt := [unit discard];
  [t expect: [receipt isError] equals: false describes: "methodless discard succeeds"];
  [t expect: [Reflect vtableOf: receipt] equals: DiscardReceiptVt describes: "discard answers the canonical receipt family"];
  [t expect: [receipt generation] equals: unit describes: "receipt names the discarded generation"];
  [t expect: [receipt logical] equals: #discarded describes: "logical discard is explicit"];
  [t expect: [receipt physical] equals: #disposed describes: "methodless mapping is physically disposed"];
  [t expect: [[receipt reason] isNil] equals: true describes: "disposed mapping needs no retention reason"];
  [t expect: [unit state] equals: #discarded describes: "discard publishes lifecycle state"];
  [t expect: [[System readFile: path] isError] equals: true describes: "discard removes the author file"];
  [t expect: [[System readFile: sidecar] isError] equals: true describes: "discard removes the candidate sidecar"];
  [t expect: [Codegen retainedGenerationCount] equals: retainedBefore describes: "disposing methodless code does not grow retention telemetry"]]];

[s test: "logical discard retains mappings that installed methods" do: [:t |
  [Reflect defineMethod: #cuDiscardPinned on: Integer as: [:self | 5]];
  let path := "/tmp/birnam-compiled-unit-discard-pinned.dylib";
  let sidecar := [path , ".candidate"];
  let source := "[Module named: #cuDiscardPinned requires: #[]]; [Reflect defineMethod: #cuDiscardPinned on: Integer as: [:self | 55]]";
  [CompiledUnit compile: source named: #cuDiscardPinned output: path];
  let unit := [CompiledUnit open: path];
  [t expect: [unit isError] equals: false describes: "method-bearing candidate opens"];
  let mapped := [unit map];
  [t expect: [mapped isError] equals: false describes: "method-bearing candidate maps"];
  let activated := [[unit activate] fulfill];
  [t expect: activated equals: unit describes: "method-bearing candidate activates"];
  [t expect: [Codegen lastError] equals: nil describes: "method-bearing activation leaves no native failure"];
  [t expect: [unit state] equals: #active describes: "method-bearing activation publishes state"];
  [t expect: [3 cuDiscardPinned] equals: 55 describes: "probe generation installs its method"];
  [[unit rollback] fulfill];
  [t expect: [3 cuDiscardPinned] equals: 5 describes: "rollback restores ordinary dispatch"];
  let retainedBefore := [Codegen retainedGenerationCount];
  let bytesBefore := [Codegen retainedGenerationBytes];
  let receipt := [unit discard];
  [t expect: [receipt generation] equals: unit describes: "retained receipt names the generation"];
  [t expect: [receipt logical] equals: #discarded describes: "logical discard still completes"];
  [t expect: [receipt physical] equals: #retained describes: "installed method pins physical mapping"];
  [t expect: [receipt reason] equals: #codeGenerationPinned describes: "receipt explains conservative retention"];
  [t expect: [Codegen retainedGenerationCount] equals: [retainedBefore + 1] describes: "retained generation count advances"];
  [t expect: [[Codegen retainedGenerationBytes] > bytesBefore] equals: true describes: "retained byte telemetry advances"];
  [t expect: [[System readFile: path] isError] equals: true describes: "retention does not preserve the author file"];
  [t expect: [[System readFile: sidecar] isError] equals: true describes: "retention does not preserve the candidate sidecar"]]];

[s test: "supersession inherits untouched managed bindings" do: [:t |
  [Reflect defineMethod: #cuInherited on: Integer as: [:self | 7]];
  [Reflect defineMethod: #cuOverlay on: Integer as: [:self | 8]];

  let firstSource := "[Module named: #cuChain requires: #[]]; [Reflect defineMethod: #cuInherited on: Integer as: [:self | 70]]";
  [CompiledUnit compile: firstSource named: #cuChain output: "/tmp/birnam-compiled-unit-chain-1.dylib"];
  let first := [CompiledUnit open: "/tmp/birnam-compiled-unit-chain-1.dylib"];
  [first map];
  [[first activate] fulfill];

  let secondSource := "[Module named: #cuChain requires: #[]]; [Reflect defineMethod: #cuOverlay on: Integer as: [:self | 80]]";
  [CompiledUnit compile: secondSource named: #cuChain output: "/tmp/birnam-compiled-unit-chain-2.dylib"];
  let second := [CompiledUnit open: "/tmp/birnam-compiled-unit-chain-2.dylib"];
  [second map];
  [[second activate] fulfill];
  [t expect: [first state] equals: #superseded describes: "native commit supersedes the prior generation"];
  [t expect: [second state] equals: #active describes: "native commit activates the successor"];
  [t expect: [3 cuInherited] equals: 70 describes: "successor inherits an untouched predecessor binding"];
  [t expect: [3 cuOverlay] equals: 80 describes: "successor overlays its own binding"];

  [[second rollback] fulfill];
  [t expect: [CompiledUnit activeFor: #cuChain] equals: first describes: "rollback atomically republishes the predecessor"];
  [t expect: [first state] equals: #active describes: "rollback restores predecessor state"];
  [t expect: [3 cuInherited] equals: 70 describes: "rollback retains predecessor behavior"];
  [t expect: [3 cuOverlay] equals: 8 describes: "rollback restores the successor's touched binding"];

  [CompiledUnit compile: secondSource named: #cuChain output: "/tmp/birnam-compiled-unit-chain-3.dylib"];
  let third := [CompiledUnit open: "/tmp/birnam-compiled-unit-chain-3.dylib"];
  [third map];
  [[third activate] fulfill];
  [Reflect defineMethod: #cuInherited on: Integer as: [:self | 700]];
  let rejected := [[third rollback] fulfill];
  [t expect: [rejected isError] equals: true describes: "rollback rejects drift in an inherited untouched binding"];
  [t expect: [third state] equals: #drifted describes: "inherited drift marks the active successor"];
  [t expect: [3 cuInherited] equals: 700 describes: "rejected rollback does not clobber the ordinary edit"];
  [t expect: [3 cuOverlay] equals: 80 describes: "rejected rollback performs no partial inverse"];
  [Reflect defineMethod: #cuInherited on: Integer as: [:self | 70]];
  [[third rollback] fulfill]]];

[s test: "nonempty generation selection is reproduced into image code" do: [:t |
  let source := "[Module named: #stacklessImage requires: #[]]; [Reflect defineMethod: #stacklessImageProbe on: Integer as: [:self | [self + 2]]]";
  let revision := [Codegen sourceRevisionOf: source];
  let digest := [revision at: 6];
  let row := #[#implementationDisposition digest #methodOperation 0 #[] #namedAdapter #resumableRequired];
  let selection := #[row];
  let path := "/tmp/birnam-stackless-image-candidate.dylib";
  let compiled := [CompiledUnit compile: source named: #stacklessImage output: path selection: selection];
  [t expect: [compiled isError] equals: false describes: "selected candidate compiles"];
  [t expect: [compiled isNil] equals: false describes: "selected compilation returns its path"];
  [t expect: [Codegen lastError] equals: nil describes: "selected compilation leaves no native failure"];
  let unit := [CompiledUnit open: path];
  [t expect: [unit isError] equals: false describes: "selected candidate opens"];
  let mapped := [unit map];
  [t expect: [mapped isError] equals: false describes: "selected candidate maps"];
  [t expect: [Codegen lastError] equals: nil describes: "selected mapping leaves no native failure"];
  let activated := [[unit activate] fulfill];
  [t expect: [activated isError] equals: false describes: "selected candidate activates"];
  [t expect: [Codegen lastError] equals: nil describes: "selected activation leaves no native failure"];
  [t expect: [40 stacklessImageProbe] equals: 42 describes: "selected dispatch runs before image-code capture"];
  let imageCode := [Codegen compileImageCode: "/tmp/birnam-stackless-selected-image-code.dylib"
    manifest: "/tmp/birnam-stackless-selected-image-manifest.bin"];
  [t expect: [imageCode isNil] equals: false describes: "nonempty generation image code compiles"];
  [t expect: [Codegen lastError] equals: nil describes: "nonempty image code capture leaves no native failure"]]]
