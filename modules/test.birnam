// test.birnam — a live, Smalltalk-style test system for birnam, pure birnam.
//
// Tests are OBJECTS THAT LIVE IN THE IMAGE, not scripts you run and throw away.
// A `TestSuite` holds its cases as DEFERRED blocks, so a suite can be run any
// number of times — edit a method, re-run its suite, repeat, all in one image.
// `Test` owns an ordered registry: suites are discoverable by module or in full.
// `describeSuitesIn:` explicitly adds a snapshot to a caller-selected Store;
// ordinary registration/running creates no facts. A `Runner`
// is a separate, pluggable collaborator that decides how results are reported;
// swap it without touching a single suite.
//
// Five objects:
//   TestSuite     a named, module-tagged collection of deferred (name, block) cases
//   TestCase      a named deferred body with discoverable, mutable fields
//   Test          the registry + the run protocol (runSuite:/runTestsForModule:/…)
//   TestContext   the `t` handed to each case block: assert:/deny:/expect:, which
//                 forward the outcome to the runner (comparison lives here, once)
//   ConsoleRunner the default runner: prints ok/FAIL lines and a total; pluggable
//
// Load it (from the repo root) with:
//   [System load: "modules/test.birnam"]
//
// DEFINE (registers; runs nothing):
//   let s := [TestSuite named: "Html" module: #html];
//   [s test: "escapes ampersand" do: [:t |
//      [t expect: [Html escape: "a&b"] equals: "a&amp;b" describes: "& -> entity"]]];
//   [s test: "void element" do: [:t | [t assert: [[Html void: "br"] = "<br>"] describes: "br"]]];
//
// RUN (reflective, re-runnable, pluggable runner):
//   [Test runSuite: s withRunner: ConsoleRunner]
//   [Test runTestsForModule: #html withRunner: ConsoleRunner]
//   [Test runAllSuitesWithRunner: ConsoleRunner]      "=> returns the runner"
//   [ConsoleRunner allPassed]                         "=> gate an exit code on this"
//
// Comparison is by printString (birnam `=` only spans ints/strings), so symbols
// and booleans compare through their print names; `assert:` wants a real boolean.

[Module named: #test requires: #[#stdlib]];

// ===========================================================================
// TestContext — the `t` passed to each case block. Owns the comparison logic
// (once), forwards each outcome to the current runner via passed:/failed:detail:.
// ===========================================================================
[Globals at: #TestContext put: [ObjectModel newSlots: #[nil] parent: ObjectVt]];
[Reflect defineMethod: #slotNames on: TestContext as: [:self | #[#runner]]];
[Reflect docModule: #test is: "A live, Smalltalk-style test system — owned suites and registry, explicit fact snapshots, pluggable runner."];

[Reflect defineMethod: #runner on: TestContext as: [:self |
  [ObjectModel slot: 0 in: self]] doc:
  "Answers the runner this context reports outcomes to."];

// A fresh context bound to a runner.
[Reflect defineMethod: #for: on: TestContext as: [:self :r |
  let t := [TestContext clone];
  [ObjectModel slot: 0 in: t put: r];
  t] doc:
  "A fresh TestContext bound to runner `r`."];

// The funnel: report a pass or a failure (with detail) to the runner.
[Reflect defineMethod: #note:label:detail: on: TestContext as: [:self :ok :label :detail |
  [ok
    ifTrue:  [| [[self runner] passed: label]]
    ifFalse: [| [[self runner] failed: label detail: detail]]];
  self] doc:
  "The funnel: report `ok` as a pass or a failure of `label` (with `detail`) to the runner. Chainable."];

[Reflect defineMethod: #assert:describes: on: TestContext as: [:self :cond :label |
  [self note: [[cond printString] = "true"] label: label detail: "expected true"]] doc:
  "Pass when `cond` is the boolean true, describing the check with `label`."];

[Reflect defineMethod: #deny:describes: on: TestContext as: [:self :cond :label |
  [self note: [[cond printString] = "false"] label: label detail: "expected false"]] doc:
  "Pass when `cond` is the boolean false, describing the check with `label`."];

[Reflect defineMethod: #expect:equals:describes: on: TestContext as: [:self :got :want :label |
  let gs := [got printString];
  let ws := [want printString];
  [self note: [gs = ws] label: label detail: ["got=" , gs , " want=" , ws]]] doc:
  "Pass when `got` and `want` print alike; failure detail carries both."];

// ===========================================================================
// ConsoleRunner — the default runner. Accumulates pass/fail totals and prints.
// Any object answering reset / suiteStarted: / passed: / failed:detail: /
// suiteFinished: / summary / allPassed can stand in its place.
// ===========================================================================
[Globals at: #ConsoleRunner put: [ObjectModel newSlots: #[0 0] parent: ObjectVt]];
[Reflect defineMethod: #slotNames on: ConsoleRunner as: [:self | #[#pass #fail]]];

[Reflect defineMethod: #passedCount on: ConsoleRunner as: [:self |
  [ObjectModel slot: 0 in: self]] doc:
  "The cumulative count of passed checks."];
[Reflect defineMethod: #failedCount on: ConsoleRunner as: [:self |
  [ObjectModel slot: 1 in: self]] doc:
  "The cumulative count of failed checks."];

// Zero the cumulative totals. The run-all/run-module entry points call this;
// runSuite:withRunner: does NOT, so several suites can accumulate into one runner.
[Reflect defineMethod: #reset on: ConsoleRunner as: [:self |
  [ObjectModel slot: 0 in: self put: 0];
  [ObjectModel slot: 1 in: self put: 0];
  self] doc:
  "Zero the cumulative totals; runSuite:withRunner: does NOT call this, so several suites can accumulate into one runner."];

[Reflect defineMethod: #suiteStarted: on: ConsoleRunner as: [:self :nm |
  [System println: ["== " , nm , " =="]];
  self] doc:
  "Print the `== nm ==` header announcing a suite."];

[Reflect defineMethod: #passed: on: ConsoleRunner as: [:self :label |
  [ObjectModel slot: 0 in: self put: [[self passedCount] + 1]];
  [System println: ["  ok   " , label]];
  self] doc:
  "Count a pass and print its ok line for `label`."];

[Reflect defineMethod: #failed:detail: on: ConsoleRunner as: [:self :label :detail |
  [ObjectModel slot: 1 in: self put: [[self failedCount] + 1]];
  [System println: ["  FAIL " , label , " (" , detail , ")"]];
  self] doc:
  "Count a failure and print its FAIL line for `label` with `detail`."];

[Reflect defineMethod: #suiteFinished: on: ConsoleRunner as: [:self :nm | self] doc:
  "A no-op hook after suite `nm` finishes; answers self."];

[Reflect defineMethod: #summary on: ConsoleRunner as: [:self |
  [System println:
    ["TOTAL: " , [[self passedCount] printString] , " passed, "
               , [[self failedCount] printString] , " failed"]];
  self] doc:
  "Print the cumulative pass/fail totals."];

[Reflect defineMethod: #allPassed on: ConsoleRunner as: [:self |
  [[self failedCount] = 0]] doc:
  "True iff no test has failed (the exit-code gate)."];

// The default runner owns zeroed totals even before the first reset.

// ===========================================================================
// TestSuite — a named, module-tagged bag of deferred cases. Registers itself
// with Test the moment it is created; unregister it when no longer needed.
// ===========================================================================
[Globals at: #TestSuite put: [ObjectModel newSlots: #[nil nil nil] parent: ObjectVt]];
[Reflect defineMethod: #slotNames on: TestSuite as: [:self | #[#name #cases #testsModule]]];

[Reflect defineMethod: #name on: TestSuite as: [:self |
  [ObjectModel slot: 0 in: self]] doc:
  "Answers the suite's name."];
[Reflect defineMethod: #cases on: TestSuite as: [:self |
  [ObjectModel slot: 1 in: self]] doc:
  "Answers the suite's deferred (name, block) cases."];

[Reflect defineMethod: #module on: TestSuite as: [:self |
  [ObjectModel slot: 2 in: self]] doc:
  "The suite's current module tag. Reflective edits affect subsequent discovery."];

[Globals at: #TestCase put: [ObjectModel newSlots: #[nil nil] parent: ObjectVt]];
[Reflect defineMethod: #slotNames on: TestCase as: [:self | #[#cname #cblock]]];
[Reflect defineMethod: #name on: TestCase as: [:self | [ObjectModel slot: 0 in: self]]];
[Reflect defineMethod: #body on: TestCase as: [:self | [ObjectModel slot: 1 in: self]]];

[Reflect defineMethod: #named:module: on: TestSuite as: [:self :nm :mod |
  let s := [TestSuite clone];
  [ObjectModel slot: 0 in: s put: nm];
  [ObjectModel slot: 1 in: s put: #[]];
  [ObjectModel slot: 2 in: s put: mod];
  [Test register: s];
  s] doc:
  "A fresh suite named `nm`, tagged with module symbol `mod`; registers with Test; no facts are created."];

[Reflect defineMethod: #test:do: on: TestSuite as: [:self :nm :blk |
  let cse := [TestCase clone];
  [ObjectModel slot: 0 in: cse put: nm];
  [ObjectModel slot: 1 in: cse put: blk];
  [ObjectModel slot: 1 in: self put: [[self cases] add: cse]];
  self] doc:
  "Add a deferred case: `nm` names it, `blk` is a 1-arg block [:t | …] run later against a fresh TestContext. Chainable."];

// ===========================================================================
// Test — the registry and the run protocol.
// ===========================================================================
[Globals at: #Test put: [ObjectModel newSlots: #[#[]] parent: ObjectVt]];
[Reflect defineMethod: #slotNames on: Test as: [:self | #[#suites]]];

// Registry snapshots are persistent Vectors. Registration owns each suite until
// unregister: or an explicit reflected registry replacement releases it.
[Reflect defineMethod: #suites on: Test as: [:self |
  [ObjectModel slot: 0 in: self]] doc:
  "Registered suites in registration order; a persistent snapshot, not a live view."];

[Reflect defineMethod: #register: on: Test as: [:self :suite |
  [[[self suites] anySatisfy: [:s | [s == suite]]] ifFalse: [|
    [ObjectModel slot: 0 in: self put: [[self suites] add: suite]]]];
  self] doc:
  "Register a suite by identity once. Retains it until unregistered; answers the registry."];

[Reflect defineMethod: #unregister: on: Test as: [:self :suite |
  [ObjectModel slot: 0 in: self put: [[self suites] reject: [:s | [s == suite]]]];
  self] doc:
  "Remove a suite by identity. Existing snapshots and explicit facts remain independent."];

[Reflect defineMethod: #suitesForModule: on: Test as: [:self :mod |
  [[self suites] select: [:s | [[s module] == mod]]]] doc:
  "Registered suites with current module-symbol identity `mod`, in registration order."];

[Reflect defineMethod: #describeSuitesIn: on: Test as: [:self :store |
  [[self suites] do: [:s |
    [store assert: s attr: #isTestSuite value: #true];
    [store assert: s attr: #testsModule value: [s module]]]];
  store] doc:
  "Explicitly add observed suite/module facts to `store`. Use a fresh Store for a new snapshot; no subscription or automatic retraction. Facts retain suites and may be historical."];

// Run one suite against a runner: announce it, hand each case block a fresh
// TestContext, then close it. Does not reset the runner (see reset).
[Reflect defineMethod: #runSuite:withRunner: on: Test as: [:self :s :r |
  [r suiteStarted: [s name]];
  let t := [TestContext for: r];
  [[s cases] do: [:cse |
    let answer := [[cse body] value: t];
    [[answer isError] ifTrue: [|
      [r failed: [cse name] detail: [answer printString]]]]]];
  [r suiteFinished: [s name]];
  s] doc:
  "Run suite `s` against runner `r`, handing each case block a fresh TestContext; does NOT reset `r` (see reset)."];

// Run every registered suite through the runner (reset first, summarise after).
// Answers the runner, so `[[Test runAllSuitesWithRunner: R] allPassed]` gates.
[Reflect defineMethod: #runAllSuitesWithRunner: on: Test as: [:self :r |
  [r reset];
  [[self suites] do: [:s | [self runSuite: s withRunner: r]]];
  [r summary];
  r] doc:
  "Run every registered suite through runner `r` (reset first, summarise after). Answers `r`, so `[[Test runAllSuitesWithRunner: R] allPassed]` gates the exit code."];

[Reflect defineMethod: #runTestsForModule:withRunner: on: Test as: [:self :mod :r |
  [r reset];
  [[self suitesForModule: mod] do: [:s | [self runSuite: s withRunner: r]]];
  [r summary];
  r] doc:
  "Run only the suites tagged with module symbol `mod` through runner `r`. Answers `r`."]
