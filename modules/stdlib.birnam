// stdlib.birnam — the SELF-HOSTED part of the standard library.
//
// The base protocol is provided by the Rust native floor and its higher rungs
// (prelude, collection) — those are the irreducible primitives.
// THIS file is birnam defining MORE of its own library, on top of those
// primitives, via `[Reflect defineMethod: #sel on: T as: aBlock]`. It is loaded by
// default; `BIRNAM_NO_STDLIB=1` runs on the bare native runtime instead.
//
// The migrated Rust host evaluates this embedded source at startup.

// This module's dependency declaration (stage 3): the self-hosted stdlib sits
// directly on the native primitives, so it requires no other self-hosted module.
// The module manager is installed first on every supported boot. The tiny
// fallback keeps stdlib directly evaluable in the native Codegen harness.
[[Module isNil]
  ifTrue: [|
    [Globals at: #Module put: [Object clone]];
    [Reflect defineMethod: #named:requires: on: Module as: [:self :name :reqs | self]]]
  ifFalse: [| nil]];
[Module named: #stdlib requires: #[]];

// -- optional documentation owner --------------------------------------------
// A method's docstring can ride its definition (`… as: block doc: "…"`) and a
// module can declare a one-line summary (`[Reflect docModule: #x is: "…"]`) with
// ZERO static dependency on the Doc system: `Doc` resolves at SEND time, so
// before modules/doc.birnam loads both just install / do nothing, and once Doc
// exists its current public protocol records the docstring under Doc's
// current module (docgen re-loads library sources for exactly this). A method
// documented while no module is current still installs; its text is dropped.
[Reflect defineMethod: #defineMethod:on:as:doc: on: Reflect as: [:self :sel :proto :blk :doc |
  [self defineMethod: sel on: proto as: blk];
  [[Globals includes: #Doc]
    ifTrue: [|
      [Doc recordMethod: sel on: proto text: doc]]
    ifFalse: [| nil]];
  self]];
[Reflect defineMethod: #docModule:is: on: Reflect as: [:self :mod :summary |
  [[Globals includes: #Doc]
    ifTrue:  [| [Doc module: mod is: summary]]
    ifFalse: [| nil]];
  self]];

[Reflect docModule: #stdlib is: "The self-hosted standard library — derived Integer/Collection/String protocol, value equality, error handling, and the |> thread."];

// -- Integer: derived arithmetic on top of the primitive + - * / mod: < <= = -----

[Reflect defineMethod: #negated on: Integer as: [:self | [0 - self]] doc:
   "The arithmetic negation of the receiver (0 - self)."];
[Reflect defineMethod: #squared on: Integer as: [:self | [self * self]] doc:
   "The receiver multiplied by itself."];
[Reflect defineMethod: #abs on: Integer
   as: [:self | [[self < 0] ifTrue: [| [0 - self]] ifFalse: [| self]]] doc:
   "The absolute value of the receiver."];

[Reflect defineMethod: #even on: Integer as: [:self | [[self mod: 2] = 0]] doc:
   "True iff the receiver is divisible by 2."];
[Reflect defineMethod: #odd  on: Integer as: [:self | [[self even] not]] doc:
   "True iff the receiver is not divisible by 2."];

[Reflect defineMethod: #max: on: Integer
   as: [:self :other | [[self > other] ifTrue: [| self] ifFalse: [| other]]] doc:
   "The larger of the receiver and `other`."];
[Reflect defineMethod: #min: on: Integer
   as: [:self :other | [[self < other] ifTrue: [| self] ifFalse: [| other]]] doc:
   "The smaller of the receiver and `other`."];

[Reflect defineMethod: #between:and: on: Integer
   as: [:self :lo :hi | [[self >= lo] & [self <= hi]]] doc:
   "True iff the receiver lies between `lo` and `hi`, both bounds inclusive."];

// Recursive — the method dispatches to itself (late-bound through the send).
[Reflect defineMethod: #factorial on: Integer
   as: [:self | [[self <= 1] ifTrue: [| 1] ifFalse: [| [self * [[self - 1] factorial]]]]] doc:
   "The factorial of the receiver, computed recursively (any receiver <= 1 answers 1)."];

// -- Object: a display helper everything inherits -------------------------------

// Print the receiver's printString followed by a newline, and answer the receiver
// (so it chains). Handy in scripts and the REPL.
[Reflect defineMethod: #printNl on: Object
   as: [:self | [System println: [self printString]]; self] doc:
   "Prints the receiver's printString and a newline; answers the receiver (so it chains)."];

// -- Collection: the higher-order protocol, defined ONCE over inject:into: -------
//
// Vector, Range, Map and String all delegate to `Collection` and each provides
// exactly one native fold primitive, `inject:into:` (birnam has no mutable locals,
// so accumulation is functional — the fold threads the accumulator). Everything
// below derives from that single primitive, so all four families answer the whole
// protocol uniformly (docs/design/41 §B). `collect:`/`select:`/`asVector` build a
// Vector — the universal sequence — regardless of the source's family.

[Reflect defineMethod: #collect: on: Collection
   as: [:self :blk | [self inject: #[] into: [:acc :e | [acc add: [blk value: e]]]]] doc:
   "A Vector of `blk`'s value for each element, in order (always a Vector, whatever the source family)."];

[Reflect defineMethod: #select: on: Collection
   as: [:self :blk | [self inject: #[] into: [:acc :e |
      [[blk value: e] ifTrue: [| [acc add: e]] ifFalse: [| acc]]]]] doc:
   "A Vector of the elements for which `blk` answers true, in order."];

[Reflect defineMethod: #reject: on: Collection
   as: [:self :blk | [self inject: #[] into: [:acc :e |
      [[blk value: e] ifTrue: [| acc] ifFalse: [| [acc add: e]]]]]] doc:
   "A Vector of the elements for which `blk` answers false, in order."];

[Reflect defineMethod: #asVector on: Collection
   as: [:self | [self inject: #[] into: [:acc :e | [acc add: e]]]] doc:
   "A Vector of the elements in order — the universal sequence, whatever the source family."];

// count: aBlock — how many elements satisfy the predicate (cardinality is `size`).
[Reflect defineMethod: #count: on: Collection
   as: [:self :blk | [self inject: 0 into: [:acc :e |
      [[blk value: e] ifTrue: [| [acc + 1]] ifFalse: [| acc]]]]] doc:
   "How many elements satisfy `blk` (whole-collection cardinality is size)."];

// isEmpty over size — no family keeps a native isEmpty; this covers them all
// (Vector/Map had native ones until the tier-A surface lift; Range never did).
[Reflect defineMethod: #isEmpty on: Collection as: [:self | [[self size] = 0]] doc:
   "True iff the collection has no elements (size = 0)."];
[Reflect defineMethod: #notEmpty on: Collection as: [:self | [[self isEmpty] not]] doc:
   "True iff the collection has at least one element."];

// first / last / at:ifAbsent: over size + at: — pure surface (no per-element
// loop), lifted from the native collection implementation's
// vFirst/vLast/vAtIfAbsent/rFirst/
// rLast). Every indexable family gets them, String included; Map keeps its own
// native at:ifAbsent: (key-based, not index-based — the map_vt method wins).
[Reflect defineMethod: #first on: Collection as: [:self |
   [[self isEmpty] ifTrue: [| nil] ifFalse: [| [self at: 0]]]] doc:
   "The first element, or nil when empty."];
[Reflect defineMethod: #last on: Collection as: [:self |
   [[self isEmpty] ifTrue: [| nil] ifFalse: [| [self at: [[self size] - 1]]]]] doc:
   "The last element, or nil when empty."];
[Reflect defineMethod: #at:ifAbsent: on: Collection as: [:self :i :aBlock |
   [[[i < 0] | [i >= [self size]]]
      ifTrue:  [| [aBlock value]]
      ifFalse: [| [self at: i]]]] doc:
   "The element at 0-based index i, or the block's value when i is out of range."];

// includes: / anySatisfy: / allSatisfy: — phrased over count: and size so they
// never seed a fold with a boolean (avoids depending on literal true/false) and
// stay correct even when an element is nil (unlike a detect:-based membership test).
[Reflect defineMethod: #includes: on: Collection
   as: [:self :x | [[self count: [:e | [e = x]]] > 0]] doc:
   "True iff some element is `=` to `x` (value equality; correct even when the matching element is nil)."];
[Reflect defineMethod: #anySatisfy: on: Collection
   as: [:self :blk | [[self count: blk] > 0]] doc:
   "True iff at least one element satisfies `blk`."];
[Reflect defineMethod: #allSatisfy: on: Collection
   as: [:self :blk | [[self count: blk] = [self size]]] doc:
   "True iff every element satisfies `blk` (an empty collection answers true)."];

// detect: — first matching element, or nil. detect:ifNone: evaluates a block when
// none match (matches Smalltalk; nil elements that match read as "not found").
[Reflect defineMethod: #detect: on: Collection
   as: [:self :blk | [self inject: nil into: [:acc :e |
      [[acc notNil] ifTrue: [| acc]
                    ifFalse: [| [[blk value: e] ifTrue: [| e] ifFalse: [| nil]]]]]]] doc:
   "The first element satisfying `blk`, or nil when none (a matching nil element reads as not found)."];
[Reflect defineMethod: #detect:ifNone: on: Collection
   as: [:self :blk :none | [[[self detect: blk] notNil]
      ifTrue: [| [self detect: blk]] ifFalse: [| [none value]]]] doc:
   "The first element satisfying `blk`, or `none`'s value when no element matches."];

// -- Vector: the tier-B SURFACE lifts (docs/44 §7, measured 2026-07-12) ----------
// The gate's verdict, case by case (bench/micro.birnam vector.*/range.*):
//   asVector   (identity)              LIFTED — pure surface, no loop.
//   asVector   (Range → Collection's)  LIFTED — 1.02× (the build is allocation-
//                                      dominated, so the per-element send drowns).
//   includes:                          LIFTED as a DELEGATION to the retained
//                                      native indexOf: scan — one send total. The
//                                      full-derived form (Collection's count:)
//                                      measured 116× and failed. Delegation also
//                                      keeps includes:/indexOf: agreeing on keyEq
//                                      (both identity on Floats — a keyEq wart,
//                                      one place to fix).
//   reversed / copyFrom:to:            STAY NATIVE — the derived per-row loops
//                                      measured 2.58× / 1.60× and failed.

[Reflect defineMethod: #asVector on: Vector as: [:self | self] doc:
   "The receiver itself — a Vector is already a Vector."];

[Reflect defineMethod: #includes: on: Vector
   as: [:self :x | [[self indexOf: x] notNil]] doc:
   "Membership via the native indexOf: scan (keyEq: value for Integer/String/Symbol, identity otherwise)."];

// -- Integer: rounding / coercion are identity on a whole number; sqrt via Float ---
[Reflect defineMethod: #floor on: Integer as: [:self | self] doc:
   "The receiver — floor is identity on a whole number."];
[Reflect defineMethod: #ceiling on: Integer as: [:self | self] doc:
   "The receiver — ceiling is identity on a whole number."];
[Reflect defineMethod: #rounded on: Integer as: [:self | self] doc:
   "The receiver — rounding is identity on a whole number."];
[Reflect defineMethod: #truncated on: Integer as: [:self | self] doc:
   "The receiver — truncation is identity on a whole number."];
[Reflect defineMethod: #asInteger on: Integer as: [:self | self] doc:
   "The receiver — an Integer coerces to itself."];
[Reflect defineMethod: #sqrt on: Integer as: [:self | [[self asFloat] sqrt]] doc:
   "The square root of the receiver as a Float (via asFloat)."];

// -- Integer: timesRepeat:, in birnam over the native to:do: loop -----------------
// Rides the prim to:do: frame, so the stack stays flat. to:do: stops-and-
// propagates on a body error (the whileTrue: contract), so the error check here
// is only to answer the RECEIVER on success (to:do: answers ITS receiver, 1).
[Reflect defineMethod: #timesRepeat: on: Integer as: [:self :aBlock |
  let r := [1 to: self do: [:i | [aBlock value]]];
  [[r isError] ifTrue: [| r] ifFalse: [| self]]] doc:
  "Run aBlock self times (a no-op when self <= 0). Answers self, or the first error the body answers."];

// -- Cell: ordinary local mutation ----------------------------------------------
// `:=` introduces a binding; mutable values live in shared Cells. asCell creates
// local state without publishing a fact. Explicit database handles still use
// `[store cellFor: entity attr: attribute]`. Cell is an ordinary authored object.
[Reflect defineMethod: #asCell on: Object as: [:self |
  [Cell with: self]] doc:
  "A fresh local mutable Cell holding self. value/set: share its state through aliases; no facts or implicit history (history answers zero). Use cellFor:attr: on a Store for fact-backed state."];
// -- StringBuilder sugar + the byte transforms it unlocks (docs/44 Phase 5) -------
// The builder itself is native: add:/addByte: are bulk/byte
// appends into a mutable buffer, asString materializes once. These are the
// birnam conveniences over it, plus asUppercase/asLowercase lifted out of the native floor —
// cold-path byte transforms a to:do: + addByte: loop expresses fine. (The HOT
// per-byte string work stays native: split:/trimmed/indexOf: — the scanners —
// and replace:with:, which json/html escaping runs on every LSP message and
// docgen string.)
[Reflect defineMethod: #addLine: on: StringBuilderVt as: [:self :x |
   [[self add: x] add: "
"]] doc:
   "Append x (printString-coerced like add:) then a newline; answers self."];
[Reflect defineMethod: #addAll: on: StringBuilderVt as: [:self :coll |
   [coll do: [:e | [self add: e]]];
   self] doc:
   "Append every element of coll in order; answers self."];
[Reflect defineMethod: #isEmpty on: StringBuilderVt as: [:self | [[self size] = 0]] doc:
   "True iff nothing has been appended yet (size = 0)."];

// All elements appended into one String — the O(n) way to fold strings together
// (an `inject:into:` fold over `,` copies O(n²) bytes; docgen measured it).
[Reflect defineMethod: #joined on: Collection as: [:self |
   let sb := [StringBuilder new];
   [self do: [:e | [sb add: e]]];
   [sb asString]] doc:
   "One String of every element in order, printString-coercing non-Strings; O(n) via StringBuilder."];

[Reflect defineMethod: #asUppercase on: String as: [:self |
   let sb := [StringBuilder new];
   [0 to: [[self size] - 1] do: [:i |
      let b := [self byteAt: i];
      [sb addByte: [[[b >= 97] & [b <= 122]] ifTrue: [| [b - 32]] ifFalse: [| b]]]]];
   [sb asString]] doc:
   "A fresh String with ASCII a-z folded to uppercase (other bytes untouched)."];
[Reflect defineMethod: #asLowercase on: String as: [:self |
   let sb := [StringBuilder new];
   [0 to: [[self size] - 1] do: [:i |
      let b := [self byteAt: i];
      [sb addByte: [[[b >= 65] & [b <= 90]] ifTrue: [| [b + 32]] ifFalse: [| b]]]]];
   [sb asString]] doc:
   "A fresh String with ASCII A-Z folded to lowercase (other bytes untouched)."];

// -- Equality: identity by default; value/structural where it has meaning (§B3) ----
//
// `=` on Object is identity over the floor's `==`. Integer/Float/String override it
// with value equality (native); Boolean/nil/Symbol are singletons, so identity IS
// value equality — they need nothing more. Collections override via DOUBLE DISPATCH:
// `a = b` asks `b` whether it is an equal collection of a's kind. The back-selectors
// default to false on Object, so `#[1] = aMap` or `#[1] = 5` answers false with no
// type tag and no special case in dispatch. Element comparison recurses through the
// ordinary `=`, so nested and mixed-type collections just work.
[Reflect defineMethod: #= on: Object as: [:self :other | [self == other]] doc:
   "Identity equality (the floor's ==); Integer/Float/String and the collections override with value equality."];
[Reflect defineMethod: #equalsVector: on: Object as: [:self :other | false] doc:
   "Double-dispatch default: false — only Vector overrides, so a non-Vector never equals a Vector."];
[Reflect defineMethod: #equalsRange:  on: Object as: [:self :other | false] doc:
   "False — only a Range value-equals a Range (the double-dispatch default)."];
[Reflect defineMethod: #equalsMap:    on: Object as: [:self :other | false] doc:
   "False — only a Map value-equals a Map (the double-dispatch default)."];

// Element-wise compare for indexable sequences (both operands already same-kind).
[Reflect defineMethod: #hasSameElementsAs: on: Collection
   as: [:self :other | [[[self size] = [other size]]
      ifTrue: [| [[0 to: [[self size] - 1]] allSatisfy: [:i | [[self at: i] = [other at: i]]]] ]
      ifFalse: [| false ]]] doc:
   "True iff `other` has the same size and an `=` element at every index (element-wise value compare, order matters)."];

[Reflect defineMethod: #= on: Vector as: [:self :other | [other equalsVector: self]] doc:
   "Value equality via double dispatch: true iff `other` is a Vector with the same elements (by =) in order."];
[Reflect defineMethod: #equalsVector: on: Vector
   as: [:self :other | [self hasSameElementsAs: other]] doc:
   "The Vector side of the double dispatch — element-wise value compare against `other`."];

[Reflect defineMethod: #= on: Range as: [:self :other | [other equalsRange: self]] doc:
   "Value equality via double dispatch: true iff `other` is a Range with the same elements (by =) in order."];
[Reflect defineMethod: #equalsRange: on: Range
   as: [:self :other | [self hasSameElementsAs: other]] doc:
   "The Range side of the double dispatch — element-wise value compare against `other`."];

// Maps compare by key→value content, independent of internal HAMT layout: same size,
// and every key of self present in other with an equal value (looked up, not walked).
[Reflect defineMethod: #= on: Map as: [:self :other | [other equalsMap: self]] doc:
   "Value equality via double dispatch: true iff `other` is a Map with the same key→value content."];
[Reflect defineMethod: #equalsMap: on: Map
   as: [:self :other | [[[self size] = [other size]]
      ifTrue: [| [[self keys] allSatisfy: [:k |
         [[other includesKey: k]
            ifTrue:  [| [[self at: k] = [other at: k]] ]
            ifFalse: [| false ]]]] ]
      ifFalse: [| false ]]] doc:
   "The Map side of the double dispatch — same size and every key of self in `other` with an `=` value (layout-independent)."];

// -- Object: the pipeline operator |> — thread a value into a block --------------
//
// `[x |> aBlock]` is `[aBlock value: x]`: it threads the left value in as the
// block's argument, so a nest of sends reads left-to-right instead of inside-out.
// Binary sends fold left, so it chains in one bracket:
// `[data |> parse |> validate |> render]` is `[render value: [validate value:
// [parse value: data]]]`. Defined on Object so any value pipes; the block chooses
// what to do with it (send, combine, guard), which recovers Smalltalk's
// thread-as-receiver fluency over birnam's native blocks.
[Reflect defineMethod: #|> on: Object as: [:self :block | [block value: self]] doc:
   "Threads the receiver into `block` — [x |> b] is [b value: x], so a nest of sends reads left-to-right."];

// ── error protocol (docs/design/44a) ─────────────────────────────────────────
// The representation (native Err payload), the doesNotUnderstand: SWAP, and the
// Error factory stays in the native core — it is floor. What lives here
// is pure block orchestration over the core primitives [e isError]/[e kind]/
// [e message] and the [Error …] factory. `ErrorVt` is the exported error-instance
// vtable; `on: ErrorVt` installs on every error instance.

// Type predicates live on the MIRROR (Reflect), not on base objects (Bracha
// stratification — a type query is asked THROUGH the mirror, not answered by the
// object itself). `[Reflect vtableOf: x]` is the one floor primitive; each
// predicate compares an object's vtable to an EXEMPLAR's — so it is independent of
// how a kind's prototype is exported (docs/design/44a).
// The exemplar vtables are taken ONCE at load (still export-shape-independent —
// derived from exemplar values, not from how a kind's prototype is exported);
// re-deriving per query would allocate a fresh "" on every string-protocol guard.
[Globals at: #SymbolExemplarVt put: [Reflect vtableOf: #s]];
[Globals at: #StringExemplarVt put: [Reflect vtableOf: ""]];
[Reflect defineMethod: #isSymbol: on: Reflect as: [:self :x | [[self vtableOf: x] == SymbolExemplarVt]] doc:
   "True iff `x` is a Symbol (a mirror query: compares x's vtable to the Symbol exemplar's)."];
[Reflect defineMethod: #isString: on: Reflect as: [:self :x | [[self vtableOf: x] == StringExemplarVt]] doc:
   "True iff `x` is a String (a mirror query: compares x's vtable to the String exemplar's)."];

// Binding reflection consumes an owner's rooted snapshot. The collector is an
// ordinary object, so inspection publishes no scratch facts.
let reflectBindingCollector := [ObjectModel newSlots: #[#[]] parent: ObjectVt];
[Reflect defineMethod: #binding:value: on: reflectBindingCollector as: [:self :name :value |
  [ObjectModel slot: 0 in: self put:
    [[ObjectModel slot: 0 in: self] add: {#name -> name #value -> value}]];
  self]];
[Reflect defineMethod: #bindingsIn: on: Reflect as: [:self :owner |
  let collector := [ObjectModel newSlots: #[#[]] parent: [self vtableOf: reflectBindingCollector]];
  let result := [owner liveBindingsDo: collector];
  [[result isError] ifTrue: [| result] ifFalse: [| [ObjectModel slot: 0 in: collector]]]
] doc: "Snapshot an owner's live bindings as name/value Maps; bound nil is present. No facts are created."];
let reflectNameCollector := [ObjectModel newSlots: #[#[] nil] parent: ObjectVt];
[Reflect defineMethod: #binding:value: on: reflectNameCollector as: [:self :name :value |
  [[value == [ObjectModel slot: 1 in: self]] ifTrue: [|
    [ObjectModel slot: 0 in: self put: [[ObjectModel slot: 0 in: self] add: name]]
  ]]; self]];
[Reflect defineMethod: #namesOf:in: on: Reflect as: [:self :object :owner |
  let collector := [ObjectModel newSlots: #[#[] object] parent: [self vtableOf: reflectNameCollector]];
  let result := [owner liveBindingsDo: collector];
  [[result isError] ifTrue: [| result] ifFalse: [| [ObjectModel slot: 0 in: collector]]]
] doc: "All names bound to this exact object in the selected owner, in that owner's order."];

// Names describe ordinary storage; no separate fact schema or value mirror.
[Reflect defineMethod: #slotNames on: Object as: [:self | #[]]];
[Reflect defineMethod: #slotsOf: on: Reflect as: [:self :object |
  let owner := ObjectModel;
  let indices := [owner referenceSlotsOf: object];
  [[[indices isNil] | [indices isError]] ifTrue: [| indices] ifFalse: [|
    let names := [object slotNames];
    [[names isError] ifTrue: [| names] ifFalse: [|
      [indices inject: #[] into: [:rows :index |
        [rows add: {#slot -> index #name -> [names at: index] #owner -> owner
                    #readable -> true #writable -> true}]]]
    ]]
  ]]
]];
[Reflect defineMethod: #slotIndex:in: on: Reflect as: [:self :key :object |
  let indices := [ObjectModel referenceSlotsOf: object];
  [[indices isError] ifTrue: [| indices] ifFalse: [|
    [[indices isNil] ifTrue: [| [Error kind: #unsupportedSlots]] ifFalse: [|
      let index := [[self isSymbol: key]
        ifTrue: [| [[object slotNames] indexOf: key]] ifFalse: [| key]];
      [[index isError] ifTrue: [| index] ifFalse: [|
        [[[indices indexOf: index] isNil]
          ifTrue: [| [Error kind: #unknownSlot]] ifFalse: [| index]]
      ]]
    ]]
  ]]
]];
[Reflect defineMethod: #slot:in: on: Reflect as: [:self :key :object |
  let index := [self slotIndex: key in: object];
  [[index isError] ifTrue: [| index] ifFalse: [| [ObjectModel slot: index in: object]]]
]];
[Reflect defineMethod: #slot:in:put: on: Reflect as: [:self :key :object :value |
  let index := [self slotIndex: key in: object];
  [[index isError] ifTrue: [| index] ifFalse: [| [ObjectModel slot: index in: object put: value]]]
]];

// Does a caught error's kind satisfy an on:do: spec? the wildcard #error, an exact
// kind symbol, or any collection of kinds. A single symbol short-circuits to false
// (no match); only a non-symbol spec (a collection) is probed with `includes:`.
[Reflect defineMethod: #kindMatches: on: ErrorVt as: [:self :want |
   [[[want = #error] | [want = [self kind]]]
      ifTrue:  [| true]
      ifFalse: [| [[Reflect isSymbol: want] ifTrue:  [| false]
                                            ifFalse: [| [want includes: [self kind]]]]]]] doc:
   "True iff the receiver's kind satisfies `want` — the wildcard #error, the exact kind symbol, or a collection of kinds."];

// [[block] on: spec do: handler] — run the protected block; if it yields an error
// whose kind matches spec, run the handler with it; else pass the value through.
[Reflect defineMethod: #on:do: on: Object as: [:self :spec :handler |
   let val := [self value];
   [[val isError]
      ifTrue:  [| [[val kindMatches: spec] ifTrue:  [| [handler value: val]]
                                           ifFalse: [| val]]]
      ifFalse: [| val]]] doc:
   "Runs the receiver block; an error whose kind matches `spec` goes to `handler`, any other result passes through."];

// [protected ensure: cleanup] — always run cleanup, answer protected's result.
[Reflect defineMethod: #ensure: on: Object as: [:self :cleanup |
   let val := [self value]; [cleanup value]; val] doc:
   "Runs the receiver block, then always runs `cleanup`; answers the protected block's result (error or not)."];

// ifError:/ifNotError: — dispatch on whether the receiver is an error.
[Reflect defineMethod: #ifError:    on: Object  as: [:self :h | self] doc:
   "Answers the receiver untouched — a non-error skips the error branch; `h` never runs (ErrorVt overrides)."];
[Reflect defineMethod: #ifNotError: on: Object  as: [:self :h | [h value: self]] doc:
   "Runs `h` with the receiver — a non-error takes the not-error branch (ErrorVt overrides to skip it)."];
[Reflect defineMethod: #ifError:    on: ErrorVt as: [:self :h | [h value: self]]  doc:
   "Runs `h` with the receiver — an error takes the error branch."];
[Reflect defineMethod: #ifNotError: on: ErrorVt as: [:self :h | self] doc:
   "Answers the receiver untouched — an error skips the not-error branch; `h` never runs."];

// Thread-friendly control. Each method enters through ifNotError: so an error
// produced by an earlier stage is preserved by identity and no user block runs.
[Reflect defineMethod: #tap: on: Object as: [:self :block |
   [self ifNotError: [:value | [block value: value]; value]]] doc:
   "Runs `block` with a non-error receiver and answers that receiver; errors pass through untouched."];
[Reflect defineMethod: #when:apply: on: Object as: [:self :predicate :block |
   [self ifNotError: [:value |
      [[predicate value: value]
         ifTrue: [| [block value: value]]
         ifFalse: [| value]]]]] doc:
   "Applies `block` to a non-error receiver when `predicate` holds; otherwise answers the receiver."];
[Reflect defineMethod: #unless:apply: on: Object as: [:self :predicate :block |
   [self when: [:value | [[predicate value: value] not]] apply: block]] doc:
   "Applies `block` to a non-error receiver unless `predicate` holds; otherwise answers the receiver."];
[Reflect defineMethod: #juxt: on: Object as: [:self :blocks |
   [self ifNotError: [:value | [blocks collect: [:block | [block value: value]]]]]] doc:
   "A Vector containing each block's result for the same non-error receiver; errors pass through untouched."];

// Persistent Map vocabulary. These methods build solely through the native
// persistent at:put: primitive and never mutate the receiver.
[Reflect defineMethod: #atPath:put: on: MapVt as: [:self :path :value |
   let key := [path at: 0];
   [[[path size] = 1]
      ifTrue: [| [self at: key put: value]]
      ifFalse: [|
         let rest := [path copyFrom: 1 to: [path size]];
         let child := [self at: key ifAbsent: [| [Map new]]];
         [self at: key put: [child atPath: rest put: value]]]]] doc:
   "A new Map with `value` at `path`, creating missing intermediate Maps."];
[Reflect defineMethod: #atPath:ifAbsent: on: MapVt as: [:self :path :absent |
   [[path isEmpty]
      ifTrue: [| [absent value]]
      ifFalse: [|
         let key := [path at: 0];
         [[self includesKey: key]
            ifTrue: [|
               let value := [self at: key];
               [[[path size] = 1]
                  ifTrue: [| value]
                  ifFalse: [|
                     [[[Reflect vtableOf: value] == MapVt]
                        ifTrue: [| [value atPath: [path copyFrom: 1 to: [path size]] ifAbsent: absent]]
                        ifFalse: [| [absent value]]]]]]
            ifFalse: [| [absent value]]]]]] doc:
   "The binding at nested `path`, or `absent` once if a segment is missing or not a Map."];
[Reflect defineMethod: #atAny:ifAbsent: on: MapVt as: [:self :keys :absent |
   let state := [keys inject: {#found -> false #key -> nil} into: [:acc :key |
      [[acc at: #found]
         ifTrue: [| acc]
         ifFalse: [|
            [[self includesKey: key]
               ifTrue: [| [[acc at: #found put: true] at: #key put: key]]
               ifFalse: [| acc]]]]]];
   [[state at: #found]
      ifTrue: [| [self at: [state at: #key]]]
      ifFalse: [| [absent value]]]] doc:
   "The value of the first bound key in `keys`, or `absent`'s value when none is bound."];
[Reflect defineMethod: #update:with:ifAbsent: on: MapVt as: [:self :key :block :absent |
   [[self includesKey: key]
      ifTrue: [| [self at: key put: [block value: [self at: key]]]]
      ifFalse: [| [absent value]]]] doc:
   "A new Map with the bound key transformed by `block`, or `absent`'s value when unbound."];
[Reflect defineMethod: #update:with: on: MapVt as: [:self :key :block |
   [self update: key with: block ifAbsent: [|
      ["Map update:with: key is absent" error: #notFound]]]] doc:
   "A new Map with the bound key transformed by `block`; an unbound key answers a #notFound error."];
[Reflect defineMethod: #removeKey: on: MapVt as: [:self :key |
   [[self keys] inject: [Map new] into: [:result :each |
      [[each = key]
         ifTrue: [| result]
         ifFalse: [| [result at: each put: [self at: each]]]]]]] doc:
   "A new Map without `key`; answers an equal Map when the key was already absent."];
[Reflect defineMethod: #merge: on: MapVt as: [:self :other |
   [[other keys] inject: self into: [:result :key |
      [result at: key put: [other at: key]]]]] doc:
   "A new Map containing both maps, with `other`'s bindings winning."];
[Reflect defineMethod: #pick: on: MapVt as: [:self :keys |
   [keys inject: [Map new] into: [:result :key |
      [[self includesKey: key]
         ifTrue: [| [result at: key put: [self at: key]]]
         ifFalse: [| result]]]]] doc:
   "A new Map restricted to the requested keys that are bound."];
[Reflect defineMethod: #omit: on: MapVt as: [:self :keys |
   [[self keys] inject: [Map new] into: [:result :key |
      [[keys includes: key]
         ifTrue: [| result]
         ifFalse: [| [result at: key put: [self at: key]]]]]]] doc:
   "A new Map without any key in `keys`."];

// Structural collection combinators. Vector keeps its native sortBy: method;
// other Collections reach that implementation through asVector.
[Reflect defineMethod: #groupBy: on: Collection as: [:self :block |
   [self inject: [Map new] into: [:groups :value |
      let key := [block value: value];
      let bucket := [groups at: key ifAbsent: [| #[]]];
      [groups at: key put: [bucket add: value]]]]] doc:
   "A Map from each derived key to the Vector of values producing it."];
[Reflect defineMethod: #sortBy: on: Collection as: [:self :block |
   [[self asVector] sortBy: block]] doc:
   "A Vector ordered by each element's value under `block`."];
[Reflect defineMethod: #uniqueBy: on: Collection as: [:self :block |
   let state := [self inject: {#seen -> [Map new] #values -> #[]} into: [:acc :value |
      let key := [block value: value];
      let seen := [acc at: #seen];
      [[seen includesKey: key]
         ifTrue: [| acc]
         ifFalse: [|
            let nextSeen := [seen at: key put: true];
            let nextValues := [[acc at: #values] add: value];
            {#seen -> nextSeen #values -> nextValues}]]]];
   [state at: #values]] doc:
   "A Vector retaining the first value for each key derived by `block`."];
[Reflect defineMethod: #zip:with: on: Collection as: [:self :other :block |
   let limit := [[self size] min: [other size]];
   [[0 to: [limit - 1]] collect: [:index |
      [block value: [self at: index] value: [other at: index]]]]] doc:
   "A Vector of pairwise block results, stopping at the shorter collection."];

// printString — "error(#kind: message)"; kind is always a symbol, message may be nil.
[Reflect defineMethod: #printString on: ErrorVt as: [:self |
   let k := [[self kind] printString];
   let m := [[[self message] isNil] ifTrue: [| ""] ifFalse: [| [": " , [self message]]]];
   [[["error(" , k] , m] , ")"]] doc:
   "Renders the error as error(#kind: message); the message part is dropped when message is nil."];

// Raise from a message string: ["boom" error] → #error; ["boom" error: #kind].
[Reflect defineMethod: #error  on: String as: [:self | [Error message: self]] doc:
   "A fresh #error-kinded error carrying the receiver as its message."];
[Reflect defineMethod: #error: on: String as: [:self :kind | [Error kind: kind message: self]] doc:
   "A fresh error of kind `kind` carrying the receiver as its message."];

// ── String: the derived protocol over the byte floor (docs/design/44 Phase 2) ──
//
// The String FLOOR is: size, at: (1-byte String), byteAt: (Integer), copyFrom:to:
// (slice-or-nil), `,` (concat), `=`, printString, asSymbol, asInteger, asNumber —
// plus two native families that are DELIBERATE retentions: asLowercase/
// asUppercase/replace:with: (they BUILD byte content; wait on the Phase-5
// StringBuilder) and the per-byte SCANNERS split:/trimmed/indexOf: (a send costs
// ~1.5-2µs, so a derived scan over bulk text — NativeDoc sweeping Rust sources for
// doc/docgen — is ~10× slower; "lift the surface, keep the native join").
// Everything else derives here. Iteration rides Range's native fold ([0 to: n]
// inject:/do: — an empty range, start > stop, iterates zero times), so String's
// whole Collection protocol (collect:/select:/detect:/…, and isEmpty/notEmpty
// from Collection itself) follows. Arg guards mirror the old native semantics:
// a non-String argument answers false (predicates) rather than erroring, via
// the [Reflect isString:] mirror.

// The fold primitive, derived: fold the 1-byte Strings through Range's fold.
[Reflect defineMethod: #inject:into: on: String
   as: [:self :acc :blk | [[0 to: [[self size] - 1]]
      inject: acc into: [:a :i | [blk value: a value: [self at: i]]]]] doc:
   "Folds `blk` over the characters as 1-byte Strings, threading `acc` — the fold the Collection protocol derives from."];

// do: — evaluate the block with each 1-byte String; answers self.
[Reflect defineMethod: #do: on: String
   as: [:self :blk |
      [[0 to: [[self size] - 1]] do: [:i | [blk value: [self at: i]]]];
      self] doc:
   "Evaluates `blk` with each character as a 1-byte String; answers the receiver."];

[Reflect defineMethod: #startsWith: on: String as: [:self :prefix |
   [[Reflect isString: prefix]
      ifTrue:  [| [[self copyFrom: 0 to: [prefix size]] = prefix]]
      ifFalse: [| false]]] doc:
   "True iff the receiver begins with `prefix` (every string starts with the empty string; a non-String answers false)."];

[Reflect defineMethod: #endsWith: on: String as: [:self :suffix |
   [[Reflect isString: suffix]
      ifTrue:  [| [[self copyFrom: [[self size] - [suffix size]] to: [self size]] = suffix]]
      ifFalse: [| false]]] doc:
   "True iff the receiver ends with `suffix` (a too-long slice is nil, which compares false; a non-String answers false)."];

// includesSubstring: — the surface over the native indexOf: scanner; indexOf:'s
// guards (non-String → nil, empty needle → 0) give exactly the right booleans.
[Reflect defineMethod: #includesSubstring: on: String as: [:self :sub |
   [[self indexOf: sub] notNil]] doc:
   "True iff `sub` occurs in the receiver (empty `sub` is everywhere; a non-String answers false)."];

// Lexicographic byte order. Stop iteration when the first unequal byte
// decides the result; no later byte reads are needed.
[Reflect defineMethod: #< on: String as: [:self :other |
   let lim := [[[self size] < [other size]] ifTrue: [| [self size]] ifFalse: [| [other size]]];
   [self byteOrderBefore: other from: 0 limit: lim]] doc:
   "True iff the receiver sorts strictly before `other` in byte order (shared prefix: shorter first)."];

// Carry progress in ordinary arguments: no mutable Cells or suffix traversal.
// The recursive branch is a tail send; byte access, equality and order remain
// current sends, including after a callback suspends or replaces a method.
[Reflect defineMethod: #byteOrderBefore:from:limit: on: String as: [:self :other :index :lim |
   [[index < lim]
      ifTrue: [|
         let ba := [self byteAt: index];
         let bb := [other byteAt: index];
         [[ba = bb]
            ifTrue: [| [self byteOrderBefore: other from: [index + 1] limit: lim]]
            ifFalse: [| [ba < bb]]]]
      ifFalse: [| [[self size] < [other size]]]]]];

// Internal: the six ASCII whitespace bytes (space \t \n \v \f \r), as trimmed/
// words define them — matching the native set exactly.
[Reflect defineMethod: #isWhitespaceByte: on: String as: [:self :b |
   [[[b = 32] | [b = 9]] | [[[b = 10] | [b = 11]] | [[b = 12] | [b = 13]]]]] doc:
   "Internal: true iff byte `b` is one of the six ASCII whitespace bytes (space, tab, LF, VT, FF, CR) — the trimmed/words set."];

// words — the whitespace-run tokenizer: thread #[parts runStart], runStart nil
// while inside whitespace; empty runs never open, so they are dropped.
[Reflect defineMethod: #words on: String as: [:self |
   let res := [[0 to: [[self size] - 1]] inject: #[ #[] nil ] into: [:acc :i |
      [[self isWhitespaceByte: [self byteAt: i]]
         ifTrue:  [| [[[acc at: 1] isNil]
                        ifTrue:  [| acc]
                        ifFalse: [| #[ [[acc at: 0] add: [self copyFrom: [acc at: 1] to: i]] nil ]]]]
         ifFalse: [| [[[acc at: 1] isNil]
                        ifTrue:  [| #[ [acc at: 0] i ]]
                        ifFalse: [| acc]]]]]];
   [[[res at: 1] isNil]
      ifTrue:  [| [res at: 0]]
      ifFalse: [| [[res at: 0] add: [self copyFrom: [res at: 1] to: [self size]]]]]] doc:
   "A Vector of the whitespace-separated runs (empty runs dropped; punctuation stays attached)."]
