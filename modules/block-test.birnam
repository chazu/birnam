// block-test.birnam — the test suite for the Block family (Rust prelude):
// whileTrue:/whileFalse:, birnam's native stack-flat iteration construct. The
// 10k-iteration loop is the load-bearing case — a recursion-styled "loop" at
// that depth overflows the native stack, so completing it at all proves the
// loop frame is constant. Loop state rides store cells ([db cellFor:attr:]),
// the mutable primitive — the grammar has no local re-assignment. Loading only
// registers the suite; run via modules/run-tests.birnam.

[[Globals includes: #TestSuite] ifTrue: [| nil] ifFalse: [| [System load: "modules/test.birnam"]]];

let s := [TestSuite named: "Block" module: #block];

[s test: "canonical false has independent inherited behavior" do: [:t |
  [t expect: [Boolean == true] equals: true describes: "Boolean remains the canonical true prototype"];
  [t expect: [False == false] equals: true describes: "False names the canonical false singleton"];
  [Reflect defineMethod: #stacklessBranchProbe on: Boolean as: [:self | #trueBehavior]];
  [Reflect defineMethod: #stacklessBranchProbe on: False as: [:self | #falseBehavior]];
  [t expect: [true stacklessBranchProbe] equals: #trueBehavior describes: "true uses Boolean behavior"];
  [t expect: [false stacklessBranchProbe] equals: #falseBehavior describes: "false overrides on its private vtable"]]];

[s test: "whileTrue: drives a cell counter through 10k iterations, flat stack" do: [:t |
  let obj := [Object clone];
  let cell := [db cellFor: obj attr: #n];
  [cell set: 0];
  let r := [[| [[cell value] < 10000]] whileTrue: [| [cell set: [[cell value] + 1]]]];
  [t expect: [cell value] equals: 10000 describes: "counted to 10000"];
  [t expect: [r isNil] equals: true describes: "a completed loop answers nil"]]];

[s test: "whileTrue: false-first never runs the body; whileFalse: mirrors" do: [:t |
  let obj := [Object clone];
  let cell := [db cellFor: obj attr: #n];
  [cell set: 0];
  [[| false] whileTrue: [| [cell set: 99]]];
  [t expect: [cell value] equals: 0 describes: "false on arrival leaves the body unrun"];
  [[| [[cell value] >= 5]] whileFalse: [| [cell set: [[cell value] + 1]]]];
  [t expect: [cell value] equals: 5 describes: "whileFalse: loops until the condition turns true"]]];

[s test: "asCell sugar: loop state one send away, cells independent" do: [:t |
  let n := [0 asCell];
  [[| [[n value] < 1000]] whileTrue: [| [n inc]]];
  [t expect: [n value] equals: 1000 describes: "asCell/inc count to 1000"];
  [t expect: [n dec] equals: 999 describes: "dec answers the new value"];
  let m := [5 asCell];
  [n set: 1];
  [t expect: [m value] equals: 5 describes: "cells are independent (fresh entity each)"]]];

[s test: "timesRepeat: runs the body n times; <=0 no-op; errors propagate" do: [:t |
  let n := [0 asCell];
  let r := [7 timesRepeat: [| [n inc]]];
  [t expect: [n value] equals: 7 describes: "seven repeats"];
  [t expect: r equals: 7 describes: "answers the receiver"];
  [0 timesRepeat: [| [n inc]]];
  [-3 timesRepeat: [| [n inc]]];
  [t expect: [n value] equals: 7 describes: "zero and negative counts are no-ops"];
  [t expect: [[[3 timesRepeat: [| [10 / 0]]] kind] printString] equals: "#zeroDivide"
     describes: "a body error stops the repeat and propagates"]]];

[s test: "to:do: stops-and-propagates on a body error (the loop contract)" do: [:t |
  let n := [0 asCell];
  let e := [1 to: 5 do: [:i | [n inc]; [[i = 2] ifTrue: [| [10 / 0]] ifFalse: [| 0]]]];
  [t expect: [[e kind] printString] equals: "#zeroDivide" describes: "propagates the body error"];
  [t expect: [n value] equals: 2 describes: "stopped at the erroring iteration"]]];

[s test: "loop error semantics: non-boolean condition, body errors propagate" do: [:t |
  let e := [[| 42] whileTrue: [| 0]];
  [t expect: [e isError] equals: true describes: "a non-boolean condition is an error, not a silent exit"];
  [t expect: [[e kind] printString] equals: "#mustBeBoolean" describes: "kinded #mustBeBoolean"];
  let e2 := [[| true] whileTrue: [| [10 / 0]]];
  [t expect: [[e2 kind] printString] equals: "#zeroDivide" describes: "a body error stops the loop and propagates"]]];
