// random.birnam — pseudo-random numbers for birnam, over libc via Alien.
//
// A birnam-native module. Wraps libc's `random()` / `srandom()` — a decent,
// SEEDABLE PRNG (better than rand()) — so sequences are reproducible when you pin
// a seed, which is what deterministic tests want. No new Zig.
//
// The stream is process-global (one libc PRNG), so `seed:` affects all draws. On
// load the module seeds itself from the clock, so an un-seeded program still
// varies run to run; call `[Random seed: n]` to make it repeatable.
//
// Load it (from the repo root) with:
//   [System load: "modules/random.birnam"]   (pulls in Time for the auto-seed)
//
// This module is DOCUMENTED: each method carries its docstring on the definition
// (`… as: block doc: "…"`) and declares a summary (`[Reflect docModule: …]`). Those
// are baseline no-ops UNLESS the Doc module is loaded first — then `[Doc text:
// #random]`, `birnam doc random`, LSP hover, and the HTML reference all read from
// this one source. No dependency on Doc either way.

// Dependency: Time, for the load-time auto-seed.
[[Globals includes: #Time] ifTrue: [| nil] ifFalse: [| [System load: "modules/time.birnam"]]];

// The module singleton + its one-line summary (a no-op without Doc loaded).
[Globals at: #Random put: [Object clone]];
[Reflect docModule: #random is: "Seedable pseudo-random numbers over libc random()/srandom()."];

// long random(void)             — no args, so the receiver is unused.
[Alien wrap: "random"  signature: "l"   as: #rawRandom   on: Random];
// void srandom(unsigned seed)   — receiver = the seed (an Integer, truncated to 32 bits).
[Alien wrap: "srandom" signature: "v i" as: #srandomSeed on: Integer];

// -- surface (documented) -----------------------------------------------------

[Reflect defineMethod: #seed: on: Random as: [:self :n | [n srandomSeed]; self] doc:
  "Seed the process-global PRNG for a reproducible sequence. Chainable."];

[Reflect defineMethod: #next on: Random as: [:self | [self rawRandom]] doc:
  "The next raw draw, an Integer in [0, 2^31-1]."];

[Reflect defineMethod: #nextInt: on: Random as: [:self :n | [[self next] mod: n]] doc:
  "A value in [0, n). Slight modulo bias for very large n — negligible for dice/indices."];

[Reflect defineMethod: #between:and: on: Random as: [:self :lo :hi |
  [lo + [self nextInt: [[hi - lo] + 1]]]] doc:
  "A value in [lo, hi], inclusive."];

[Reflect defineMethod: #bool on: Random as: [:self | [[self nextInt: 2] = 0]] doc:
  "A fair coin — true or false."];

[Reflect defineMethod: #pick: on: Random as: [:self :coll |
  [coll at: [self nextInt: [coll size]]]] doc:
  "A random element of a collection answering size + at: (0-based), e.g. a Vector."];

// Auto-seed from the clock so the default stream varies run to run. Calls the
// wrapped srandom directly (not `seed:`) to avoid a same-unit method at load time.
[[Time nowMillis] srandomSeed]
