// markdown.birnam — a small Markdown-to-HTML renderer for birnam, pure birnam.
//
// Covers the subset the guide pages use — NOT CommonMark:
//   # .. ####        headings (each gets a slug id for deep links)
//   ```              fenced code blocks (content escaped verbatim, no inline)
//   - item           unordered lists (one level)
//   blank line       paragraph separator
//   `code`           inline code (protected from further inline processing)
//   **bold**         strong emphasis
// Everything else is paragraph prose. There is deliberately NO link/italic
// syntax: birnam prose is full of `[` `]` and `*`-adjacent text, and a partial
// parse that corrupts code-heavy prose is worse than no parse.
//
// Load it (from the repo root) with:
//   [Module load: #markdown]
//   [Markdown toHtml: "# Hi\n\nsome `code` here"]
//   [Markdown toHtml: md shiftHeadings: 1]   "# -> <h2> (for embedding in a page)"
//
// Line-based state machine, the NativeDoc pattern: a scanner object holds the
// mode + buffers in cells, every line feeds through once, a final flush closes
// whatever is open. Rendering is offline (docgen), so per-line birnam work is
// fine — the perf gate concerns hot paths, not site builds.

[Module named: #markdown requires: #[#html]];
[[Globals includes: #Html] ifTrue: [| nil] ifFalse: [| [Module load: #html]]];

[Globals at: #Markdown put: [Object clone]];
[Reflect docModule: #markdown is: "Markdown -> HTML for the guide subset: headings, fences, lists, paragraphs, `code`, **bold**."];

// -- inline markup --------------------------------------------------------------

[Reflect defineMethod: #boldHtml: on: Markdown as: [:self :t |
  let parts := [t split: "**"];
  let sb := [StringBuilder new];
  [0 to: [[parts size] - 1] do: [:i |
    [[[i mod: 2] = 0]
      ifTrue:  [| [sb add: [Html escape: [parts at: i]]]]
      ifFalse: [| [sb add: [Html tag: "strong" text: [parts at: i]]]]]]];
  [sb asString]] doc:
  "Raw prose -> HTML with **bold** spans; everything is escaped (odd segments become <strong>)."];

[Reflect defineMethod: #inlineHtml: on: Markdown as: [:self :t |
  let parts := [t split: "`"];
  let sb := [StringBuilder new];
  [0 to: [[parts size] - 1] do: [:i |
    [[[i mod: 2] = 0]
      ifTrue:  [| [sb add: [self boldHtml: [parts at: i]]]]
      ifFalse: [| [sb add: [Html tag: "code" text: [parts at: i]]]]]]];
  [sb asString]] doc:
  "Raw prose -> HTML: `code` spans first (their content is protected), **bold** in the rest, all escaped."];

// A heading's anchor id: lowercased, spaces to dashes, markup chars dropped.
[Reflect defineMethod: #slugOf: on: Markdown as: [:self :t |
  let a := [[t asLowercase] replace: " " with: "-"];
  let b := [a replace: "`" with: ""];
  [[b replace: "*" with: ""] replace: "\"" with: ""]] doc:
  "A heading's anchor id: lowercased, spaces to dashes, backticks/asterisks/quotes dropped."];

// -- the line machine -------------------------------------------------------------

// Close an open paragraph / list; a no-op when nothing is open.
[Reflect defineMethod: #flush:out: on: Markdown as: [:self :sc :out |
  let mode := [[db cellFor: sc attr: #mode] value];
  [[mode = #para]
    ifTrue: [| [out add: [Html tag: "p" body: [self inlineHtml: [[[db cellFor: sc attr: #buf] value] asString]]]]]
    ifFalse: [| nil]];
  [[mode = #list]
    ifTrue: [|
      let items := [StringBuilder new];
      let me := self;
      [[[db cellFor: sc attr: #items] value] do: [:it |
        [items add: [Html tag: "li" body: [me inlineHtml: it]]]]];
      [out add: [Html tag: "ul" body: [items asString]]]]
    ifFalse: [| nil]];
  [[db cellFor: sc attr: #mode] set: #none];
  self] doc:
  "Close the scanner's open paragraph or list into `out`; a no-op when nothing is open."];

[Reflect defineMethod: #heading:level:scanner:out: on: Markdown as: [:self :txt :level :sc :out |
  [self flush: sc out: out];
  let shift := [[db cellFor: sc attr: #shift] value];
  let n := [level + shift];
  let tag := ["h" , [[[n < 6] ifTrue: [| n] ifFalse: [| 6]] printString]];
  [out add: [Html tag: tag
                  attrs: [Html attr: "id" value: [self slugOf: txt]]
                  body: [self inlineHtml: txt]]];
  self] doc:
  "Emit one heading (level+shift, capped at h6) with a slug id, flushing open prose first."];

// Inside a fence: ``` closes it (emit the <pre>), anything else accumulates raw.
[Reflect defineMethod: #codeLine:scanner:out: on: Markdown as: [:self :line :sc :out |
  [[line startsWith: "```"]
    ifTrue:  [|
      [out add: [Html tag: "pre" body: [Html tag: "code" text: [[[db cellFor: sc attr: #buf] value] asString]]]];
      [[db cellFor: sc attr: #mode] set: #none]]
    ifFalse: [|
      let b := [[db cellFor: sc attr: #buf] value];
      [[b isEmpty] ifTrue: [| [b add: line]] ifFalse: [| [[b add: "\n"] add: line]]]]];
  self] doc:
  "One line while inside a fence: ``` closes and emits the <pre><code>; others accumulate verbatim."];

// A list item: open the list if needed, append the item text (raw; inline at flush).
[Reflect defineMethod: #listLine:scanner:out: on: Markdown as: [:self :line :sc :out |
  [[[[db cellFor: sc attr: #mode] value] = #list]
    ifTrue:  [| nil]
    ifFalse: [|
      [self flush: sc out: out];
      [[db cellFor: sc attr: #mode] set: #list];
      [[db cellFor: sc attr: #items] set: #[]]]];
  let items := [[db cellFor: sc attr: #items] value];
  [[db cellFor: sc attr: #items] set: [items add: [line copyFrom: 2 to: [line size]]]];
  self] doc:
  "One `- ` line: opens a list (closing other prose) if needed, then appends the item text."];

// A prose line: continue the open paragraph or start a fresh one.
[Reflect defineMethod: #paraLine:scanner:out: on: Markdown as: [:self :line :sc :out |
  [[[[db cellFor: sc attr: #mode] value] = #para]
    ifTrue:  [| [[[[db cellFor: sc attr: #buf] value] add: " "] add: [line trimmed]]]
    ifFalse: [|
      [self flush: sc out: out];
      [[db cellFor: sc attr: #mode] set: #para];
      let b := [StringBuilder new];
      [b add: [line trimmed]];
      [[db cellFor: sc attr: #buf] set: b]]];
  self] doc:
  "One plain line: joins the open paragraph with a space, or starts a new one."];

// The non-heading tail: list item, blank (paragraph break), or prose.
[Reflect defineMethod: #proseTail:scanner:out: on: Markdown as: [:self :line :sc :out |
  [[line startsWith: "- "]
    ifTrue:  [| [self listLine: line scanner: sc out: out]]
    ifFalse: [|
      [[[line trimmed] isEmpty]
        ifTrue:  [| [self flush: sc out: out]]
        ifFalse: [| [self paraLine: line scanner: sc out: out]]]]];
  self] doc:
  "A non-heading, non-fence line: list item, blank (closes open prose), or paragraph text."];

// Outside a fence: ``` opens one; # headings dispatch by prefix; else the tail.
[Reflect defineMethod: #proseLine:scanner:out: on: Markdown as: [:self :line :sc :out |
  [[line startsWith: "```"]
    ifTrue:  [|
      [self flush: sc out: out];
      [[db cellFor: sc attr: #mode] set: #code];
      [[db cellFor: sc attr: #buf] set: [StringBuilder new]]]
    ifFalse: [|
      [[line startsWith: "#### "]
        ifTrue:  [| [self heading: [line copyFrom: 5 to: [line size]] level: 4 scanner: sc out: out]]
        ifFalse: [|
          [[line startsWith: "### "]
            ifTrue:  [| [self heading: [line copyFrom: 4 to: [line size]] level: 3 scanner: sc out: out]]
            ifFalse: [|
              [[line startsWith: "## "]
                ifTrue:  [| [self heading: [line copyFrom: 3 to: [line size]] level: 2 scanner: sc out: out]]
                ifFalse: [|
                  [[line startsWith: "# "]
                    ifTrue:  [| [self heading: [line copyFrom: 2 to: [line size]] level: 1 scanner: sc out: out]]
                    ifFalse: [| [self proseTail: line scanner: sc out: out]]]]]]]]]]];
  self] doc:
  "One line outside a fence: ``` opens one, `#`-prefixes emit headings, everything else takes the prose tail."];

[Reflect defineMethod: #feedLine:scanner:out: on: Markdown as: [:self :line :sc :out |
  [[[[db cellFor: sc attr: #mode] value] = #code]
    ifTrue:  [| [self codeLine: line scanner: sc out: out]]
    ifFalse: [| [self proseLine: line scanner: sc out: out]]];
  self] doc:
  "Feed one line to the scanner: verbatim while a fence is open, structural dispatch otherwise."];

// -- entry points -----------------------------------------------------------------

[Reflect defineMethod: #toHtml:shiftHeadings: on: Markdown as: [:self :md :shift |
  let sc := [Object clone];
  [[db cellFor: sc attr: #mode]  set: #none];
  [[db cellFor: sc attr: #buf]   set: [StringBuilder new]];
  [[db cellFor: sc attr: #items] set: #[]];
  [[db cellFor: sc attr: #shift] set: shift];
  let out := [StringBuilder new];
  let me := self;
  [[md split: "\n"] do: [:line | [me feedLine: line scanner: sc out: out]]];
  [[[[db cellFor: sc attr: #mode] value] = #code]
    ifTrue:  [| [out add: [Html tag: "pre" body: [Html tag: "code" text: [[[db cellFor: sc attr: #buf] value] asString]]]]]
    ifFalse: [| [self flush: sc out: out]]];
  [out asString]] doc:
  "Render `md` to an HTML fragment with headings shifted down `shift` levels (an unclosed fence still emits)."];

[Reflect defineMethod: #toHtml: on: Markdown as: [:self :md |
  [self toHtml: md shiftHeadings: 0]] doc:
  "Render `md` to an HTML fragment (headings at their written level)."]
