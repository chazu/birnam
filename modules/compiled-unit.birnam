// compiled-unit.birnam — the low-level reflected candidate lifecycle over Generation's narrow
// candidate/ledger mechanism (docs/design/47). Candidate opening and validation
// are inert; dependency loading and native mapping are explicit operations.

[Module named: #compiledUnit requires: #[#modules #stdlib]];

// Lifecycle records own ordinary named reference slots. Explicit facts are independent.
[[[Globals at: #CompiledUnit] isNil]
  ifTrue: [| [Globals at: #CompiledUnit put: [ObjectModel newSlots: #[nil nil nil nil nil nil nil nil nil nil nil nil false] parent: ObjectVt]]]
  ifFalse: [| nil]];
[Reflect defineMethod: #slotNames on: CompiledUnit as: [:self | #[#unitName #generation #kind #state #requires #provides #sourceRevision #authoredSource #revisionDigest #artifactChecksum #expectedBaseDigest #importStatus #rollbackAvailable]]];
[[[Globals at: #DispatchGeneration] isNil]
  ifTrue: [| [Globals at: #DispatchGeneration put: [ObjectModel newSlots: #[nil nil nil nil nil nil nil] parent: ObjectVt]]]
  ifFalse: [| nil]];
[Reflect defineMethod: #slotNames on: DispatchGeneration as: [:self | #[#sourceMap #baseDigest #generationSelection #predecessor #deltaUnit #kind #state]]];
[[[Globals at: #CompiledOperation] isNil]
  ifTrue: [| [Globals at: #CompiledOperation put: [ObjectModel newSlots: #[nil nil nil nil] parent: ObjectVt]]]
  ifFalse: [| nil]];
[Reflect defineMethod: #slotNames on: CompiledOperation as: [:self | #[#targetName #selector #operation #priorPresent]]];
let currentDispatchGeneration := [nil asCell];
let compiledGenerationNumbers := [{} asCell];

[Reflect defineMethod: #current on: DispatchGeneration as: [:self |
  [currentDispatchGeneration value]]];

[Reflect defineMethod: #current: on: DispatchGeneration as: [:self :generation |
  [currentDispatchGeneration set: generation];
  generation]];

[Reflect defineMethod: #sourceMap on: DispatchGeneration as: [:self | [ObjectModel slot: 0 in: self]]];

[Reflect defineMethod: #baseDigest on: DispatchGeneration as: [:self | [ObjectModel slot: 1 in: self]]];

[Reflect defineMethod: #generationSelection on: DispatchGeneration as: [:self | [ObjectModel slot: 2 in: self]]];

[Reflect defineMethod: #predecessor on: DispatchGeneration as: [:self | [ObjectModel slot: 3 in: self]]];

[Reflect defineMethod: #deltaUnit on: DispatchGeneration as: [:self | [ObjectModel slot: 4 in: self]]];


[Reflect defineMethod: #entryFor: on: DispatchGeneration as: [:self :name |
  [[self sourceMap] inject: nil into: [:found :entry |
    [[found notNil]
      ifTrue: [| found]
      ifFalse: [|
        [[[entry at: 0] = name]
          ifTrue: [| entry]
          ifFalse: [| nil]]]]]]]];

[Reflect defineMethod: #revisionFor: on: DispatchGeneration as: [:self :name |
  let entry := [self entryFor: name];
  [[entry isNil] ifTrue: [| nil] ifFalse: [| [entry at: 1]]]]];

[Reflect defineMethod: #unitFor: on: DispatchGeneration as: [:self :name |
  let entry := [self entryFor: name];
  [[entry isNil] ifTrue: [| nil] ifFalse: [| [entry at: 2]]]]];

[Reflect defineMethod: #fromProjection:predecessor:delta: on: DispatchGeneration as: [:self :projection :prior :unit |
  let generation := [self clone];
  [generation sourceMap: [projection at: 1]];
  [generation baseDigest: [projection at: 2]];
  [generation generationSelection: [projection at: 3]];
  [generation predecessor: prior];
  [generation deltaUnit: unit];
  generation]];

// Loading an image restores descriptions and code, but no transaction authority.
// Explicit adoption flattens the retained source map into a predecessor-free
// baseline. It neither mints replacement units nor changes retained history.
[Reflect defineMethod: #adoptCurrent on: DispatchGeneration as: [:self |
  let origin := [self current];
  let projection := [Codegen initialGenerationProjection];
  [[projection isError]
    ifTrue: [| projection]
    ifFalse: [|
      let baseline := [self fromProjection: projection predecessor: nil delta: nil];
      [self current: baseline];
      let adopted := [Generation adoptInitialGeneration: baseline];
      [[adopted isError]
        ifTrue: [|
          [[[self current] == baseline] ifTrue: [| [self current: origin]]];
          adopted]
        ifFalse: [| baseline]]]]]];

[Reflect defineMethod: #state on: CompiledUnit as: [:self | [ObjectModel slot: 3 in: self]]];

[Reflect defineMethod: #kind on: CompiledUnit as: [:self | [ObjectModel slot: 2 in: self]]];


[Reflect defineMethod: #unitName on: CompiledUnit as: [:self | [ObjectModel slot: 0 in: self]]];

[Reflect defineMethod: #generation on: CompiledUnit as: [:self | [ObjectModel slot: 1 in: self]]];

[Reflect defineMethod: #requires on: CompiledUnit as: [:self | [ObjectModel slot: 4 in: self]]];

[Reflect defineMethod: #provides on: CompiledUnit as: [:self | [ObjectModel slot: 5 in: self]]];

[Reflect defineMethod: #sourceRevision on: CompiledUnit as: [:self | [ObjectModel slot: 6 in: self]]];

[Reflect defineMethod: #authoredSource on: CompiledUnit as: [:self | [ObjectModel slot: 7 in: self]]];

[Reflect defineMethod: #revisionDigest on: CompiledUnit as: [:self | [ObjectModel slot: 8 in: self]]];

[Reflect defineMethod: #artifactChecksum on: CompiledUnit as: [:self | [ObjectModel slot: 9 in: self]]];

[Reflect defineMethod: #artifactLocation on: CompiledUnit as: [:self |
  [Generation candidateContentPath: self]]];

[Reflect defineMethod: #operations on: CompiledUnit as: [:self |
  let ops := [self provides];
  [[ops isNil] ifTrue: [| #[]] ifFalse: [| ops]]]];

[Reflect defineMethod: #additions on: CompiledUnit as: [:self |
  [[self operations] inject: #[] into: [:rows :op |
    [[[op operation] = #install]
      ifTrue: [|
        [[op priorPresent]
          ifTrue: [| rows]
          ifFalse: [| [rows add: op]]]]
      ifFalse: [| rows]]]]]];

[Reflect defineMethod: #replacements on: CompiledUnit as: [:self |
  [[self operations] inject: #[] into: [:rows :op |
    [[[op operation] = #install]
      ifTrue: [|
        [[op priorPresent]
          ifTrue: [| [rows add: op]]
          ifFalse: [| rows]]]
      ifFalse: [| rows]]]]]];

[Reflect defineMethod: #removals on: CompiledUnit as: [:self |
  [[self operations] inject: #[] into: [:rows :op |
    [[[op operation] = #remove]
      ifTrue: [| [rows add: op]]
      ifFalse: [| rows]]]]]];

[Reflect defineMethod: #expectedBaseDigest on: CompiledUnit as: [:self | [ObjectModel slot: 10 in: self]]];

[Reflect defineMethod: #importStatus on: CompiledUnit as: [:self | [ObjectModel slot: 11 in: self]]];

[Reflect defineMethod: #isMapped on: CompiledUnit as: [:self |
  [Generation candidateMapped: self]]];

[Reflect defineMethod: #rollbackAvailable on: CompiledUnit as: [:self | [ObjectModel slot: 12 in: self]]];

// Compare with this module's currently registered source, independently of any
// optional certificate. This is a live descriptive query, not an admission check.
[Reflect defineMethod: #dependencyChanges on: CompiledUnit as: [:self |
  let source := [Codegen moduleSourceFor: [self unitName]];
  [[source isError] ifTrue: [| source] ifFalse: [|
    [[source isNil] ifTrue: [| [Error kind: #moduleNotRegistered]] ifFalse: [|
      let revision := [Codegen sourceRevisionOf: source];
      [[revision isError] ifTrue: [| revision] ifFalse: [|
        [[revision isNil] ifTrue: [| [Error kind: #invalidSourceRevision]] ifFalse: [|
          let old := [revision at: 2];
          let now := [self requires];
          let added := [now inject: #[] into: [:rows :dep |
            [[old includes: dep] ifTrue: [| rows] ifFalse: [| [rows add: dep]]]]];
          let removed := [old inject: #[] into: [:rows :dep |
            [[now includes: dep] ifTrue: [| rows] ifFalse: [| [rows add: dep]]]]];
          {#added -> added, #removed -> removed}]]]]]]]]]];

[Reflect defineMethod: #setState: on: CompiledUnit as: [:self :state |
  [self state: state];
  self]];

[Reflect defineMethod: #generationNumbers on: CompiledUnit as: [:self |
  [compiledGenerationNumbers value]]];

[Reflect defineMethod: #generationNumbers: on: CompiledUnit as: [:self :numbers |
  [compiledGenerationNumbers set: numbers];
  self]];

[Reflect defineMethod: #nextGenerationFor: on: CompiledUnit as: [:self :name |
  let numbers := [self generationNumbers];
  let old := [numbers at: name];
  let next := [[old isNil] ifTrue: [| 1] ifFalse: [| [old + 1]]];
  [self generationNumbers: [[self generationNumbers] at: name put: next]];
  next]];

// Produces the dylib plus its pointer-free `.candidate` envelope. It does not
// open, map, or activate the result.
[Reflect defineMethod: #compile:named:output: on: CompiledUnit as: [:self :source :name :path |
  [Generation compileCandidate: source named: name output: path]]];

// Generation validates selection before asking Codegen to lower the source. This wrapper
// carries no policy of its own and cannot infer or repair malformed rows.
[Reflect defineMethod: #compile:named:output:selection: on: CompiledUnit as: [:self :source :name :path :selection |
  [Generation compileCandidate: source named: name output: path selection: selection]]];

// Inspect-only open. Generation verifies the sidecar and complete artifact hash
// before reflecting metadata into this freshly minted policy object.
[Reflect defineMethod: #open: on: CompiledUnit as: [:self :path |
  let unit := [self clone];
  let inspected := [Generation inspectCandidate: path into: unit];
  [[inspected isError]
    ifTrue: [| inspected]
    ifFalse: [|
      [unit generation: [self nextGenerationFor: [unit unitName]]];
      [unit setState: #candidate];
      unit]]]];

[Reflect defineMethod: #missingDependencies on: CompiledUnit as: [:self |
  [[self requires] inject: #[] into: [:missing :dep |
    [[Module isLoaded: dep]
      ifTrue: [| missing]
      ifFalse: [| [missing add: dep]]]]]]];

// Explicit ordinary effects. Candidate rejection/rollback never claims to undo
// what these module initializers did.
[Reflect defineMethod: #prepareDependencies on: CompiledUnit as: [:self |
  let me := self;
  [[self missingDependencies] inject: self into: [:answer :dep |
    [[answer isError]
      ifTrue: [| answer]
      ifFalse: [|
        let loaded := [Module load: dep];
        [[loaded isError] ifTrue: [| loaded] ifFalse: [| me]]]]]]]];

[Reflect defineMethod: #map on: CompiledUnit as: [:self |
  let missing := [self missingDependencies];
  [[[missing size] = 0]
    ifTrue: [| [Generation mapCandidate: self]]
    ifFalse: [| [Error kind: #dependenciesMissing]]]]];

[Reflect defineMethod: #removeFiles on: CompiledUnit as: [:self |
  [Generation removeCandidateFiles: self]]];

[Reflect defineMethod: #discard on: CompiledUnit as: [:self |
  [Generation discardCandidate: self]]];

// Validation consumes no dispatch capability: preparation snapshots the complete
// plan and discard immediately invalidates the one-shot token.
[Reflect defineMethod: #validate on: CompiledUnit as: [:self |
  let token := [Generation prepareActivation: self plan: [self publicationPlan: #activate]];
  [[token isError] ifTrue: [| token] ifFalse: [| [Generation discardPrepared: token]]]]];

[Reflect defineMethod: #publicationPlan: on: CompiledUnit as: [:self :action | #[action self]]];

[Reflect defineMethod: #activate on: CompiledUnit as: [:self |
  [Generation commitPrepared: [Generation prepareActivation: self plan: [self publicationPlan: #activate]]]]];

[Reflect defineMethod: #rollback on: CompiledUnit as: [:self |
  [[[self state] = #rolledBack] ifTrue: [| self] ifFalse: [|
    [Generation commitPreparedRollback: [Generation prepareRollback: self plan: [self publicationPlan: #rollback]]]]]]];

[Reflect defineMethod: #activeFor: on: CompiledUnit as: [:self :name |
  [Generation activeCandidateFor: name]]];

[Reflect defineMethod: #unitName: on: CompiledUnit as: [:self :value | [ObjectModel slot: 0 in: self put: value]]];
[Reflect defineMethod: #generation: on: CompiledUnit as: [:self :value | [ObjectModel slot: 1 in: self put: value]]];
[Reflect defineMethod: #kind: on: CompiledUnit as: [:self :value | [ObjectModel slot: 2 in: self put: value]]];
[Reflect defineMethod: #state: on: CompiledUnit as: [:self :value | [ObjectModel slot: 3 in: self put: value]]];
[Reflect defineMethod: #requires: on: CompiledUnit as: [:self :value | [ObjectModel slot: 4 in: self put: value]]];
[Reflect defineMethod: #provides: on: CompiledUnit as: [:self :value | [ObjectModel slot: 5 in: self put: value]]];
[Reflect defineMethod: #sourceRevision: on: CompiledUnit as: [:self :value | [ObjectModel slot: 6 in: self put: value]]];
[Reflect defineMethod: #authoredSource: on: CompiledUnit as: [:self :value | [ObjectModel slot: 7 in: self put: value]]];
[Reflect defineMethod: #revisionDigest: on: CompiledUnit as: [:self :value | [ObjectModel slot: 8 in: self put: value]]];
[Reflect defineMethod: #artifactChecksum: on: CompiledUnit as: [:self :value | [ObjectModel slot: 9 in: self put: value]]];
[Reflect defineMethod: #expectedBaseDigest: on: CompiledUnit as: [:self :value | [ObjectModel slot: 10 in: self put: value]]];
[Reflect defineMethod: #importStatus: on: CompiledUnit as: [:self :value | [ObjectModel slot: 11 in: self put: value]]];
[Reflect defineMethod: #rollbackAvailable: on: CompiledUnit as: [:self :value | [ObjectModel slot: 12 in: self put: value]]];
[Reflect defineMethod: #sourceMap: on: DispatchGeneration as: [:self :value | [ObjectModel slot: 0 in: self put: value]]];
[Reflect defineMethod: #baseDigest: on: DispatchGeneration as: [:self :value | [ObjectModel slot: 1 in: self put: value]]];
[Reflect defineMethod: #generationSelection: on: DispatchGeneration as: [:self :value | [ObjectModel slot: 2 in: self put: value]]];
[Reflect defineMethod: #predecessor: on: DispatchGeneration as: [:self :value | [ObjectModel slot: 3 in: self put: value]]];
[Reflect defineMethod: #deltaUnit: on: DispatchGeneration as: [:self :value | [ObjectModel slot: 4 in: self put: value]]];
[Reflect defineMethod: #kind on: DispatchGeneration as: [:self | [ObjectModel slot: 5 in: self]]];
[Reflect defineMethod: #kind: on: DispatchGeneration as: [:self :value | [ObjectModel slot: 5 in: self put: value]]];
[Reflect defineMethod: #state on: DispatchGeneration as: [:self | [ObjectModel slot: 6 in: self]]];
[Reflect defineMethod: #state: on: DispatchGeneration as: [:self :value | [ObjectModel slot: 6 in: self put: value]]];
[Reflect defineMethod: #targetName on: CompiledOperation as: [:self | [ObjectModel slot: 0 in: self]]];
[Reflect defineMethod: #targetName: on: CompiledOperation as: [:self :value | [ObjectModel slot: 0 in: self put: value]]];
[Reflect defineMethod: #selector on: CompiledOperation as: [:self | [ObjectModel slot: 1 in: self]]];
[Reflect defineMethod: #selector: on: CompiledOperation as: [:self :value | [ObjectModel slot: 1 in: self put: value]]];
[Reflect defineMethod: #operation on: CompiledOperation as: [:self | [ObjectModel slot: 2 in: self]]];
[Reflect defineMethod: #operation: on: CompiledOperation as: [:self :value | [ObjectModel slot: 2 in: self put: value]]];
[Reflect defineMethod: #priorPresent on: CompiledOperation as: [:self | [ObjectModel slot: 3 in: self]]];
[Reflect defineMethod: #priorPresent: on: CompiledOperation as: [:self :value | [ObjectModel slot: 3 in: self put: value]]];
[Module markLoaded: #compiledUnit]
