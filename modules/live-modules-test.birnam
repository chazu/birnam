// L1b file-backed revision policy over the livePolicy fixture registered before G0.

[[Globals includes: #TestSuite] ifTrue: [| nil] ifFalse: [| [System load: "modules/test.birnam"]]];

let s := [TestSuite named: "LiveModules" module: #liveModules];
let livePath := "/tmp/birnam-live-policy.birnam";
let stalePath := "/tmp/birnam-live-policy-stale.birnam";
let siblingPath := "/tmp/birnam-live-policy-sibling.birnam";
let invalidPath := "/tmp/birnam-live-policy-invalid.birnam";
let missingDepPath := "/tmp/birnam-live-policy-missing-dep.birnam";
let successorSource := "// exact successor comment\n[Module named: #livePolicy requires: #[]]; [Reflect defineMethod: #liveReplace on: Integer as: [:self | 100]]; [Reflect defineMethod: #liveAdd on: Integer as: [:self | 30]]; [Reflect removeMethod: #liveRemove on: Integer]";
let thirdSource := "// exact successor comment\n[Module named: #livePolicy requires: #[]]; [Reflect defineMethod: #liveReplace on: Integer as: [:self | 1000]]; [Reflect defineMethod: #liveAdd on: Integer as: [:self | 300]]; [Reflect removeMethod: #liveRemove on: Integer]";

// The fixture source was staged into G0 by compiled-unit-test; install its live
// baseline bindings before opening candidates so inspection can classify add vs
// replace and activation validates the actual binding snapshot.
[Reflect defineMethod: #liveReplace on: Integer as: [:self | 10]];
[Reflect defineMethod: #liveRemove on: Integer as: [:self | 20]];

[s test: "fileOut is exact and unchanged import is idempotent" do: [:t |
  let source := [LiveModules sourceFor: #livePolicy];
  let digest := [LiveModules currentDigest];
  let result := [LiveModules fileOut: #livePolicy to: livePath];
  [t expect: result equals: livePath describes: "fileOut succeeds"];
  let bytes := [System readFile: livePath];
  let prefix := ["// birnam-live-base sha256:" , digest];
  [t expect: [bytes startsWith: [prefix , "\n"]] equals: true describes: "one-line base envelope is first"];
  let authored := [bytes copyFrom: [[prefix size] + 1] to: [bytes size]];
  [t expect: authored equals: source describes: "authored bytes after the envelope are untouched"];
  let identical := [LiveModules import: livePath for: #livePolicy];
  [t expect: [LiveImport isImport: identical] equals: true describes: "unchanged import is an idempotent result"];
  [t expect: [identical status] equals: #identical describes: "idempotent result is explicit"];
  [t expect: [identical revisionDigest] equals: [[LiveModules revisionFor: #livePolicy] at: 6] describes: "idempotent import retains revision identity"]]];

[s test: "staging is inert and exposes the candidate delta" do: [:t |
  let base := [LiveModules currentDigest];
  [System writeFile: livePath contents: [LiveModules envelopeFor: successorSource base: base]];
  let before := [LiveModules sourceFor: #livePolicy];
  let unit := [LiveModules import: livePath for: #livePolicy];
  [t expect: [unit isError] equals: false describes: "candidate-safe successor imports"];
  [t expect: [unit unitName] equals: #livePolicy describes: "declared canonical module is retained"];
  [t expect: [unit expectedBaseDigest] equals: base describes: "candidate records its expected whole-runtime base"];
  [t expect: [unit authoredSource] equals: successorSource describes: "candidate retains exact authored source"];
  [t expect: [unit isMapped] equals: false describes: "import does not map native code"];
  [t expect: [LiveModules import: livePath] equals: unit describes: "re-import reuses the retained inspected candidate"];
  [t expect: [[unit additions] size] equals: 1 describes: "addition is inspectable"];
  [t expect: [[unit replacements] size] equals: 1 describes: "replacement is inspectable"];
  [t expect: [[unit removals] size] equals: 1 describes: "removal is inspectable"];
  [t expect: [[[unit dependencyChanges] at: #added] size] equals: 0 describes: "no dependency additions"];
  [t expect: [[[unit dependencyChanges] at: #removed] size] equals: 0 describes: "no dependency removals"];
  [t expect: [[LiveModules stagedCandidates] includes: unit] equals: true describes: "staged candidate is retained"];
  [t expect: [LiveModules sourceFor: #livePolicy] equals: before describes: "import does not publish source authority"];
  [t expect: [3 liveReplace] equals: 10 describes: "import does not replace dispatch"];
  [t expect: [3 liveRemove] equals: 20 describes: "import does not remove dispatch"];

  let intent := [LiveModules activationFor: unit];
  [t expect: [EvolutionIntent isIntent: intent] equals: true describes: "activation is represented as a host intent"];
  [t expect: [unit isMapped] equals: true describes: "explicit activation preparation maps the candidate"];
  [intent fulfill];
  [t expect: [3 liveReplace] equals: 100 describes: "host fulfillment activates replacement"];
  [t expect: [3 liveAdd] equals: 30 describes: "host fulfillment activates addition"];
  [t expect: [[3 liveRemove] isError] equals: true describes: "host fulfillment activates removal"];
  [t expect: [LiveModules sourceFor: #livePolicy] equals: successorSource describes: "activation publishes exact source authority"];
  [t expect: [[LiveModules import: livePath] status] equals: #identical describes: "predecessor-based file becomes idempotent after activation"]]];

[s test: "divergence and invalid files are kinded and inert" do: [:t |
  let activeSource := [LiveModules sourceFor: #livePolicy];
  let ancestor := [[DispatchGeneration current] predecessor];
  let oldBase := [ancestor baseDigest];
  [System writeFile: stalePath contents: [LiveModules envelopeFor: thirdSource base: oldBase]];
  let stale := [LiveModules import: stalePath];
  [t expect: [stale kind] equals: #staleAncestor describes: "ancestor bases are distinguished"];

  let siblingBase := "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff";
  [System writeFile: siblingPath contents: [LiveModules envelopeFor: thirdSource base: siblingBase]];
  let sibling := [LiveModules import: siblingPath];
  [t expect: [sibling kind] equals: #siblingDivergence describes: "unknown valid bases are sibling divergence"];

  [System writeFile: invalidPath contents: successorSource];
  [t expect: [[LiveModules import: invalidPath] kind] equals: #missingBase describes: "missing envelope is explicit"];
  [System writeFile: invalidPath contents: ["// birnam-live-base sha256:BAD\n" , successorSource]];
  [t expect: [[LiveModules import: invalidPath] kind] equals: #malformedEnvelope describes: "malformed envelope is explicit"];
  [System writeFile: invalidPath contents: [LiveModules envelopeFor: successorSource base: [LiveModules currentDigest]]];
  [t expect: [[LiveModules import: invalidPath for: #notLivePolicy] kind] equals: #wrongModuleName describes: "requested and declared names must match"];
  let unsafe := "[Module named: #livePolicy requires: #[]]; 42; [Reflect defineMethod: #liveReplace on: Integer as: [:self | 9]]";
  [System writeFile: invalidPath contents: [LiveModules envelopeFor: unsafe base: [LiveModules currentDigest]]];
  [t expect: [[LiveModules import: invalidPath] kind] equals: #unsupportedTopLevelForm describes: "unsupported top-level forms are rejected whole"];
  [t expect: [LiveModules sourceFor: #livePolicy] equals: activeSource describes: "all rejected imports leave source authority unchanged"];
  [t expect: [3 liveReplace] equals: 100 describes: "all rejected imports leave dispatch unchanged"]]];

[s test: "dependency preparation propagates the original Module error" do: [:t |
  let source := "[Module named: #livePolicy requires: #[#definitelyMissingLiveDependency]]; [Reflect defineMethod: #liveReplace on: Integer as: [:self | 101]]";
  [System writeFile: missingDepPath contents: [LiveModules envelopeFor: source base: [LiveModules currentDigest]]];
  let unit := [LiveModules import: missingDepPath];
  [t expect: [unit isError] equals: false describes: "dependency errors do not prevent inert inspection"];
  [t expect: [[[unit dependencyChanges] at: #added] includes: #definitelyMissingLiveDependency] equals: true describes: "dependency delta is inspectable"];
  let prepared := [unit prepareDependencies];
  [t expect: [prepared isError] equals: true describes: "dependency preparation answers the loader failure"];
  [t expect: [prepared kind] equals: #loadFailed describes: "original Module load kind is preserved"];
  [t expect: [3 liveReplace] equals: 100 describes: "dependency failure leaves dispatch active"];
  [t expect: [[LiveModules durabilityStatus] kind] equals: #stagedCandidatesPresent describes: "full baselines reject leftover inert candidates"];
  [unit discard];
  [t expect: [unit state] equals: #discarded describes: "abandoned candidate can be discarded explicitly"];
  [t expect: [[LiveModules stagedCandidates] includes: unit] equals: false describes: "discard removes the transient staged record"]]];

[s test: "candidate-safe dependency changes activate and remain rollbackable" do: [:t |
  let source := "[Module named: #livePolicy requires: #[#stdlib]]; [Reflect defineMethod: #liveReplace on: Integer as: [:self | 101]]; [Reflect defineMethod: #liveAdd on: Integer as: [:self | 31]]; [Reflect removeMethod: #liveRemove on: Integer]";
  [System writeFile: missingDepPath contents: [LiveModules envelopeFor: source base: [LiveModules currentDigest]]];
  let unit := [LiveModules import: missingDepPath];
  [t expect: [[[unit dependencyChanges] at: #added] includes: #stdlib] equals: true describes: "existing dependency addition is inspectable"];
  let intent := [LiveModules activationFor: unit];
  [t expect: [EvolutionIntent isIntent: intent] equals: true describes: "safe dependency-only top-level change validates"];
  [intent fulfill];
  [t expect: [3 liveReplace] equals: 101 describes: "dependency revision activates"];
  [[unit rollback] fulfill];
  [t expect: [3 liveReplace] equals: 100 describes: "dependency revision rolls back to its predecessor"]]];

[s test: "rollback intent restores the predecessor generation" do: [:t |
  let intent := [LiveModules rollback];
  [t expect: [EvolutionIntent isIntent: intent] equals: true describes: "rollback is represented as a host intent"];
  [intent fulfill];
  [t expect: [3 liveReplace] equals: 10 describes: "rollback restores predecessor replacement"];
  [t expect: [3 liveRemove] equals: 20 describes: "rollback restores predecessor removal"];
  [t expect: [[3 liveAdd] isError] equals: true describes: "rollback removes the addition"]]]
