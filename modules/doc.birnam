// doc.birnam — docstrings + documentation generation for birnam, pure birnam.
//
// Documentation is DATA IN THE IMAGE, the same shape as the test system: register
// a one-line summary per module and a docstring per selector; a module's
// documented-ness is a fact (`mod isDocumented true`), so the system's own docs
// are queryable, and the summary/method-list live in store cells beside it.
// Rendering is a separate act: Markdown out of the box, or HTML by COMPOSING
// modules/html.birnam (a module documenting modules, rendered by another module).
//
// Load it (from the repo root) with:
//   [Module load: #doc]
//
// REGISTER  (call module:is: ONCE per module, before its for:in:says: lines):
//   [Doc module: #html is: "HTML generation — string combinators, no state."]
//   [Doc for: #escape:   in: #html says: "Escape the five markup chars; & first."]
//   [Doc for: #tag:body: in: #html says: "<name>inner</name>; inner is raw markup."]
//
// RENDER:
//   [Doc markdownForModule: #html]   "=> a Markdown section (String)"
//   [Doc htmlForModule: #html]       "=> an HTML fragment, built with Html"
//   [Doc modules]                    "=> every documented module symbol (a query)"
//   [Doc markdownAll]                "=> every module's Markdown, concatenated"
//
// GOTCHA that shaped this: an UNSET store cell's `value` is a raw sentinel that
// answers neither isNil nor printString — so nothing here reads a cell before it
// is written. module:is: seeds the summary and method-list cells; the other
// methods assume the module was documented first (their stated precondition).

[Module named: #doc requires: #[#html]];
// System load: also supports this file directly, outside dependency planning.
[[Globals includes: #Html] ifTrue: [| nil] ifFalse: [| [Module load: #html]]];

[Globals at: #Doc put: [Object clone]];
// Seed the current-module cell (a VALUE — nil means "none"): the stdlib's
// Doc-aware `defineMethod:on:as:doc:` reads it the moment #Doc exists, and an
// unset cell's sentinel answers nothing. Guides seed empty for the same reason
// (htmlIndex reads the cell whether or not loadGuides: ever ran).
[[db cellFor: Doc attr: #currentModule] set: nil];
[[db cellFor: Doc attr: #guides] set: #[]];

// -- registration -------------------------------------------------------------

// A module's one-line summary. Marks the module documented (a fact, so the doc
// set is queryable) and seeds its summary + ordered method-list cells. Call once,
// first — calling it again resets the method list.
[Reflect defineMethod: #module:is: on: Doc as: [:self :mod :summary |
  [db assert: mod attr: #isDocumented value: #true];
  [[db cellFor: mod attr: #docSummary] set: summary];
  [[db cellFor: mod attr: #docMethods] set: #[]];
  [[db cellFor: Doc attr: #currentModule] set: mod];
  self]];

// Doc documents itself — from here down, `doc:` definitions record under #doc.
// (The `defineMethod:on:as:doc:` and `docModule:is:` funnels live in the STDLIB
// now, Doc-aware via a send-time Globals check — loading this module is what
// switches them from install-and-drop to install-and-record.)
[Doc module: #doc is: "Docstrings + documentation generation — the registry, its queries, and the plaintext/Markdown/HTML renderers."];

// A docstring for one selector in a module (which must already be documented).
// Appended to the module's ordered method-list as a small entry clone. The
// receiver prototype is unknown on this path, so `#proto` is seeded nil (a
// VALUE — the renderers read it, and an unset cell's sentinel answers nothing).
[Reflect defineMethod: #for:in:says: on: Doc as: [:self :sel :mod :text |
  let e := [Object clone];
  [[db cellFor: e attr: #sel]   set: sel];
  [[db cellFor: e attr: #text]  set: text];
  [[db cellFor: e attr: #proto] set: nil];
  let cur := [[db cellFor: mod attr: #docMethods] value];
  [[db cellFor: mod attr: #docMethods] set: [cur add: e]];
  self] doc:
  "Record a docstring for `sel` in the (already documented) module `mod`, appended to its ordered entry list; receiver unknown (proto nil)."];

// -- queries ------------------------------------------------------------------

// Every documented module symbol.
[Reflect defineMethod: #modules on: Doc as: [:self |
  [db findAll: ?m where: #[ #[?m #isDocumented #true] ]]] doc:
  "Every documented module symbol (the `isDocumented` fact — a query, so the doc set is data)."];

// A module's ordered method-doc entries (module must be documented).
[Reflect defineMethod: #methodsOf: on: Doc as: [:self :mod |
  [[db cellFor: mod attr: #docMethods] value]] doc:
  "The ordered method-doc entries of `mod` (which must be documented — the cell is seeded by module:is:)."];

// A selector's clean display name — the mirror's inverse of interning.
[Reflect defineMethod: #nameOf: on: Doc as: [:self :sel |
  [Reflect nameOf: sel]] doc:
  "A selector's clean display name (colons kept, no sigil) — the mirror's inverse of interning."];

// Every documented method entry whose selector's name equals `name` (a String),
// across all modules — the hover / `birnam doc <sel>` path (a selector may occur
// in several modules).
[Reflect defineMethod: #lookup: on: Doc as: [:self :name |
  [[self modules] inject: #[] into: [:acc :m |
    [[self methodsOf: m] inject: acc into: [:a2 :e |
      [[[self nameOf: [[db cellFor: e attr: #sel] value]] = name]
        ifTrue:  [| [a2 add: e]]
        ifFalse: [| a2]]]]]]] doc:
  "Every documented entry whose selector prints as `name` (a String), across all modules — the hover / `birnam doc <sel>` path."];

// Is `mod` a documented module? Reads only the queryable modules list — never
// an unset cell.
[Reflect defineMethod: #isDocumented: on: Doc as: [:self :mod |
  [[self modules] includes: mod]] doc:
  "True iff `mod` was registered with module:is: (reads only the queryable modules list, never an unset cell)."];

[Reflect defineMethod: #isRustFloor: on: Doc as: [:self :mod |
  [[db findAll: ?m where: #[ #[?m #docKind #rustFloor] ]] includes: mod]] doc:
  "True iff `mod`'s docs came from a Rust-source scan (the #docKind #rustFloor fact) rather than a loadable birnam module."];

[Reflect defineMethod: #isNativeRust: on: Doc as: [:self :mod |
  [[db findAll: ?m where: #[ #[?m #docKind #nativeRust] ]] includes: mod]] doc:
  "True iff `mod` belongs to a native Rust crate above or alongside the Rust floor, recorded as #nativeRust."];

// Every documented module, ordered by display name (String `<` under sortBy:).
[Reflect defineMethod: #sortedModules on: Doc as: [:self |
  let me := self;
  [[self modules] sortBy: [:m | [me nameOf: m]]]] doc:
  "Every documented module, ordered by display name (String `<` under sortBy:)."];

// The Globals name whose binding IS `obj` (identity), or "" if it has none —
// the reverse of `Globals at:`, for showing a prototype (prototypes print as
// anObject). Reads the `#__globals__` facts codegen records for every binding.
[Reflect defineMethod: #globalNameOf: on: Doc as: [:self :obj |
  let names := [db findAll: ?n where: #[ #[ #__globals__ ?n ?v ] ]];
  [names inject: "" into: [:acc :n |
    [[acc isEmpty]
      ifTrue:  [| [[[Globals at: n ifAbsent: [| nil]] == obj]
                    ifTrue:  [| [Reflect nameOf: n]]
                    ifFalse: [| acc]]]
      ifFalse: [| acc]]]]] doc:
  "The Globals name whose binding IS `obj` (identity), or \"\" — the reverse of `Globals at:`, for naming prototypes (they print as anObject)."];

// -- source view: derived from recorded module sources ---------------------------
//
// Codegen retains authored module sources and projects their declarative method
// spans for documentation without a method-operation journal.

// The selector token in a `[Reflect defineMethod: #sel on: T as: …]` source string:
// the `#…` right after the FIRST `defineMethod:`, up to the next space — a keyword
// selector keeps its colons ("#tag:body:" -> "tag:body:"). "" if `src` isn't a
// definition. First occurrence on BOTH splits: a method body freely mentions
// symbols (`[x at: #k]`), and last-occurrence parsing read those as the selector.
[Reflect defineMethod: #selectorInSource: on: Doc as: [:self :src |
  let afterDM   := [[src split: "defineMethod:"] at: 1 ifAbsent: [| ""]];
  let afterHash := [[afterDM split: "#"] at: 1 ifAbsent: [| ""]];
  [[[afterHash split: " "] first] trimmed]] doc:
  "The selector token of a defineMethod source span (first-occurrence parse, colons kept), or \"\" if `src` isn't a definition."];

// Every recorded method-source string, across all loaded modules.
[Reflect defineMethod: #methodSources on: Doc as: [:self |
  [Codegen recordedMethodSources]] doc:
  "Every declarative method definition in the recorded authored modules."];

// The recorded source(s) of every method whose selector prints as `name` (a String).
[Reflect defineMethod: #sourcesForSelector: on: Doc as: [:self :name |
  [[self methodSources] inject: #[] into: [:acc :src |
    [[[self selectorInSource: src] = name]
      ifTrue:  [| [acc add: src]]
      ifFalse: [| acc]]]]] doc:
  "The recorded source(s) of every method whose selector prints as `name` — the fallback when nothing is registered (the source IS the documentation)."];

// Every recorded source, indexed: a Map from selector name (String) to a Vector
// of source strings. One pass over the sources — the whole-site renderer builds
// this ONCE and looks up per entry (per-selector `sourcesForSelector:` scans
// would make the page build quadratic).
[Reflect defineMethod: #sourceIndex on: Doc as: [:self |
  let me := self;
  [[self methodSources] inject: [Map new] into: [:idx :src |
    let nm := [me selectorInSource: src];
    [[nm isEmpty]
      ifTrue:  [| idx]
      ifFalse: [| [idx at: nm put: [[idx at: nm ifAbsent: [| #[] ]] add: src]]]]]]] doc:
  "A Map from selector name to its recorded source strings, built in ONE pass — the whole-site renderer's lookup table."];

// Every recorded-but-undocumented selector name, sorted — the doc-gap audit.
// A name counts as documented if ANY module registered a docstring for it.
[Reflect defineMethod: #undocumentedSelectors on: Doc as: [:self |
  let me := self;
  let documented := [[self modules] inject: [Map new] into: [:acc :m |
    [[me methodsOf: m] inject: acc into: [:a2 :e |
      [a2 at: [me nameOf: [[db cellFor: e attr: #sel] value]] put: true]]]]];
  [[[[self sourceIndex] keys] inject: #[] into: [:acc :k |
    [[documented includesKey: k] ifTrue: [| acc] ifFalse: [| [acc add: k]]]]]
    sortBy: [:x | x]]] doc:
  "Every recorded-but-undocumented selector name, sorted — the doc-gap worklist (documented anywhere counts)."];

// Coverage needs only a count; use the page's existing index and never sort.
[Reflect defineMethod: #undocumentedSelectorCountIn: on: Doc as: [:self :srcIdx |
  let me := self;
  let documented := [[self modules] inject: [Map new] into: [:acc :m |
    [[me methodsOf: m] inject: acc into: [:a2 :e |
      [a2 at: [me nameOf: [[db cellFor: e attr: #sel] value]] put: true]]]]];
  [[srcIdx keys] inject: 0 into: [:count :name |
    [[documented includesKey: name] ifTrue: [| count] ifFalse: [| [count + 1]]]]]] doc:
  "Count recorded-but-undocumented selectors in an existing source index, without rebuilding it or sorting names."];

// The indexed sources for one selector, narrowed to the receiver when known:
// `protoName` non-empty keeps only definitions on that prototype (the recorded
// span reads `… on: <Name> …`), falling back to all matches if none survive.
[Reflect defineMethod: #sourcesFor:proto:in: on: Doc as: [:self :selName :protoName :srcIdx |
  let all := [srcIdx at: selName ifAbsent: [| #[] ]];
  [[protoName isEmpty]
    ifTrue:  [| all]
    ifFalse: [|
      let mark := [["on: " , protoName] , " "];
      let hits := [all inject: #[] into: [:acc :s |
        [[s includesSubstring: mark] ifTrue: [| [acc add: s]] ifFalse: [| acc]]]];
      [[hits isEmpty] ifTrue: [| all] ifFalse: [| hits]]]]] doc:
  "The indexed sources for `selName`, narrowed to definitions on `protoName` when non-empty (falls back to all matches)."];

// The exact authored source in the current generation (or the boot stage before
// G0 is sealed), never a path-derived compatibility fact.
[Reflect defineMethod: #moduleSource: on: Doc as: [:self :mod |
  let source := [Codegen moduleSourceFor: mod];
  [[source isNil] ifTrue: [| ""] ifFalse: [| source]]] doc:
  "The exact authored source for `mod` in the current dispatch generation, or \"\"."];

// "// x" -> "x": eat the marker and ONE following space (deeper indentation
// kept, so example blocks hold their alignment); a bare "//" -> "".
[Reflect defineMethod: #stripSlashes: on: Doc as: [:self :ln |
  [[ln startsWith: "// "]
    ifTrue:  [| [ln copyFrom: 3 to: [ln size]]]
    ifFalse: [| [ln copyFrom: 2 to: [ln size]]]]] doc:
  "\"// x\" -> \"x\": eat the marker and ONE space, keeping deeper indentation (example alignment); bare \"//\" -> \"\"."];

// The leading `//` comment block of `mod`'s recorded source — the hand-written
// header prose (usage, examples, gotchas), or "" when the module has none (or
// no recorded source). NativeDoc's `//!` trick applied to birnam files: the source
// is already a fact, so the header needs no file I/O and no re-registration.
[Reflect defineMethod: #headerOf: on: Doc as: [:self :mod |
  let src := [self moduleSource: mod];
  [[src isEmpty]
    ifTrue:  [| ""]
    ifFalse: [|
      let me := self;
      let lines := [src split: "\n"];
      let r := [lines inject: #[ true "" ] into: [:acc :ln |
        [[[acc at: 0] & [ln startsWith: "//"]]
          ifTrue:  [| #[ true [[[acc at: 1] , [me stripSlashes: ln]] , "\n"] ]]
          ifFalse: [| #[ false [acc at: 1] ] ]]]];
      [[r at: 1] trimmed]]]] doc:
  "The leading // comment block of `mod`'s recorded source — the hand-written header prose (usage, gotchas), or \"\"."];

// -- CLI ----------------------------------------------------------------------

// `birnam doc <mod>` — the registered docs, else the recorded whole-module source
// (a dylib load), else a friendly note.
[Reflect defineMethod: #cli: on: Doc as: [:self :mod |
  [[self isDocumented: mod]
    ifTrue:  [| [self text: mod]]
    ifFalse: [|
      let src := [self moduleSource: mod];
      [[src isEmpty]
        ifTrue:  [| [["no documentation for " , [self nameOf: mod]] , "\n"]]
        ifFalse: [| [[[self nameOf: mod] , "\n\n"] , [src , "\n"]]]]]]] doc:
  "`birnam doc <mod>` — the registered docs, else the recorded whole-module source, else a friendly note."];

// `birnam doc <mod> <sel>` — the docstring(s) for one selector name (a String),
// else the recorded source(s) of that selector, else a friendly note.
[Reflect defineMethod: #cli:sel: on: Doc as: [:self :mod :selName |
  let hits := [self lookup: selName];
  [[hits isEmpty]
    ifTrue:  [|
      let srcs := [self sourcesForSelector: selName];
      [[srcs isEmpty]
        ifTrue:  [| [["no documentation for " , selName] , "\n"]]
        ifFalse: [| [srcs inject: "" into: [:acc :s | [acc , [s , "\n"]]]]]]]
    ifFalse: [| [hits inject: "" into: [:acc :e |
      let s := [self nameOf: [[db cellFor: e attr: #sel] value]];
      let t := [[db cellFor: e attr: #text] value];
      [acc , [[s , "\n    "] , [t , "\n"]]]]]]]] doc:
  "`birnam doc <mod> <sel>` — the docstring(s) for one selector name, else its recorded source(s), else a note."];

// Markdown hover body for a selector NAME: registered docstrings if any, else the
// recorded source in a code block, else "" (nothing to show). The single source of
// hover truth — the LSP renders whatever this returns.
[Reflect defineMethod: #hoverBodyFor: on: Doc as: [:self :name |
  let hits := [self lookup: name];
  [[hits isEmpty]
    ifTrue:  [|
      [[self sourcesForSelector: name] inject: "" into: [:acc :s |
        [acc , [["```birnam\n" , s] , "\n```\n\n"]]]]]
    ifFalse: [| [hits inject: "" into: [:acc :e |
      [acc , [[[db cellFor: e attr: #text] value] , "\n\n"]]]]]]] doc:
  "The Markdown hover body for selector `name`: registered docstrings, else fenced recorded source, else \"\" — the LSP's single source of truth."];

// -- rendering: plaintext (the REPL / `birnam doc` view) ----------------------

// A module's docs as indented plain text — what `[Doc text: #random]` at the REPL
// (and the `birnam doc` CLI) prints.
[Reflect defineMethod: #text: on: Doc as: [:self :mod |
  let name    := [self nameOf: mod];
  let summary := [[db cellFor: mod attr: #docSummary] value];
  let sb := [StringBuilder new];
  [sb add: [[name , "\n"] , [summary , "\n\n"]]];
  [[self methodsOf: mod] do: [:e |
    let sel := [self nameOf: [[db cellFor: e attr: #sel] value]];
    let txt := [[db cellFor: e attr: #text] value];
    [sb add: [["  " , sel] , [["\n      " , txt] , "\n"]]]]];
  [sb asString]] doc:
  "The module's docs as indented plain text — what the REPL and the `birnam doc` CLI print."];

// -- rendering: Markdown ------------------------------------------------------

[Reflect defineMethod: #markdownForModule: on: Doc as: [:self :mod |
  let name    := [self nameOf: mod];
  let summary := [[db cellFor: mod attr: #docSummary] value];
  let sb := [StringBuilder new];
  [sb add: ["# " , name , "\n\n" , summary , "\n\n"]];
  [[self methodsOf: mod] do: [:e |
    let sel := [self nameOf: [[db cellFor: e attr: #sel] value]];
    let txt := [[db cellFor: e attr: #text] value];
    [sb add: ["- `" , sel , "` — " , txt , "\n"]]]];
  [sb asString]] doc:
  "One module's docs as a Markdown section: # name, the summary, a bullet per selector."];

// Every documented module's Markdown, back to back (module order unspecified).
[Reflect defineMethod: #markdownAll on: Doc as: [:self |
  let sb := [StringBuilder new];
  [[self modules] do: [:m | [[sb add: [self markdownForModule: m]] add: "\n"]]];
  [sb asString]] doc:
  "Every documented module's Markdown, concatenated (module order unspecified)."];

// -- guides: static Markdown pages rendered into the reference -------------------

// The page title of a guide: its first `# ` heading's text, else "guide".
[Reflect defineMethod: #guideTitleOf: on: Doc as: [:self :md |
  let first := [[md split: "\n"] first];
  [[first startsWith: "# "]
    ifTrue:  [| [first copyFrom: 2 to: [first size]]]
    ifFalse: [| "guide"]]] doc:
  "The page title of a guide: the text of its first `# ` heading, else \"guide\"."];

// Load every `*.md` under `dir` (filename order — number the files to order the
// chapters), render each via Markdown (headings shifted one level so a page's
// `#` sits under the site's h1), and remember them for htmlIndex. Answers the
// guide entities; a missing dir is an empty guide set, not an error.
[Reflect defineMethod: #loadGuides: on: Doc as: [:self :dir |
  [[Globals includes: #Markdown] ifTrue: [| nil] ifFalse: [| [Module load: #markdown]]];
  let me := self;
  let gs := [[File isDir: dir]
    ifTrue: [|
      let names := [[File listDir: dir] sortBy: [:x | x]];
      [names inject: #[] into: [:acc :nm |
        [[nm endsWith: ".md"]
          ifTrue: [|
            let md := [File readText: [[dir , "/"] , nm]];
            let g := [Object clone];
            [[db cellFor: g attr: #slug]  set: [[nm split: "."] first]];
            [[db cellFor: g attr: #title] set: [me guideTitleOf: md]];
            [[db cellFor: g attr: #html]  set: [Markdown toHtml: md shiftHeadings: 1]];
            [acc add: g]]
          ifFalse: [| acc]]]]]
    ifFalse: [| #[]]];
  [[db cellFor: Doc attr: #guides] set: gs];
  gs] doc:
  "Load every `*.md` under `dir` (filename order) as a guide page: title from the first heading, body via Markdown. Answers the guides."];

// -- rendering: HTML (composes modules/html.birnam) ---------------------------

// The reference site's stylesheet: sticky sidebar + readable measure, light and
// dark via prefers-color-scheme. Pure CSS (no quotes — it rides a <style> raw).
[Reflect defineMethod: #stylesheet on: Doc as: [:self |
  [":root{--fg:#1c1c22;--bg:#ffffff;--muted:#666677;--line:#e2e2e8;--chip:#f4f4f7;--accent:#2757a8}"
    , "@media (prefers-color-scheme:dark){:root{--fg:#e8e8ee;--bg:#16161a;--muted:#9999aa;--line:#2c2c34;--chip:#232329;--accent:#7aa2e8}}"
    , "*{box-sizing:border-box}"
    , "body{margin:0;display:flex;gap:2rem;font:16px/1.55 system-ui,sans-serif;color:var(--fg);background:var(--bg)}"
    , "nav{position:sticky;top:0;height:100vh;overflow-y:auto;flex:0 0 15rem;padding:1.25rem 1rem;border-right:1px solid var(--line)}"
    , "nav h2{font-size:.72rem;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin:1.1rem 0 .3rem}"
    , "nav ul{list-style:none;margin:0;padding:0}"
    , "nav a{color:var(--fg);text-decoration:none;display:block;padding:.15rem .45rem;border-radius:4px}"
    , "nav a:hover{background:var(--chip)}"
    , "main{max-width:48rem;min-width:0;padding:1.25rem 2rem 4rem 0}"
    , "main h1{font-size:1.6rem;margin:.5rem 0 1rem}"
    , "section{border-top:1px solid var(--line);padding-top:1rem;margin-top:1.5rem}"
    , "main h2{font-size:1.25rem;margin:.2rem 0 .3rem}"
    , "main h2 a{color:inherit;text-decoration:none}"
    , "main h3{font-size:1.05rem;margin:1.2rem 0 .3rem}"
    , "main h4{font-size:.95rem;margin:1rem 0 .25rem}"
    , "main li{margin:.15rem 0}"
    , ".kind{font-size:.68rem;vertical-align:middle;background:var(--chip);color:var(--muted);border:1px solid var(--line);border-radius:99px;padding:.12rem .55rem;margin-left:.55rem;text-transform:uppercase;letter-spacing:.06em}"
    , ".summary{color:var(--muted);margin:.2rem 0 1rem}"
    , "code{font:.875em ui-monospace,monospace;background:var(--chip);padding:.1em .35em;border-radius:4px}"
    , "dl{margin:0}"
    , "dt{margin-top:.9rem}"
    , "dt code{color:var(--accent)}"
    , ".proto{font-size:.8rem;color:var(--muted);margin-left:.45rem}"
    , "dd{margin:.25rem 0 0 1rem}"
    , "details{margin-top:.3rem}"
    , "summary{cursor:pointer;font-size:.8rem;color:var(--muted)}"
    , "pre{background:var(--chip);border:1px solid var(--line);border-radius:6px;padding:.7rem .9rem;overflow-x:auto}"
    , "pre code{background:none;padding:0}"
    , "#q{width:100%;padding:.35rem .5rem;border:1px solid var(--line);border-radius:6px;background:var(--chip);color:var(--fg);font:inherit;font-size:.85rem;margin-bottom:.5rem}"
    , ".notes{margin:.4rem 0 1rem}"
    , ".notes pre{white-space:pre-wrap}"
    , "footer{margin-top:2.5rem;padding-top:1rem;border-top:1px solid var(--line);color:var(--muted);font-size:.85rem}"
    , "@media (max-width:52rem){body{flex-direction:column}nav{position:static;height:auto;flex:none;border-right:none;border-bottom:1px solid var(--line)}main{padding:0 1.25rem 3rem}}"]] doc:
  "The reference site's CSS: sticky sidebar, readable measure, light/dark via prefers-color-scheme (quote-free, rides <style> raw)."];

// The type-to-filter script: hide entries whose anchor (mod-sel) misses the
// needle, then sections with no hits and a missing name. Single-quoted JS only
// (it rides a birnam double-quoted literal into a raw <script>).
[Reflect defineMethod: #filterScript on: Doc as: [:self |
  ["var q=document.getElementById('q');"
    , "if(q){q.addEventListener('input',function(){"
    , "var needle=q.value.toLowerCase();"
    , "document.querySelectorAll('main section').forEach(function(sec){"
    , "var any=false;"
    , "sec.querySelectorAll('dt').forEach(function(dt){"
    , "var hit=needle===''||dt.id.toLowerCase().indexOf(needle)>-1;"
    , "dt.style.display=hit?'':'none';"
    , "var dd=dt.nextElementSibling;"
    , "if(dd&&dd.tagName==='DD'){dd.style.display=hit?'':'none';}"
    , "if(hit){any=true;}"
    , "});"
    , "var show=needle===''||any||sec.id.toLowerCase().indexOf(needle)>-1;"
    , "sec.style.display=show?'':'none';"
    , "});"
    , "});}"]] doc:
  "The type-to-filter JS: hides entries whose anchor misses the needle, then sections with no hits and a non-matching name."];

// One method entry: <dt id="mod-sel"><code>sel</code> on Proto</dt> then a <dd>
// with the docstring and, when the store has it, the recorded source in a
// collapsed <details> — the source IS the documentation, now on the page too.
[Reflect defineMethod: #htmlForEntry:module:sources: on: Doc as: [:self :e :modName :srcIdx |
  let sel   := [self nameOf: [[db cellFor: e attr: #sel] value]];
  let txt   := [[db cellFor: e attr: #text] value];
  let proto := [[db cellFor: e attr: #proto] value];
  let protoName := [[proto isNil] ifTrue: [| ""] ifFalse: [| [self globalNameOf: proto]]];
  let onSpan := [[protoName isEmpty]
    ifTrue:  [| ""]
    ifFalse: [| [Html tag: "span" attrs: [Html attr: "class" value: "proto"]
                      body: ["on " , [Html escape: protoName]]]]];
  let srcs := [self sourcesFor: sel proto: protoName in: srcIdx];
  let srcHtml := [[srcs isEmpty]
    ifTrue:  [| ""]
    ifFalse: [|
      let pre := [srcs inject: "" into: [:acc :s |
        [acc , [Html tag: "pre" body: [Html tag: "code" text: s]]]]];
      [Html tag: "details" body: [[Html tag: "summary" text: "source"] , pre]]]];
  [[Html tag: "dt" attrs: [Html attr: "id" value: [[modName , "-"] , sel]]
         body: [[Html tag: "code" text: sel] , onSpan]]
    , [Html tag: "dd" body: [[Html escape: txt] , srcHtml]]]] doc:
  "One entry: an anchored <dt> (#modName-sel, selector + receiver badge) and a <dd> with the docstring and any recorded source in <details>."];

// One module's section body: <h2> (self-link + native-floor badge), the summary,
// the header prose (when the source records one) in a collapsed <details>, and
// a <dl> of entries. `srcIdx` is a prebuilt `sourceIndex`.
[Reflect defineMethod: #htmlForModule:sources: on: Doc as: [:self :mod :srcIdx |
  let me := self;
  let name    := [self nameOf: mod];
  let summary := [[db cellFor: mod attr: #docSummary] value];
  let badge := [[self isRustFloor: mod]
      ifTrue:  [| [Html tag: "span" attrs: [Html attr: "class" value: "kind"] body: "Rust floor"]]
      ifFalse: [| [[self isNativeRust: mod]
        ifTrue:  [| [Html tag: "span" attrs: [Html attr: "class" value: "kind"] body: "Native Rust"]]
        ifFalse: [| ""]]]];
  let header := [self headerOf: mod];
  let notes := [[header isEmpty]
    ifTrue:  [| ""]
    ifFalse: [| [Html tag: "details" attrs: [Html attr: "class" value: "notes"]
                      body: [[Html tag: "summary" text: "module notes"]
                              , [Html tag: "pre" body: [Html tag: "code" text: header]]]]]];
  let items := [StringBuilder new];
  [[self methodsOf: mod] do: [:e |
    [items add: [me htmlForEntry: e module: name sources: srcIdx]]]];
  [[Html tag: "h2" body: [[Html tag: "a" attrs: [Html attr: "href" value: ["#" , name]] body: [Html escape: name]] , badge]]
    , [Html tag: "p" attrs: [Html attr: "class" value: "summary"] body: [Html escape: summary]]
    , [notes
    , [Html tag: "dl" body: [items asString]]]]] doc:
  "One module's section body: self-linked <h2> (+ native-floor badge), summary, header-prose notes, and a <dl> of entries (`srcIdx` = a prebuilt sourceIndex)."];

// The standalone form builds its own source index (whole-site rendering passes
// one shared index instead — see htmlIndex).
[Reflect defineMethod: #htmlForModule: on: Doc as: [:self :mod |
  [self htmlForModule: mod sources: [self sourceIndex]]] doc:
  "One module's HTML section body, standalone — builds its own source index (htmlIndex shares one instead)."];

// A sidebar list for `mods`: one <li><a href="#name">name</a></li> each.
[Reflect defineMethod: #navListFor: on: Doc as: [:self :mods |
  let sb := [StringBuilder new];
  [mods do: [:m |
    let nm := [self nameOf: m];
    [sb add: [Html tag: "li" body: [Html tag: "a" attrs: [Html attr: "href" value: ["#" , nm]] body: nm]]]]];
  [sb asString]] doc:
  "A sidebar list for `mods`: one <li><a href=\"#name\">name</a></li> each."];

// One HTML page for EVERY documented module: a grouped, name-sorted sidebar
// (birnam modules apart from native Rust sources) + a section each, styled by
// `stylesheet`. (Accumulation rides StringBuilder — `secs` is the WHOLE page
// body, the single biggest string docgen builds; an inject `,` fold would
// re-copy it per module.)
[Reflect defineMethod: #htmlIndex on: Doc as: [:self |
  let me := self;
  let mods := [self sortedModules];
  let birnamMods := [mods inject: #[] into: [:acc :m |
    [[[me isRustFloor: m] | [me isNativeRust: m]]
      ifTrue: [| acc] ifFalse: [| [acc add: m]]]]];
  let rustMods := [mods inject: #[] into: [:acc :m |
    [[me isRustFloor: m] ifTrue: [| [acc add: m]] ifFalse: [| acc]]]];
  let nativeRustMods := [mods inject: #[] into: [:acc :m |
    [[me isNativeRust: m] ifTrue: [| [acc add: m]] ifFalse: [| acc]]]];
  let srcIdx := [self sourceIndex];
  let guides := [[db cellFor: Doc attr: #guides] value];
  let nav := [StringBuilder new];
  [nav add: [Html void: "input" attrs: [[[Html attr: "id" value: "q"] , [Html attr: "type" value: "search"]]
                                          , [Html attr: "placeholder" value: "filter selectors"]]]];
  [[guides isEmpty] ifTrue: [| nil] ifFalse: [|
    [nav add: [Html tag: "h2" text: "guide"]];
    let gl := [StringBuilder new];
    [guides do: [:g |
      let slug  := [[db cellFor: g attr: #slug] value];
      let title := [[db cellFor: g attr: #title] value];
      [gl add: [Html tag: "li" body: [Html tag: "a" attrs: [Html attr: "href" value: ["#guide-" , slug]] body: [Html escape: title]]]]]];
    [nav add: [Html tag: "ul" body: [gl asString]]]]];
  [nav add: [Html tag: "h2" text: "modules"]];
  [nav add: [Html tag: "ul" body: [me navListFor: birnamMods]]];
  [[rustMods isEmpty] ifTrue: [| nil] ifFalse: [|
    [nav add: [Html tag: "h2" text: "Rust floor"]];
    [nav add: [Html tag: "ul" body: [me navListFor: rustMods]]]]];
  [[nativeRustMods isEmpty] ifTrue: [| nil] ifFalse: [|
    [nav add: [Html tag: "h2" text: "Native Rust"]];
    [nav add: [Html tag: "ul" body: [me navListFor: nativeRustMods]]]]];
  let secs := [StringBuilder new];
  [secs add: [Html tag: "h1" text: "birnam documentation"]];
  [guides do: [:g |
    let slug := [[db cellFor: g attr: #slug] value];
    [secs add: [Html tag: "section"
                     attrs: [[Html attr: "id" value: ["guide-" , slug]] , [Html attr: "class" value: "guide"]]
                     body: [[db cellFor: g attr: #html] value]]]]];
  [mods do: [:m |
    [secs add: [Html tag: "section" attrs: [Html attr: "id" value: [me nameOf: m]] body: [me htmlForModule: m sources: srcIdx]]]]];
  let docCount := [mods inject: 0 into: [:acc :m | [acc + [[me methodsOf: m] size]]]];
  let gapCount := [self undocumentedSelectorCountIn: srcIdx];
  let stats := [[[[[mods size] printString] , " modules — "] , [[docCount printString] , " documented selectors — "]]
                 , [[gapCount printString] , " recorded selectors still source-only"]];
  [secs add: [Html tag: "footer" body: [Html escape: stats]]];
  let body := [[[Html tag: "nav" body: [nav asString]] , [Html tag: "main" body: [secs asString]]]
                , [Html tag: "script" body: [self filterScript]]];
  [Html page: "birnam documentation" style: [self stylesheet] body: body]] doc:
  "The whole reference page: filter box, grouped name-sorted nav, a section per documented module, coverage footer — styled and scripted."];

// The supported runtime modules. This is intentionally an identity catalog,
// not a directory scan: repository files are build inputs, while installed
// compiled units are the runtime authority.
[Reflect defineMethod: #productionModules on: Doc as: [:self |
  #[#cli #file #html #http #json #log #lsp #markdown #os #process #random #repl #socket #time #nativedoc]] doc:
  "The canonical production-module identities included in the Birnam runtime bundle."];

[Reflect defineMethod: #isProductionModule: on: Doc as: [:self :name |
  [[self productionModules] includes: name]] doc:
  "True iff `name` is a supported production module identity in the runtime bundle."];

// The floor units boot before Doc exists, so their doc: sends were intentionally
// dropped. Re-run those exact compiled units now: identical source metadata and
// method installs are idempotent, while their documentation registrations land.
[Reflect defineMethod: #loadFloorDocs on: Doc as: [:self |
  [#[#stdlib #toml #config] inject: self into: [:acc :name |
    [[acc isError]
      ifTrue:  [| acc]
      ifFalse: [| [Codegen load: [Module dylibPathFor: name]]]]]]] doc:
  "Replay the compiled stdlib, Toml, and Config units after Doc exists so their reference registrations land without loose source."];

// Load every supported runtime module from its compiled unit so doc:
// registrations and embedded source metadata enter the current image.
[Reflect defineMethod: #loadAllModules on: Doc as: [:self |
  let floor := [self loadFloorDocs];
  [[floor isError]
    ifTrue:  [| floor]
    ifFalse: [|
      let loaded := [[self productionModules] inject: self into: [:acc :name |
        [[acc isError] ifTrue: [| acc] ifFalse: [| [Module load: name]]]]];
      [[loaded isError]
        ifTrue:  [| loaded]
        ifFalse: [|
          [#[#compiledUnitDocs #concurrencyDocs] inject: self into: [:answer :name |
            [[answer isError] ifTrue: [| answer] ifFalse: [| [Module load: name]]]]]]]]]] doc:
  "Load every supported runtime module from its compiled unit so its documentation and source metadata become visible. Answers self."];

// Build the full HTML reference to `out`: load the compiled production closure,
// extract the separately shipped Cargo workspace docs, load authored guides,
// then write `htmlIndex`. Answers `out`.
[Reflect defineMethod: #buildSite:rustWorkspace:guides: on: Doc as: [:self :out :rw :gd |
  let me := self;
  let loaded := [self loadAllModules];
  [[loaded isError]
    ifTrue:  [| loaded]
    ifFalse: [|
      [self loadGuides: gd];
      [NativeDoc scanRustWorkspace: rw];
      [File write: out contents: [me htmlIndex]];
      out]]] doc:
  "Build the full HTML reference to `out`: load compiled production modules, guides, and every installed Rust workspace crate, then write htmlIndex. Answers `out`."];

// module:is: predates the #doc registration above (it IS the registrar), so its
// docstring rides the appended path instead of a doc: define:
[Doc for: #module:is: in: #doc says: "Register `mod` with a one-line `summary`: marks it documented, seeds its cells, and makes it the CURRENT module for doc: definitions. Call once, first — calling again resets the method list."]
