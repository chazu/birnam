// Each request gets its own failure cell; no shared parser or publication state.
[Reflect defineMethod: #failure on: ImageFormat as: [:self |
  [self value]
]];
[Reflect defineMethod: #reject: on: ImageFormat as: [:self :error |
  let cell := self;
  [[[cell value] isNil] ifTrue: [| [cell set: error]]]; [cell value]
]];
[Reflect defineMethod: #checked: on: ImageFormat as: [:self :body |
  [[[self failure] isNil] ifTrue: [|
    let result := [body value];
    [[result isError] ifTrue: [| [self reject: result]]];
    [[[self failure] isNil] ifTrue: [| result] ifFalse: [| [self failure]]]]
  ifFalse: [| [self failure]]]
]];
[Reflect defineMethod: #worker on: ImageFormat as: [:self |
  [db localCell: nil prototype: self]
]];
[Reflect defineMethod: #inspect:architecture:abi: on: ImageFormat as: [:self :bytes :architecture :abi |
  [[self worker] inspectBytes: bytes architecture: architecture abi: abi]
]];
[Reflect defineMethod: #compose: on: ImageFormat as: [:self :fields |
  [[self worker] composeFields: fields]
]];
