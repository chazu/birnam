// stdlib-test.birnam — the test suite for the SELF-HOSTED string protocol in
// src/id/stdlib.birnam (docs/design/44 Phase 2): isEmpty/notEmpty (via
// Collection), startsWith:/endsWith:, includesSubstring: (over the native
// indexOf: scanner), words, and the derived do:/inject:into: fold. The edge
// cases here are the byte-for-byte oracle the migration was verified against —
// they pin the OLD native semantics (arg guards answer false/#[self], never
// error). Loading only registers the suite; run via modules/run-tests.birnam.

[[Globals includes: #TestSuite] ifTrue: [| nil] ifFalse: [| [System load: "modules/test.birnam"]]];

let s := [TestSuite named: "Stdlib" module: #stdlib];

[s test: "isEmpty / notEmpty ride Collection" do: [:t |
  [t expect: ["" isEmpty]   equals: true  describes: "empty isEmpty"];
  [t expect: ["x" isEmpty]  equals: false describes: "non-empty isEmpty"];
  [t expect: ["" notEmpty]  equals: false describes: "empty notEmpty"];
  [t expect: ["x" notEmpty] equals: true  describes: "non-empty notEmpty"]]];

[s test: "first / last / at:ifAbsent: ride Collection (the tier-A surface lift)" do: [:t |
  [t expect: [#[7 8 9] first] equals: 7 describes: "vector first"];
  [t expect: [#[7 8 9] last]  equals: 9 describes: "vector last"];
  [t expect: [[#[] first] isNil] equals: true describes: "empty vector first is nil"];
  [t expect: [#[7 8 9] at: 1 ifAbsent: [| 99]] equals: 8 describes: "in-range index answers the element"];
  [t expect: [#[7 8 9] at: 3 ifAbsent: [| 99]] equals: 99 describes: "past-end runs the block"];
  [t expect: [#[7 8 9] at: -1 ifAbsent: [| 99]] equals: 99 describes: "negative runs the block"];
  [t expect: [[1 to: 4] first] equals: 1 describes: "range first"];
  [t expect: [[1 to: 4] last]  equals: 4 describes: "range last"];
  [t expect: ["abc" first] equals: "a" describes: "string first (new, via Collection)"];
  [t expect: [{#a -> 1} at: #a ifAbsent: [| 9]] equals: 1 describes: "map keeps its key-based native at:ifAbsent:"]]];

[s test: "StringBuilder: bulk add, coercion, addByte:, addLine:, addAll:, joined" do: [:t |
  let sb := [StringBuilder new];
  [[[sb add: "ab"] add: 42] addByte: 33];
  [t expect: [sb asString] equals: "ab42!" describes: "add coerces via printString; addByte appends raw"];
  [t expect: [sb size] equals: 5 describes: "size counts bytes"];
  [t expect: [[StringBuilder new] asString] equals: "" describes: "empty builder is the empty string"];
  [t expect: [[StringBuilder new] isEmpty] equals: true describes: "isEmpty rides size"];
  [t expect: [#["a" "b" "c"] joined] equals: "abc" describes: "Collection joined is the O(n) fold"];
  let lb := [StringBuilder new];
  [lb addLine: "x"];
  [t expect: [lb size] equals: 2 describes: "addLine: appends the newline"];
  let s2 := [StringBuilder new];
  [s2 addAll: #["x" 1 "y"]];
  [t expect: [s2 asString] equals: "x1y" describes: "addAll: appends each element in order"]]];

[s test: "asUppercase / asLowercase: birnam over the builder, old semantics pinned" do: [:t |
  [t expect: ["HeLLo" asLowercase] equals: "hello" describes: "asLowercase folds A-Z"];
  [t expect: ["HeLLo" asUppercase] equals: "HELLO" describes: "asUppercase folds a-z"];
  [t expect: ["" asUppercase] equals: "" describes: "empty stays empty"];
  [t expect: ["a1! Z" asUppercase] equals: "A1! Z" describes: "non-letters pass through"];
  [t expect: ["a1! Z" asLowercase] equals: "a1! z" describes: "non-letters pass through (lower)"]]];

[s test: "startsWith: incl. empty prefix, too-long prefix, non-String" do: [:t |
  [t expect: ["hello" startsWith: "he"]     equals: true  describes: "plain prefix"];
  [t expect: ["hello" startsWith: "hello"]  equals: true  describes: "whole string"];
  [t expect: ["hello" startsWith: "hellox"] equals: false describes: "longer than receiver"];
  [t expect: ["hello" startsWith: ""]       equals: true  describes: "empty prefix always true"];
  [t expect: ["hello" startsWith: 42]       equals: false describes: "non-String answers false"];
  [t expect: ["" startsWith: ""]            equals: true  describes: "empty on empty"]]];

[s test: "endsWith: incl. empty suffix, too-long suffix, non-String" do: [:t |
  [t expect: ["hello" endsWith: "lo"]     equals: true  describes: "plain suffix"];
  [t expect: ["hello" endsWith: ""]       equals: true  describes: "empty suffix always true"];
  [t expect: ["hello" endsWith: "xhello"] equals: false describes: "longer than receiver"];
  [t expect: ["hello" endsWith: #sym]     equals: false describes: "non-String answers false"]]];

[s test: "includesSubstring: over the native indexOf: scanner" do: [:t |
  [t expect: ["hello" includesSubstring: "ell"] equals: true  describes: "inner hit"];
  [t expect: ["hello" includesSubstring: "xyz"] equals: false describes: "miss"];
  [t expect: ["hello" includesSubstring: ""]    equals: true  describes: "empty needle is everywhere"];
  [t expect: ["hello" includesSubstring: nil]   equals: false describes: "non-String answers false"]]];

[s test: "words drops empty runs, keeps punctuation attached" do: [:t |
  [t expect: ["  the  cat sat\n" words] equals: #["the" "cat" "sat"] describes: "runs split, empties dropped"];
  [t expect: [["   " words] size] equals: 0 describes: "all-whitespace has no words"];
  [t expect: [["" words] size]    equals: 0 describes: "empty has no words"];
  [t expect: ["one" words]        equals: #["one"] describes: "single unpadded word"]]];

[s test: "string do: / inject:into: fold the 1-byte characters in order" do: [:t |
  [t expect: ["xyz" inject: "" into: [:acc :c | [acc , c]]] equals: "xyz" describes: "inject rejoins in order"];
  [t expect: ["hello" inject: 0 into: [:acc :c |
      [[c = "l"] ifTrue: [| [acc + 1]] ifFalse: [| acc]]]] equals: 2 describes: "inject counts"];
  [t expect: ["" inject: 99 into: [:acc :c | 0]] equals: 99 describes: "empty string answers the seed"];
  [t expect: ["ab" do: [:c | nil]] equals: "ab" describes: "do: answers self"]]];

// The Collection protocol arrives on String through the derived fold.
[s test: "String answers the whole Collection protocol via the derived fold" do: [:t |
  [t expect: ["abc" asVector] equals: #["a" "b" "c"] describes: "asVector"];
  [t expect: ["abc" collect: [:c | [c , "!"]]] equals: #["a!" "b!" "c!"] describes: "collect:"];
  [t expect: ["hello" count: [:c | [c = "l"]]] equals: 2 describes: "count:"];
  [t expect: ["hello" detect: [:c | [c = "e"]]] equals: "e" describes: "detect:"]]];

// The tier-B lift boundary (docs/44 §7, measured 2026-07-12): includes: and
// asVector are stdlib.birnam now; reversed/copyFrom:to: stayed native (the
// derived per-row loops failed the gate) — the whole surface is pinned HERE
// either way, so a future re-lift is behavior-checked by this block.
[s test: "tier-B boundary: reversed / copyFrom:to: / includes: / asVector" do: [:t |
  [t expect: [#[1 2 3] reversed] equals: #[3 2 1] describes: "reversed"];
  [t expect: [#[] reversed] equals: #[] describes: "empty reversed"];
  [t expect: [#[1 2 3 4] copyFrom: 1 to: 3] equals: #[2 3] describes: "copyFrom:to: is half-open"];
  [t expect: [#[1 2 3] copyFrom: 0 to: 0] equals: #[] describes: "empty slice"];
  [t expect: [#[1 2 3] copyFrom: 2 to: 1] equals: nil describes: "to < from answers nil"];
  [t expect: [#[1 2 3] copyFrom: 0 to: 9] equals: nil describes: "past-end answers nil"];
  [t expect: [#[1 2 3] includes: 2] equals: true describes: "includes: hit"];
  [t expect: [#[1 2 3] includes: 9] equals: false describes: "includes: miss"];
  [t expect: [#[1.5 2.5] includes: 1.5] equals: true
     describes: "includes: rides indexOf:'s keyEq — Floats by VALUE (the keyEq wart is fixed)"];
  [t expect: [#[1.5 2.5] indexOf: 2.5] equals: 1 describes: "indexOf: finds an equal-valued Float"];
  [t expect: [#[1.5] includes: 1.25] equals: false describes: "unequal Floats still miss"];
  [t expect: [#[1.5] includes: 1] equals: false describes: "per-type: an Integer never equals a Float key"];
  [t expect: [[1 to: 3] asVector] equals: #[1 2 3] describes: "Range asVector (Collection derived)"];
  [t expect: [[3 to: 1] asVector] equals: #[] describes: "empty Range asVector"];
  let v := #[1 2];
  [t expect: [v asVector] equals: v describes: "Vector asVector is the identity"]]];

// The perf-retained native scanners keep their exact contract (they are the
// floor under includesSubstring: and NativeDoc's bulk sweeps).
[s test: "native scanners: split: / trimmed / indexOf: contracts hold" do: [:t |
  [t expect: ["a,,b" split: ","]  equals: #["a" "" "b"] describes: "split keeps empty parts"];
  [t expect: [["" split: ","] size] equals: 1 describes: "split of empty is #[\"\"]"];
  [t expect: ["abc" split: 42]    equals: #["abc"] describes: "non-String separator answers #[self]"];
  [t expect: ["  hi  " trimmed]   equals: "hi" describes: "trimmed"];
  [t expect: ["   " trimmed]      equals: "" describes: "all-whitespace trims to empty"];
  [t expect: ["hello" indexOf: "lo"] equals: 3 describes: "indexOf: substring"];
  [t expect: ["hello" indexOf: "z"]  equals: nil describes: "indexOf: miss is nil"];
  [t expect: ["hello" indexOf: ""]   equals: 0 describes: "empty needle answers 0"]]];

// bracketDepth is the REPLs' form reader (modules/repl.birnam `isBalanced:`):
// net [/{ nesting, blind to brackets inside strings and // comments.
[s test: "native scanners: bracketDepth counts [/{ outside strings and comments" do: [:t |
  [t expect: ["[3 + 4]" bracketDepth]   equals: 0 describes: "balanced form"];
  [t expect: ["" bracketDepth]          equals: 0 describes: "empty is balanced"];
  [t expect: ["let x := [#[1 2" bracketDepth] equals: 2 describes: "two open"];
  [t expect: ["{ #a -> [b" bracketDepth] equals: 2 describes: "brace + bracket open"];
  [t expect: ["[\"a ] b\"]" bracketDepth] equals: 0 describes: "bracket inside a string ignored"];
  [t expect: ["[\"unterminated" bracketDepth] equals: 1 describes: "unterminated string holds it open"];
  [t expect: ["[\"esc \\\" ] \"]" bracketDepth] equals: 0 describes: "escaped quote stays in-string"];
  [t expect: ["[1] // a ] comment [" bracketDepth] equals: 0 describes: "brackets in a // comment ignored"];
  [t expect: ["[1 // open
]" bracketDepth] equals: 0 describes: "a // comment ends at its newline"];
  [t expect: ["a]" bracketDepth] equals: -1 describes: "over-closed goes negative"]]];

[s test: "Reflect nameOf: answers a symbol's bare name (the mirror's un-intern)" do: [:t |
  [t expect: [Reflect nameOf: #stdlib] equals: "stdlib" describes: "bare name, no sigil"];
  [t expect: [Reflect nameOf: #named:requires:] equals: "named:requires:" describes: "keyword selector keeps its colons"];
  [t expect: [[Reflect nameOf: "str"] kind] equals: #notASymbol describes: "a non-symbol answers the kinded error"]]];

[s test: "Reflect globalNamed: resolves canonical exported globals" do: [:t |
  let system := [Reflect globalNamed: #System];
  [t expect: [system == System] equals: true describes: "the canonical export wins over a persisted namesake"];
  let println := [[Reflect allMethodsOf: system] detect: [:entry |
    [[entry at: #selector] = #println:]]];
  [t expect: [println at: #target] equals: #System describes: "native System protocol remains visible"]]];

// Appending "" must be a no-op even on a FRESH builder (backing still null) —
// pinned because inline-markup folds add empty segments routinely.
[s test: "StringBuilder add: of an empty string is a safe no-op" do: [:t |
  let sb := [StringBuilder new];
  [sb add: ""];
  [t expect: [sb asString] equals: "" describes: "fresh builder + empty add"];
  [[sb add: "x"] add: ""];
  [t expect: [sb asString] equals: "x" describes: "empty add after content"]]];

// String < is byte-order strcmp: first unequal byte decides, a fully shared
// prefix defers to length, and it doubles as the `sortBy:` key protocol.
[s test: "String < is lexicographic byte order (a sortBy: key)" do: [:t |
  [t expect: ["abc" < "abd"] equals: true  describes: "first unequal byte decides"];
  [t expect: ["abd" < "abc"] equals: false describes: "and in the other direction"];
  [t expect: ["ab" < "ab"]   equals: false describes: "equal strings are not <"];
  [t expect: ["ab" < "abc"]  equals: true  describes: "shared prefix: shorter first"];
  [t expect: ["abc" < "ab"]  equals: false describes: "shared prefix: longer is not <"];
  [t expect: ["" < "a"]      equals: true  describes: "empty sorts before everything"];
  [t expect: ["" < ""]       equals: false describes: "empty is not < empty"];
  [t expect: ["B" < "a"]     equals: true  describes: "byte order, not case-folded (B=66 < a=97)"];
  [t expect: [[#[ "peg" "cli" "alien" ] sortBy: [:x | x]] printString]
     equals: "#[alien cli peg]" describes: "String keys drive sortBy:"]]];

[s test: "Reflect explores effective methods and live facts" do: [:t |
  let methods := [Reflect allMethodsOf: String];
  [t expect: [[methods size] > 0] equals: true describes: "method enumeration is non-empty"];
  let method := [methods detect: [:entry |
    [[entry at: #selector] = #asUppercase]]];
  [t expect: [method at: #target] equals: #String describes: "method names its source target"];
  [t expect: [[Reflect methodSource: method] notNil] equals: true describes: "method source is available"];
  let person := [Object clone];
  [db assert: person attr: #name value: "Ada"];
  let facts := [Reflect factsOf: person];
  [t expect: [facts size] equals: 1 describes: "factsOf: returns current live facts"];
  [t expect: [[facts at: 0] at: #value] equals: "Ada" describes: "fact map exposes its value"];
  [t assert: [[[facts at: 0] at: #entity] == person] describes: "fact map retains entity identity"];
  [t expect: [[facts at: 0] at: #attribute] equals: #name describes: "fact map names its attribute"];
  [db assert: #reflectionTag attr: #cardinality value: #many];
  [db assert: person attr: #reflectionTag value: #kept];
  [db assert: person attr: #reflectionTag value: #removed];
  [db retract: person attr: #reflectionTag value: #removed];
  [db assert: person attr: #boundNil value: nil];
  let current := [Reflect factsOf: person];
  [t expect: [current size] equals: 3 describes: "live facts exclude retractions and retain bound nil"];
  let tag := [current detect: [:row | [[row at: #attribute] = #reflectionTag]]];
  [t expect: [tag at: #value] equals: #kept describes: "many-valued facts remain separate rows"];
  let bound := [current detect: [:row | [[row at: #attribute] = #boundNil]]];
  [t assert: [[bound includesKey: #value] & [[bound at: #value] isNil]] describes: "a nil fact still has a value key"]]];

[s test: "fact reflection follows Store replacement and roots collecting callbacks" do: [:t |
  let person := [Object clone];
  [db assert: person attr: #name value: "Grace"];
  let original := [db methodFor: #liveTriplesDo:];
  [Reflect defineMethod: #liveTriplesDo: on: db as: [:self :visitor |
    [System gc]; [original invokeOn: self arguments: #[visitor]]]];
  let facts := [Reflect factsOf: person];
  [Reflect removeMethod: #liveTriplesDo: on: db];
  [System gc];
  [t expect: [facts size] equals: 1 describes: "collecting Store replacement is observed"];
  [t assert: [[[facts at: 0] at: #entity] == person] describes: "fact snapshot survives collection"];
  [Reflect defineMethod: #liveTriplesDo: on: db as: [:self :visitor | [Error kind: #reflectionSnapshot]]];
  let failure := [Reflect factsOf: person];
  [Reflect removeMethod: #liveTriplesDo: on: db];
  [t expect: [failure kind] equals: #reflectionSnapshot describes: "Store snapshot failure propagates"]]];

// The floor's doesNotUnderstand: answers a kinded #doesNotUnderstand error for
// ANY arity. Dispatch forwards an unbound send as [selector, arg0, …], so the
// handler sees 1 + argc arguments; a guard that demanded exactly 1 made every
// keyword and binary send answer nil, and a renamed selector then read as a
// silent nil at the call site instead of an error naming it.
[s test: "an unbound selector errors at every arity, not just unary" do: [:t |
  let o := [Object clone];
  let unary := [o zzzUnknown];
  [t expect: [unary isError] equals: true describes: "unary send errors"];
  [t expect: [[unary kind] printString] equals: "#doesNotUnderstand" describes: "kinded #doesNotUnderstand"];
  let keyword := [o zzzUnknown: 1];
  [t expect: [keyword isError] equals: true describes: "one-keyword send errors"];
  [t expect: [[keyword kind] printString] equals: "#doesNotUnderstand" describes: "same kind"];
  [t assert: [[keyword message] includesSubstring: "zzzUnknown:"] describes: "the message names the selector, colon and all"];
  let four := [o zzzA: 1 zzzB: 2 zzzC: 3 zzzD: 4];
  [t expect: [four isError] equals: true describes: "four-keyword send errors"];
  [t assert: [[four message] includesSubstring: "zzzA:zzzB:zzzC:zzzD:"] describes: "the whole keyword selector is named"];
  let binary := [o ~~ 1];
  [t expect: [binary isError] equals: true describes: "binary send errors"];
  [t expect: [[binary kind] printString] equals: "#doesNotUnderstand" describes: "binary is the same kind"]]];

// Runtime method installation derives the trampoline's arity from the selector.
// A binary operator carries no colons, so counting colons alone read `#|>` as
// unary and handed its two-parameter block a `value:` — every binary method
// defined outside an AOT artifact answered #doesNotUnderstand instead of
// running. Only the from-source path was affected, which is why stdlib's own
// `|>` worked while an override of it could not.
[s test: "a binary operator can be defined at runtime, not only ahead of time" do: [:t |
  let p := [Object clone];
  [Reflect defineMethod: #@@ on: p as: [:self :other | [other + 1]]];
  [t expect: [p @@ 41] equals: 42 describes: "a fresh binary selector dispatches with its argument"];
  [Reflect defineMethod: #|> on: p as: [:self :block | "overridden"]];
  [t expect: [p |> [:x | x]] equals: "overridden" describes: "a prototype can override Object's |>"];
  [t expect: [5 |> [:x | [x + 1]]] equals: 6 describes: "Object's |> is untouched by the override"]]];

[s test: "thread control combinators transform, observe, and preserve errors" do: [:t |
  let seen := [0 asCell];
  [t expect: [5 tap: [:x | [seen set: x]]] equals: 5 describes: "tap: answers its receiver"];
  [t expect: [seen value] equals: 5 describes: "tap: evaluates its block with the receiver"];
  [t expect: [5 when: [:x | [x odd]] apply: [:x | [x + 1]]] equals: 6 describes: "when:apply: transforms when true"];
  [t expect: [4 when: [:x | [x odd]] apply: [:x | 99]] equals: 4 describes: "when:apply: otherwise preserves self"];
  [t expect: [4 unless: [:x | [x odd]] apply: [:x | [x + 1]]] equals: 5 describes: "unless:apply: transforms when false"];
  [t expect: [5 unless: [:x | [x odd]] apply: [:x | 99]] equals: 5 describes: "unless:apply: otherwise preserves self"];
  let err := ["stop" error: #threadControl];
  let calls := [0 asCell];
  [t assert: [[err tap: [:x | [calls inc]]] == err] describes: "tap: preserves error identity"];
  [t assert: [[err when: [:x | [calls inc]; true] apply: [:x | [calls inc]]] == err]
     describes: "when:apply: preserves error identity"];
  [t assert: [[err unless: [:x | [calls inc]; false] apply: [:x | [calls inc]]] == err]
     describes: "unless:apply: preserves error identity"];
  [t assert: [[err juxt: #[[:x | [calls inc]]]] == err] describes: "juxt: preserves error identity"];
  [t expect: [calls value] equals: 0 describes: "no control-combinator user block runs on an error"]]];

[s test: "Map persistent update and absence combinators" do: [:t |
  let base := {#a -> 1 #b -> 2};
  [t expect: [base update: #a with: [:x | [x + 9]]] equals: {#a -> 10 #b -> 2}
     describes: "update:with: transforms a bound value"];
  [t expect: [[base update: #missing with: [:x | x]] kind] equals: #notFound
     describes: "update:with: reports a missing key"];
  [t expect: [base update: #missing with: [:x | x] ifAbsent: [| #fallback]] equals: #fallback
     describes: "the explicit absence block supplies the operation result"];
  [t expect: [base removeKey: #a] equals: {#b -> 2} describes: "removeKey: drops one binding"];
  [t expect: [base merge: {#b -> 20 #c -> 30}] equals: {#a -> 1 #b -> 20 #c -> 30}
     describes: "merge: is right-biased"];
  [t expect: [base pick: #[#b #missing]] equals: {#b -> 2} describes: "pick: keeps requested bound keys"];
  [t expect: [base omit: #[#b #missing]] equals: {#a -> 1} describes: "omit: drops requested keys"];
  let nested := [[Map new] atPath: #[#a #b #c] put: 7];
  [t expect: [nested atPath: #[#a #b #c] ifAbsent: [| 99]] equals: 7 describes: "atPath:put: and atPath:ifAbsent: agree"];
  [t expect: [nested atPath: #[#a #x] ifAbsent: [| 99]] equals: 99 describes: "a missing path runs one fallback"];
  [t expect: [{#a -> 1 #b -> 2} atAny: #[#x #b #a] ifAbsent: [| 99]] equals: 2
     describes: "atAny:ifAbsent: chooses the first bound key"];
  [t expect: [base atAny: #[#x #y] ifAbsent: [| 99]] equals: 99 describes: "atAny:ifAbsent: falls back once"]]];

[s test: "structural combinators derive vectors and groups" do: [:t |
  [t expect: [3 juxt: #[[:x | [x + 1]] [:x | [x * 2]]]] equals: #[4 6]
     describes: "juxt: applies every block to one receiver"];
  [t expect: [#[1 2 3 4 5] groupBy: [:x | [x mod: 2]]]
     equals: {0 -> #[2 4] 1 -> #[1 3 5]} describes: "groupBy: retains input order within buckets"];
  [t expect: [[3 to: 1] sortBy: [:x | x]] equals: #[] describes: "general sortBy: returns a Vector"];
  [t expect: [#[1 2 3 4 5] uniqueBy: [:x | [x mod: 3]]] equals: #[1 2 3]
     describes: "uniqueBy: retains the first value per derived key"];
  [t expect: [#[1 2 3] zip: #[10 20] with: [:a :b | [a + b]]] equals: #[11 22]
     describes: "zip:with: stops at the shorter collection"]]];
