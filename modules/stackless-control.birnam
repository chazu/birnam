[Reflect defineMethod: #serviceTask on: prototype as: [:self | [model slot: serviceTaskSlot in: self]]];
[Reflect defineMethod: #serviceTask: on: prototype as: [:self :value |
  [model slot: serviceTaskSlot in: self put: value]; self
