// Executor fields describe this process. Retained views still refer to the
// same owner after restore, whose fields are reset just as the former transient
// fields were. initialize supplies the normal queue/quantum defaults lazily.
[Reflect defineMethod: #imagePayload on: TaskExecutor as: [:self |
  [ObjectModel newSlots: #[nil nil nil nil nil nil] parent: ObjectVt]
]];
[TaskExecutor queue: #[]];
[TaskExecutor ingress: #[]];
[TaskExecutor draining: false];
[TaskExecutor current: nil];
[TaskExecutor quantum: 128];
[Reflect defineMethod: #initialize on: TaskExecutor as: [:self |
  [[[self queue] isNil] ifTrue: [|
    [self queue: #[]];
    [self ingress: #[]];
    [self draining: false];
    [self quantum: 128];
    [self current: nil]]];
  self]];
[Reflect defineMethod: #quantum on: TaskExecutor as: [:self |
  [self initialize];
  [self storedQuantum]]];
// Only the executing task needs a transition guard. Host executor work and
// synchronous native callbacks already run without another task being selected.
[Reflect defineMethod: #transition: on: TaskExecutor as: [:self :body |
  let task := [self current];
  [[task isNil]
    ifTrue: [| [body value]]
    ifFalse: [|
      let machine := [task machine];
      [[machine isNil]
        ifTrue: [| [body value]]
        ifFalse: [|
          [[[machine executionState] = #running]
            ifTrue: [|
              [[task canControl]
                ifTrue: [| [task transition: body]]
                ifFalse: [| [body value]]]]
            ifFalse: [| [body value]]]]]]]]];

[Reflect defineMethod: #enqueue: on: TaskExecutor as: [:self :job |
  [TaskExecutor transition: [|
    [self initialize];
    [self queue: [[self queue] add: job]];
    self]]]];
// Queue notifications; never recursively drive another task from a completing
// child's native entry. Each drive returns before the next task can run.
[Reflect defineMethod: #hasWork on: TaskExecutor as: [:self |
  [[[[self queue] size] > 0]
    ifTrue: [| true]
    ifFalse: [|
      [[[[self ingress] size] > 0]
        ifTrue: [| true]
        ifFalse: [|
          let task := [self serviceTask];
          [[task isNil] ifTrue: [| false] ifFalse: [| [[task pollOutcome] isNil]]]]]]]]];
[Reflect defineMethod: #watch: on: TaskExecutor as: [:self :task |
  [self transition: [|
    [self ingress: [[self ingress] add: task]];
    [self field: #ingress]]]]];
[Reflect defineMethod: #pollIngress on: TaskExecutor as: [:self |
  let service := [self serviceTask];
  [[service notNil] ifTrue: [|
    let control := [Isolate pollServiceControl];
    [[control = true] ifTrue: [| [service cancel: #remoteCancellation]]];
    [[control = #ownerLost] ifTrue: [| [service cancel: #ownerLost]]]]];
  [[self ingress] do: [:task | [task pollExternal]]];
  [self ingress: [[self ingress] select: [:task |
    [[task externalResult] isNil]]]];
  self]];
[Reflect defineMethod: #idle on: TaskExecutor as: [:self |
  [Isolate idleFor: 1]]];
[Reflect defineMethod: #driveNext on: TaskExecutor as: [:self |
  let queue := [self queue];
  let job := [queue at: 0];
  [self queue: [queue copyFrom: 1 to: [queue size]]];
  let task := [job at: 0];
  [self current: task];
  let progress := [task drive: job];
  [self current: nil];
  progress]];
[Reflect defineMethod: #drain on: TaskExecutor as: [:self |
  [self initialize];
  [[self draining]
    ifTrue: [| nil]
    ifFalse: [|
      [self draining: true];
      let result := [[| [self hasWork]] whileTrue: [|
        [self pollIngress];
        [[[[self queue] size] > 0]
          ifTrue: [| [self driveNext]]
          ifFalse: [| [[self hasWork] ifTrue: [| [self idle]]]]]]];
      [self draining: false];
      result]]]];


[Reflect defineMethod: #prepare:parent: on: TaskControl as: [:self :body :parent |
  let task := [self clone];
  [ObjectModel slot: 0 in: task put: true];
  [task machine: [Machine new]];
  [task outcome: nil];
  [task waitToken: nil];
  [task shieldDepth: 0];
  [task failures: #[]];
  [task failureSources: #[]];
  [task childFailures: #[]];
  [task cancelled: false];
  [task cancelReason: nil];
  [task parent: parent];
  [task children: #[]];
  [task waiters: #[]];
  [task body: body];
  [task joining: false];
  [task protectedFromParent: false];
  [task controlError: nil];
