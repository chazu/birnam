[[|
let names := #[#queue #ingress #draining #current #quantum #serviceTask];
let fieldView := TaskField;
let indices := {#queue -> 0, #ingress -> 1, #draining -> 2, #current -> 3, #quantum -> 4, #serviceTask -> 5};
let prototype := [ObjectModel newSlots: #[nil nil nil nil nil nil] parent: ObjectVt];
[Reflect defineMethod: #slotNames on: prototype as: [:self | names]];
[Reflect defineMethod: #field: on: prototype as: [:self :name |
  let index := [indices at: name];
  [[index isError] ifTrue: [| index] ifFalse: [|
    [[index isNil] ifTrue: [| [Error kind: #unknownSlot]] ifFalse: [|
      [fieldView owner: self slot: index]
    ]]
  ]]
]];
// Internal state access uses ordinary replaceable owner methods. Explicit
// field: callers retain views of these same slots. Captures are values, not methods.
let model := ObjectModel;
let queueSlot := 0;
[Reflect defineMethod: #queue on: prototype as: [:self | [model slot: queueSlot in: self]]];
[Reflect defineMethod: #queue: on: prototype as: [:self :value |
  [model slot: queueSlot in: self put: value]; self
]];
let ingressSlot := 1;
[Reflect defineMethod: #ingress on: prototype as: [:self | [model slot: ingressSlot in: self]]];
[Reflect defineMethod: #ingress: on: prototype as: [:self :value |
  [model slot: ingressSlot in: self put: value]; self
]];
let drainingSlot := 2;
[Reflect defineMethod: #draining on: prototype as: [:self | [model slot: drainingSlot in: self]]];
[Reflect defineMethod: #draining: on: prototype as: [:self :value |
  [model slot: drainingSlot in: self put: value]; self
]];
let currentSlot := 3;
[Reflect defineMethod: #current on: prototype as: [:self | [model slot: currentSlot in: self]]];
[Reflect defineMethod: #current: on: prototype as: [:self :value |
  [model slot: currentSlot in: self put: value]; self
]];
let quantumSlot := 4;
[Reflect defineMethod: #storedQuantum on: prototype as: [:self | [model slot: quantumSlot in: self]]];
[Reflect defineMethod: #quantum: on: prototype as: [:self :value |
  [model slot: quantumSlot in: self put: value]; self
]];
