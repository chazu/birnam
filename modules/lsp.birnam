// lsp.birnam — a Language Server for birnam, over stdio, in pure birnam.
//
// Speaks LSP (JSON-RPC + `Content-Length` framing) on stdin/stdout, backed by the
// pure-birnam Json module. The first project-aware slice adds read-only workspace
// resolution, per-document project contexts, UTF-16 coordinates, full-document
// versions, and bounded document retention. It performs parse-only diagnostics
// on open/save; change notifications only retain text so completion requests are
// never queued behind a full diagnostic pass. Source-backed navigation reads
// retained open buffers and never activates code.
// Lifecycle, document synchronization, diagnostics, hover, and source-backed
// navigation are handled; unsupported requests answer method-not-found.
//
// DEPENDENCIES — load first (needs Json + the self-hosted stdlib):
//   [Module load: #lsp];
//   [Lsp serveStdio]                       "blocks, reading LSP messages from stdin"
// Or just run examples/lsp-server.birnam. Point your editor's LSP client (e.g.
// Emacs lsp-mode) at that command, from the repo root. STDOUT carries only protocol
// bytes; all logging goes to STDERR (`log:`).
//
// TRANSPORT is stdio (what editors default to). A socket transport / a server that
// runs INSIDE a live image (answering from real runtime state) is a later layer;
// the dispatch here is transport-agnostic (it only calls readMessage/sendMessage).

[Module named: #lsp requires: #[#json]];
// Each server owns its state. Immutable Maps are shared by shallow clones;
// writes replace that clone's own slot. `new` requests fresh empty state.
let lspInitialState := [:self | #[[Map new] [Map new] [Map new] [Map new] [Map new] [Map new] [Map new] [Map new] nil 0 [Map new] "" ""]];
[Globals at: #Lsp put: [ObjectModel newSlots: [lspInitialState value: nil] parent: ObjectVt]];
[Reflect defineMethod: #initialState on: Lsp as: lspInitialState];
[Reflect defineMethod: #new on: Lsp as: [:self |
  [ObjectModel newSlots: [self initialState] parent: [Reflect vtableOf: self]]]];
[Reflect defineMethod: #slotNames on: Lsp as: [:self | #[#docs #versions #projectRoots #projectCache #projectFailures #documentPaths #projectIndexes #runtimeCompletionCache #runtimeGlobalCompletionCache #runtimeGlobalCompletionBuildCount #completionResponseCache #inputBuffer #workspaceUri]]];
[Reflect docModule: #lsp is: "A stdio language server (LSP: framing, diagnostics, hover, and navigation), over Json."];

// These are syntax-sensitive compiler forms, indexed as data so the analysis
// policy does not grow a receiver/selector conditional ladder.
let analysisThreadedSpecialSelectors := {
  "System" -> #["embedFile:"],
  "Module" -> #["named:requires:"],
  "Alien" -> #["dlopen:"],
  "Reflect" -> #["defineMethod:on:as:" "defineMethod:on:as:doc:" "removeMethod:on:"]};

// -- libc I/O (fd 0 = stdin, 1 = stdout, 2 = stderr) --------------------------
// recv/send are socket-only; stdio is a pipe, so use raw read/write on the fd.
// ssize_t read(int fd, void *buf, size_t count)      — receiver = fd
[Alien wrap: "read"  signature: "l i p u" as: #readInto:count: on: Integer];
// ssize_t write(int fd, const void *buf, size_t count) — receiver = fd; buf as `s`
[Alien wrap: "write" signature: "l i s u" as: #writeStr:count: on: Integer];
// void exit(int status)  — receiver = status
[Alien wrap: "exit"  signature: "v i"     as: #cExit          on: Integer];

// -- framed output ------------------------------------------------------------

// Write the whole string to `fd`, looping over partial writes.
[Reflect defineMethod: #writeAllTo:str: on: Lsp as: [:self :fd :s |
  let n := [s size];
  let r := [[n = 0]
    ifTrue: [| 0]
    ifFalse: [|
      let k := [fd writeStr: s count: n];
      [[k < n]
        ifTrue:  [| [[k < 1] ifTrue: [| k] ifFalse: [| [self writeAllTo: fd str: [s copyFrom: k to: n]]]]]
        ifFalse: [| k]]]];
  r] doc:
  "Writes all of `s` to file descriptor `fd`, looping over partial writes; answers the last write's count."];

// Send one JSON-RPC message with its Content-Length header (to stdout).
[Reflect defineMethod: #sendMessage: on: Lsp as: [:self :body |
  let framed := [[["Content-Length: " , [[body size] printString]] , "\r\n\r\n"] , body];
  [self writeAllTo: 1 str: framed];
  self] doc:
  "Sends `body` to stdout as one JSON-RPC message, framed with its Content-Length header."];

// Diagnostic/trace logging — STDERR only, so stdout stays pure protocol.
[Reflect defineMethod: #log: on: Lsp as: [:self :msg |
  [self writeAllTo: 2 str: [msg , "\n"]];
  self] doc:
  "Writes `msg` plus a newline to STDERR, so stdout stays pure protocol."];

// -- framed input -------------------------------------------------------------

[Reflect defineMethod: #inputBuffer on: Lsp as: [:self |
  [ObjectModel slot: 11 in: self]
  ] doc:
  "Answers bytes already read from stdin but not consumed as a complete JSON-RPC frame." ];

[Reflect defineMethod: #inputBuffer: on: Lsp as: [:self :bytes |
  [ObjectModel slot: 11 in: self put: bytes];
  self
  ] doc:
  "Replaces the retained JSON-RPC input bytes." ];

[Reflect defineMethod: #readInputChunk on: Lsp as: [:self |
  let buf := [Alien alloc: 65537];
  let k := [0 readInto: buf count: 65536];
  [[k > 0] ifTrue: [|
    [buf pokeByte: 0 at: k];
    [self inputBuffer: [[self inputBuffer] , [buf peekStringAt: 0]]]]];
  [buf free];
  k
  ] doc:
  "Reads one available stdin chunk into the retained framing buffer." ];

[Reflect defineMethod: #takeBufferedMessage on: Lsp as: [:self |
  let buffered := [self inputBuffer];
  let headerEnd := [buffered indexOf: "\r\n\r\n"];
  [[headerEnd isNil]
    ifTrue: [| nil]
    ifFalse: [|
      let bodyStart := [headerEnd + 4];
      let header := [buffered copyFrom: 0 to: bodyStart];
      let bodyEnd := [bodyStart + [self contentLengthOf: header]];
      [[bodyEnd > [buffered size]]
        ifTrue: [| nil]
        ifFalse: [|
          let body := [buffered copyFrom: bodyStart to: bodyEnd];
          [self inputBuffer: [buffered copyFrom: bodyEnd to: [buffered size]]];
          body]]]]
  ] doc:
  "Consumes and answers one complete retained JSON-RPC body, or nil when more bytes are needed." ];

// Extract the Content-Length value (an Integer) from a header block.
[Reflect defineMethod: #contentLengthOf: on: Lsp as: [:self :header |
  let step := [:found :line |
    [[line startsWith: "Content-Length:"]
      ifTrue:  [| [[[line split: ":"] at: 1] trimmed]]
      ifFalse: [| found]]];
  let numStr := [[header split: "\r\n"] inject: "" into: step];
  let r := [numStr asInteger];
  r] doc:
  "Answers the Content-Length value (an Integer) extracted from the `header` block."];

// Read one whole message; answer its JSON body String, or nil at EOF.
[Reflect defineMethod: #readMessage on: Lsp as: [:self |
  let buffered := [self takeBufferedMessage];
  [[buffered notNil]
    ifTrue: [| buffered]
    ifFalse: [|
      let k := [self readInputChunk];
      [[k < 1] ifTrue: [| nil] ifFalse: [| [self readMessage]]]]]
  ] doc:
  "Reads one whole framed message through a retained chunk buffer; answers its JSON body String, or nil at EOF."];

// -- diagnostics --------------------------------------------------------------

// Static diagnostics carry byte spans from the local source-analysis policy.
// Convert those spans to LSP UTF-16 positions only at this protocol boundary.
[Reflect defineMethod: #utf16UnitsAt:in: on: Lsp as: [:self :i :line |
  let b := [line byteAt: i];
  let width := [[b >= 240] ifTrue: [| 2] ifFalse: [| 1]];
  [[b < 128] ifTrue: [| 1] ifFalse: [| width]]
  ] doc:
  "Answers the UTF-16 width of the UTF-8 code point beginning at byte offset `i`; malformed bytes count as one unit." ];

[Reflect defineMethod: #utf8WidthAt:in: on: Lsp as: [:self :i :line |
  let b := [line byteAt: i];
  let wide := [[b < 240] ifTrue: [| 3] ifFalse: [| 4]];
  let middle := [[b < 224] ifTrue: [| 2] ifFalse: [| wide]];
  [[b < 128] ifTrue: [| 1] ifFalse: [| middle]]
  ] doc:
  "Answers the byte width of the UTF-8 code point beginning at `i`; malformed high bytes conservatively consume four bytes." ];

[Reflect defineMethod: #utf16Offset:in: on: Lsp as: [:self :byteOffset :line |
  let units := [0 asCell];
  [0 to: [[byteOffset - 1] min: [[line size] - 1]] do: [:i |
    let b := [line byteAt: i];
    // UTF-8 continuation bytes do not begin a code point. A four-byte
    // sequence is the only case that consumes two UTF-16 code units.
    [[[b >= 128] & [b <= 191]] ifTrue: [| nil]
      ifFalse: [| [units set: [[units value] + [self utf16UnitsAt: i in: line]]]]]]];
  [units value]
  ] doc:
  "Converts a UTF-8 byte offset in `line` to an LSP UTF-16 code-unit offset." ];

[Reflect defineMethod: #byteOffsetForUtf16:in: on: Lsp as: [:self :target :line |
  let bytes := [0 asCell];
  let units := [0 asCell];
  [0 to: [[line size] - 1] do: [:i |
    [[[units value] < target]
      ifTrue: [|
        let b := [line byteAt: i];
        let continuation := [[b >= 128] & [b <= 191]];
        [continuation ifFalse: [|
            [units set: [[units value] + [self utf16UnitsAt: i in: line]]];
            [bytes set: [i + [self utf8WidthAt: i in: line]]]]]]
      ifFalse: [| nil]]]];
  [bytes value]
  ] doc:
  "Converts an LSP UTF-16 character offset in `line` to a UTF-8 byte offset for lexical features." ];

[Reflect defineMethod: #positionAtByte:in: on: Lsp as: [:self :byteOffset :text |
  let off := [[byteOffset max: 0] min: [text size]];
  let prefix := [text copyFrom: 0 to: off];
  let lines := [prefix split: "\n"];
  let line := [[lines size] - 1];
  let lineText := [lines at: line];
  [Map
    => new
    => at: "line" put: line
    => at: "character" put: [self utf16Offset: [lineText size] in: lineText]]
  ] doc:
  "Converts an absolute UTF-8 byte offset in `text` to an LSP line/UTF-16 position." ];

[Reflect defineMethod: #diagFromError:text: on: Lsp as: [:self :err :text |
  let firstLine := [[[err printString] split: "\n"] first];
  let parts := [firstLine split: ":"];
  let hasLC := [[parts size] >= 2];
  let line := [hasLC ifTrue: [| [[[parts at: 0] trimmed] asInteger]] ifFalse: [| 1]];
  let col  := [hasLC ifTrue: [| [[[parts at: 1] trimmed] asInteger]] ifFalse: [| 1]];
  let l0 := [[line < 1] ifTrue: [| 0] ifFalse: [| [line - 1]]];
  let lineText := [self lineAt: l0 in: text];
  let byte0 := [[col < 1] ifTrue: [| 0] ifFalse: [| [col - 1]]];
  let c0 := [self utf16Offset: byte0 in: lineText];
  let endByte := [[byte0 < [lineText size]] ifTrue: [| [byte0 + 1]] ifFalse: [| byte0]];
  let c1 := [self utf16Offset: endByte in: lineText];
  let startP := [Map => new => at: "line" put: l0 => at: "character" put: c0];
  let endCharacter := [[c1 <= c0] ifTrue: [| [c0 + 1]] ifFalse: [| c1]];
  let endP := [Map => new => at: "line" put: l0 => at: "character" put: endCharacter];
  let range := [Map => new => at: "start" put: startP => at: "end" put: endP];
  [Map
    => new
    => at: "range" put: range
    => at: "severity" put: 1
    => at: "source" put: "birnam"
    => at: "message" put: firstLine]] doc:
  "Answers one LSP Diagnostic (severity 1 = Error) with a UTF-16 range built from `err`'s \"line:col: message\" first line."];

[Reflect defineMethod: #diagFromProject: on: Lsp as: [:self :snapshot |
  let start := [Map => new => at: "line" put: 0 => at: "character" put: 0];
  let finish := [Map => new => at: "line" put: 0 => at: "character" put: 1];
  let range := [Map => new => at: "start" put: start => at: "end" put: finish];
  let kind := [snapshot at: "kind" ifAbsent: [| "projectResolutionFailed"]];
  let message := [snapshot at: "message" ifAbsent: [| "project resolution failed"]];
  [Map
    => new
    => at: "range" put: range
    => at: "severity" put: 1
    => at: "source" put: "birnam"
    => at: "code" put: kind
    => at: "message" put: message]
  ] doc:
  "Answers one LSP Diagnostic for a shared project-resolver failure, preserving its kind and message." ];

// -- source inspection -------------------------------------------------------
//
// Lang and Peg already expose the parser/CST seam to Birnam. Keep the compiler
// floor responsible for parsing and move the LSP policy — what counts as a
// symbol, occurrence, binding, or provable diagnostic — into this module.
// The walkers use `rule`/`childAt:` instead of `ruleName`/`children` so the hot
// path does not allocate a String or a Vector for every CST node.

[Reflect defineMethod: #analysisText:from: on: Lsp as: [:self :node :source |
  [source copyFrom: [node start] to: [node end]]
  ] doc:
  "Returns the source slice covered by one CST node." ];

[Reflect defineMethod: #analysisSkip: on: Lsp as: [:self :node |
  let rule := [node rule];
  let wrapperRule := [#[#expr #primary #message #threadDispatch] includes: rule];
  let wrapper := [[[node childCount] = 1] & wrapperRule];
  [wrapper
    ifTrue: [| [self analysisSkip: [node childAt: 0]]]
    ifFalse: [| node]]
  ] doc:
  "Descends through single-child expression, primary, message, and threaded-dispatch wrappers." ];

[Reflect defineMethod: #analysisAppend:to: on: Lsp as: [:self :entry :out |
  [out set: [[out value] add: entry]];
  out
  ] doc:
  "Appends one analysis entry through a persistent-vector cell." ];

[Reflect defineMethod: #analysisDiagnostic:message:start:end: on: Lsp as: [:self :kind :message :start :finish |
  [Map
    => new
    => at: "kind" put: kind
    => at: "message" put: message
    => at: "start" put: start
    => at: "end" put: finish]
  ] doc:
  "Builds one byte-span static-analysis diagnostic." ];

[Reflect defineMethod: #analysisSymbolEntry:kind:name:detail:start:end:selectionStart: on: Lsp as: [:self :kind :name :detail :start :finish :selectionStart :selectionEnd |
  [Map
    => new
    => at: "name" put: name
    => at: "kind" put: kind
    => at: "detail" put: detail
    => at: "start" put: start
    => at: "end" put: finish
    => at: "selectionStart" put: selectionStart
    => at: "selectionEnd" put: selectionEnd]
  ] doc:
  "Builds one source-symbol entry with byte spans." ];

[Reflect defineMethod: #analysisOccurrenceEntry:name:start: on: Lsp as: [:self :name :start :finish |
  [Map
    => new
    => at: "name" put: name
    => at: "start" put: start
    => at: "end" put: finish]
  ] doc:
  "Builds one lexical occurrence entry with a byte span." ];

[Reflect defineMethod: #analysisBindingEntry:kind:name:start:end:scopeStart: on: Lsp as: [:self :kind :name :start :finish :scopeStart :scopeEnd |
  [Map
    => new
    => at: "kind" put: kind
    => at: "name" put: name
    => at: "start" put: start
    => at: "end" put: finish
    => at: "scopeStart" put: scopeStart
    => at: "scopeEnd" put: scopeEnd]
  ] doc:
  "Builds one lexical binding entry with its CST-derived scope." ];

[Reflect defineMethod: #analysisParsed: on: Lsp as: [:self :text |
  let cst := [Lang parse: text];
  [[[cst isNil] | [cst isError]] ifTrue: [| nil] ifFalse: [| cst]]
  ] doc:
  "Parses source without evaluation and returns a CST, or nil on syntax failure." ];

[Reflect defineMethod: #analysisSymbolName:source: on: Lsp as: [:self :node0 :source |
  let node := [self analysisSkip: node0];
  let raw := [self analysisText: node from: source];
  let validRule := [[node rule] = #symbol];
  let validSize := [[raw size] > 1];
  let valid := [[validRule & validSize] & [raw startsWith: "#"]];
  [valid ifTrue: [| [raw copyFrom: 1 to: [raw size]]] ifFalse: [| nil]]
  ] doc:
  "Returns a selector/module symbol's spelling without its leading hash." ];

[Reflect defineMethod: #analysisIdentName:source: on: Lsp as: [:self :node0 :source |
  let node := [self analysisSkip: node0];
  [[[node rule] = #ident] ifTrue: [| [self analysisText: node from: source]] ifFalse: [| nil]]
  ] doc:
  "Returns an identifier spelling, or nil for a non-identifier CST node." ];

[Reflect defineMethod: #analysisReflectReceiver:source: on: Lsp as: [:self :node :source |
  let name := [self analysisIdentName: node source: source];
  [[name notNil] & [name = "Reflect"]]
  ] doc:
  "Recognizes the literal Reflect receiver without claiming aliases are special." ];

[Reflect defineMethod: #analysisKeywordParts:source: on: Lsp as: [:self :node :source |
  let selector := ["" asCell];
  let args := [#[] asCell];
  [0 to: [[node childCount] - 1] do: [:i |
    let part := [node childAt: i];
    [[[i mod: 2] = 0]
      ifTrue: [| let word := [self analysisText: part from: source];
                 [selector set: [[selector value] , word]]]
      ifFalse: [| [args set: [[args value] add: part]]]]]];
  let result := [#[] add: [selector value]];
  [result add: [args value]]
  ] doc:
  "Returns a keyword message's concatenated selector and expression arguments." ];

[Reflect defineMethod: #analysisBlockParamCount: on: Lsp as: [:self :node0 |
  let node := [self analysisSkip: node0];
  [[[node rule] = #block]
    ifTrue: [|
      let count := [0 asCell];
      [0 to: [[node childCount] - 1] do: [:i |
        let child := [node childAt: i];
        let childRule := [child rule];
        [[childRule = #ident] ifTrue: [| [count set: [[count value] + 1]]]]]];
      [count value]]
    ifFalse: [| nil]]
  ] doc:
  "Counts direct block parameter identifiers, or answers nil for another node." ];

[Reflect defineMethod: #analysisAddModuleSymbol:selector:args:source:whole:out: on: Lsp as: [:self :receiver :selector :args :source :whole :out |
  let shape := [[receiver = "Module"] & [[selector = "named:requires:"] & [[args size] = 2]]];
  [shape ifTrue: [|
    let name := [self analysisSymbolName: [args at: 0] source: source];
    [[name notNil] ifTrue: [|
      let selected := [self analysisSkip: [args at: 0]];
      [self analysisAppend:
        [self analysisSymbolEntry: 3 kind: name name: "module"
          detail: [whole start] start: [whole end] end: [[selected start] + 1]
          selectionStart: [selected end]] to: out]]]]];
  out
  ] doc:
  "Adds a Module named:requires: symbol when the source shape proves it." ];

[Reflect defineMethod: #analysisAddMethodSymbol:selector:args:source:whole:out: on: Lsp as: [:self :receiver :selector :args :source :whole :out |
  let methodDecl := [[selector = "defineMethod:on:as:"] & [[args size] = 3]];
  let methodDoc := [[selector = "defineMethod:on:as:doc:"] & [[args size] = 4]];
  let shape := [[methodDecl | methodDoc] & [receiver = "Reflect"]];
  [shape ifTrue: [|
    let name := [self analysisSymbolName: [args at: 0] source: source];
    let detail := [self analysisIdentName: [args at: 1] source: source];
    let valid := [[name notNil] & [detail notNil]];
    [valid ifTrue: [|
      let selected := [self analysisSkip: [args at: 0]];
      [self analysisAppend:
        [self analysisSymbolEntry: 6 kind: name name: detail
          detail: [whole start] start: [whole end] end: [[selected start] + 1]
          selectionStart: [selected end]] to: out]]]]];
  out
  ] doc:
  "Adds a literal Reflect defineMethod: symbol when the source shape proves it." ];

[Reflect defineMethod: #analysisCollectSymbolStatement:source:out: on: Lsp as: [:self :stmt :source :out |
  let count := [stmt childCount];
  [[count > 0] ifTrue: [|
    let whole := [self analysisSkip: [stmt childAt: 0]];
    let rule := [whole rule];
    let isLet := [rule = #letBinding];
    [isLet ifTrue: [|
      let name := [whole childAt: 0];
      [self analysisAppend:
        [self analysisSymbolEntry: 13 kind: [self analysisText: name from: source]
          name: "top-level let" detail: [whole start] start: [whole end] end: [name start]
          selectionStart: [name end]] to: out]]];
    let isSend := [rule = #send];
    [isSend ifTrue: [|
      let recv := [self analysisSkip: [whole childAt: 0]];
      let msg := [self analysisSkip: [whole childAt: 1]];
      let sendShape := [[[recv rule] = #ident] & [[msg rule] = #keywordMsg]];
      [sendShape ifTrue: [|
        let parts := [self analysisKeywordParts: msg source: source];
        let selector := [parts at: 0];
        let args := [parts at: 1];
        let recvName := [self analysisText: recv from: source];
        [self analysisAddModuleSymbol: recvName selector: selector args: args
          source: source whole: whole out: out];
        [self analysisAddMethodSymbol: recvName selector: selector args: args
          source: source whole: whole out: out]]]]]]];
  out
  ] doc:
  "Collects one top-level let, module, or literal Reflect method symbol." ];

[Reflect defineMethod: #analysisCollectSymbols:source:out: on: Lsp as: [:self :statements :source :out |
  [0 to: [[statements childCount] - 1] do: [:i |
    [self analysisCollectSymbolStatement: [statements childAt: i] source: source out: out]]];
  out
  ] doc:
  "Collects top-level let, module, and literal Reflect method symbols." ];

[Reflect defineMethod: #analysisCollectKeywordOccurrences:source:index:out: on: Lsp as: [:self :node :source :index :out |
  [[[index + 1] < [node childCount]] ifTrue: [|
    let part := [node childAt: index];
    [self analysisAppend:
      [self analysisOccurrenceEntry: [self analysisText: part from: source]
        name: [part start] start: [part end]] to: out];
    [self analysisCollectOccurrences: [node childAt: [index + 1]] source: source out: out];
    [self analysisCollectKeywordOccurrences: node source: source index: [index + 2] out: out]]]
  ] doc:
  "Collects selector parts and their expression arguments in source order." ];

[Reflect defineMethod: #analysisCollectOccurrences:source:out: on: Lsp as: [:self :node :source :out |
  let rule := [node rule];
  let literal := [[[rule = #symbol] | [rule = #number]] | [[rule = #float] | [rule = #string]]];
  let skip := [literal | [rule = #logicVar]];
  let ident := [rule = #ident];
  let keyword := [rule = #keywordMsg];
  let walk := [[[skip not] & [ident not]] & [keyword not]];
  [ident ifTrue: [|
    [self analysisAppend:
      [self analysisOccurrenceEntry: [self analysisText: node from: source]
        name: [node start] start: [node end]] to: out]]];
  [keyword ifTrue: [| [self analysisCollectKeywordOccurrences: node source: source index: 0 out: out]]];
  [walk ifTrue: [|
    [0 to: [[node childCount] - 1] do: [:i |
      [self analysisCollectOccurrences: [node childAt: i] source: source out: out]]]]];
  out
  ] doc:
  "Collects lexical identifiers and keyword selector parts without resolving dispatch." ];

[Reflect defineMethod: #analysisCollectBindings:source:scopeStart:scopeEnd:out: on: Lsp as: [:self :node0 :source :scopeStart :scopeEnd :out |
  let node := [self analysisSkip: node0];
  let rule := [node rule];
  let isBlock := [rule = #block];
  let isLet := [rule = #letBinding];
  [isBlock ifTrue: [|
    [0 to: [[node childCount] - 1] do: [:i |
      let child := [node childAt: i];
      let isParam := [[child rule] = #ident];
      [isParam ifTrue: [|
        [self analysisAppend:
          [self analysisBindingEntry: "parameter" kind: [self analysisText: child from: source]
            name: [child start] start: [child end] end: [node start]
            scopeStart: [node end]] to: out]]]]];
    [0 to: [[node childCount] - 1] do: [:i |
      let child := [node childAt: i];
      let isStatements := [[child rule] = #statements];
      [isStatements ifTrue: [|
        [self analysisCollectBindings: child source: source scopeStart: [node start] scopeEnd: [node end] out: out]]]]]]];
  [isLet ifTrue: [|
    let name := [node childAt: 0];
    [self analysisAppend:
      [self analysisBindingEntry: "local" kind: [self analysisText: name from: source]
        name: [name start] start: [name end] end: scopeStart
        scopeStart: scopeEnd] to: out];
    let hasValue := [[node childCount] > 1];
    [hasValue ifTrue: [|
      [self analysisCollectBindings: [node childAt: 1] source: source
        scopeStart: scopeStart scopeEnd: scopeEnd out: out]]]]];
  let recurse := [[isBlock not] & [isLet not]];
  [recurse ifTrue: [|
    [0 to: [[node childCount] - 1] do: [:i |
      [self analysisCollectBindings: [node childAt: i] source: source
        scopeStart: scopeStart scopeEnd: scopeEnd out: out]]]]];
  out
  ] doc:
  "Collects lexical locals and block parameters with CST-derived scopes." ];

[Reflect defineMethod: #analysisStaticStatement:source:out: on: Lsp as: [:self :stmt :source :out |
  let count := [stmt childCount];
  [[count > 0] ifTrue: [|
    let inner := [stmt childAt: 0];
    let isLet := [[inner rule] = #letBinding];
    [isLet ifTrue: [| [self analysisStaticNode: [inner childAt: 1] source: source out: out]]];
    [isLet ifFalse: [| [self analysisStaticNode: inner source: source out: out]]]]];
  out
  ] doc:
  "Checks one statement, skipping the binding name and visiting its value." ];

[Reflect defineMethod: #analysisStaticStatements:source:out: on: Lsp as: [:self :statements :source :out |
  [0 to: [[statements childCount] - 1] do: [:i |
    [self analysisStaticStatement: [statements childAt: i] source: source out: out]]];
  out
  ] doc:
  "Checks every statement in one CST statements node." ];

[Reflect defineMethod: #analysisThreadedSpecialHead:receiver:source: on: Lsp as: [:self :dispatch0 :recv :source |
  let dispatch := [self analysisSkip: dispatch0];
  [[[dispatch rule] = #keywordMsg]
    ifTrue: [|
      let recvName := [self analysisIdentName: recv source: source];
      let selectors := [analysisThreadedSpecialSelectors at: recvName ifAbsent: [| #[]]];
      let parts := [self analysisKeywordParts: dispatch source: source];
      [selectors includes: [parts at: 0]]]
    ifFalse: [| false]]
  ] doc:
  "Answers whether a receiver and first threaded dispatch spell a source-sensitive compiler form." ];

[Reflect defineMethod: #analysisStaticDispatchArguments:source:out: on: Lsp as: [:self :dispatch0 :source :out |
  let dispatch := [self analysisSkip: dispatch0];
  [0 to: [[dispatch childCount] - 1] do: [:i |
    let child := [dispatch childAt: i];
    [[[child rule] = #expr] ifTrue: [|
      [self analysisStaticNode: child source: source out: out]]]]];
  out
  ] doc:
  "Checks the expression arguments directly owned by one unary, binary, or keyword dispatch." ];

[Reflect defineMethod: #analysisStaticThreaded:receiver:source:out: on: Lsp as: [:self :msg :recv :source :out |
  let first := [msg childAt: 0];
  [[self analysisThreadedSpecialHead: first receiver: recv source: source]
    ifTrue: [|
      let dispatch := [self analysisSkip: first];
      [self analysisAppend:
        [self analysisDiagnostic: "threadedSpecialForm"
          message: "source-sensitive special forms cannot use => threading"
          start: [msg start] end: [dispatch end]] to: out]]];
  [0 to: [[msg childCount] - 1] do: [:i |
    [self analysisStaticDispatchArguments: [msg childAt: i] source: source out: out]]];
  out
  ] doc:
  "Checks a threaded message's restricted head and recursively visits every leg argument." ];

[Reflect defineMethod: #analysisStaticNode:source:out: on: Lsp as: [:self :node0 :source :out |
  let node := [self analysisSkip: node0];
  let rule := [node rule];
  let isSend := [rule = #send];
  [isSend ifTrue: [|
    let recv := [node childAt: 0];
    let msg := [self analysisSkip: [node childAt: 1]];
    let msgRule := [msg rule];
    let isThreaded := [msgRule = #threadedMsg];
    [isThreaded ifTrue: [|
      [self analysisStaticThreaded: msg receiver: recv source: source out: out]]];
    let isKeyword := [msgRule = #keywordMsg];
    [isKeyword ifTrue: [|
      let parts := [self analysisKeywordParts: msg source: source];
      let selector := [parts at: 0];
      let args := [parts at: 1];
      let isDefine := [[selector = "defineMethod:on:as:"] & [[args size] = 3]];
      let isDefineDoc := [[selector = "defineMethod:on:as:doc:"] & [[args size] = 4]];
      let isReflectDefine := [[isDefine | isDefineDoc] & [self analysisReflectReceiver: recv source: source]];
      [isReflectDefine ifTrue: [|
        let selected := [self analysisSkip: [args at: 0]];
        let actual := [self analysisBlockParamCount: [args at: 2]];
        let valid := [[selected notNil] & [actual notNil]];
        [valid ifTrue: [|
          let expected := [[self selectorArity: [self analysisSymbolName: [args at: 0] source: source]] + 1];
          let mismatch := [[actual = expected] not];
          [mismatch ifTrue: [|
            let raw := [self analysisText: selected from: source];
            let plural := [[expected = 1] ifTrue: [| ""] ifFalse: [| "s"]];
            let message := ["selector " , raw , " expects " , [expected printString]
              , " block parameter" , plural , " including self"];
            let suffix := [", got " , [actual printString]];
            [self analysisAppend:
              [self analysisDiagnostic: "selectorArity" message: [message , suffix]
                start: [selected start] end: [selected end]] to: out]]]]]]];
      [args do: [:arg | [self analysisStaticNode: arg source: source out: out]]];
    let isBinary := [msgRule = #binaryMsg];
    [isBinary ifTrue: [| [self analysisStaticNode: [msg childAt: 1] source: source out: out]]];
    let isMessage := [msgRule = #message];
    [isMessage ifTrue: [|
      [0 to: [[msg childCount] - 1] do: [:i |
        [self analysisStaticNode: [msg childAt: i] source: source out: out]]]]];
    [self analysisStaticNode: recv source: source out: out]]];
  let isStatements := [rule = #statements];
  [isStatements ifTrue: [| [self analysisStaticStatements: node source: source out: out]]];
  let isBlock := [rule = #block];
  [isBlock ifTrue: [|
    [0 to: [[node childCount] - 1] do: [:i |
      let child := [node childAt: i];
      let isStatements := [[child rule] = #statements];
      [isStatements ifTrue: [| [self analysisStaticNode: child source: source out: out]]]]]]];
  let isVector := [rule = #vectorLit];
  [isVector ifTrue: [|
    [0 to: [[node childCount] - 1] do: [:i |
      [self analysisStaticNode: [node childAt: i] source: source out: out]]]]];
  let isMap := [rule = #mapLit];
  [isMap ifTrue: [|
    [0 to: [[node childCount] - 1] do: [:i |
      let entry := [node childAt: i];
      let hasPair := [[entry childCount] >= 2];
      [hasPair ifTrue: [|
        [self analysisStaticNode: [entry childAt: 0] source: source out: out];
        [self analysisStaticNode: [entry childAt: 1] source: source out: out]]]]]]]]];
  out
  ] doc:
  "Checks only source-provable selector arity and recursively visits expression nodes." ];

[Reflect defineMethod: #staticDiagnosticsOf: on: Lsp as: [:self :text |
  let cst := [self analysisParsed: text];
  [[cst isNil]
    ifTrue: [|
      let off := [Lang furthestFail];
      [#[] add: [self analysisDiagnostic: "syntaxError" message: "syntax error"
        start: off end: [[off + 1] min: [text size]]]]]
    ifFalse: [|
      let out := [#[] asCell];
      [[[cst childCount] > 0] ifTrue: [|
        [self analysisStaticStatements: [cst childAt: 0] source: text out: out]]];
      [out value]]]
  ] doc:
  "Parses source and answers static diagnostics without evaluation or Store mutation." ];

[Reflect defineMethod: #sourceSymbolsOf: on: Lsp as: [:self :text |
  let cst := [self analysisParsed: text];
  let out := [#[] asCell];
  [[[cst notNil] & [[cst childCount] > 0]] ifTrue: [|
    [self analysisCollectSymbols: [cst childAt: 0] source: text out: out]]];
  [out value]
  ] doc:
  "Parses source and answers top-level authored symbols with byte spans." ];

[Reflect defineMethod: #sourceOccurrencesOf: on: Lsp as: [:self :text |
  let cst := [self analysisParsed: text];
  let out := [#[] asCell];
  [[[cst notNil] & [[cst childCount] > 0]] ifTrue: [|
    [self analysisCollectOccurrences: [cst childAt: 0] source: text out: out]]];
  [out value]
  ] doc:
  "Parses source and answers lexical identifier/keyword occurrences." ];

[Reflect defineMethod: #sourceBindingsOf: on: Lsp as: [:self :text |
  let cst := [self analysisParsed: text];
  let out := [#[] asCell];
  [[[cst notNil] & [[cst childCount] > 0]] ifTrue: [|
    [self analysisCollectBindings: [cst childAt: 0] source: text
      scopeStart: 0 scopeEnd: [text size] out: out]]];
  [out value]
  ] doc:
  "Parses source and answers lexical locals and parameters with scope spans." ];

[Reflect defineMethod: #sourceAnalysisOf: on: Lsp as: [:self :text |
  let cst := [self analysisParsed: text];
  let symbols := [#[] asCell];
  let occurrences := [#[] asCell];
  let bindings := [#[] asCell];
  [[[cst notNil] & [[cst childCount] > 0]] ifTrue: [|
    let root := [cst childAt: 0];
    [self analysisCollectSymbols: root source: text out: symbols];
    [self analysisCollectOccurrences: root source: text out: occurrences];
    [self analysisCollectBindings: root source: text scopeStart: 0 scopeEnd: [text size] out: bindings]]];
  [Map
    => new
    => at: "symbols" put: [symbols value]
    => at: "occurrences" put: [occurrences value]
    => at: "bindings" put: [bindings value]]
  ] doc:
  "Parses once and answers the three source indexes used by project-aware navigation." ];

[Reflect defineMethod: #diagFromStatic:text: on: Lsp as: [:self :snapshot :text |
  let start := [snapshot at: "start" ifAbsent: [| 0]];
  let finish := [snapshot at: "end" ifAbsent: [| start]];
  let range := [Map
    => new
    => at: "start" put: [self positionAtByte: start in: text]
    => at: "end" put: [self positionAtByte: finish in: text]];
  let kind := [snapshot at: "kind" ifAbsent: [| "static" ]];
  let message := [snapshot at: "message" ifAbsent: [| "static diagnostic" ]];
  [Map
    => new
    => at: "range" put: range
    => at: "severity" put: 1
    => at: "source" put: "birnam"
    => at: "code" put: kind
    => at: "message" put: message]
  ] doc:
  "Converts one source-analysis diagnostic with byte spans into an LSP Diagnostic." ];

// Parse and inspect `text` without eval, Store mutation, or artifact writes →
// a Vector of Diagnostics (empty if OK).
[Reflect defineMethod: #compileDiagnostics: on: Lsp as: [:self :text |
  let raw := [self staticDiagnosticsOf: text];
  [raw inject: #[] into: [:out :entry | [out add: [self diagFromStatic: entry text: text]]]]
  ] doc:
  "Parses and statically inspects `text`; answers a Vector of Diagnostics — empty when it is clean." ];

// Statically diagnose `text` and publish diagnostics for `uri`.
[Reflect defineMethod: #diagnoseUri:text: on: Lsp as: [:self :uri :text |
  let diags := [self compileDiagnostics: text];
  let project := [self projectSnapshotFor: uri];
  let all := [[project notNil]
    ifTrue: [| [[project at: "ok" ifAbsent: [| false]]
      ifTrue: [| diags]
      ifFalse: [| [diags add: [self diagFromProject: project]]]]]
    ifFalse: [| diags]];
  let params := [Map => new => at: "uri" put: uri => at: "diagnostics" put: all];
  [self sendNote: "textDocument/publishDiagnostics" params: params];
  self] doc:
  "Statically diagnoses `text`, appends a shared project-resolution diagnostic when needed, and publishes the resulting diagnostics for `uri`." ];

// -- source-backed navigation -----------------------------------------------

[Reflect defineMethod: #rangeForStart:end:in: on: Lsp as: [:self :start :finish :text |
  [Map
    => new
    => at: "start" put: [self positionAtByte: start in: text]
    => at: "end" put: [self positionAtByte: finish in: text]]
  ] doc:
  "Builds an LSP range from absolute UTF-8 byte spans." ];

[Reflect defineMethod: #lspSymbolFrom:text: on: Lsp as: [:self :entry :text |
  let name := [entry at: "name" ifAbsent: [| ""]];
  let kind := [entry at: "kind" ifAbsent: [| 13]];
  let detail := [entry at: "detail" ifAbsent: [| ""]];
  let start := [entry at: "start" ifAbsent: [| 0]];
  let finish := [entry at: "end" ifAbsent: [| start]];
  let selectionStart := [entry at: "selectionStart" ifAbsent: [| start]];
  let selectionEnd := [entry at: "selectionEnd" ifAbsent: [| finish]];
  let range := [self rangeForStart: start end: finish in: text];
  let selection := [self rangeForStart: selectionStart end: selectionEnd in: text];
  [Map
    => new
    => at: "name" put: name
    => at: "kind" put: kind
    => at: "detail" put: detail
    => at: "range" put: range
    => at: "selectionRange" put: selection]
  ] doc:
  "Converts one source-analysis symbol into an LSP DocumentSymbol." ];

[Reflect defineMethod: #sourceSymbolsFor: on: Lsp as: [:self :text |
  let raw := [self sourceSymbolsOf: text];
  [raw inject: #[] into: [:out :entry | [out add: [self lspSymbolFrom: entry text: text]]]]
  ] doc:
  "Answers source-backed top-level document symbols for `text`." ];

[Reflect defineMethod: #locationForEntry:uri:text: on: Lsp as: [:self :entry :uri :text |
  let start := [entry at: "start" ifAbsent: [| 0]];
  let finish := [entry at: "end" ifAbsent: [| start]];
  let range := [self rangeForStart: start end: finish in: text];
  [Map => new => at: "uri" put: uri => at: "range" put: range]
  ] doc:
  "Answers an LSP Location for a source occurrence or declaration entry." ];

[Reflect defineMethod: #locationForSymbol:uri:text: on: Lsp as: [:self :entry :uri :text |
  let start := [entry at: "selectionStart" ifAbsent: [| [entry at: "start" ifAbsent: [| 0]]]];
  let finish := [entry at: "selectionEnd" ifAbsent: [| [entry at: "end" ifAbsent: [| start]]]];
  let range := [self rangeForStart: start end: finish in: text];
  [Map => new => at: "uri" put: uri => at: "range" put: range]
  ] doc:
  "Answers an LSP definition Location using a symbol's selection range." ];

[Reflect defineMethod: #tokenAtPosition:in: on: Lsp as: [:self :pos :text |
  let lineNo := [pos at: "line" ifAbsent: [| 0]];
  let character := [pos at: "character" ifAbsent: [| 0]];
  let lineText := [self lineAt: lineNo in: text];
  let byteCol := [self byteOffsetForUtf16: character in: lineText];
  [self tokenAt: byteCol in: lineText]
  ] doc:
  "Answers the lexical token at an LSP position, using UTF-16 protocol coordinates." ];

[Reflect defineMethod: #onDocumentSymbol:id: on: Lsp as: [:self :p :id |
  let td := [p at: "textDocument" ifAbsent: [| [Map new]]];
  let uri := [td at: "uri" ifAbsent: [| ""]];
  let stored := [[self docsMap] at: uri ifAbsent: [| ""]];
  let text := [[stored isNil] ifTrue: [| ""] ifFalse: [| stored]];
  [self respond: id result: [self sourceSymbolsFor: text]];
  self] doc:
  "Answers documentSymbol from the open buffer's parsed source spans." ];

[Reflect defineMethod: #onDefinition:id: on: Lsp as: [:self :p :id |
  let td := [p at: "textDocument" ifAbsent: [| [Map new]]];
  let uri := [td at: "uri" ifAbsent: [| ""]];
  let pos := [p at: "position" ifAbsent: [| [Map new]]];
  let index := [self projectIndexFor: uri];
  let found := [[index notNil] ifTrue: [| [self symbolForPosition: pos uri: uri index: index]] ifFalse: [| nil]];
  let result := [[found isNil] ifTrue: [| nil] ifFalse: [| [self locationForIndexedSymbol: found]]];
  [self respond: id result: result];
  self] doc:
  "Answers a source-backed definition from the current project, including unopened dependency modules." ];

[Reflect defineMethod: #onReferences:id: on: Lsp as: [:self :p :id |
  let td := [p at: "textDocument" ifAbsent: [| [Map new]]];
  let uri := [td at: "uri" ifAbsent: [| ""]];
  let pos := [p at: "position" ifAbsent: [| [Map new]]];
  let context := [p at: "context" ifAbsent: [| [Map new]]];
  let includeDeclaration := [context at: "includeDeclaration" ifAbsent: [| false]];
  let index := [self projectIndexFor: uri];
  let found := [[index notNil] ifTrue: [| [self symbolForPosition: pos uri: uri index: index]] ifFalse: [| nil]];
  let result := [#[] asCell];
  [[found notNil] ifTrue: [|
    [includeDeclaration ifTrue: [| [result set: [[result value] add: [self locationForIndexedSymbol: found]]]]];
    let documents := [index at: "documents" ifAbsent: [| #[]]];
    [documents do: [:doc |
      let localOnly := [[found at: "kind" ifAbsent: [| 13]] = 13];
      let sameDocument := [[doc at: "uri" ifAbsent: [| ""]] = [found at: "uri" ifAbsent: [| ""]]];
      let eligible := [localOnly ifTrue: [| sameDocument] ifFalse: [| true]];
      [eligible ifTrue: [|
        let occurrences := [doc at: "occurrences" ifAbsent: [| #[]]];
        [occurrences do: [:occurrence |
          let start := [occurrence at: "start" ifAbsent: [| 0]];
          let selection := [found at: "selectionStart" ifAbsent: [| -1]];
          let declaration := [[start = selection] & sameDocument];
          let matches := [[declaration not] & [self occurrenceMatchesSymbol: found entry: occurrence]];
          [matches ifTrue: [| [result set: [[result value] add: [self locationForIndexedOccurrence: occurrence doc: doc]]]]]]]]]]]]];
  [self respond: id result: [result value]];
  self] doc:
  "Answers authored references across the resolved project without pretending to resolve late-bound dispatch." ];

[Reflect defineMethod: #workspaceSymbolsFor: on: Lsp as: [:self :query |
  let workspace := [self workspaceUri];
  let workspaceIndex := [[workspace isEmpty] ifTrue: [| nil] ifFalse: [| [self projectIndexFor: workspace]]];
  let fallback := [[self docsMap] keys];
  let useFallback := [workspaceIndex isNil];
  let uri := [useFallback
    ifTrue: [| [fallback at: 0 ifAbsent: [| ""]]]
    ifFalse: [| workspace]];
  let index := [useFallback
    ifTrue: [| [self projectIndexFor: uri]]
    ifFalse: [| workspaceIndex]];
  [[index isNil]
    ifTrue: [| #[]]
    ifFalse: [|
      let seen := [Map new asCell];
      let symbols := [index at: "symbols" ifAbsent: [| #[]]];
      [symbols inject: #[] into: [:out :entry |
        let name := [entry at: "name" ifAbsent: [| ""]];
        let already := [[seen value] at: name ifAbsent: [| nil]];
        [[[already isNil] & [[query isEmpty] | [name includesSubstring: query]]]
          ifTrue: [|
            [seen set: [[seen value] at: name put: true]];
            [out add: [Map
              => new
              => at: "name" put: name
              => at: "kind" put: [entry at: "kind" ifAbsent: [| 13]]
              => at: "location" put: [self locationForIndexedSymbol: entry]]]]
          ifFalse: [| out]]]]]]
  ] doc:
  "Answers workspace/symbol over the resolver-selected authored modules, including unopened dependencies." ];

[Reflect defineMethod: #onWorkspaceSymbol:id: on: Lsp as: [:self :p :id |
  let query := [p at: "query" ifAbsent: [| ""]];
  [self respond: id result: [self workspaceSymbolsFor: query]];
  self] doc:
  "Answers workspace/symbol from currently retained open documents." ];

[Reflect defineMethod: #completionItemForBinding: on: Lsp as: [:self :entry |
  let name := [entry at: "name" ifAbsent: [| ""]];
  let module := [entry at: "module" ifAbsent: [| "<buffer>"]];
  [Map
    => new
    => at: "label" put: name
    => at: "kind" put: 6
    => at: "detail" put: [[entry at: "kind" ifAbsent: [| "local"]] , " in #" , module]
    => at: "documentation" put: ["authored binding in " , [entry at: "path" ifAbsent: [| ""]]]]
  ] doc:
  "Builds a variable or parameter CompletionItem from an authored binding." ];

[Reflect defineMethod: #completionItemForSymbol: on: Lsp as: [:self :entry |
  let kind := [entry at: "kind" ifAbsent: [| 13]];
  let itemKind := [{6 -> 2, 3 -> 9} at: kind ifAbsent: [| 13]];
  let name := [entry at: "name" ifAbsent: [| ""]];
  let detail := [[kind = 6]
    ifTrue: [| ["method on " , [entry at: "detail" ifAbsent: [| ""]]]]
    ifFalse: [| [{3 -> "module"} at: kind ifAbsent: [| "symbol"]]]];
  [Map
    => new
    => at: "label" put: name
    => at: "kind" put: itemKind
    => at: "detail" put: detail
    => at: "documentation" put: [self symbolSourceBody: entry]]
  ] doc:
  "Builds a method, module, or authored symbol CompletionItem." ];

[Reflect defineMethod: #completionSkipSpacesLeft:in: on: Lsp as: [:self :i :line |
  [[i <= 0]
    ifTrue: [| 0]
    ifFalse: [|
      let byte := [line byteAt: [i - 1]];
      let whitespace := [[byte = 32] | [byte = 9]];
      [whitespace
        ifTrue: [| [self completionSkipSpacesLeft: [i - 1] in: line]]
        ifFalse: [| i]]]]
  ] doc:
  "Scans left over horizontal whitespace and answers the first occupied boundary." ];

[Reflect defineMethod: #completionLiteralReceiverAtPosition:in: on: Lsp as: [:self :position :text |
  let lineNo := [position at: "line" ifAbsent: [| 0]];
  let line := [self lineAt: lineNo in: text];
  let col := [self byteOffsetForUtf16: [position at: "character" ifAbsent: [| 0]] in: line];
  let prefixStart := [self scanLeft: col in: line];
  let receiverEnd := [self completionSkipSpacesLeft: prefixStart in: line];
  let receiverStart := [self scanLeft: receiverEnd in: line];
  let head := [self completionSkipSpacesLeft: receiverStart in: line];
  let bracketed := [[head > 0] & [[line byteAt: [head - 1]] = 91]];
  let present := [receiverEnd > receiverStart];
  [[bracketed & present]
    ifTrue: [| [line copyFrom: receiverStart to: receiverEnd]]
    ifFalse: [| ""]]
  ] doc:
  "Answers the exact global receiver in an incomplete `[ Global prefix` send, or empty." ];

[Reflect defineMethod: #completionGlobalReceiverPrefixAtPosition:in: on: Lsp as: [:self :position :text |
  let lineNo := [position at: "line" ifAbsent: [| 0]];
  let line := [self lineAt: lineNo in: text];
  let col := [self byteOffsetForUtf16: [position at: "character" ifAbsent: [| 0]] in: line];
  let prefixStart := [self scanLeft: col in: line];
  let head := [self completionSkipSpacesLeft: prefixStart in: line];
  let bracketed := [[head > 0] & [[line byteAt: [head - 1]] = 91]];
  [bracketed
    ifTrue: [| [line copyFrom: prefixStart to: col]]
    ifFalse: [| nil]]
  ] doc:
  "Answers the possibly-empty global prefix directly after `[` in receiver position, or nil." ];

[Reflect defineMethod: #completionItemForRuntimeGlobalName: on: Lsp as: [:self :globalName |
  let name := [Reflect nameOf: globalName];
  [Map
    => new
    => at: "label" put: name
    => at: "kind" put: 6
    => at: "detail" put: "exported runtime global"]
  ] doc:
  "Builds one CompletionItem from an exported runtime global name." ];

[Reflect defineMethod: #runtimeGlobalCompletionBuildCount on: Lsp as: [:self |
  [ObjectModel slot: 9 in: self]
  ] doc:
  "Answers how many times this LSP process built its bounded export snapshot." ];

[Reflect defineMethod: #clearRuntimeGlobalCompletionCache on: Lsp as: [:self |
  [ObjectModel slot: 8 in: self put: nil];
  [ObjectModel slot: 9 in: self put: 0];
  self
  ] doc:
  "Drops the process-local exported-global completion snapshot." ];

[Reflect defineMethod: #runtimeGlobalCompletionItems on: Lsp as: [:self |
  let cached := [ObjectModel slot: 8 in: self];
  [[cached notNil]
    ifTrue: [| cached]
    ifFalse: [|
      let items := [[Reflect allGlobalNames] inject: #[] into: [:out :name |
        [out add: [self completionItemForRuntimeGlobalName: name]]]];
      [ObjectModel slot: 8 in: self put: items];
      [ObjectModel slot: 9 in: self put:
        [[self runtimeGlobalCompletionBuildCount] + 1]];
      items]]
  ] doc:
  "Builds the exported runtime global CompletionItems once per LSP process." ];

[Reflect defineMethod: #runtimeGlobalCompletionItemsForPrefix: on: Lsp as: [:self :prefix |
  [[self runtimeGlobalCompletionItems]
    inject: #[] into: [:out :item |
      let name := [item at: "label" ifAbsent: [| ""]];
      [[name startsWith: prefix] ifTrue: [| [out add: item]] ifFalse: [| out]]]]
  ] doc:
  "Filters the process-cached exported-global snapshot by receiver prefix." ];

[Reflect defineMethod: #completionItemForRuntimeMethod:receiver: on: Lsp as: [:self :entry :receiverName |
  let selector := [entry at: #selector ifAbsent: [| nil]];
  let name := [[selector isNil] ifTrue: [| ""] ifFalse: [| [Reflect nameOf: selector]]];
  let target := [entry at: #target ifAbsent: [| nil]];
  let targetName := [[target isNil] ifTrue: [| receiverName] ifFalse: [| [Reflect nameOf: target]]];
  [Map
    => new
    => at: "label" put: name
    => at: "kind" put: 2
    => at: "detail" put: ["runtime method on " , targetName]]
  ] doc:
  "Builds a bounded method CompletionItem without scanning historical source generations." ];

[Reflect defineMethod: #runtimeCompletionCacheMap on: Lsp as: [:self |
  [ObjectModel slot: 7 in: self]
  ] doc:
  "Answers receiver-name-to-bounded-runtime-completion-items retained for this server process." ];

[Reflect defineMethod: #clearRuntimeCompletionCache on: Lsp as: [:self |
  [ObjectModel slot: 7 in: self put: [Map new]];
  self
  ] doc:
  "Drops the process-local runtime completion snapshot cache." ];

[Reflect defineMethod: #runtimeCompletionItemsFor:named: on: Lsp as: [:self :receiver :receiverName |
  let cached := [[self runtimeCompletionCacheMap] at: receiverName ifAbsent: [| nil]];
  [[cached notNil]
    ifTrue: [| cached]
    ifFalse: [|
      let items := [[Reflect allMethodsOf: receiver] inject: #[] into: [:out :entry |
        [out add: [self completionItemForRuntimeMethod: entry receiver: receiverName]]]];
      [ObjectModel slot: 7 in: self put:
        [[self runtimeCompletionCacheMap] at: receiverName put: items]];
      items]]
  ] doc:
  "Builds each literal global receiver's bounded method items once; the LSP process does not evaluate edited source, so its runtime method set is stable." ];

[Reflect defineMethod: #runtimeCompletionItemsFor:named:prefix: on: Lsp as: [:self :receiver :receiverName :prefix |
  [[self runtimeCompletionItemsFor: receiver named: receiverName]
    inject: #[] into: [:out :item |
      let name := [item at: "label" ifAbsent: [| ""]];
      [[name startsWith: prefix] ifTrue: [| [out add: item]] ifFalse: [| out]]]]
  ] doc:
  "Filters one already-cached receiver method snapshot without retaining edited prefixes." ];

[Reflect defineMethod: #completionResponseCacheMap on: Lsp as: [:self |
  [ObjectModel slot: 10 in: self]
  ] doc:
  "Answers the single exact completion response retained per open document URI." ];

[Reflect defineMethod: #clearCompletionResponseCache on: Lsp as: [:self |
  [ObjectModel slot: 10 in: self put: [Map new]];
  self
  ] doc:
  "Drops exact document completion responses." ];

[Reflect defineMethod: #cachedCompletionFor:uri:position: on: Lsp as: [:self :text :uri :position |
  let entry := [[self completionResponseCacheMap] at: uri ifAbsent: [| nil]];
  let storedPosition := [[entry isNil]
    ifTrue: [| nil]
    ifFalse: [| [entry at: "position" ifAbsent: [| nil]]]];
  let sameText := [[entry notNil] & [[entry at: "text" ifAbsent: [| ""]] = text]];
  let sameLine := [[storedPosition notNil] &
    [[storedPosition at: "line" ifAbsent: [| -1]] = [position at: "line" ifAbsent: [| -2]]]];
  let sameCharacter := [[storedPosition notNil] &
    [[storedPosition at: "character" ifAbsent: [| -1]] = [position at: "character" ifAbsent: [| -2]]]];
  [[sameText & [sameLine & sameCharacter]]
    ifTrue: [| [entry at: "result" ifAbsent: [| nil]]]
    ifFalse: [| nil]]
  ] doc:
  "Answers a retained completion only for byte-identical text and the same LSP position." ];

[Reflect defineMethod: #rememberCompletion:text:uri:position: on: Lsp as: [:self :result :text :uri :position |
  let entry := [Map
    => new
    => at: "text" put: text
    => at: "position" put: position
    => at: "result" put: result];
  [ObjectModel slot: 10 in: self put:
    [[self completionResponseCacheMap] at: uri put: entry]];
  result
  ] doc:
  "Retains one exact completion response per document, replacing the older entry." ];

[Reflect defineMethod: #completionItemsForRuntimeReceiver:position:prefix:seen: on: Lsp as: [:self :text :position :prefix :seen |
  let receiverName := [self completionLiteralReceiverAtPosition: position in: text];
  let receiver := [[receiverName isEmpty]
    ifTrue: [| nil]
    ifFalse: [| [Reflect globalNamed: [receiverName asSymbol]]]];
  let items := [[receiver isNil]
    ifTrue: [| #[]]
    ifFalse: [| [self runtimeCompletionItemsFor: receiver named: receiverName prefix: prefix]]];
  [items inject: #[] into: [:out :item |
    let name := [item at: "label" ifAbsent: [| ""]];
    let already := [[seen value] at: name ifAbsent: [| nil]];
    let shouldAdd := [[already isNil] & [[name isEmpty] not]];
    [shouldAdd
      ifTrue: [|
        [seen set: [[seen value] at: name put: true]];
        [out add: item]]
      ifFalse: [| out]]]]
  ] doc:
  "Answers cached live methods only when the incomplete send spells an exact global receiver." ];

[Reflect defineMethod: #completionItemsFor:uri:position:index: on: Lsp as: [:self :text :uri :position :index |
  let prefix := [self completionPrefixAtPosition: position in: text];
  let seen := [Map new asCell];
  let receiverName := [self completionLiteralReceiverAtPosition: position in: text];
  let globalPrefix := [self completionGlobalReceiverPrefixAtPosition: position in: text];
  [[receiverName isEmpty]
    ifTrue: [|
      let offset := [self byteOffsetAtPosition: position in: text];
      let doc := [self documentInIndex: index uri: uri];
      let items := [#[] asCell];
      [[globalPrefix notNil] ifTrue: [|
        [[self runtimeGlobalCompletionItemsForPrefix: globalPrefix] do: [:item |
          let name := [item at: "label" ifAbsent: [| ""]];
          let already := [[seen value] at: name ifAbsent: [| nil]];
          [[[already isNil] & [[name isEmpty] not]] ifTrue: [|
            [seen set: [[seen value] at: name put: true]];
            [items set: [[items value] add: item]]]]]]]];
      [[doc notNil] ifTrue: [|
        let bindings := [doc at: "bindings" ifAbsent: [| #[]]];
        [bindings do: [:entry |
          let name := [entry at: "name" ifAbsent: [| ""]];
          let start := [entry at: "scopeStart" ifAbsent: [| 0]];
          let finish := [entry at: "scopeEnd" ifAbsent: [| [text size]]];
          let already := [[seen value] at: name ifAbsent: [| nil]];
          let inScope := [[offset >= start] & [offset <= finish]];
          let wanted := [[already isNil] & [name startsWith: prefix]];
          let shouldAdd := [wanted & inScope];
          [shouldAdd ifTrue: [| [seen set: [[seen value] at: name put: true]]; [items set: [[items value] add: [self completionItemForBinding: entry]]]]]]]]];
      let symbols := [index at: "symbols" ifAbsent: [| #[]]];
      [symbols do: [:entry |
        let name := [entry at: "name" ifAbsent: [| ""]];
        let already := [[seen value] at: name ifAbsent: [| nil]];
        let shouldAdd := [[already isNil] & [name startsWith: prefix]];
        [shouldAdd ifTrue: [| [seen set: [[seen value] at: name put: true]]; [items set: [[items value] add: [self completionItemForSymbol: entry]]]]]]];
      [items value]]
    ifFalse: [| [self completionItemsForRuntimeReceiver: text position: position prefix: prefix seen: seen]]]
  ] doc:
  "Answers exported receiver names, exact-receiver live methods, and scoped authored bindings and symbols." ];

[Reflect defineMethod: #onCompletion:id: on: Lsp as: [:self :p :id |
  let td := [p at: "textDocument" ifAbsent: [| [Map new]]];
  let uri := [td at: "uri" ifAbsent: [| ""]];
  let position := [p at: "position" ifAbsent: [| [Map new]]];
  let stored := [[self docsMap] at: uri ifAbsent: [| ""]];
  let text := [[stored isNil] ifTrue: [| ""] ifFalse: [| stored]];
  let cached := [self cachedCompletionFor: text uri: uri position: position];
  let result := [[cached notNil]
    ifTrue: [| cached]
    ifFalse: [|
      let receiverName := [self completionLiteralReceiverAtPosition: position in: text];
      let index := [[receiverName isEmpty] ifTrue: [| [self projectIndexFor: uri]] ifFalse: [| [Map new]]];
      let computed := [[[receiverName isEmpty] & [index isNil]]
        ifTrue: [| #[]]
        ifFalse: [| [self completionItemsFor: text uri: uri position: position index: index]]];
      [self rememberCompletion: computed text: text uri: uri position: position]]];
  [self respond: id result: result];
  self] doc:
  "Answers LSP completion from in-scope bindings and resolver-selected authored symbols." ];

[Reflect defineMethod: #signatureForSymbol: on: Lsp as: [:self :entry |
  let selector := [entry at: "name" ifAbsent: [| ""]];
  let count := [self selectorArity: selector];
  let params := #[];
  [[count > 0] ifTrue: [|
    [0 to: [count - 1] do: [:i |
      let label := ["arg" , [[i + 1] printString]];
      let parameter := [Map => new => at: "label" put: label];
      [params add: parameter]]]]];
  let label := [["#" , selector] , " on " , [entry at: "detail" ifAbsent: [| ""]]];
  [Map
    => new
    => at: "label" put: label
    => at: "documentation" put: [self symbolSourceBody: entry]
    => at: "parameters" put: params]
  ] doc:
  "Builds one LSP SignatureInformation from a source-backed method selector." ];

[Reflect defineMethod: #onSignatureHelp:id: on: Lsp as: [:self :p :id |
  let td := [p at: "textDocument" ifAbsent: [| [Map new]]];
  let uri := [td at: "uri" ifAbsent: [| ""]];
  let position := [p at: "position" ifAbsent: [| [Map new]]];
  let index := [self projectIndexFor: uri];
  let stored := [[self docsMap] at: uri ifAbsent: [| ""]];
  let text := [[stored isNil] ifTrue: [| ""] ifFalse: [| stored]];
  let found := [[index isNil] ifTrue: [| nil] ifFalse: [| [self symbolForPosition: position uri: uri index: index]]];
  let result := [[found isNil] ifTrue: [| nil] ifFalse: [|
    let signature := [self signatureForSymbol: found];
    [Map
      => new
      => at: "signatures" put: #[signature]
      => at: "activeSignature" put: 0
      => at: "activeParameter" put: 0]]];
  [self respond: id result: result];
  self] doc:
  "Answers signature help for a method selector under the cursor; dynamic receiver dispatch remains intentionally unresolved." ];

// -- JSON-RPC response builders -----------------------------------------------

[Reflect defineMethod: #respond:result: on: Lsp as: [:self :id :result |
  let msg := [Map
    => new
    => at: "jsonrpc" put: "2.0"
    => at: "id" put: id
    => at: "result" put: result];
  [self sendMessage: [Json stringify: msg]];
  self] doc:
  "Sends a JSON-RPC success response: `result` under request `id`."];

[Reflect defineMethod: #respondError: on: Lsp as: [:self :id |
  let error := [Map => new => at: "code" put: -32601 => at: "message" put: "method not found"];
  let msg := [Map
    => new
    => at: "jsonrpc" put: "2.0"
    => at: "id" put: id
    => at: "error" put: error];
  [self sendMessage: [Json stringify: msg]];
  self] doc:
  "Sends a JSON-RPC error response for `id`: -32601 method not found."];

[Reflect defineMethod: #sendNote:params: on: Lsp as: [:self :method :params |
  let note := [Map
    => new
    => at: "jsonrpc" put: "2.0"
    => at: "method" put: method
    => at: "params" put: params];
  [self sendMessage: [Json stringify: note]];
  self] doc:
  "Sends a JSON-RPC notification: `method` with `params` (no id, no reply expected)."];

// -- request/notification handlers --------------------------------------------

[Reflect defineMethod: #loadProjectSnapshotFor: on: Lsp as: [:self :uri |
  [[[Reflect globalNamed: #HostProject] notNil]
    ifTrue: [|
      let snapshot := [HostProject snapshotForUri: uri];
      [[snapshot isNil] ifTrue: [| nil] ifFalse: [| snapshot]]]
    ifFalse: [| nil]]
  ] doc:
  "Asks the host-side shared Project resolver for a native snapshot for `uri`; answers a map or nil when the native owner is unavailable." ];

[Reflect defineMethod: #projectRootsMap on: Lsp as: [:self |
  [ObjectModel slot: 2 in: self]
  ] doc:
  "Answers the URI-to-canonical-project-root map." ];

[Reflect defineMethod: #projectCacheMap on: Lsp as: [:self |
  [ObjectModel slot: 3 in: self]
  ] doc:
  "Answers the canonical-project-root-to-snapshot cache." ];

[Reflect defineMethod: #projectFailuresMap on: Lsp as: [:self |
  [ObjectModel slot: 4 in: self]
  ] doc:
  "Answers the URI-to-failed-project-snapshot map." ];

[Reflect defineMethod: #projectRootOf: on: Lsp as: [:self :uri |
  [[self projectRootsMap] at: uri ifAbsent: [| nil]]
  ] doc:
  "Answers the canonical project root associated with `uri`, or nil when resolution has failed or not run." ];

[Reflect defineMethod: #projectSnapshotFor: on: Lsp as: [:self :uri |
  let root := [self projectRootOf: uri];
  [[root notNil]
    ifTrue: [| [[self projectCacheMap] at: root ifAbsent: [| nil]]]
    ifFalse: [| [[self projectFailuresMap] at: uri ifAbsent: [| nil]]]]
  ] doc:
  "Answers the cached project snapshot for a document URI, resolving project identity per document rather than through one global workspace snapshot." ];

[Reflect defineMethod: #documentPathsMap on: Lsp as: [:self |
  [ObjectModel slot: 5 in: self]
  ] doc:
  "Answers the open-document URI-to-decoded-path map." ];

[Reflect defineMethod: #projectIndexesMap on: Lsp as: [:self |
  [ObjectModel slot: 6 in: self]
  ] doc:
  "Answers the read-only authored-source index cache keyed by project root." ];

[Reflect defineMethod: #pathForUri: on: Lsp as: [:self :uri |
  [[[Reflect globalNamed: #HostProject] notNil]
    ifTrue: [| [HostProject pathForUri: uri]]
    ifFalse: [| nil]]
  ] doc:
  "Asks the read-only native project owner to decode a document URI into its filesystem path." ];

[Reflect defineMethod: #uriForPath: on: Lsp as: [:self :path |
  let found := [nil asCell];
  let paths := [[self documentPathsMap] keys];
  [paths do: [:uri |
    let known := [[self documentPathsMap] at: uri ifAbsent: [| nil]];
    let match := [[known notNil] & [known = path]];
    [match ifTrue: [| [found set: uri]]]]];
  let hasFound := [[found value] notNil];
  [hasFound ifTrue: [| [found value]] ifFalse: [| ["file://" , path]]]
  ] doc:
  "Answers the retained open URI for `path`, or a file URI for an unopened authored source." ];

[Reflect defineMethod: #invalidateProjectIndexes on: Lsp as: [:self |
  [ObjectModel slot: 6 in: self put: [Map new]];
  self] doc:
  "Drops derived authored-source indexes after a document or project-topology change." ];

[Reflect defineMethod: #sourceTextForPath: on: Lsp as: [:self :path |
  let uri := [self uriForPath: path];
  let open := [[self docsMap] at: uri ifAbsent: [| nil]];
  [[open notNil]
    ifTrue: [| open]
    ifFalse: [|
      let disk := [System readFile: path];
      [[disk isError] ifTrue: [| ""] ifFalse: [| disk]]]]
  ] doc:
  "Answers open-buffer text when available, otherwise the authored source at `path`; errors become empty analysis text." ];

[Reflect defineMethod: #indexedSymbol:module:path:uri:text: on: Lsp as: [:self :entry :module :path :uri :text |
  [Map
    => new
    => at: "name" put: [entry at: "name" ifAbsent: [| ""]]
    => at: "kind" put: [entry at: "kind" ifAbsent: [| 13]]
    => at: "detail" put: [entry at: "detail" ifAbsent: [| ""]]
    => at: "start" put: [entry at: "start" ifAbsent: [| 0]]
    => at: "end" put: [entry at: "end" ifAbsent: [| 0]]
    => at: "selectionStart" put: [entry at: "selectionStart" ifAbsent: [| 0]]
    => at: "selectionEnd" put: [entry at: "selectionEnd" ifAbsent: [| 0]]
    => at: "module" put: module
    => at: "path" put: path
    => at: "uri" put: uri
    => at: "source" put: text]
  ] doc:
  "Adds canonical module/path/URI/source provenance to one parser-backed source symbol." ];

[Reflect defineMethod: #indexedBinding:module:path:uri:text: on: Lsp as: [:self :entry :module :path :uri :text |
  [Map
    => new
    => at: "kind" put: [entry at: "kind" ifAbsent: [| "local"]]
    => at: "name" put: [entry at: "name" ifAbsent: [| ""]]
    => at: "start" put: [entry at: "start" ifAbsent: [| 0]]
    => at: "end" put: [entry at: "end" ifAbsent: [| 0]]
    => at: "scopeStart" put: [entry at: "scopeStart" ifAbsent: [| 0]]
    => at: "scopeEnd" put: [entry at: "scopeEnd" ifAbsent: [| 0]]
    => at: "module" put: module
    => at: "path" put: path
    => at: "uri" put: uri
    => at: "source" put: text]
  ] doc:
  "Adds canonical module/path/URI/source provenance to one lexical binding." ];

[Reflect defineMethod: #sourceDocumentIndex:path:uri:text: on: Lsp as: [:self :module :path :uri :text |
  let raw := [self sourceAnalysisOf: text];
  let rawSymbols := [raw at: "symbols"];
  let symbols := [rawSymbols inject: #[] into: [:out :entry |
    [out add: [self indexedSymbol: entry module: module path: path uri: uri text: text]]]];
  let rawOccurrences := [raw at: "occurrences"];
  let rawBindings := [raw at: "bindings"];
  let bindings := [rawBindings inject: #[] into: [:out :entry |
    [out add: [self indexedBinding: entry module: module path: path uri: uri text: text]]]];
  [Map
    => new
    => at: "module" put: module
    => at: "path" put: path
    => at: "uri" put: uri
    => at: "source" put: text
    => at: "symbols" put: symbols
    => at: "occurrences" put: rawOccurrences
    => at: "bindings" put: bindings]
  ] doc:
  "Builds one parser-backed authored document index without evaluating its source." ];

[Reflect defineMethod: #sourceIndexFor:uri: on: Lsp as: [:self :snapshot :currentUri |
  let root := [snapshot at: "projectRoot" ifAbsent: [| ""]];
  let digest := [snapshot at: "digest" ifAbsent: [| ""]];
  let cached := [[self projectIndexesMap] at: root ifAbsent: [| nil]];
  let sameDigest := [[cached notNil] & [[cached at: "digest" ifAbsent: [| ""]] = digest]];
  [sameDigest ifTrue: [| cached] ifFalse: [|
      let modules := [snapshot at: "modules" ifAbsent: [| #[]]];
      let docs := [modules inject: #[] into: [:out :module |
        let path := [module at: "path" ifAbsent: [| ""]];
        let uri := [self uriForPath: path];
        let text := [self sourceTextForPath: path];
        let moduleName := [module at: "name" ifAbsent: [| ""]];
        let doc := [self sourceDocumentIndex: moduleName path: path uri: uri text: text];
        [out add: doc]]];
      let symbols := [docs inject: #[] into: [:out :doc |
        let docSymbols := [doc at: "symbols" ifAbsent: [| #[]]];
        [docSymbols inject: out into: [:acc :entry | [acc add: entry]]]]];
      let currentPath := [self pathForUri: currentUri];
      let already := [docs anySatisfy: [:doc | [[doc at: "uri" ifAbsent: [| ""]] = currentUri]]];
      let addCurrent := [[already not] & [currentPath notNil]];
      let currentDoc := [addCurrent ifTrue: [|
        let text := [[self docsMap] at: currentUri ifAbsent: [| ""]];
        [self sourceDocumentIndex: "<buffer>" path: currentPath uri: currentUri text: text]] ifFalse: [| nil]];
      let allDocs := [addCurrent ifTrue: [| [docs add: currentDoc]] ifFalse: [| docs]];
      let currentSymbols := [addCurrent ifTrue: [| [currentDoc at: "symbols" ifAbsent: [| #[]]]] ifFalse: [| #[]]];
      let allSymbols := [currentSymbols inject: symbols into: [:out :entry | [out add: entry]]];
      let index := [Map
        => new
        => at: "digest" put: digest
        => at: "root" put: root
        => at: "documents" put: allDocs
        => at: "symbols" put: allSymbols];
      [ObjectModel slot: 6 in: self put: [[self projectIndexesMap] at: root put: index]];
      index]]
  ] doc:
  "Builds or returns the canonical-root authored-source index, using open buffers only for analysis." ];

[Reflect defineMethod: #documentInIndex:uri: on: Lsp as: [:self :index :uri |
  [[index at: "documents" ifAbsent: [| #[]]] detect: [:doc |
    [[doc at: "uri" ifAbsent: [| ""]] = uri]] ifNone: [| nil]]
  ] doc:
  "Answers one indexed document by URI." ];

[Reflect defineMethod: #projectIndexFor: on: Lsp as: [:self :uri |
  let snapshot := [self projectSnapshotFor: uri];
  let valid := [[snapshot notNil] & [snapshot at: "ok" ifAbsent: [| false]]];
  [valid ifTrue: [| [self sourceIndexFor: snapshot uri: uri]] ifFalse: [| nil]]
  ] doc:
  "Answers the authored-source index for a document's resolved project, or nil on resolution failure." ];

[Reflect defineMethod: #symbolMatchesToken:token: on: Lsp as: [:self :entry :token |
  let name := [entry at: "name" ifAbsent: [| ""]];
  let kind := [entry at: "kind" ifAbsent: [| 13]];
  [[name = token] | [[kind = 6] & [name startsWith: token]]]
  ] doc:
  "Matches an exact symbol or a method selector whose current keyword part is under the cursor." ];

[Reflect defineMethod: #symbolInDocument:token: on: Lsp as: [:self :doc :token |
  let symbols := [doc at: "symbols" ifAbsent: [| #[]]];
  let exact := [symbols detect: [:entry |
    [[entry at: "name" ifAbsent: [| ""]] = token]] ifNone: [| nil]];
  [[exact notNil]
    ifTrue: [| exact]
    ifFalse: [| [symbols detect: [:entry | [self symbolMatchesToken: entry token: token]] ifNone: [| nil]]]]
  ] doc:
  "Finds the best source-backed symbol in one indexed document." ];

[Reflect defineMethod: #symbolForPosition:uri:index: on: Lsp as: [:self :position :uri :index |
  let doc := [self documentInIndex: index uri: uri];
  let text := [[doc notNil] ifTrue: [| [doc at: "source" ifAbsent: [| ""]]] ifFalse: [| ""]];
  let lineNo := [position at: "line" ifAbsent: [| 0]];
  let lineText := [self lineAt: lineNo in: text];
  let col := [self byteOffsetForUtf16: [position at: "character" ifAbsent: [| 0]] in: lineText];
  let token := [self tokenAt: col in: lineText];
  let local := [[doc notNil] ifTrue: [| [self symbolInDocument: doc token: token]] ifFalse: [| nil]];
  [[local notNil]
    ifTrue: [| local]
    ifFalse: [| [[index at: "symbols" ifAbsent: [| #[]]] detect: [:entry |
      [self symbolMatchesToken: entry token: token]] ifNone: [| nil]]]]
  ] doc:
  "Resolves a cursor token to a source-backed project symbol, preferring its open document." ];

[Reflect defineMethod: #locationForIndexedSymbol: on: Lsp as: [:self :entry |
  let start := [entry at: "selectionStart" ifAbsent: [| [entry at: "start" ifAbsent: [| 0]]]];
  let finish := [entry at: "selectionEnd" ifAbsent: [| [entry at: "end" ifAbsent: [| start]]]];
  let range := [self rangeForStart: start end: finish in: [entry at: "source" ifAbsent: [| ""]]];
  [Map
    => new
    => at: "uri" put: [entry at: "uri" ifAbsent: [| ""]]
    => at: "range" put: range]
  ] doc:
  "Answers an LSP Location for an indexed authored symbol definition." ];

[Reflect defineMethod: #locationForIndexedOccurrence:doc: on: Lsp as: [:self :entry :doc |
  let start := [entry at: "start" ifAbsent: [| 0]];
  let finish := [entry at: "end" ifAbsent: [| start]];
  let range := [self rangeForStart: start end: finish in: [doc at: "source" ifAbsent: [| ""]]];
  [Map
    => new
    => at: "uri" put: [doc at: "uri" ifAbsent: [| ""]]
    => at: "range" put: range]
  ] doc:
  "Answers an LSP Location for an indexed authored occurrence." ];

[Reflect defineMethod: #occurrenceMatchesSymbol:entry: on: Lsp as: [:self :symbol :entry |
  let symbolName := [symbol at: "name" ifAbsent: [| ""]];
  let entryName := [entry at: "name" ifAbsent: [| ""]];
  let kind := [symbol at: "kind" ifAbsent: [| 13]];
  [[kind = 6] ifTrue: [| [symbolName startsWith: entryName]] ifFalse: [| [symbolName = entryName]]]
  ] doc:
  "Matches lexical occurrences to a method selector or local binding without claiming dynamic dispatch." ];

[Reflect defineMethod: #symbolSourceBody: on: Lsp as: [:self :entry |
  let name := [entry at: "name" ifAbsent: [| ""]];
  let kind := [entry at: "kind" ifAbsent: [| 13]];
  let module := [entry at: "module" ifAbsent: [| "<buffer>"]];
  let path := [entry at: "path" ifAbsent: [| ""]];
  let detail := [entry at: "detail" ifAbsent: [| ""]];
  let source := [entry at: "source" ifAbsent: [| ""]];
  let methodBody := ["Birnam method `#" , name , "` on `" , detail
    , "\n\nmodule `#" , module , "`\n\nsource: `" , path
    , "`\n\n```birnam\n" , source , "\n```"];
  let moduleBody := ["Birnam module `#" , name , "`\n\nsource: `" , path
    , "`\n\nrequires its resolver-selected dependencies."];
  let bindingBody := ["Birnam binding `" , name , "`\n\nmodule `#" , module
    , "`\n\nsource: `" , path];
  [{6 -> methodBody, 3 -> moduleBody} at: kind ifAbsent: [| bindingBody]]
  ] doc:
  "Builds semantic hover text from authored source provenance." ];

[Reflect defineMethod: #selectorArity: on: Lsp as: [:self :selector |
  let colons := [[[selector split: ":"] size] - 1];
  let first := [[[selector size] > 0] ifTrue: [| [selector byteAt: 0]] ifFalse: [| 0]];
  let letter := [[[first >= 97] & [first <= 122]] | [[first >= 65] & [first <= 90]]];
  [[colons > 0] ifTrue: [| colons] ifFalse: [| [letter ifTrue: [| 0] ifFalse: [| 1]]]]
  ] doc:
  "Answers keyword colon arity, or one for a non-letter binary selector." ];

[Reflect defineMethod: #byteOffsetAtPosition:in: on: Lsp as: [:self :position :text |
  let lineNo := [position at: "line" ifAbsent: [| 0]];
  let character := [position at: "character" ifAbsent: [| 0]];
  let offset := [0 asCell];
  [0 to: lineNo do: [:i |
    [[i < lineNo] ifTrue: [| [offset set: [[offset value] + [[self lineAt: i in: text] size] + 1]]]]]];
  [[offset value] + [self byteOffsetForUtf16: character in: [self lineAt: lineNo in: text]]]
  ] doc:
  "Converts an LSP position to an absolute UTF-8 byte offset for lexical scope filtering." ];

[Reflect defineMethod: #completionPrefixAtPosition:in: on: Lsp as: [:self :position :text |
  let lineNo := [position at: "line" ifAbsent: [| 0]];
  let line := [self lineAt: lineNo in: text];
  let col := [self byteOffsetForUtf16: [position at: "character" ifAbsent: [| 0]] in: line];
  let start := [self scanLeft: col in: line];
  [line copyFrom: start to: col]
  ] doc:
  "Answers the identifier prefix immediately before an LSP completion cursor." ];

[Reflect defineMethod: #rememberProjectSnapshot:for:oldRoot: on: Lsp as: [:self :snapshot :uri :oldRoot |
  let ok := [snapshot at: "ok" ifAbsent: [| false]];
  let root := [snapshot at: "projectRoot" ifAbsent: [| ""]];
  let valid := [ok & [[root isEmpty] not]];
  [valid
    ifTrue: [|
      [ObjectModel slot: 2 in: self put: [[self projectRootsMap] at: uri put: root]];
      [ObjectModel slot: 3 in: self put: [[self projectCacheMap] at: root put: snapshot]];
      [ObjectModel slot: 4 in: self put: [[self projectFailuresMap] at: uri put: nil]];
      snapshot]
    ifFalse: [|
      [[oldRoot notNil]
        ifTrue: [|
          [ObjectModel slot: 2 in: self put: [[self projectRootsMap] at: uri put: oldRoot]];
          [ObjectModel slot: 3 in: self put: [[self projectCacheMap] at: oldRoot put: snapshot]];
          [ObjectModel slot: 4 in: self put: [[self projectFailuresMap] at: uri put: nil]]]
        ifFalse: [|
          [ObjectModel slot: 2 in: self put: [[self projectRootsMap] at: uri put: nil]];
          [ObjectModel slot: 4 in: self put: [[self projectFailuresMap] at: uri put: snapshot]]]];
      snapshot]]
  ] doc:
  "Stores a successful snapshot in the canonical-root cache, or retains a failure per URI; a refresh failure for an existing project replaces that project's cached snapshot." ];

[Reflect defineMethod: #refreshProjectFor: on: Lsp as: [:self :uri |
  let oldRoot := [self projectRootOf: uri];
  let snapshot := [self loadProjectSnapshotFor: uri];
  [[snapshot notNil] ifTrue: [| [self rememberProjectSnapshot: snapshot for: uri oldRoot: oldRoot]]];
  snapshot
  ] doc:
  "Refreshes the project snapshot for one document URI and updates the shared canonical-root cache." ];

[Reflect defineMethod: #primeWorkspaceFor: on: Lsp as: [:self :uri |
  let snapshot := [self loadProjectSnapshotFor: uri];
  let ok := [[snapshot notNil] ifTrue: [| [snapshot at: "ok" ifAbsent: [| false]]] ifFalse: [| false]];
  let root := [[snapshot notNil] ifTrue: [| [snapshot at: "projectRoot" ifAbsent: [| ""]]] ifFalse: [| ""]];
  [[ok & [[root isEmpty] not]] ifTrue: [|
    [ObjectModel slot: 3 in: self put: [[self projectCacheMap] at: root put: snapshot]]]];
  [ObjectModel slot: 12 in: self put: uri];
  snapshot
  ] doc:
  "Primes the canonical-root cache from an explicit workspace URI without assigning that workspace snapshot to every document." ];

[Reflect defineMethod: #workspaceUri on: Lsp as: [:self |
  [ObjectModel slot: 12 in: self]
  ] doc:
  "Answers the URI used for the current project workspace." ];

[Reflect defineMethod: #onInitialize:params: on: Lsp as: [:self :id :p |
  let foldersRaw := [p at: "workspaceFolders" ifAbsent: [| #[]]];
  let folders := [[foldersRaw isNil] ifTrue: [| #[]] ifFalse: [| foldersRaw]];
  let folder := [[folders isEmpty] ifTrue: [| [Map new]] ifFalse: [| [folders at: 0]]];
  let rootRaw := [folder at: "uri" ifAbsent: [| [p at: "rootUri" ifAbsent: [| [p at: "rootPath" ifAbsent: [| ""]]]]]];
  let root := [[rootRaw isNil] ifTrue: [| ""] ifFalse: [| rootRaw]];
  [[root isEmpty] ifFalse: [| [self primeWorkspaceFor: root]]];
  let sync := [Map
    => new
    => at: "openClose" put: true
    => at: "change" put: 1
    => at: "save" put: true];
  let caps := [Map
    => new
    => at: "textDocumentSync" put: sync
    => at: "hoverProvider" put: true
    => at: "documentSymbolProvider" put: true
    => at: "definitionProvider" put: true
    => at: "referencesProvider" put: true
    => at: "workspaceSymbolProvider" put: true
    => at: "completionProvider" put: [Map => new => at: "resolveProvider" put: false]
    => at: "signatureHelpProvider" put: [Map => new => at: "triggerCharacters" put: #[":"]]];
  let info := [Map => new => at: "name" put: "birnam" => at: "version" put: "0.1"];
  let result := [Map => new => at: "capabilities" put: caps => at: "serverInfo" put: info];
  [self respond: id result: result];
  self] doc:
  "Answers initialize after selecting an explicit workspace URI when supplied; project resolution remains read-only."];

[Reflect defineMethod: #onShutdown: on: Lsp as: [:self :id |
  [self respond: id result: nil];
  self] doc:
  "Answers the shutdown request `id` with a nil result."];

[Reflect defineMethod: #onDidOpen: on: Lsp as: [:self :p |
  let td := [p at: "textDocument" ifAbsent: [| [Map new]]];
  let uri := [td at: "uri" ifAbsent: [| ""]];
  let text := [td at: "text" ifAbsent: [| ""]];
  let version := [td at: "version" ifAbsent: [| 0]];
  [self refreshProjectFor: uri];
  [self rememberDocumentPath: uri];
  [self storeDoc: uri text: text version: version];
  [self diagnoseUri: uri text: text];
  self] doc:
  "didOpen: stores the opened document and version, resolves its document-scoped project, and publishes diagnostics."];

[Reflect defineMethod: #onDidChange: on: Lsp as: [:self :p |
  let td := [p at: "textDocument" ifAbsent: [| [Map new]]];
  let uri := [td at: "uri" ifAbsent: [| ""]];
  let version := [td at: "version" ifAbsent: [| 0]];
  let changes := [p at: "contentChanges" ifAbsent: [| #[]]];
  let text := [[changes isEmpty] ifTrue: [| ""] ifFalse: [| [[changes at: 0] at: "text" ifAbsent: [| ""]]]];
  let current := [self versionOf: uri];
  [[version >= current]
    ifTrue: [| [self storeDoc: uri text: text version: version]]];
  self] doc:
  "didChange: accepts only non-stale full-text versions and replaces the document; diagnostics run on open/save so interactive requests do not queue behind every keystroke."];

[Reflect defineMethod: #republishProjectDiagnosticsFor:and: on: Lsp as: [:self :oldRoot :newRoot |
  let docs := [self docsMap];
  [[docs keys] do: [:candidate |
    let text := [docs at: candidate ifAbsent: [| nil]];
    [[text isNil] ifFalse: [|
      let root := [self projectRootOf: candidate];
      let sameOld := [[oldRoot notNil] & [root = oldRoot]];
      let sameNew := [[newRoot notNil] & [root = newRoot]];
      [[sameOld | sameNew] ifTrue: [| [self diagnoseUri: candidate text: text]]]]]]];
  self] doc:
  "Republishes open-document diagnostics for documents attached to either project root after a saved project refresh." ];

[Reflect defineMethod: #onDidSave: on: Lsp as: [:self :p |
  let td := [p at: "textDocument" ifAbsent: [| [Map new]]];
  let uri := [td at: "uri" ifAbsent: [| ""]];
  let oldRoot := [self projectRootOf: uri];
  [self refreshProjectFor: uri];
  let newRoot := [self projectRootOf: uri];
  [self republishProjectDiagnosticsFor: oldRoot and: newRoot];
  self] doc:
  "didSave: refreshes the disk-backed project graph and republishes diagnostics for open documents in the affected project." ];

[Reflect defineMethod: #onDidClose: on: Lsp as: [:self :p |
  let td := [p at: "textDocument" ifAbsent: [| [Map new]]];
  let uri := [td at: "uri" ifAbsent: [| ""]];
  [ObjectModel slot: 0 in: self put: [[self docsMap] at: uri put: nil]];
  [ObjectModel slot: 1 in: self put: [[self versionsMap] at: uri put: nil]];
  [ObjectModel slot: 5 in: self put: [[self documentPathsMap] at: uri put: nil]];
  [self invalidateProjectIndexes];
  let params := [Map => new => at: "uri" put: uri => at: "diagnostics" put: #[]];
  [self sendNote: "textDocument/publishDiagnostics" params: params];
  self] doc:
  "didClose: releases the retained document text/version and clears its diagnostics."];

// -- hover (docs from the Doc system) -----------------------------------------

// Per-uri document text (a Map keyed by uri value), so hover can read the source.
[Reflect defineMethod: #docsMap on: Lsp as: [:self | [ObjectModel slot: 0 in: self]] doc:
  "Answers the per-uri document-text Map owned by this server."];
[Reflect defineMethod: #versionsMap on: Lsp as: [:self | [ObjectModel slot: 1 in: self]] doc:
  "Answers the per-uri document-version Map."];
[Reflect defineMethod: #versionOf: on: Lsp as: [:self :uri |
  let v := [[self versionsMap] at: uri ifAbsent: [| 0]];
  [[v isNil] ifTrue: [| 0] ifFalse: [| v]]
  ] doc:
  "Answers the last accepted version for `uri`, or zero when no version is stored."];
[Reflect defineMethod: #storeDoc:text:version: on: Lsp as: [:self :uri :text :version |
  [ObjectModel slot: 0 in: self put: [[self docsMap] at: uri put: text]];
  [ObjectModel slot: 1 in: self put: [[self versionsMap] at: uri put: version]];
  [self invalidateProjectIndexes];
  self] doc:
  "Stores a full-text document and its accepted LSP version for `uri`." ];

[Reflect defineMethod: #rememberDocumentPath: on: Lsp as: [:self :uri |
  let path := [self pathForUri: uri];
  [ObjectModel slot: 5 in: self put: [[self documentPathsMap] at: uri put: path]];
  self] doc:
  "Stores the host-decoded path for one open document so disk modules can be overridden by its buffer." ];

// The 0-based line `n` of `text`.
[Reflect defineMethod: #lineAt:in: on: Lsp as: [:self :n :text |
  let lines := [text split: "\n"];
  let r := [[n < [lines size]] ifTrue: [| [lines at: n]] ifFalse: [| ""]];
  r] doc:
  "Answers the 0-based line `n` of `text`; \"\" when out of range."];

// A byte that can appear in an identifier: A-Z a-z 0-9 _.
[Reflect defineMethod: #isIdentByte: on: Lsp as: [:self :b |
  let uppercase := [[b >= 65] & [b <= 90]];
  let lowercase := [[b >= 97] & [b <= 122]];
  let digit := [[b >= 48] & [b <= 57]];
  let letter := [uppercase | lowercase];
  [letter | [digit | [b = 95]]]] doc:
  "True iff byte `b` can appear in an identifier: A-Z, a-z, 0-9, or _."];

[Reflect defineMethod: #scanLeft:in: on: Lsp as: [:self :i :line |
  let r := [[i <= 0]
    ifTrue:  [| 0]
    ifFalse: [| [[self isIdentByte: [line byteAt: [i - 1]]]
      ifTrue:  [| [self scanLeft: [i - 1] in: line]]
      ifFalse: [| i]]]];
  r] doc:
  "Answers the start index of the identifier run in `line` that ends just before index `i`, scanning left."];
[Reflect defineMethod: #scanRight:in: on: Lsp as: [:self :i :line |
  let r := [[i >= [line size]]
    ifTrue:  [| i]
    ifFalse: [| [[self isIdentByte: [line byteAt: i]]
      ifTrue:  [| [self scanRight: [i + 1] in: line]]
      ifFalse: [| i]]]];
  r] doc:
  "Answers the index just past the identifier run in `line` starting at index `i`, scanning right."];

// The identifier token at 0-based column `col` in `line`; a keyword selector part
// keeps its trailing ':' (byte 58). "" when the cursor isn't on an identifier.
[Reflect defineMethod: #tokenAt:in: on: Lsp as: [:self :col :line |
  let n := [line size];
  let r := [[n = 0]
    ifTrue:  [| ""]
    ifFalse: [|
      let c := [[col >= n] ifTrue: [| [n - 1]] ifFalse: [| col]];
      [[self isIdentByte: [line byteAt: c]]
        ifTrue:  [|
          let s := [self scanLeft: c in: line];
          let e := [self scanRight: c in: line];
          let w := [line copyFrom: s to: e];
          [[e < n]
            ifTrue:  [| [[[line byteAt: e] = 58] ifTrue: [| [w , ":"]] ifFalse: [| w]]]
            ifFalse: [| w]]]
        ifFalse: [| ""]]]];
  r] doc:
  "Answers the identifier token at 0-based column `col` in `line` (a keyword part keeps its ':'); \"\" when not on one."];

// Build an LSP Hover result (markdown): a bold token header over a rendered body.
[Reflect defineMethod: #hoverResult:token: on: Lsp as: [:self :body :tok |
  let value := ["**" , tok , "**\n\n" , body];
  let contents := [Map => new => at: "kind" put: "markdown" => at: "value" put: value];
  [Map => new => at: "contents" put: contents]] doc:
  "Answers an LSP Hover result (markdown): a bold `tok` header over the rendered `body`."];

// textDocument/hover: the Doc body for the token under the cursor — a hand-written
// docstring, else the recorded method source, else nil (nothing to show, or no Doc).
[Reflect defineMethod: #onHover:id: on: Lsp as: [:self :p :id |
  let td   := [p at: "textDocument" ifAbsent: [| [Map new]]];
  let uri  := [td at: "uri" ifAbsent: [| ""]];
  let pos  := [p at: "position" ifAbsent: [| [Map new]]];
  let ln   := [pos at: "line" ifAbsent: [| 0]];
  let ch   := [pos at: "character" ifAbsent: [| 0]];
  let stored := [[self docsMap] at: uri ifAbsent: [| ""]];
  let text := [[stored isNil] ifTrue: [| ""] ifFalse: [| stored]];
  let lineText := [self lineAt: ln in: text];
  let byteCol := [self byteOffsetForUtf16: ch in: lineText];
  let tok  := [self tokenAt: byteCol in: lineText];
  let body := [[Globals includes: #Doc] ifTrue: [| [Doc hoverBodyFor: tok]] ifFalse: [| ""]];
  let index := [self projectIndexFor: uri];
  let symbol := [[index notNil] ifTrue: [| [self symbolForPosition: pos uri: uri index: index]] ifFalse: [| nil]];
  let semantic := [[symbol isNil] ifTrue: [| ""] ifFalse: [| [self symbolSourceBody: symbol]]];
  let combined := [[body isEmpty]
    ifTrue: [| semantic]
    ifFalse: [| [[semantic isEmpty] ifTrue: [| body] ifFalse: [| [body , "\n\n" , semantic]]]]];
  [[combined isEmpty]
    ifTrue:  [| [self respond: id result: nil]]
    ifFalse: [| [self respond: id result: [self hoverResult: combined token: tok]]]];
  self] doc:
  "Answers documentation plus authored method/module/binding provenance for the token under the cursor." ];

// -- dispatch + loop ----------------------------------------------------------

[Reflect defineMethod: #dispatch: on: Lsp as: [:self :msg |
  let m  := [msg at: "method" ifAbsent: [| ""]];
  let id := [msg at: "id" ifAbsent: [| nil]];
  let p  := [msg at: "params" ifAbsent: [| [Map new]]];
  let handlers := {
    "initialize" -> [| [self onInitialize: id params: p]],
    "textDocument/hover" -> [| [self onHover: p id: id]],
    "textDocument/didOpen" -> [| [self onDidOpen: p]],
    "textDocument/didChange" -> [| [self onDidChange: p]],
    "textDocument/didClose" -> [| [self onDidClose: p]],
    "textDocument/didSave" -> [| [self onDidSave: p]],
    "textDocument/documentSymbol" -> [| [self onDocumentSymbol: p id: id]],
    "textDocument/definition" -> [| [self onDefinition: p id: id]],
    "textDocument/references" -> [| [self onReferences: p id: id]],
    "textDocument/completion" -> [| [self onCompletion: p id: id]],
    "textDocument/signatureHelp" -> [| [self onSignatureHelp: p id: id]],
    "workspace/symbol" -> [| [self onWorkspaceSymbol: p id: id]],
    "shutdown" -> [| [self onShutdown: id]],
    "exit" -> [| [0 cExit]]};
  let handler := [handlers at: m ifAbsent: [| nil]];
  [[handler notNil]
    ifTrue: [| [handler value]]
    ifFalse: [|
      [[id notNil]
        ifTrue: [| [self respondError: id]]
        ifFalse: [| self]]]]
  ] doc:
  "Routes a parsed JSON-RPC `msg` to its handler by method name; unknown requests answer method-not-found."];

// Parse a body and dispatch it; ignore malformed JSON.
[Reflect defineMethod: #handle: on: Lsp as: [:self :body |
  let msg := [Json parse: body];
  let r := [[msg isError]
    ifTrue:  [| self]
    ifFalse: [| [self dispatch: msg]]];
  r] doc:
  "Parses the JSON `body` and dispatches it; malformed JSON is ignored."];

// Read + handle one message; terminate the process at EOF.
[Reflect defineMethod: #step on: Lsp as: [:self |
  let body := [self readMessage];
  let r := [[body isNil]
    ifTrue:  [| [0 cExit]]
    ifFalse: [| [self handle: body]]];
  r] doc:
  "Reads and handles one message; terminates the process at EOF."];

// The server loop. `to:do:` is a native (iterative) loop — no per-message stack
// growth — and `step` blocks on read(), so this idles (no busy loop) until a
// message arrives; `exit`/EOF terminate the process. `to:do:` stops-and-
// propagates when the body answers an error, so a step's fault (one bad
// message) is swallowed HERE, explicitly — it must not kill the server.
[Reflect defineMethod: #serveStdio on: Lsp as: [:self |
  let me := self;
  [1 to: 1000000000 do: [:i | [me step]; 0]];
  self] doc:
  "Run the LSP server loop on stdin/stdout: read framed messages, dispatch, reply. Blocks until exit/EOF."];
