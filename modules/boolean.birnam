// Boolean policy over canonical identities retained by the cold-bootstrap seed.
// Word compares opaque identities and selects data without a temporary Word.
// It never invokes a branch or implements Boolean behavior.
[Module named: #booleanValues requires: #[#nativeValues]];
let boolWord := Word;
let boolTrue := true;
let boolFalse := false;
let boolNil := nil;
let boolNilThunk := [| boolNil];
let boolTrueThunk := [| boolTrue];
let boolFalseThunk := [| boolFalse];
let boolTrueBytes := ["true" asBytes];
let boolFalseBytes := ["false" asBytes];
let boolString := String;
let boolExecution := Execution;
let boolByteSignature := "ob";
let boolPrintTrue := [| [boolExecution sendNativeTo: boolString selector: #fromBytes:
  arguments: #[boolTrueBytes] signature: boolByteSignature resultFactory: boolWord]];
let boolPrintFalse := [| [boolExecution sendNativeTo: boolString selector: #fromBytes:
  arguments: #[boolFalseBytes] signature: boolByteSignature resultFactory: boolWord]];

[Reflect defineMethod: #not on: Boolean as: [boolExecution block: [:self |
  let otherwise := [boolWord selectIfSameObject: self with: boolFalse ifEqual: boolTrue ifDifferent: boolNil];
  [boolWord selectIfSameObject: self with: boolTrue ifEqual: boolFalse ifDifferent: otherwise]
] withNativeSignature: "o"]];
[Reflect defineMethod: #& on: Boolean as: [boolExecution block: [:self :other |
  let otherwise := [boolWord selectIfSameObject: self with: boolFalse ifEqual: self ifDifferent: boolNil];
  [boolWord selectIfSameObject: self with: boolTrue ifEqual: other ifDifferent: otherwise]
] withNativeSignature: "oO"]];
[Reflect defineMethod: #| on: Boolean as: [boolExecution block: [:self :other |
  let otherwise := [boolWord selectIfSameObject: self with: boolFalse ifEqual: other ifDifferent: boolNil];
  [boolWord selectIfSameObject: self with: boolTrue ifEqual: self ifDifferent: otherwise]
] withNativeSignature: "oO"]];
// The deferred-result ABI invokes only the selected block and preserves raw
// native Word/Bytes/Unit/Entry results and failures at the existing Id boundary.
[Reflect defineMethod: #ifTrue:ifFalse: on: Boolean as:
  [boolExecution block: [:self :yes :no |
    let otherwise := [boolWord selectIfSameObject: self with: boolFalse ifEqual: no ifDifferent: boolNilThunk];
    [boolWord selectIfSameObject: self with: boolTrue ifEqual: yes ifDifferent: otherwise]
  ] withNativeSignature: "vOO"]];
[Reflect defineMethod: #ifTrue: on: Boolean as:
  [boolExecution block: [:self :yes |
    [boolWord selectIfSameObject: self with: boolTrue ifEqual: yes ifDifferent: boolNilThunk]
  ] withNativeSignature: "vO"]];
[Reflect defineMethod: #ifFalse: on: Boolean as:
  [boolExecution block: [:self :no |
    [boolWord selectIfSameObject: self with: boolFalse ifEqual: no ifDifferent: boolNilThunk]
  ] withNativeSignature: "vO"]];
[Reflect defineMethod: #and: on: Boolean as:
  [boolExecution block: [:self :other |
    let otherwise := [boolWord selectIfSameObject: self with: boolFalse ifEqual: boolFalseThunk ifDifferent: boolNilThunk];
    [boolWord selectIfSameObject: self with: boolTrue ifEqual: other ifDifferent: otherwise]
  ] withNativeSignature: "vO"]];
[Reflect defineMethod: #or: on: Boolean as:
  [boolExecution block: [:self :other |
    let otherwise := [boolWord selectIfSameObject: self with: boolFalse ifEqual: other ifDifferent: boolNilThunk];
    [boolWord selectIfSameObject: self with: boolTrue ifEqual: boolTrueThunk ifDifferent: otherwise]
  ] withNativeSignature: "vO"]];
[Reflect defineMethod: #printString on: Boolean as:
  [boolExecution block: [:self |
    let otherwise := [boolWord selectIfSameObject: self with: boolFalse ifEqual: boolPrintFalse ifDifferent: boolNilThunk];
    [boolWord selectIfSameObject: self with: boolTrue ifEqual: boolPrintTrue ifDifferent: otherwise]
  ] withNativeSignature: "v"]];
[Module markLoaded: #booleanValues];
