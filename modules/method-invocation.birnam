// Ordinary method construction policy. Templates share the declared code, while
// each bound Method retains its own implementation. This module is deliberately
// compiled as normal resumable Birnam, including on its first bootstrap load.
[Module named: #methodInvocation requires: #[#globals]];
[[|
let templateSlot := 0;
let factory := [ObjectModel newSlots: #[[Map new]] parent: ObjectVt];
[Namespace at: #MethodInvocation put: factory];

// Namespace exports are process-local owners, resolved by name in an image.
// Only this owner's ordinary slot retains the derived cache. It never changes
// Globals' binding revision or publishes Store facts. Fresh bootstrap creates an
// empty cache; saving an image neither serializes nor clears this live slot.
[Reflect defineMethod: #templates on: factory as: [:self |
  [ObjectModel slot: templateSlot in: self]
]];
[Reflect defineMethod: #clearTemplates on: factory as: [:self |
  let result := [ObjectModel slot: templateSlot in: self put: [Map new]];
  [[result isError] ifTrue: [| result] ifFalse: [| self]]
]];
[Reflect defineMethod: #compileTemplateForArity: on: factory as: [:self :arity |
  // The Oop entry already handles every supported arity. Its neutral template
  // shares code without compiling another native unit for each cache entry.
  [Codegen methodTemplateForArity: arity]
]];
[Reflect defineMethod: #templateForArity: on: factory as: [:self :arity |
  let template := [[self templates] at: arity];
  [[template isNil] ifTrue: [|
    let created := [self compileTemplateForArity: arity];
    [[created isError] ifTrue: [| created] ifFalse: [|
      // Compilation may reenter construction. Merge into the current cache;
      // never replay the compiler or overwrite from the pre-compilation Map.
      let current := [self templates];
      let next := [current at: arity put: created];
      [[next isError] ifTrue: [| next] ifFalse: [|
        // If a nested update wins after the read, keep its cache. The selected
        // template still serves this call; a cache miss never warrants replay.
        let result := [ObjectModel replaceSlot: templateSlot in: self expected: current with: next];
        [[result isError] ifTrue: [| result] ifFalse: [| created]]
      ]]
    ]]
  ] ifFalse: [| template]]
]];
[Reflect defineMethod: #methodForArity:implementation: on: factory as: [:self :arity :implementation |
  // A failed template answers this send through Error's ordinary protocol.
  [self methodForTemplate: [self templateForArity: arity] implementation: implementation]
]];
[Reflect defineMethod: #methodForTemplate:implementation: on: factory as: [:self :template :implementation |
  [template withImplementation: implementation]
]];
// The cold seed remains selected while the control library replaces Boolean
// methods in several steps. The host explicitly installs this policy once that
// substrate is complete. Reloads and later replacement are ordinary sends.
[Reflect defineMethod: #install on: factory as: [:self |
  [Reflect defineMethod: #methodForArity:implementation: on: Reflect as: [:facade :arity :implementation |
    [MethodInvocation methodForArity: arity implementation: implementation]
  ]];
  [Reflect defineMethod: #methodForTemplate:implementation: on: Reflect as: [:facade :template :implementation |
    [MethodInvocation methodForTemplate: template implementation: implementation]
  ]]
]];
factory
] value]
