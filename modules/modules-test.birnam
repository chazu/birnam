// Owned Module registry, traversal and scheduling contracts. Test records live
// in the manager's persistent Maps; no automatic fact projection is required.
// Loading this file registers the suite; run through modules/run-tests.birnam.

[[Globals includes: #TestSuite] ifTrue: [| nil] ifFalse: [| [System load: "modules/test.birnam"]]];

let s := [TestSuite named: "Modules" module: #modules];

[s test: "loadOrder: topologically sorts — every dependency precedes its dependent" do: [:t |
  // a → {b, c}, b → {c}, c → {} . The only valid order is c, b, a.
  [Module named: #tta requires: #[#ttb #ttc]];
  [Module named: #ttb requires: #[#ttc]];
  [Module named: #ttc requires: #[]];
  let order := [Module loadOrder: #[#tta]];
  [t expect: [order size] equals: 3 describes: "the root plus its transitive deps"];
  [t expect: [order at: 0] equals: #ttc describes: "no deps → first"];
  [t expect: [order at: 1] equals: #ttb describes: "needs c"];
  [t expect: [order at: 2] equals: #tta describes: "needs b, c → last"];
  // A shared dependency is emitted exactly once even when reached twice.
  let seen := [order inject: 0 into: [:acc :nm |
    [[nm = #ttc] ifTrue: [| [acc + 1]] ifFalse: [| acc]]]];
  [t expect: seen equals: 1 describes: "shared dep emitted once"]]];

[s test: "a dependency cycle answers #circularDependency, not an infinite loop" do: [:t |
  [Module named: #ttx requires: #[#tty]];
  [Module named: #tty requires: #[#ttx]];
  let r := [Module loadOrder: #[#ttx]];
  [t expect: [r isError] equals: true describes: "an error value, no loop"];
  [t expect: [r kind] equals: #circularDependency describes: "the kinded cycle error"]]];

[s test: "kernel modules are represented (registered, kind #kernel), not managed" do: [:t |
  [t expect: [Module isRegistered: #store] equals: true describes: "boot registered the kernel set"];
  [t expect: [Module kindOf: #store] equals: #kernel describes: "kind #kernel"];
  [t expect: [Module isLoaded: #store] equals: true describes: "kernel modules are already up"];
  [t expect: [Module isRegistered: #ttghost] equals: false describes: "an unregistered name"];
  [t expect: [[Module requiresOf: #ttghost] size] equals: 0 describes: "unregistered = a leaf (empty requires)"];
  // A self-hosted module that requires a kernel one sorts after it (kernel = leaf).
  [Module named: #ttapp requires: #[#store]];
  let order := [Module loadOrder: #[#ttapp]];
  [t expect: [order size] equals: 2 describes: "app + its kernel dep"];
  [t expect: [order at: 0] equals: #store describes: "the kernel dep is a satisfied leaf"];
  [t expect: [order at: 1] equals: #ttapp describes: "the app after it"]]];

[s test: "the manager itself is a self-hosted module (Phase 5b)" do: [:t |
  [t expect: [Module isRegistered: #modules] equals: true describes: "self-registered at its own end"];
  [t expect: [Module kindOf: #modules] equals: #selfHosted describes: "no longer a kernel dylib"];
  [t expect: [Module isLoaded: #modules] equals: true describes: "self-marked loaded"];
  [t expect: [Module kindOf: #stdlib] equals: #selfHosted describes: "stdlib registered by its own opening statement"]]];

[s test: "composeSources: joins an entry and ordered source parts" do: [:t |
  let entryPath := "/tmp/birnam-module-compose-entry.birnam";
  let partPath := "/tmp/birnam-module-compose-part.birnam";
  [System writeFile: entryPath contents: "[Module named: #ttcompose requires: #[]];"];
  [System writeFile: partPath contents: "// compose-part\n[Reflect defineMethod: #composePart on: Integer as: [:self | self]];"];
  let source := [Module composeSources: #[entryPath partPath]];
  [t expect: [source isError] equals: false describes: "composition returns source text"];
  [t assert: [source includesSubstring: "#ttcompose"] describes: "entry source is present"];
  [t assert: [source includesSubstring: "compose-part"] describes: "part source is present"]]];

[s test: "library directory is discoverable independent ordinary state" do: [:t |
  let manager := [Module clone]; let original := [Module libDir];
  [t expect: [manager libDir] equals: original describes: "ordinary clone copies the current directory value"];
  [manager libDir: nil];
  [t expect: [manager libDir] equals: "lib" describes: "nil retains the default directory"];
  [t expect: [Reflect slot: #libDir in: manager] equals: nil describes: "reflection exposes stored nil"];
  [t expect: [[[Reflect slotsOf: manager] at: 0] at: #name] equals: #libDir describes: "directory is named"];
  [t assert: [[manager libDir: "/one"] == manager] describes: "setter answers manager"];
  [t expect: [Reflect slot: #libDir in: manager] equals: "/one" describes: "setter and mirror share storage"];
  [Reflect slot: #libDir in: manager put: "/two"];
  [System gc];
  [t expect: [manager dylibPathFor: #sample] equals: "/two/libbirnam_sample.dylib" describes: "mirror edit changes real module lookup"];
  [t expect: [Module libDir] equals: original describes: "clone does not mutate the host manager"];
  [t expect: [[Module requiresOf: #stdlib] size] equals: 0 describes: "dependency registry remains available"]]];

[s test: "owned registry preserves flags partial records and extensions" do: [:t |
  let manager := [Module clone]; [manager registry: [Map new]];
  [t expect: [manager recordNames] equals: #[] describes: "empty registry is enumerable"];
  [t expect: [manager recordOf: #absent] equals: nil describes: "absent record"];
  [manager markLoaded: #late];
  [t expect: [manager isLoaded: #late] equals: true describes: "loaded-only record"];
  [t expect: [manager isRegistered: #late] equals: false describes: "loaded does not imply registered"];
  [manager field: #extension of: #late put: #kept];
  [manager named: #late requires: #[#dep]];
  [t expect: [manager isLoaded: #late] equals: true describes: "declaration preserves loaded"];
  [t expect: [manager field: #extension of: #late] equals: #kept describes: "declaration preserves custom fields"];
  [manager kernel: #late];
  [t expect: [manager requiresOf: #late] equals: #[#dep] describes: "kernel conversion preserves existing dependencies"];
  [t expect: [manager kindOf: #late] equals: #kernel describes: "kernel kind"];
  [manager field: #loaded of: #late put: false];
  [manager field: #registered of: #late put: nil];
  [manager field: #requires of: #late put: nil];
  [t expect: [manager isLoaded: #late] equals: false describes: "false flag is preserved"];
  [t expect: [manager isRegistered: #late] equals: false describes: "nil flag defaults false"];
  [t expect: [manager requiresOf: #late] equals: #[] describes: "nil requirements default empty"];
  [t assert: [[manager recordOf: #late] includesKey: #requires] describes: "raw Map distinguishes a bound nil field"];
  [manager record: #nilRecord put: nil];
  [t assert: [[manager registry] includesKey: #nilRecord] describes: "bound nil record remains discoverable"];
  [t expect: [manager field: #kind of: #nilRecord] equals: nil describes: "nil record getter"];
  [t assert: [[manager removeRecord: #late] == manager] describes: "removal returns manager"];
  [t expect: [manager recordOf: #late] equals: nil describes: "removal deletes record"];
  [t assert: [[manager registry] includesKey: #nilRecord] describes: "removal preserves unrelated record"]]];

[s test: "registry snapshots clones and Reflect edits have explicit ownership" do: [:t |
  let manager := [Module clone]; [manager registry: [Map new]];
  [manager named: #a requires: #[]];
  let snapshot := [manager registry]; let record := [manager recordOf: #a]; let clone := [manager clone];
  [manager markLoaded: #a];
  [t expect: [record at: #loaded] equals: nil describes: "record snapshot stays unchanged"];
  [t expect: [[snapshot at: #a] at: #loaded] equals: nil describes: "registry snapshot stays unchanged"];
  [t expect: [clone isLoaded: #a] equals: false describes: "clone has an independent registry root"];
  [Reflect slot: #registry in: manager put: {#b -> {#registered -> true #requires -> #[#a]}}];
  [t expect: [manager recordNames] equals: #[#b] describes: "generic replacement is authoritative"];
  [t expect: [manager loadOrder: #[#b]] equals: #[#a #b] describes: "traversal uses edited records"];
  [t expect: [clone recordNames] equals: #[#a] describes: "generic replacement leaves clone alone"];
  [manager record: #b put: [[manager recordOf: #b] at: #kind put: #custom]];
  [t expect: [manager kindOf: #b] equals: #custom describes: "edited record can be installed"]]];

[s test: "registry reads can reenter park and observe later edits" do: [:t |
  let manager := [Module clone]; [manager registry: [Map new]];
  [manager named: #a requires: #[#b]]; [manager named: #b requires: #[]];
  let reader := [manager methodFor: #requiresOf:]; let visits := [#[] asCell];
  [Reflect defineMethod: #requiresOf: on: manager as: [:self :name |
    [visits set: [[visits value] add: name]];
    [[name == #a] ifTrue: [|
      [self named: #nested requires: #[]];
      [self loadOrder: #[#nested]];
      [self field: #requires of: #b put: #[#c]]; [System gc]]];
    [reader invokeOn: self arguments: #[name]]]];
  [t expect: [manager loadOrder: #[#a]] equals: #[#c #b #a] describes: "later dependency reads see current records"];
  [t expect: [visits value] equals: #[#a #nested #b #c] describes: "reentry leaves outer traversal independent"];
  [Reflect defineMethod: #requiresOf: on: manager as: [:self :name |
    [[TaskExecutor current] wait]; [reader invokeOn: self arguments: #[name]]]];
  let task := [TaskControl start: [:task | [manager requiresOf: #a]]];
  let token := [task waitToken];
  [t assert: [token notNil] describes: "read replacement may suspend"];
  [manager field: #requires of: #a put: #[#changed]]; [System gc];
  [task resolve: token with: nil];
  [t expect: [task pollOutcome] equals: #[#success #[#changed]] describes: "resumed read sees current owned state"]]];

[s test: "timesliced registry updates do not lose records or fields" do: [:t |
  let quantum := [TaskExecutor quantum];
  [#[128 1] do: [:budget |
    [[TaskExecutor field: #quantum] set: budget];
    let manager := [Module clone]; [manager registry: [Map new]];
    let task := [TaskControl start: [:parent |
      [TaskExecutor transition: [|
        [parent fork: [:child |
          [manager field: #left of: #shared put: 1];
          [manager named: #left requires: #[]]; #left]];
        [parent fork: [:child |
          [manager field: #right of: #shared put: 2];
          [manager named: #right requires: #[]]; #right]]
      ]]; #joined
    ]];
    [t expect: [task pollOutcome] equals: #[#success #joined] describes: "both tasks complete"];
    [t expect: [manager field: #left of: #shared] equals: 1 describes: "left field survives interleaving"];
    [t expect: [manager field: #right of: #shared] equals: 2 describes: "right field survives interleaving"];
    [t assert: [[manager isRegistered: #left] & [manager isRegistered: #right]] describes: "different records survive interleaving"]
  ]];
  [[TaskExecutor field: #quantum] set: quantum]]];

[s test: "failed Map updates preserve the registry and unwind transitions" do: [:t |
  let manager := [Module clone]; let original := [manager registry];
  let broken := [Object clone]; let failure := [Error kind: #registryWriteFailed];
  [Reflect defineMethod: #at: on: broken as: [:self :key | nil]];
  [Reflect defineMethod: #at:put: on: broken as: [:self :key :value | failure]];
  [Reflect defineMethod: #registry on: manager as: [:self | broken]];
  [t assert: [[manager record: #a put: [Map new]] == failure] describes: "record edit returns Map failure"];
  [t assert: [[Reflect slot: #registry in: manager] == original] describes: "failed record edit preserves storage"];
  [t assert: [[manager field: #kind of: #a put: #custom] == failure] describes: "field edit returns outer Map failure"];
  [t assert: [[Reflect slot: #registry in: manager] == original] describes: "failed field edit preserves storage"];
  let recordOwner := [Module clone];
  [recordOwner registry: {#a -> broken}]; let before := [recordOwner registry];
  [t assert: [[recordOwner field: #kind of: #a put: #custom] == failure] describes: "inner record failure propagates"];
  [t assert: [[recordOwner registry] == before] describes: "inner failure preserves whole registry"];
  let task := [TaskControl start: [:task |
    let answer := [manager record: #a put: [Map new]];
    let depth := [[task field: #transitionDepth] value];
    #[answer depth]
  ]];
  let outcome := [task pollOutcome];
  [t expect: [outcome at: 0] equals: #success describes: "ordinary Error return is not a task failure"];
  [t assert: [[[outcome at: 1] at: 0] == failure] describes: "task receives original error"];
  [t expect: [[outcome at: 1] at: 1] equals: 0 describes: "failure releases transition depth"];
  let values := [Module clone]; [values registry: [Map new]];
  [values field: #payload of: #a put: failure];
  [t assert: [[values field: #payload of: #a] == failure] describes: "Error remains valid field data"]]];
