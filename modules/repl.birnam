// repl.birnam — birnam's REPLs (console + socket), in pure birnam. Layer 2b.
//
// TWO FRONT ENDS, ONE READER. The console (`[Repl console]` — bring-up, the
// whileTrue: read-eval-print loop, teardown) is what `birnam`, `--repl`,
// `-i`, and an image boot without `main` drop into — stdin over libc fgets via
// Alien, values to stdout, located compile errors to stderr.
// `[Repl serveOn: 5555]` is the same loop over TCP: a client (nc, or Emacs over a
// network comint) types forms; the image evaluates each against its LIVE state
// with `[Codegen evalPersisting:]` and writes the value back. No new native code —
// evaluation of received source is a capability the image already has.
//
// DEPENDENCIES — load first (Repl does NOT auto-load, to keep loading simple):
//   [Module load: #socket];   // for serveOn: only; console needs none
//   [Module load: #repl];
//   [Repl serveOn: 5555]
// then, from another terminal:  nc localhost 5555
//
// Bindings PERSIST across forms (evalPersisting:), so `let x := 40` on one line and
// `[x + 2]` on the next work — you are talking to the real image. Multi-line forms
// accumulate until their brackets balance before evaluating. `:quit` disconnects.
//
// SCOPE: one connection at a time (blocking, on the Socket floor). Native CLI
// entry uses Host-owned turns; direct authored serveOn: retains its recursive
// session helper; evaluated results are ordinary values.

// -- the REPL -----------------------------------------------------------------

[Module named: #repl requires: #[#config]];
// The service and its clones share ordinary session state. Image projection
// resets that owner, retaining aliases; borrowed process streams never close.
[[|
let model := ObjectModel; let ownerSlot := 0; let setupSlot := 1;
let inputSlot := 0; let errorSlot := 1; let bufferSlot := 2;
let empty := #[nil nil nil];
let ownerPrototype := [Cell with: empty];
[Reflect defineMethod: #imagePayload on: ownerPrototype as: [:self | [Cell with: empty]]];
let repl := [model newSlots: #[[ownerPrototype with: empty] [Cell with: false]] parent: ObjectVt];
[Reflect defineMethod: #slotNames on: repl as: [:self | #[#consoleOwner #stdioState]]];
[Reflect defineMethod: #stdioState on: repl as: [:self | [model slot: setupSlot in: self]]];
[Reflect defineMethod: #stdioReady on: repl as: [:self | [[self stdioState] value]]];
[Reflect defineMethod: #consoleOwner on: repl as: [:self | [model slot: ownerSlot in: self]]];
[Reflect defineMethod: #consoleOwner: on: repl as: [:self :owner |
  [model slot: ownerSlot in: self put: owner]; self
]];
[Reflect defineMethod: #installConsoleState: on: repl as: [:self :state |
  [self consoleOwner: [ownerPrototype with: state]]
]];
[Reflect defineMethod: #consoleInput on: repl as: [:self | [[[self consoleOwner] value] at: inputSlot]]];
[Reflect defineMethod: #consoleError on: repl as: [:self | [[[self consoleOwner] value] at: errorSlot]]];
[Reflect defineMethod: #consoleBuffer on: repl as: [:self | [[[self consoleOwner] value] at: bufferSlot]]];
[Reflect defineMethod: #closeConsoleResources on: repl as: [:self |
  let owner := [self consoleOwner]; let observed := [owner value];
  [[owner replace: observed with: empty] ifTrue: [|
    let buffer := [observed at: bufferSlot];
    let freed := [[buffer isNil] ifTrue: [| nil] ifFalse: [| [buffer free]]];
    [[freed isError] ifTrue: [| freed] ifFalse: [| self]]
  ] ifFalse: [| self]]
]];
[Globals at: #Repl put: repl]
] value];
[Reflect docModule: #repl is: "The REPL — bracket-aware form reader, eval-print loop, console session, and the --listen network server."];

// Brackets balanced? Rides the native `bracketDepth` scanner (per-byte work is
// perf-retained native, like split:/trimmed — docs/design/44 §7): net `[`/`{`
// depth, ignoring brackets inside strings and // comments. `<= 0`: over-closed
// reads as done — the parser reports the real error.
[Reflect defineMethod: #isBalanced: on: Repl as: [:self :src |
  let r := [[src bracketDepth] <= 0];
  r] doc:
  "True iff `src`'s brackets balance (net depth <= 0 via the native bracketDepth scanner); over-closed reads as done."];

// True once `src` holds at least one non-blank char AND its brackets balance.
[Reflect defineMethod: #isComplete: on: Repl as: [:self :src |
  let hasText := [[[src trimmed] size] > 0];
  let done := [hasText & [self isBalanced: src]];
  done] doc:
  "True once `src` holds at least one non-blank char AND its brackets balance."];

// Evaluate one complete form against the live image and write the reply.
[Reflect defineMethod: #replyTo:src: on: Repl as: [:self :conn :src |
  let val := [Codegen evalPersisting: src];
  let err := [Codegen lastError];
  let msg := [[err notNil]
    ifTrue:  [| [["!! " , [err printString]] , "\r\n"]]
    ifFalse: [| [["=> " , [val printString]] , "\r\n"]]];
  [conn sendString: msg];
  self] doc:
  "Evaluates the complete form `src` against the live image and writes the value (or `!! error`) reply to `conn`."];

// Host socket turns use the same reader and wire format, but return evaluated
// values before presentation so generation intents can run with no live frame.
[Reflect defineMethod: #socketHostStep:buffer: on: Repl as: [:self :conn :buffer |
  let chunk := [conn recv];
  [[chunk isEmpty]
    ifTrue: [| #[#done nil]]
    ifFalse: [|
      let acc := [[buffer value] , chunk];
      [[[acc trimmed] startsWith: ":quit"]
        ifTrue: [| #[#done nil]]
        ifFalse: [|
          [[self isComplete: acc]
            ifTrue: [|
              [buffer set: ""];
              let val := [Codegen evalPersisting: [acc trimmed]];
              let err := [Codegen lastError];
              [[err notNil]
                ifTrue: [|
                  [conn sendString: [["!! " , [err printString]] , "\r\nbirnam> "]];
                  #[#continue nil]]
                ifFalse: [| #[#evaluated val]]]]
            ifFalse: [| [buffer set: acc]; #[#continue nil]]]]]]]] doc:
  "Reads one socket chunk, returning a host turn record; the buffer Cell retains incomplete source."];

[Reflect defineMethod: #printSocketResult:to: on: Repl as: [:self :value :conn |
  [conn sendString: [["=> " , [value printString]] , "\r\nbirnam> "]];
  self] doc:
  "Prints the final value of a host-owned socket turn and its next prompt."];

[Reflect defineMethod: #socketHostListen:bind: on: Repl as: [:self :port :bind |
  [System println: ["birnam socket REPL listening on " , [bind , [":" , [port printString]]]]];
  let fd := [Socket listenOn: port bind: bind];
  [[fd < 0]
    ifTrue: [| [Error kind: #socketBindFailed message: ["could not bind " , [bind , [":" , [port printString]]]]]]
    ifFalse: [| fd]]] doc:
  "Opens the listener for the Host-owned accept loop, or answers a bind Error."];

// Read/accumulate/evaluate loop for one connected client. Recurses per read;
// ends when the client hangs up ("" from recv) or sends `:quit`.
[Reflect defineMethod: #loop:buffer: on: Repl as: [:self :conn :buf |
  let chunk := [conn recv];
  let done := [[chunk isEmpty]
    ifTrue:  [| true]
    ifFalse: [|
      let acc := [buf , chunk];
      [[[acc trimmed] startsWith: ":quit"]
        ifTrue:  [| true]
        ifFalse: [|
          [[self isComplete: acc]
            ifTrue:  [|
              [self replyTo: conn src: [acc trimmed]];
              [conn sendString: "birnam> "];
              [self loop: conn buffer: ""]]
            ifFalse: [| [self loop: conn buffer: acc]]]]]]];
  done] doc:
  "Read/accumulate/evaluate loop for one client on `conn`; recurses per read, ends on hang-up (empty recv) or `:quit`."];

// One client session: greet, then loop.
[Reflect defineMethod: #session: on: Repl as: [:self :conn |
  [conn sendString: "birnam socket REPL — type a form (multi-line ok), :quit to leave.\r\nbirnam> "];
  [self loop: conn buffer: ""];
  self] doc:
  "One client session on `conn`: greet, then run the read/eval loop until it ends."];

// Listen on `port` and serve one client at a time. Blocks (Socket accept loop).
[Reflect defineMethod: #serveOn:bind: on: Repl as: [:self :port :bind |
  let me := self;
  [System println: ["birnam socket REPL listening on " , [bind , [":" , [port printString]]]]];
  let status := [Socket serve: port bind: bind with: [:conn | [me session: conn]]];
  [[status < 0]
    ifTrue: [| [Error kind: #socketBindFailed message: ["could not bind " , [bind , [":" , [port printString]]]]]]
    ifFalse: [| self]]] doc:
  "Listens on IPv4 `bind` and `port` and serves one socket-REPL client at a time; blocks in the Socket accept loop."];

[Reflect defineMethod: #serveOn: on: Repl as: [:self :port |
  [self serveOn: port bind: "0.0.0.0"]] doc:
  "Listens on `port` on all IPv4 interfaces and serves a socket-REPL client at a time."];

// -- the console REPL ----------------------------------------------------------
// The interactive loop the binary drops into. Reads stdin through libc fgets
// (Alien), prints prompts + values on stdout (System print:, an unbuffered fd
// write), and puts located compile errors on STDERR so stdout stays values-only.
// Recurses once per form, like the socket session — fine for interactive use.

// Setup is shared across clones and retained with restored wrapper code in images.
// Explicit wrapStdio reinstalls; sessions never repair or overwrite user edits.
[Reflect defineMethod: #wrapStdio on: Repl as: [:self |
  [[self stdioState] set: false];
  let wrappers := #[
    #["dlopen" "p p i" #consoleOpenProcess: ForeignAddress]
    #["dlsym" "p p s" #consoleSymbol: ForeignAddress]
    #["dlclose" "i p" #consoleCloseLibrary ForeignAddress]
    #["clearerr" "v p" #consoleClearError ForeignAddress]
    #["fgets" "p p i p" #fgetsSize:stream: ForeignAddress]
    #["fputs" "i s p" #fputsTo: String]
    #["fflush" "i p" #fflush ForeignAddress]
  ];
  let result := [wrappers inject: self into: [:status :row |
    [[status isError] ifTrue: [| status] ifFalse: [|
      [Alien wrap: [row at: 0] signature: [row at: 1] as: [row at: 2] on: [row at: 3]]
    ]]
  ]];
  [[result isError] ifTrue: [| result] ifFalse: [|
    [[self stdioState] set: true]; self
  ]]] doc:
  "Explicitly installs stdio wrappers, marking shared setup ready only after success; partial failure remains retryable."];

// Write `s` to stderr, immediately (fputs is buffered; the flush keeps stderr
// interleaved correctly with the unbuffered stdout prompts).
[Reflect defineMethod: #conErr: on: Repl as: [:self :s |
  let fe := [self consoleError];
  [s fputsTo: fe];
  [fe fflush];
  self] doc:
  "Writes `s` to stderr and flushes immediately, keeping stderr interleaved with the unbuffered stdout prompts."];

// One raw line from stdin, INCLUDING its trailing newline (a partial last line —
// EOF with no newline — comes back as-is). nil at EOF with nothing read.
// NOTE (here and below): the console sticks to the NATIVE string floor (size /
// byteAt: / trimmed / split:). The original reason — stdlib surface lifts didn't
// survive an image save/reload — is FIXED (doc'd-define recording + exportref +
// module replay); the floor is kept deliberately: the console is boot-critical,
// and the fewer layers it rides during bring-up, the less can strand it.
[Reflect defineMethod: #readLineInto: on: Repl as: [:self :acc |
  let buf := [self consoleBuffer];
  let fp  := [self consoleInput];
  let r   := [buf fgetsSize: 4096 stream: fp];
  [[r isNull]
    ifTrue:  [| [[[acc size] = 0] ifTrue: [| nil] ifFalse: [| acc]]]
    ifFalse: [|
      let line := [acc , [buf peekStringAt: 0]];
      [[[line byteAt: [[line size] - 1]] = 10]
        ifTrue:  [| line]
        ifFalse: [| [self readLineInto: line]]]]]] doc:
  "Reads one raw stdin line onto `acc`, INCLUDING its trailing newline; nil at EOF with nothing read."];

// Accumulate lines (a continuation prompt between them) until brackets balance.
// nil at EOF-with-nothing; EOF mid-form answers the partial form — the evaluator
// reports the real error, exactly as a pasted-then-closed session would.
[Reflect defineMethod: #readFormInto: on: Repl as: [:self :acc |
  let ln := [self readLineInto: ""];
  [[ln isNil]
    ifTrue:  [| [[[acc size] = 0] ifTrue: [| nil] ifFalse: [| acc]]]
    ifFalse: [|
      let form := [acc , ln];
      [[self isBalanced: form]
        ifTrue:  [| form]
        ifFalse: [|
          [System print: "   ... "];
          [self readFormInto: form]]]]]] doc:
  "Accumulates lines onto `acc` until brackets balance; nil at EOF-with-nothing, the partial form at EOF mid-form."];

// A value for the human: nil directly (it has no printString of its own),
// everything else via printString (errors render as `error(#kind: msg)`).
[Reflect defineMethod: #resultString: on: Repl as: [:self :v |
  let r := [[v isNil] ifTrue: [| "nil"] ifFalse: [| [v printString]]];
  r] doc:
  "A display string for `v`: nil renders as \"nil\", everything else via printString."];

// List the user-visible globals (the persisted bindings), skipping internal
// `__`-prefixed entries (block stashes, etc). Symbols print as `#name`, so the
// filter looks for `#__` and the display drops the sigil.
[Reflect defineMethod: #printGlobals on: Repl as: [:self |
  let bindings := [Reflect bindingsIn: Globals];
  [[bindings isError] ifTrue: [| bindings] ifFalse: [|
    let shown := [bindings select: [:row |
      let nm := [[row at: #name] printString];
      [[[nm size] > 2]
        ifTrue: [| [[[[nm byteAt: 1] = 95] & [[nm byteAt: 2] = 95]] not]]
        ifFalse: [| true]]
    ]];
    [shown do: [:row |
      [System print: ["  " , [Reflect nameOf: [row at: #name]]]];
      [System print: " = "];
      [System println: [self resultString: [row at: #value]]]
    ]];
    [[shown isEmpty] ifTrue: [| [System println: "  (no globals defined yet)"]]]
  ]];
  self] doc:
  "Prints the user-visible globals (persisted bindings), skipping internal `__`-prefixed entries."];

[Reflect defineMethod: #printHelp on: Repl as: [:self |
  [System println: "Commands:"];
  [System println: "  :help        this message"];
  [System println: "  :globals     list the bindings you've defined"];
  [System println: "  :quit        leave the REPL  (or Ctrl-D)"];
  [System println: "Everything else is birnam: an expression prints its value; `let x := …`"];
  [System println: "binds a name that persists across lines. Use CompiledUnit candidates for"];
  [System println: "method changes. Multi-line forms continue until the brackets balance."];
  self] doc:
  "Prints the console REPL's `:help` text: the commands and the basics of a session."];

// Handle a `:command` (exact match — `:quit extra` is unknown). True to quit.
[Reflect defineMethod: #command: on: Repl as: [:self :cmd |
  let quit := [[[cmd = ":quit"] | [cmd = ":q"]] | [cmd = ":exit"]];
  let r := [quit
    ifTrue:  [| true]
    ifFalse: [|
      [[[cmd = ":help"] | [cmd = ":h"]]
        ifTrue:  [| [self printHelp]; false]
        ifFalse: [|
          [[[cmd = ":globals"] | [cmd = ":g"]]
            ifTrue:  [| [self printGlobals]; false]
            ifFalse: [| [System println: "unknown command (try :help)"]; false]]]]]];
  r] doc:
  "Handles a `:command` line `cmd` (exact match; unknown prints a hint). True iff the session should quit."];

// Evaluate one form: a compile failure (syntax or out-of-subset) reports its
// located block on stderr; otherwise the value prints. Faults are catchable
// values, so the loop never dies on a bad line.
[Reflect defineMethod: #evalConsole: on: Repl as: [:self :src |
  let val := [Codegen evalPersisting: src];
  let err := [Codegen lastError];
  [[err notNil]
    ifTrue:  [| [self conErr: [err , "\n"]]]
    ifFalse: [| [System println: [self resultString: val]]]];
  self] doc:
  "Evaluates one form `src`: a compile failure reports its located block on stderr, otherwise the value prints on stdout."];

// One prompt → read → dispatch step. Answers false when the session is over
// (EOF, or a quit command); true to go again. The loop is `console`'s native
// whileTrue: — recursing here instead segfaulted a long piped session
// (~1700 lines) by exhausting the C stack.
[Reflect defineMethod: #consoleStep on: Repl as: [:self |
  [System print: "birnam> "];
  let form := [self readFormInto: ""];
  let r := [[form isNil]
    ifTrue:  [| false]
    ifFalse: [|
      let src := [form trimmed];
      [[[src size] = 0]
        ifTrue:  [| true]
        ifFalse: [|
          [[[src byteAt: 0] = 58]
            ifTrue:  [| [[self command: src] ifTrue: [| false] ifFalse: [| true]]]
            ifFalse: [| [self evalConsole: src]; true]]]]]];
  r] doc:
  "One prompt/read/dispatch step; false when the session is over (EOF or a quit command), true to go again."];

// Host-owned step protocol. Evaluation returns its value to Rust before the host
// prints it, allowing the host to drain any process-isolate cleanup between turns.
[Reflect defineMethod: #hostStep on: Repl as: [:self |
  [System print: "birnam> "];
  let form := [self readFormInto: ""];
  [[form isNil]
    ifTrue: [| #[#done nil]]
    ifFalse: [|
      let src := [form trimmed];
      [[[src size] = 0]
        ifTrue: [| #[#continue nil]]
        ifFalse: [|
          [[[src byteAt: 0] = 58]
            ifTrue: [|
              [[self command: src] ifTrue: [| #[#done nil]] ifFalse: [| #[#continue nil]]]]
            ifFalse: [|
              let val := [Codegen evalPersisting: src];
              let err := [Codegen lastError];
              [[err notNil]
                ifTrue: [| [self conErr: [err , "\n"]]; #[#continue nil]]
                ifFalse: [| #[#evaluated val]]]]]]]]]] doc:
  "Reads and evaluates at most one form, returning a host protocol record; evaluated values are returned without printing or interpreting their type."];

[Reflect defineMethod: #printHostResult: on: Repl as: [:self :value |
  [System println: [self resultString: value]];
  self] doc:
  "Prints the final value of one host-owned evaluation step."];

// birnam.toml project bring-up: load configured compiled modules dependency-first,
// then run the root-resolved `main`, all before the prompt.
[Reflect defineMethod: #applyConfigLoads on: Repl as: [:self |
  let config := [Globals at: #Config];
  [[config isNil]
    ifTrue: [| self]
    ifFalse: [|
      [[config loads] inject: self into: [:status :name |
        [[status isError]
          ifTrue:  [| status]
          ifFalse: [| [Module load: [name asSymbol]]]]]]]]] doc:
  "Loads every module named by birnam.toml `load` through Module (dependencies first); answers the first propagated error."];

[Reflect defineMethod: #applyConfigMain on: Repl as: [:self |
  let config := [Globals at: #Config];
  [[config notNil]
    ifTrue:  [|
      let m := [config main];
      [[m notNil] ifTrue: [| [System load: m]] ifFalse: [| self]]]
    ifFalse: [| self]]] doc:
  "Runs the nearest birnam.toml's root-resolved `main` before the prompt; a no-op when absent."];

[Reflect defineMethod: #applyConfig on: Repl as: [:self |
  let config := [Globals at: #Config];
  [[config notNil] ifTrue: [| [config refresh]] ifFalse: [| nil]];
  let loaded := [self applyConfigLoads];
  [[loaded isError]
    ifTrue:  [| loaded]
    ifFalse: [| [self applyConfigMain]]]] doc:
  "Applies project configuration in order: compiled module loads, then the main source entry point."];

// Session bring-up: wire the stdio FILE*s, honor config main, greet. `console`
// then loops `consoleStep` until it answers false, and closes with consoleDone.
[Reflect defineMethod: #consoleInit on: Repl as: [:self |
  let initialized := [self consoleHostInit];
  [[initialized isError]
    ifTrue: [| initialized]
    ifFalse: [| [self consoleHostReady]]]] doc:
  "Compatibility bring-up combining consoleHostInit and consoleHostReady; the normal host inserts G0 publication between them."];

// The standard stream variable names differ between Darwin and libc targets.
// These are C data symbols, read through Alien's public pointer protocol.
[Reflect defineMethod: #consoleSymbol:or:in: on: Repl as: [:self :first :fallback :library |
  let address := [library consoleSymbol: first];
  [[address isError] ifTrue: [| address] ifFalse: [|
    let resolved := [[address isNull] ifTrue: [| [library consoleSymbol: fallback]] ifFalse: [| address]];
    [[resolved isError] ifTrue: [| resolved] ifFalse: [|
      [[resolved isNull] ifTrue: [| [Error kind: #consoleStdioUnavailable message: fallback]] ifFalse: [| resolved]]
    ]]
  ]]
]];
[Reflect defineMethod: #borrowConsoleStreams on: Repl as: [:self |
  let library := [ForeignAddress consoleOpenProcess: 1];
  [[library isError] ifTrue: [| library] ifFalse: [|
    [[library isNull] ifTrue: [| [Error kind: #consoleStdioUnavailable]] ifFalse: [|
      let input := [self consoleSymbol: "__stdinp" or: "stdin" in: library];
      let error := [self consoleSymbol: "__stderrp" or: "stderr" in: library];
      let streams := [[input isError] ifTrue: [| input] ifFalse: [|
        [[error isError] ifTrue: [| error] ifFalse: [| #[[input peekPtrAt: 0] [error peekPtrAt: 0]]]]
      ]];
      let closed := [library consoleCloseLibrary];
      [[streams isError] ifTrue: [| streams] ifFalse: [|
        [[closed isError] ifTrue: [| closed] ifFalse: [|
          [[closed < 0] ifTrue: [| [Error kind: #consoleLibraryCloseFailed]] ifFalse: [|
            [[[[streams at: 0] isNull] | [[streams at: 1] isNull]]
              ifTrue: [| [Error kind: #consoleStdioUnavailable]] ifFalse: [| streams]]
          ]]
        ]]
      ]]
    ]]
  ]]
]];
[Reflect defineMethod: #openConsoleResources on: Repl as: [:self |
  let wrapped := [[self stdioReady] ifTrue: [| self] ifFalse: [| [self wrapStdio]]];
  [[wrapped isError] ifTrue: [| wrapped] ifFalse: [|
    let retired := [self closeConsoleResources];
    [[retired isError] ifTrue: [| retired] ifFalse: [|
      let streams := [self borrowConsoleStreams];
      [[streams isError] ifTrue: [| streams] ifFalse: [|
        let buffer := [Alien alloc: 4096];
        [[buffer isError] ifTrue: [| buffer] ifFalse: [|
          [[streams at: 0] consoleClearError]; [[streams at: 1] consoleClearError];
          [self installConsoleState: #[[streams at: 0] [streams at: 1] buffer]]
        ]]
      ]]
    ]]
  ]]
]];
[Reflect defineMethod: #consoleHostInit on: Repl as: [:self |
  let opened := [self openConsoleResources];
  [[opened isError] ifTrue: [| opened] ifFalse: [|
    let config := [Globals at: #Config];
    [[config notNil] ifTrue: [| [config refresh]] ifFalse: [| nil]];
    [self applyConfigLoads]
  ]]
] doc: "Borrows process stdio, owns a read buffer, and loads configured modules during bootstrap."];

// Published project entry has already applied its configuration and main.
[Reflect defineMethod: #consoleHostInitNoConfig on: Repl as: [:self |
  [self openConsoleResources]
] doc: "Opens a console session without applying Config loads or main."];

[Reflect defineMethod: #consoleHostReady on: Repl as: [:self |
  let configured := [self applyConfigMain];
  [[configured isError]
    ifTrue: [| configured]
    ifFalse: [|
      [System println: "birnam — an interactive image. :help for commands, :quit (or Ctrl-D) to leave."];
      self]]] doc:
  "Runs the configured main and greets after G0 is published and the runtime is marked running."];

[Reflect defineMethod: #consoleHostReadyNoMain on: Repl as: [:self |
  [System println: "birnam — an interactive image. :help for commands, :quit (or Ctrl-D) to leave."];
  self] doc:
  "Greets after a project run has already evaluated main, without evaluating Config main again."];

[Reflect defineMethod: #consoleDone on: Repl as: [:self |
  [System println: ""];
  [self closeConsoleResources]
] doc: "Retires the session, frees its owned read buffer and prints a final newline. Process stdio streams are borrowed and remain open."];

// The whole session: bring-up, the read-eval-print loop, teardown. The loop is
// a native whileTrue: (stack-flat), so it lives here and not in a separate driver
// frame; the binary just sends #console. consoleStep answers exactly true or
// false, so a step that faults (answers an error) stops the loop and the error
// becomes `r` — teardown still runs, and `console` answers the error for the
// driver to report.
[Reflect defineMethod: #console on: Repl as: [:self |
  let init := [self consoleInit];
  let me := self;
  let r := [[init isError]
    ifTrue:  [| init]
    ifFalse: [| [[| [me consoleStep]] whileTrue: [| 0]]]];
  [self consoleDone];
  r] doc:
  "Runs the whole console session: bring-up, a native whileTrue: over consoleStep, teardown; a faulting step's error is answered."]
